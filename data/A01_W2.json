  "ai_feedback": {
    "error_analysis": {
      "summary": "평음 ㄷ의 VOT가 격음 ㅌ 수준으로 길어, 평음과 격음의 경계가 거의 사라진 상태입니다.",
      "summary_vn": "VOT của âm thường ㄷ dài tương đương âm bật hơi ㅌ, khiến ranh giới giữa âm thường và âm bật hơi gần như biến mất.",
      "detail": "다리 ㄷ의 VOT가 117ms로 원어민 44ms의 약 2.7배에 달하고, 타다 ㅌ의 VOT 123ms와 거의 같은 길이입니다. 따뜻하다 ㄸ는 VOT 4ms로 원어민 0ms와 거의 일치해 경음은 잘 형성되어 있습니다. F0 패턴(semitone)에서도 평음 ㄷ가 -0.9로 원어민 -3.4보다 +2.5 높게 올라와, 격음 -0.2와의 음높이 차이가 0.7밖에 나지 않아 위계가 평탄해진 상태입니다.",
      "detail_vn": "VOT của 다리 ㄷ là 117ms, gấp khoảng 2.7 lần so với người bản ngữ (44ms), gần bằng với VOT 123ms của 타다 ㅌ. 따뜻하다 ㄸ có VOT 4ms, gần như trùng với người bản ngữ (0ms), cho thấy âm căng được tạo tốt. Về F0 (semitone), âm thường ㄷ là -0.9, cao hơn người bản ngữ (-3.4) tới +2.5, và chỉ chênh 0.7 so với âm bật hơi (-0.2), khiến trật tự ba bậc gần như bị san phẳng."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 대립이 없어, ㄷ를 발음할 때도 격음처럼 강한 기식을 함께 내보내는 경향이 있습니다. 또한 평음의 핵심 단서인 '낮게 시작하는 모음 음높이'가 학습자 모국어에서는 기능하지 않아, 모음을 평탄·중간 높이로 시작하면서 격음과의 음높이 차이까지 사라진 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ đối lập ba bậc âm thường·âm căng·âm bật hơi như tiếng Hàn, nên khi phát âm ㄷ, người học có xu hướng đẩy luồng hơi mạnh giống như âm bật hơi. Ngoài ra, dấu hiệu cốt lõi của âm thường là 'nguyên âm bắt đầu ở cao độ thấp' không hoạt động trong tiếng mẹ đẻ, nên nguyên âm được bắt đầu ở cao độ trung bình·bằng phẳng, khiến khoảng cách cao độ với âm bật hơi cũng biến mất.",
    "correction": {
      "main_focus": "평음 ㄷ의 기식을 줄이고, 모음 ㅏ를 더 낮은 음높이에서 시작해 격음과의 위계를 다시 만드는 것이 최우선입니다.",
      "main_focus_vn": "Ưu tiên hàng đầu là giảm luồng hơi của âm thường ㄷ và bắt đầu nguyên âm ㅏ ở cao độ thấp hơn để tái lập trật tự với âm bật hơi.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 평음·경음·격음을 차례로 발음하며 바람 양의 차이(거의 없음 → 없음 → 강함)를 체감하기",
        "최소대립쌍 '다–따–타'를 거울 앞에서 천천히 반복하며, 평음 모음은 낮게·격음 모음은 약간 높게 시작하는 음높이 차이를 함께 연습하기",
        "원어민 음원과 본인 녹음을 번갈아 들으며 평음의 기식 길이와 모음 시작 톤을 비교·교정하기"
      ],
      "steps_vn": [
