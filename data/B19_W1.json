  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음이 비슷한 음가로 모여 있어 위계가 아직 잘 드러나지 않는 인상입니다.",
      "summary_vn": "Ba âm 평음·경음·격음 hiện đang nằm gần nhau, nên thứ bậc (hierarchy) giữa chúng chưa thực sự lộ rõ.",
      "detail": "세 단어 모두 VOT 측정이 흔들려 단정은 어렵지만, F0 패턴(semitone)으로 보면 위계가 거꾸로 또는 평탄하게 나타납니다. 바지(ㅂ)는 자기 baseline 대비 -0.7 st 로 원어민(-3.7 st)보다 +3.0 st 높게 떠 있고, 빠르다(ㅃ)는 +0.8 st 로 원어민(-0.4 st)과 큰 차이 없이 비슷한 높이에 머무릅니다. 반대로 파란색(ㅍ)은 -0.2 st 로, 격음에서 기대되는 상승(+3.4 st)이 나타나지 않아 원어민과 -3.5 st 차이로 가장 멀리 떨어져 있습니다. 즉 평음은 너무 높이, 격음은 너무 낮게 발음되어 셋이 한 줄에 가깝게 눌려 있는 모양입니다.",
      "detail_vn": "Cả ba từ đều có VOT đo không ổn định nên khó khẳng định chắc chắn, nhưng nhìn vào F0 pattern (semitone) thì thứ bậc đang bị đảo hoặc bị san phẳng. 바지(ㅂ) ở -0.7 st so với baseline của chính bạn, cao hơn người bản ngữ (-3.7 st) tới +3.0 st; 빠르다(ㅃ) ở +0.8 st, gần như ngang với người bản ngữ (-0.4 st). Ngược lại 파란색(ㅍ) chỉ ở -0.2 st, không có cú nâng cao (+3.4 st) như mong đợi ở âm 격음, lệch tới -3.5 st so với người bản ngữ — đây là khoảng cách lớn nhất. Nói cách khác, 평음 thì bị đẩy lên quá cao, còn 격음 lại bị kéo xuống quá thấp, khiến cả ba âm bị ép gần như cùng một mặt phẳng.",
      "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 세 자음을 하나의 범주처럼 인식하시는 경향이 자연스럽게 나타납니다. 특히 격음의 강한 기식과 경음의 후두 긴장은 베트남어에 존재하지 않는 동작이라 동시에 약해지기 쉽고, 그래서 F0 높낮이가 자음 종류와 연동되지 않고 평탄해지는 인상입니다. VOT 측정값들이 모두 비현실적으로 크게 나온 것도, 파열 직후 모음 시작 지점이 명확하게 갈라지지 않아서일 가능성이 큽니다.",
      "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba bậc 평음·경음·격음 như tiếng Hàn, nên việc cảm nhận ba phụ âm này như cùng một loại là điều rất tự nhiên. Đặc biệt, luồng hơi mạnh của 격음 và sự căng thanh hầu của 경음 đều không tồn tại trong tiếng Việt, nên hai động tác này dễ cùng lúc bị yếu đi, khiến cao độ F0 không gắn với loại phụ âm và bị san phẳng. Việc VOT cả ba từ đều cho ra giá trị lớn bất thường nhiều khả năng là vì ranh giới giữa lúc bật hơi và lúc nguyên âm bắt đầu chưa được tách rõ."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 세 자음을 하나의 범주처럼 인식하시는 경향이 자연스럽게 나타납니다. 특히 격음의 강한 기식과 경음의 후두 긴장은 베트남어에 존재하지 않는 동작이라 동시에 약해지기 쉽고, 그래서 F0 높낮이가 자음 종류와 연동되지 않고 평탄해지는 인상입니다. VOT 측정값들이 모두 비현실적으로 크게 나온 것도, 파열 직후 모음 시작 지점이 명확하게 갈라지지 않아서일 가능성이 큽니다.",
    "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba bậc 평음·경음·격음 như tiếng Hàn, nên việc cảm nhận ba phụ âm này như cùng một loại là điều rất tự nhiên. Đặc biệt, luồng hơi mạnh của 격음 và sự căng thanh hầu của 경음 đều không tồn tại trong tiếng Việt, nên hai động tác này dễ cùng lúc bị yếu đi, khiến cao độ F0 không gắn với loại phụ âm và bị san phẳng. Việc VOT cả ba từ đều cho ra giá trị lớn bất thường nhiều khả năng là vì ranh giới giữa lúc bật hơi và lúc nguyên âm bắt đầu chưa được tách rõ.",
    "correction": {
      "main_focus": "세 자음을 동시에 고치려 하지 말고, 입 앞 손바닥에 닿는 '바람의 양' 차이부터 평·경·격으로 분명히 만드는 것에 집중하세요.",
      "main_focus_vn": "Đừng cố sửa cả ba phụ âm cùng lúc — hãy tập trung trước hết vào việc tạo ra khác biệt rõ ràng về 'lượng hơi' chạm vào lòng bàn tay đặt trước miệng giữa 평·경·격.",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 격음(파)에는 강한 바람, 평음(바)에는 부드러운 바람, 경음(빠)에는 거의 바람 없이 짧고 단단하게 — 세 단계 바람 양을 몸으로 익히세요.",
        "최소대립쌍 '바-빠-파' 를 천천히 반복하며 거울로 입 모양과 목 긴장도를 함께 확인하고, 한 세트 끝날 때마다 원어민 음원과 자기 녹음을 번갈아 들어 비교하세요.",
        "녹음 전 평소 말하는 톤으로 짧게 워밍업한 뒤, 격음에서는 음높이를 살짝 올리고 평음에서는 의식적으로 낮춰 시작해, 자음 종류와 F0 높낮이가 함께 움직이도록 연결시키세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm: với 격음 (파) thổi luồng hơi mạnh, với 평음 (바) thổi hơi nhẹ, với 경음 (빠) gần như không có hơi mà phát ngắn và chắc — luyện cho cơ thể quen với ba mức lượng hơi này.",
        "Lặp lại chậm cặp đối lập tối thiểu '바-빠-파', dùng gương để cùng kiểm tra hình miệng và độ căng cổ họng; sau mỗi lượt, nghe xen kẽ giọng người bản ngữ và bản thu của chính bạn để so sánh.",
        "Trước khi thu, hãy khởi động ngắn bằng giọng nói bình thường của mình, rồi bắt đầu 격음 với cao độ nhỉnh hơn một chút và 평음 với cao độ chủ động thấp hơn — để loại phụ âm và độ cao F0 luôn di chuyển cùng nhau."
      ]
    },
    "overall": "현재는 평음·경음·격음 세 자음이 비슷한 영역에 모여 있어 위계가 거의 평평한 상태로 보이지만, F0 측면에서 보면 경음(빠르다) 위치는 원어민과 매우 가까워서 출발점은 결코 나쁘지 않습니다. 가장 큰 과제는 격음 ㅍ의 기식과 음높이를 함께 끌어올려 위쪽으로 분리시키고, 평음 ㅂ은 의식적으로 더 낮고 부드럽게 가라앉히는 일입니다. VOT 측정이 흔들린 점은 발음 자체의 문제라기보다 파열·모음 경계가 아직 또렷하게 갈라지지 않은 신호일 수 있으니, 자음을 또렷이 끊어 발음하는 연습을 함께 해 주시면 다음 측정에서 훨씬 안정적인 값이 나올 것입니다. 한 번에 셋을 다 잡지 마시고 '바람의 양' 차이부터 만드세요.",
    "overall_vn": "Hiện tại ba phụ âm 평음·경음·격음 đang nằm gần nhau khiến thứ bậc gần như bị phẳng, nhưng xét về F0 thì vị trí của 경음 (빠르다) lại rất gần người bản ngữ — đây là điểm khởi đầu hoàn toàn không tệ. Nhiệm vụ lớn nhất là kéo 격음 ㅍ lên cao hơn cả về luồng hơi lẫn cao độ, đồng thời chủ động hạ 평음 ㅂ xuống thấp hơn và mềm hơn. Việc VOT đo không ổn định nhiều khả năng không phải lỗi phát âm mà là tín hiệu cho thấy ranh giới giữa bật hơi và nguyên âm chưa được tách rõ; nếu bạn luyện thêm cách phát âm phụ âm dứt khoát, lần đo tiếp theo sẽ ổn định hơn nhiều. Đừng cố sửa cả ba cùng lúc — hãy bắt đầu từ khác biệt 'lượng hơi' trước.",
