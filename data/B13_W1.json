  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음의 구분이 아직 평탄하게 모여 있어, 위계가 형성되는 초기 단계입니다.",
      "summary_vn": "Sự phân biệt giữa ba phụ âm 평음·경음·격음 vẫn còn khá phẳng, đang ở giai đoạn đầu hình thành hệ thống tương phản.",
      "detail": "바지(ㅂ)의 VOT 가 121ms 로 원어민 97ms 보다 24ms 더 길게 나와, 평음이 오히려 격음에 가까운 기식 양을 띱니다. 빠르다(ㅃ)의 VOT 는 2ms 로 원어민 0ms 와 거의 같아 후두 차원에서는 잘 잡혔지만, F0 가 baseline 대비 +2.0 st 더 높이 떠 평음과의 톤 위계가 과장된 인상입니다. 파란색(ㅍ)은 VOT 가 596ms 로 비현실적으로 측정되어 수치는 신뢰하기 어렵지만, 청각·일반 경향상 기식이 충분히 폭발하지 못하고 길게 끌리는 인상이 있습니다. 결과적으로 ㅂ 은 너무 세고, ㅍ 은 약하게 흐려져 두 자음의 경계가 흐릿해지는 양상입니다.",
      "detail_vn": "VOT của 바지(ㅂ) là 121ms, dài hơn 24ms so với người bản ngữ (97ms), khiến âm 평음 lại mang lượng hơi gần với 격음. VOT của 빠르다(ㅃ) là 2ms, gần như trùng với người bản ngữ (0ms) — phần thanh quản đã ổn, nhưng F0 lại cao hơn baseline +2.0 st, làm tương phản cao độ với 평음 bị phóng đại. 파란색(ㅍ) đo được VOT 596ms — con số phi thực tế nên không tin cậy, song theo cảm nhận và xu hướng chung, hơi bật dường như không đủ mạnh mà kéo dài ra. Kết quả là ㅂ thì hơi mạnh quá, ㅍ lại yếu đi, khiến ranh giới giữa hai âm này trở nên mờ."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 대립이 없고, /b/-/p/ 정도의 2중 구분만 존재하기 때문에, 학습자가 셋을 같은 범주로 인식하면서 기식 양과 후두 긴장을 동시에 조절하기 어려워합니다. 또한 평음을 '약하게' 발음하려 신경 쓸수록 오히려 숨을 길게 내보내 격음 쪽으로 흘러가고, 격음은 '강하게'라는 의식이 기식보다 길이로 표현되는 경향이 있습니다.",
    "cause_vn": "Tiếng Việt không có hệ ba bậc 평음·경음·격음 như tiếng Hàn, chỉ có đối lập hai bậc kiểu /b/-/p/, nên người học dễ gom cả ba âm vào cùng một loại và khó điều khiển đồng thời lượng hơi và độ căng thanh quản. Hơn nữa, khi cố phát âm 평음 'nhẹ', người học lại vô tình đẩy hơi ra dài hơn, trượt sang phía 격음; còn 격음 'mạnh' lại được thể hiện bằng độ dài thay vì bằng hơi bật.",
    "correction": {
      "main_focus": "평음(바)을 더 짧고 부드럽게 마무리해 격음(파)과의 기식 차이를 만드는 것이 이번 단계의 가장 큰 과제입니다.",
      "main_focus_vn": "Trọng tâm lớn nhất giai đoạn này là làm cho 평음 (바) ngắn và nhẹ hơn, để tạo khoảng cách rõ ràng về lượng hơi với 격음 (파).",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 바-빠-파를 천천히 발음하며 바람의 양을 세 단계(부드러운 바람·거의 없는 바람·강한 바람)로 구분해 체감하기",
        "최소대립쌍 바-빠-파를 거울 앞에서 천천히 반복하며 입술 긴장과 숨의 길이를 시각·촉각으로 함께 확인하기",
        "자기 녹음과 원어민 음원을 번갈아 들으며, 특히 평음에서 숨이 길게 새는지 짧게 끊기는지 청각으로 비교하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm, phát âm chậm 바-빠-파 và cảm nhận ba mức lượng hơi (gió nhẹ · gần như không có gió · gió mạnh)",
        "Lặp lại cặp tối thiểu 바-빠-파 chậm rãi trước gương, đồng thời quan sát độ căng môi và độ dài hơi bằng cả mắt và xúc giác",
        "Nghe xen kẽ bản ghi của mình và bản ghi người bản ngữ, đặc biệt chú ý xem ở 평음 hơi bị rò ra dài hay được ngắt ngắn gọn"
      ]
