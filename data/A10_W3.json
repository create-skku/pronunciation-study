  "ai_feedback": {
    "error_analysis": {
      "summary": "평음 Iㄱ과 격음 ㅋ의 VOT 차이가 거의 사라져 두 소리가 서로 가까워지고 있습니다.",
      "summary_vn": "Khoảng cách VOT giữa âm bình (평음) ㄱ và âm bật hơi (격음) ㅋ gần như biến mất, khiến hai âm này nghe rất giống nhau.",
      "detail": "가방의 ㄱ은 VOT 94ms로 원어민 63ms보다 약 31ms 길어, 평음으로 시작해야 할 자음이 이미 격음 영역까지 들어와 있습니다. 카드의 ㅋ은 VOT 96ms로 원어민 83ms와 비슷한 범위이지만, 문제는 ㄱ(94ms)과 ㅋ(96ms)의 VOT가 거의 같다는 점입니다. 까만색의 ㄲ은 VOT 21ms로 원어민 8ms보다 다소 길지만 평음·격음과 분명히 구별되는 짧은 영역에 잘 들어와 있어 강점입니다. F0 패턴(semitone)을 보면 평음 -2.7, 경음 0.7, 격음 1.7로 '평음<경음·격음' 위계 자체는 형성되어 있어 음높이 감각은 살아 있습니다.",
      "detail_vn": "ㄱ trong 가방 có VOT 94ms, dài hơn người bản xứ (63ms) khoảng 31ms — phụ âm lẽ ra phải là âm bình thì đã lấn sang vùng của âm bật hơi. ㅋ trong 카드 có VOT 96ms, gần với mức bản xứ (83ms), nhưng vấn đề là ㄱ (94ms) và ㅋ (96ms) gần như bằng nhau về VOT. ㄲ trong 까만색 đạt VOT 21ms — dù hơi dài hơn bản xứ (8ms) nhưng vẫn nằm rõ trong vùng ngắn, tách biệt khỏi âm bình và âm bật hơi, đây là điểm mạnh. Về cao độ F0 (semitone): 평음 -2.7, 경음 0.7, 격음 1.7 — thứ bậc 'âm bình < âm căng·âm bật hơi' đã hình thành, cho thấy cảm nhận cao độ rất tốt."
    },
    "cause": "베트남어에는 한국어처럼 평음·경음·격음 3단계 구분이 없고, 베트남어 /k/는 기식이 강한 편이라 한국어 평음 ㄱ도 자동으로 강하게 발음하게 됩니다. 그 결과 ㄱ의 VOT가 길어져 격음 영역에 들어가고, 정작 격음 ㅋ과 구별이 사라지는 전형적인 T3 패턴이 나타납니다. 다행히 F0 위계는 만들어 두었기 때문에, 자음 길이(VOT)만 다듬으면 셋이 빠르게 분리될 수 있습니다.",
    "cause_vn": "Tiếng Việt không có hệ thống 3 bậc 평음·경음·격음 như tiếng Hàn, và âm /k/ tiếng Việt vốn có lượng hơi khá mạnh, nên ㄱ tiếng Hàn cũng tự động được phát âm mạnh theo. Kết quả là VOT của ㄱ bị kéo dài vào vùng âm bật hơi, làm mất ranh giới với ㅋ — đây là kiểu T3 điển hình. Điểm may mắn là thứ bậc F0 đã được xây dựng, nên chỉ cần tinh chỉnh độ dài VOT của phụ âm là ba âm sẽ tách ra nhanh chóng.",
    "correction": {
      "main_focus": "평음 ㄱ의 VOT를 짧게 줄여 격음 ㅋ과의 시간 간격을 다시 벌리는 것이 가장 큰 한 가지 초점입니다.",
      "main_focus_vn": "Trọng tâm lớn nhất là rút ngắn VOT của âm bình ㄱ để mở lại khoảng cách thời gian với âm bật hơi ㅋ.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 가-까-카를 천천히 발음하며 바람의 양이 '약함-거의 없음-매우 강함' 순으로 분명히 달라지는지 손으로 확인하기",
        "최소대립쌍 가-까-카를 원어민 음원과 본인 녹음을 번갈아 들으며, 자음이 끝나고 모음이 시작되는 순간까지의 길이 차이에 귀 기울이기",
        "거울 앞에서 평음은 입술과 혀에 힘을 빼고 짧게, 격음은 같은 입 모양에서 숨을 길게 뱉으며 발음해 신체 감각으로 두 소리를 분리하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm, phát âm chậm 가-까-카 và dùng tay cảm nhận lượng hơi thay đổi rõ theo thứ tự 'yếu - gần như không có - rất mạnh'",
        "Nghe luân phiên cặp tối thiểu 가-까-카 do người bản xứ và bản thu của mình, tập trung vào sự khác biệt về độ dài từ khi kết thúc phụ âm đến khi nguyên âm bắt đầu",
        "Đứng trước gương, phát âm âm bình với môi và lưỡi thả lỏng, ngắn gọn; âm bật hơi giữ nguyên khẩu hình nhưng thở ra dài hơn — tách hai âm bằng cảm giác cơ thể"
      ]
    },
    "overall": "F0 패턴에서 평음<경음·격음 위계가 분명히 보이고, 경음 ㄲ을 짧은 VOT 영역에 안정적으로 안착시킨 점은 큰 강점입니다. 다만 평음 ㄱ의 VOT가 격음 수준까지 길어져, ㄱ과 ㅋ이 시간축에서 거의 겹치는 것이 현재의 핵심 문제입니다. 음높이 감각은 이미 갖춰져 있으니, 이제 자음의 '길이'만 조절하면 세 소리가 빠르게 분리될 단계에 있습니다. 전체적으로 베트남 학습자 중에서도 진전 속도가 빠른 케이스입니다.",
    "overall_vn": "Trong mẫu F0, thứ bậc 'âm bình < âm căng·âm bật hơi' hiện rõ, và việc giữ vững ㄲ trong vùng VOT ngắn là điểm mạnh lớn. Tuy nhiên, VOT của ㄱ bị kéo dài tới mức của âm bật hơi, khiến ㄱ và ㅋ gần như chồng lên nhau trên trục thời gian — đây là vấn đề cốt lõi hiện tại. Cảm nhận về cao độ đã sẵn sàng, chỉ cần điều chỉnh 'độ dài' của phụ âm là ba âm sẽ tách rời nhanh chóng. Nhìn chung, đây là trường hợp tiến bộ nhanh so với mặt bằng người học Việt Nam.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 ㄱ은 VOT 94ms로, PRAAT 파형에서 자음 첫 칸의 너비가 원어민(63ms)보다 약 1.5배 넓게 보입니다. 이는 평음으로 시작해야 할 자음이 이미 격음 영역에 가깝게 들어가 있다는 뜻입니다. 다행히 파란 F0 곡선의 시작점은 -2.7 semitone으로 충분히 낮아, 음높이는 평음답게 잘 유지하고 있습니다. 입술을 닫았다가 거의 동시에 'ㅏ'로 넘어간다는 느낌으로, 자음 첫 칸을 지금보다 절반 정도 좁히는 것을 목표로 연습해 보세요. 손바닥을 입 앞에 댔을 때 바람이 거의 느껴지지 않을 정도가 평음의 기준입니다.",
      "gabang_vn": "ㄱ trong 가방 có VOT 94ms — trên dạng sóng PRAAT, ô đầu tiên của phụ âm rộng gấp khoảng 1.5 lần so với người bản xứ (63ms). Điều này có nghĩa là phụ âm vốn phải là âm bình đã lấn gần sang vùng âm bật hơi. May mắn là điểm bắt đầu của đường F0 màu xanh ở mức -2.7 semitone, đủ thấp, nên cao độ vẫn giữ đúng tính chất của âm bình. Hãy luyện tập với cảm giác khép môi rồi chuyển sang 'ㅏ' gần như ngay lập tức, đặt mục tiêu thu hẹp ô đầu khoảng một nửa so với hiện tại. Khi đặt lòng bàn tay trước miệng mà gần như không cảm thấy hơi — đó là chuẩn của âm bình.",
      "ggamansaek": "까만색의 ㄲ은 VOT 21ms로 원어민(8ms)보다 약간 길지만, PRAAT 파형의 첫 칸이 평음·격음보다 분명히 좁게 나타나 짧은 VOT 영역에 잘 안착해 있습니다. 파란 F0 곡선도 0.7 semitone으로 원어민의 1.3과 거의 비슷한 높이에서 출발해, 경음의 음높이 특성도 살아 있습니다. 후두에 힘을 살짝 더 모아 입을 여는 순간을 더 빠르게 만들면, 자음 첫 칸을 한 칸 더 좁힐 수 있습니다. 세 소리 중 가장 잘 발음된 단어이니 이 감각을 다른 단어 연습의 기준점으로 삼으세요.",
      "ggamansaek_vn": "ㄲ trong 까만색 đạt VOT 21ms — hơi dài hơn bản xứ (8ms) nhưng ô đầu trên dạng sóng PRAAT hẹp rõ rệt so với âm bình và âm bật hơi, cho thấy đã ổn định trong vùng VOT ngắn. Đường F0 màu xanh khởi điểm 0.7 semitone, gần bằng mức 1.3 của người bản xứ, nên đặc tính cao độ của âm căng cũng đã có. Nếu dồn thêm chút lực vào thanh quản và mở miệng nhanh hơn, ô đầu của phụ âm có thể hẹp thêm một nhịp nữa. Đây là từ phát âm tốt nhất trong ba từ — hãy lấy cảm giác này làm chuẩn cho các từ còn lại.",
      "kadeu": "카드의 ㅋ은 VOT 96ms로 원어민(83ms)과 비슷한 영역에 들어와 있어, PRAAT 파형 첫 칸의 너비 자체는 격음답게 충분히 넓습니다. F0 곡선도 1.7 semitone으로 원어민 1.9와 거의 일치해 음높이 측면도 거의 완성되어 있습니다. 다만 ㄱ(94ms)과 거의 같은 VOT로 발음하고 있어, 격음 자체의 문제라기보다 평음이 격음 쪽으로 끌려와 두 소리가 겹친 것이 문제입니다. 손바닥을 입 앞에 댔을 때 'ㅋ'에서만 바람이 분명히 느껴지는지, 'ㄱ'에서는 바람이 거의 없는지 두 단어를 번갈아 발음하며 확인해 보세요.",
      "kadeu_vn": "ㅋ trong 카드 có VOT 96ms, nằm gần vùng của người bản xứ (83ms), và trên dạng sóng PRAAT thì ô đầu của phụ âm đủ rộng đúng đặc trưng âm bật hơi. Đường F0 cũng đạt 1.7 semitone, gần như trùng với mức 1.9 của bản xứ — yếu tố cao độ gần như hoàn thiện. Vấn đề là VOT gần như bằng với ㄱ (94ms), nên thực chất không phải ㅋ sai mà là âm bình bị kéo lên gần ㅋ, làm hai âm chồng lên nhau. Hãy đặt lòng bàn tay trước miệng và phát âm xen kẽ hai từ — kiểm tra xem chỉ ㅋ mới có hơi mạnh rõ, còn ㄱ thì gần như không có hơi."
    },
    "encouragement": "F0 위계와 경음 ㄲ을 이미 잘 만들어 두었으니, 평음의 VOT 하나만 다듬으면 세 소리가 빠르게 분리될 거예요!",
    "encouragement_vn": "Bạn đã xây dựng được thứ bậc F0 và phát âm ㄲ rất tốt — chỉ cần tinh chỉnh VOT của âm bình thôi là ba âm sẽ tách rời nhanh chóng!",
