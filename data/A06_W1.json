  "ai_feedback": {
    "error_analysis": {
      "summary": "경음은 잘 구분되지만, 격음의 기식이 지나치게 강하고 평음·격음의 음높이 위계가 약한 단계입니다.",
      "summary_vn": "빠르다 (âm căng) được phân biệt tốt, nhưng luồng hơi của 파란색 (âm bật hơi) quá mạnh và sự phân tầng cao độ giữa 바지 (âm thường) và 파란색 (âm bật hơi) còn yếu.",
      "detail": "바지의 VOT는 85ms로 원어민 97ms와 비슷하지만, 평음 기준(~20ms)에 비하면 상당히 길어 평음치고는 기식이 과한 편입니다. 빠르다는 VOT 4ms로 경음 기준(~10ms)에 완벽히 부합하며 가장 안정적인 발음입니다. 반면 파란색은 VOT 149ms로 원어민 60ms의 두 배가 넘어, 기식이 과도하게 길게 분출되는 경향이 관찰됩니다. F0 패턴(semitone)을 보면 바지(-0.9)와 빠르다(0.9)의 위계 차이가 1.8st로 좁아, 평음-경음 음높이 분리가 충분치 않습니다.",
      "detail_vn": "VOT của 바지 là 85ms, gần với người bản ngữ (97ms), nhưng so với tiêu chuẩn âm thường (~20ms) thì khá dài — luồng hơi hơi quá mức cho một âm thường. 빠르다 có VOT 4ms, hoàn toàn khớp với tiêu chuẩn âm căng (~10ms) và là phát âm ổn định nhất. Ngược lại, 파란색 có VOT 149ms, gấp hơn hai lần người bản ngữ (60ms) — luồng hơi bật ra quá dài. Về cao độ F0 (semitone), khoảng cách giữa 바지 (-0.9) và 빠르다 (0.9) chỉ 1.8st, cho thấy sự phân tách cao độ giữa âm thường và âm căng chưa đủ rõ."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 학습자가 ㅂ과 ㅍ을 '기식의 강약'이라는 단일 축으로만 인식하는 경향이 있습니다. 그래서 ㅍ을 발음할 때 '확실히 다르게'를 의식한 결과 과도하게 강한 기식이 나오고, 동시에 두 자음 사이의 모음 음높이 차이라는 또 다른 단서를 놓치게 됩니다. 경음 ㅃ은 후두 긴장이라는 비교적 명확한 신체감각이 있어 잘 습득된 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc âm thường·âm căng·âm bật hơi như tiếng Hàn, nên người học có xu hướng chỉ nhận thức ㅂ và ㅍ trên một trục duy nhất là 'cường độ luồng hơi'. Vì vậy khi phát âm ㅍ, ý thức 'phải khác hẳn' khiến luồng hơi bật ra quá mạnh, đồng thời bỏ lỡ tín hiệu thứ hai là sự khác biệt cao độ nguyên âm giữa hai phụ âm. 빠르다 (âm căng) có cảm giác cơ thể rõ ràng từ sự căng thanh quản, nên đã được tiếp thu khá tốt.",
    "correction": {
      "main_focus": "격음의 기식을 줄이는 대신, 평음과 격음 사이의 모음 음높이 차이로 두 자음을 구별하는 새로운 단서를 만들어 보세요.",
      "main_focus_vn": "Thay vì dùng luồng hơi quá mạnh ở 파란색 (âm bật hơi), hãy tạo tín hiệu phân biệt mới giữa 바지 (âm thường) và 파란색 (âm bật hơi) bằng sự chênh lệch cao độ nguyên âm.",
      "steps": [
        "거울 앞에서 입 모양과 입술 긴장도를 확인하며, 최소대립쌍 '바-빠-파'를 천천히 3회씩 반복하기.",
        "손바닥을 입 앞 10cm에 두고 세 자음의 바람 양 차이를 체감하기 — 평음은 거의 무바람, 격음은 분명하되 과하지 않게.",
        "원어민 음원을 듣고 본인 녹음과 번갈아 재생하며, 자음 직후 모음의 음높이 출발점에 집중해 비교하기."
      ],
      "steps_vn": [
        "Đứng trước gương, quan sát hình dạng môi và độ căng môi, lặp lại chậm cặp tối thiểu '바-빠-파' mỗi từ 3 lần.",
        "Đặt lòng bàn tay cách miệng 10cm và cảm nhận sự khác biệt luồng hơi của ba phụ âm — âm thường gần như không có hơi, âm bật hơi rõ ràng nhưng không quá mức.",
        "Nghe âm thanh người bản ngữ và bản ghi của mình xen kẽ, tập trung so sánh điểm xuất phát cao độ của nguyên âm ngay sau phụ âm."
      ]
    },
    "overall": "경음(빠)은 원어민 수준에 매우 근접해 있으며, 이는 학습자의 분명한 강점입니다. 다만 격음(파)의 기식이 과도하게 길어 '의식적으로 다르게 발음하려는' 노력이 오히려 부자연스러움을 만들고 있고, 평음과 격음의 음높이 차이가 좁아 두 자음의 구분이 기식 하나에만 의존하고 있습니다. 다음 단계는 '격음을 약하게, 그러나 모음을 살짝 높게' 라는 두 축의 균형을 잡는 것입니다. 강점인 경음을 기준점으로 삼아 세 자음의 위계를 천천히 다듬어 가시면 좋습니다.",
    "overall_vn": "빠르다 (âm căng) rất gần với mức người bản ngữ, đây là điểm mạnh rõ rệt của bạn. Tuy nhiên, luồng hơi của 파란색 (âm bật hơi) quá dài — nỗ lực 'phát âm khác đi một cách có ý thức' lại tạo ra sự thiếu tự nhiên, và khoảng cách cao độ giữa âm thường và âm bật hơi còn hẹp, khiến sự phân biệt hai phụ âm phụ thuộc hoàn toàn vào luồng hơi. Bước tiếp theo là cân bằng hai trục: 'âm bật hơi nhẹ hơn, nhưng nguyên âm cao hơn một chút'. Hãy lấy 빠르다 (âm căng) làm điểm tựa và từ từ điều chỉnh hệ thống ba bậc.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 파형을 보면 자음 시작 후 모음 진입까지의 첫 칸 너비(VOT)가 85ms로, 원어민 97ms보다 약간 짧지만 평음치고는 여전히 긴 편입니다. 파란 F0 곡선의 출발 높이(-0.9st)도 평탄해 보이는데, 평음의 자연스러운 위치는 더 낮아야 합니다. 입술을 가볍게 닿았다가 떼는 느낌으로, 숨을 거의 내보내지 않고 짧게 '바'를 발음해 보세요. 손바닥을 입 앞에 댔을 때 바람이 거의 느껴지지 않아야 합니다.",
      "baji_vn": "Nhìn dạng sóng của 바지, độ rộng ô đầu tiên (VOT) từ khi bắt đầu phụ âm đến nguyên âm là 85ms, ngắn hơn người bản ngữ (97ms) một chút nhưng vẫn dài đối với một âm thường. Điểm xuất phát của đường cong F0 màu xanh (-0.9st) cũng khá phẳng — vị trí tự nhiên của âm thường lẽ ra phải thấp hơn. Hãy phát âm '바' ngắn gọn, với cảm giác môi chỉ chạm nhẹ rồi tách ra, gần như không thở ra. Khi đặt lòng bàn tay trước miệng, gần như không cảm thấy luồng hơi.",
      "bbareuda": "빠르다의 파형은 자음 시작과 모음 진입이 거의 붙어 있어 첫 칸이 매우 좁고(VOT 4ms), 이는 경음 기준(~10ms)과 정확히 맞아떨어집니다. 파란 F0 곡선도 0.9st로 약간 높게 출발해 경음의 음높이 특성을 잘 살리고 있습니다. 후두를 살짝 조이고 입술을 단단히 닫았다 짧고 강하게 터뜨리는 감각이 잘 잡혀 있으니, 이 신체감각을 기억해 두세요. 다른 두 자음을 다듬을 때 기준점으로 삼을 수 있는 강점입니다.",
      "bbareuda_vn": "Dạng sóng của 빠르다 cho thấy phụ âm và nguyên âm gần như dính liền, ô đầu tiên rất hẹp (VOT 4ms), khớp chính xác với tiêu chuẩn âm căng (~10ms). Đường cong F0 màu xanh cũng xuất phát hơi cao ở 0.9st, thể hiện tốt đặc trưng cao độ của âm căng. Cảm giác siết nhẹ thanh quản, khép chặt môi rồi bật ra ngắn và mạnh đã được nắm bắt tốt — hãy ghi nhớ cảm giác cơ thể này. Đây là điểm mạnh có thể dùng làm điểm tựa khi điều chỉnh hai phụ âm còn lại.",
      "paransaek": "파란색의 파형에서 첫 칸(VOT)이 149ms로, 원어민 60ms의 두 배가 훌쩍 넘게 매우 넓게 펼쳐져 있습니다. 격음은 기식이 분명해야 하지만, 이 정도면 '필요 이상으로 길게' 바람을 내보내는 상태입니다. F0 측정이 불완전해 모음 음높이는 단정하기 어렵지만, 베트남 학습자에게 흔히 보이듯 음높이 단서보다 기식에만 의존했을 가능성이 있는 인상입니다. 손바닥을 입 앞 10cm에 두고 바람이 '짧고 분명하게' 한 번만 닿도록, 동시에 ㅏ 모음을 평소보다 살짝 높은 톤으로 시작해 보세요.",
      "paransaek_vn": "Trong dạng sóng của 파란색, ô đầu tiên (VOT) rộng tới 149ms, gấp hơn hai lần người bản ngữ (60ms) — trải dài rất rộng. Âm bật hơi cần có luồng hơi rõ ràng, nhưng ở mức này là 'thổi hơi dài hơn mức cần thiết'. Đo F0 không hoàn chỉnh nên khó khẳng định cao độ nguyên âm, nhưng có vẻ như bạn đang phụ thuộc hoàn toàn vào luồng hơi mà bỏ qua tín hiệu cao độ — một xu hướng thường thấy ở người học Việt Nam. Hãy đặt lòng bàn tay cách miệng 10cm, để luồng hơi chạm vào lòng bàn tay 'ngắn và rõ ràng' chỉ một lần, đồng thời bắt đầu nguyên âm ㅏ với tông cao hơn bình thường một chút."
