  "ai_feedback": {
    "error_analysis": {
      "summary": "경음(ㅃ)은 잘 구분되나, 평음(ㅂ)과 격음(ㅍ)의 음높이 위계가 뒤집혀 두 소리가 섞이는 단계입니다.",
      "summary_vn": "Âm căng (ㅃ) đã được phân biệt khá tốt, nhưng thứ bậc cao độ giữa âm thường (ㅂ) và âm bật hơi (ㅍ) đang bị đảo ngược, khiến hai âm này lẫn vào nhau.",
      "detail": "바지의 VOT는 71ms로 원어민 97ms보다 짧지만 평음치고는 다소 길게 나왔고, 무엇보다 ㅏ의 F0 패턴이 자기 baseline 대비 +3.0 st(원어민은 -3.7 st)로 너무 높게 시작되어 격음에 가까운 인상을 줍니다. 반면 파란색의 VOT는 59ms로 격음 길이를 거의 맞췄지만, ㅏ의 F0가 -1.4 st(원어민 +3.4 st)로 오히려 낮게 시작해 음높이 단서가 사라졌습니다. 빠르다는 VOT 4ms, F0 -2.0 st로 짧고 낮은 경음 위계를 잘 지키고 있습니다. 결과적으로 '바'와 '파'가 길이는 어느 정도 분리되지만 음높이 패턴은 평음↔격음이 거꾸로 뒤집혀, 두 음이 청각적으로 혼동되기 쉽습니다.",
      "detail_vn": "VOT của 바지 là 71ms, ngắn hơn người bản xứ (97ms) nhưng vẫn hơi dài so với âm thường; quan trọng hơn là cao độ F0 của ㅏ ở mức +3.0 st so với baseline (người bản xứ -3.7 st), bắt đầu quá cao nên nghe gần như âm bật hơi. Ngược lại, VOT của 파란색 là 59ms, gần đạt độ dài của âm bật hơi, nhưng F0 của ㅏ lại -1.4 st (người bản xứ +3.4 st), bắt đầu thấp nên mất tín hiệu cao độ. 빠르다 với VOT 4ms và F0 -2.0 st giữ đúng đặc trưng ngắn và thấp của âm căng. Kết quả là 바 và 파 tách nhau phần nào về độ dài, nhưng cao độ lại bị đảo ngược, khiến hai âm dễ bị nhầm khi nghe."
    },
    "cause": "베트남어에는 한국어처럼 평음·경음·격음 3중 대립이 없어, 학습자는 주로 '기식의 길이'만으로 자음을 구분하려는 경향이 있습니다. 그래서 VOT는 어느 정도 조절되지만, 한국어 평음·격음 구분에서 결정적인 '뒤따르는 모음의 음높이' 단서는 아직 자동화되지 않았고, 오히려 평음에서 긴장해 음높이가 높아지는 역전 현상이 나타납니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc đối lập âm thường·âm căng·âm bật hơi như tiếng Hàn, nên người học thường chỉ dựa vào 'độ dài hơi bật' để phân biệt phụ âm. Vì vậy VOT đã được điều chỉnh ở mức nhất định, nhưng tín hiệu 'cao độ của nguyên âm theo sau' — yếu tố then chốt để phân biệt 평음·격음 trong tiếng Hàn — vẫn chưa tự động hóa, thậm chí còn bị đảo ngược do căng cơ khi phát âm âm thường.",
    "correction": {
      "main_focus": "평음은 '낮고 부드럽게', 격음은 '길고 높게' — 길이와 음높이를 한 묶음으로 함께 움직이는 습관 만들기.",
      "main_focus_vn": "Âm thường thì 'thấp và nhẹ', âm bật hơi thì 'dài và cao' — tạo thói quen di chuyển độ dài và cao độ cùng nhau như một cặp đôi.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 최소대립쌍(바-빠-파)을 천천히 반복하며, 평음엔 바람이 거의 없고 격음엔 바람이 분명히 느껴지는지 매번 확인하기.",
        "자기 baseline 톤으로 '아~' 워밍업을 한 뒤, 평음 자음은 baseline보다 낮은 음, 격음 자음은 baseline보다 높은 음으로 시작하는 모음 음정 연습을 반복하기.",
        "원어민 음원과 본인 녹음을 PRAAT에서 번갈아 재생하며, 자음 직후 파란 F0 곡선의 시작 높이가 평음↔격음에서 반대 방향인지 시각적으로 확인하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm và lặp lại chậm các cặp tối thiểu (바-빠-파), mỗi lần kiểm tra xem âm thường gần như không có hơi còn âm bật hơi thì hơi phả ra rõ ràng.",
        "Khởi động bằng 'a~' ở tông baseline của mình, sau đó luyện tập bắt đầu nguyên âm sau phụ âm thường ở tông thấp hơn baseline, và sau phụ âm bật hơi ở tông cao hơn baseline.",
        "Mở PRAAT, nghe xen kẽ bản ghi của người bản xứ và của mình, kiểm tra bằng mắt xem đường cong F0 màu xanh ngay sau phụ âm có đi ngược chiều giữa âm thường và âm bật hơi hay không."
      ]
    },
    "overall": "전체적으로 경음 빠르다는 원어민 기준에 거의 도달했고, 격음 파란색의 VOT 길이도 매우 인상적입니다. 다만 평음·격음의 음높이 위계가 뒤집혀 있어, 같은 ㅏ 모음인데도 바지에서는 높게, 파란색에서는 낮게 시작되는 패턴이 가장 큰 개선 지점입니다. VOT는 이미 잘 다루고 계시니, 다음 단계는 '음높이'라는 두 번째 단서를 함께 움직이는 것입니다. 한 달만 음높이 단서에 집중하시면 세 음의 분리가 분명히 들리는 단계로 올라갑니다.",
    "overall_vn": "Nhìn chung, âm căng trong 빠르다 đã gần đạt chuẩn người bản xứ, và độ dài VOT của âm bật hơi trong 파란색 cũng rất ấn tượng. Tuy nhiên, thứ bậc cao độ giữa âm thường và âm bật hơi đang bị đảo ngược — cùng là nguyên âm ㅏ nhưng ở 바지 lại bắt đầu cao, còn ở 파란색 lại bắt đầu thấp — đây là điểm cần cải thiện lớn nhất. Bạn đã xử lý VOT tốt rồi, bước tiếp theo là di chuyển thêm tín hiệu thứ hai là 'cao độ' cùng lúc. Chỉ cần tập trung vào tín hiệu cao độ trong một tháng, ba âm sẽ tách bạch rõ ràng khi nghe.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 PRAAT 파형 첫 칸(폐쇄 구간 직후 VOT)이 71ms로 잡혀, 원어민 97ms보다 짧긴 하지만 평음치고는 여전히 길게 나타납니다. 더 큰 문제는 그 옆 파란 F0 곡선인데, ㅏ 모음이 baseline보다 +3.0 st 높이에서 시작해 곡선이 위로 솟아 있습니다 — 원어민은 -3.7 st로 아래에서 부드럽게 시작합니다. 입술을 가볍게 닫았다가 힘 빼고 떼면서, 모음을 자기 평소 말소리보다 살짝 낮은 톤으로 시작해 보세요. 손바닥에 바람이 거의 느껴지지 않을 정도면 평음 길이로 충분합니다.",
      "baji_vn": "Ô đầu tiên trên dạng sóng PRAAT của 바지 (VOT ngay sau đoạn đóng) là 71ms, ngắn hơn người bản xứ 97ms nhưng vẫn hơi dài so với âm thường. Vấn đề lớn hơn là đường cong F0 màu xanh kế bên: nguyên âm ㅏ bắt đầu ở mức +3.0 st cao hơn baseline, đường cong vọt lên trên — trong khi người bản xứ bắt đầu nhẹ nhàng ở -3.7 st bên dưới. Hãy khép môi nhẹ, thả lực rồi mở ra, đồng thời bắt đầu nguyên âm ở tông hơi thấp hơn giọng nói thường ngày của bạn. Nếu lòng bàn tay gần như không cảm thấy hơi, độ dài âm thường đã đủ.",
      "bbareuda": "빠르다는 PRAAT 상 폐쇄 직후 파형 첫 칸이 거의 보이지 않을 정도로 짧고(VOT 4ms, 원어민 0ms), F0도 -2.0 st로 baseline 아래에서 안정적으로 시작합니다 — 경음의 '짧고 낮은 시작' 패턴을 거의 완벽히 살리셨습니다. 이 감각, 즉 입술을 단단히 다물고 후두에 살짝 힘을 준 뒤 짧게 터뜨리는 느낌을 평음·격음 연습의 기준점으로 삼으세요.",
      "bbareuda_vn": "Trên PRAAT, ô đầu tiên của dạng sóng ngay sau đoạn đóng ở 빠르다 gần như không thấy được vì quá ngắn (VOT 4ms, người bản xứ 0ms), và F0 cũng bắt đầu ổn định ở -2.0 st dưới baseline — bạn đã thể hiện gần như hoàn hảo đặc trưng 'bắt đầu ngắn và thấp' của âm căng. Hãy lấy cảm giác này — khép chặt môi, hơi siết thanh quản rồi bật ngắn — làm điểm tham chiếu khi luyện tập âm thường và âm bật hơi.",
      "paransaek": "파란색의 VOT는 59ms로 원어민 60ms와 거의 동일해 PRAAT 파형 첫 칸 너비가 훌륭히 길게 그려집니다 — 기식 길이는 합격입니다. 그런데 그 직후 파란 F0 곡선이 -1.4 st로 아래에서 시작해, 원어민의 위로 솟은 +3.4 st 시작과 정반대 방향으로 그려집니다. 손바닥을 입 앞 10cm에 대고 '파!'를 외칠 때 바람이 분명히 느껴지는 감각은 유지하시되, 동시에 모음 ㅏ를 평소보다 한 음 정도 높은 톤에서 시작해 보세요 — 길이는 이미 됐으니 음높이만 위로 끌어올리면 됩니다.",
      "paransaek_vn": "VOT của 파란색 là 59ms, gần như bằng người bản xứ 60ms nên ô đầu tiên trên dạng sóng PRAAT được vẽ dài đẹp — độ dài hơi bật đã đạt yêu cầu. Nhưng ngay sau đó, đường cong F0 màu xanh lại bắt đầu ở -1.4 st bên dưới, ngược chiều hoàn toàn với điểm bắt đầu +3.4 st vọt lên của người bản xứ. Hãy giữ cảm giác hơi phả rõ ràng vào lòng bàn tay cách miệng 10cm khi hô 'pa!', đồng thời bắt đầu nguyên âm ㅏ ở tông cao hơn bình thường khoảng một bậc — độ dài đã ổn, chỉ cần kéo cao độ lên trên là được."
    },
    "encouragement": "VOT 조절 능력이 이미 원어민에 근접한 만큼, 음높이라는 마지막 퍼즐만 맞추면 세 음이 또렷이 분리됩니다 — 충분히 해내실 수 있어요!",
    "encouragement_vn": "Khả năng điều chỉnh VOT của bạn đã rất gần với người bản xứ, chỉ cần ghép thêm mảnh ghép cuối cùng là cao độ thì ba âm sẽ tách bạch rõ ràng — bạn hoàn toàn làm được!",
