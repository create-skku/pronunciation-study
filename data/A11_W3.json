  "ai_feedback": {
    "error_analysis": {
      "summary": "VOT 위계는 원어민과 매우 근접하고, 모음 음높이도 평음 대비 경음이 분명히 높아 3중 구분의 골격이 잘 잡혀 있습니다.",
      "summary_vn": "Trật tự VOT của bạn rất gần với người bản xứ, độ cao nguyên âm của 경음 (까) cũng rõ ràng cao hơn 평음 (가) — khung phân biệt 3 loại phụ âm đã được hình thành tốt.",
      "detail": "가방 VOT 61ms (원어민 63ms), 까만색 4ms (원어민 8ms), 카드 91ms (원어민 83ms) — 세 음이 4ms → 61ms → 91ms 로 깨끗하게 분리되어 있습니다. F0 ㅏ pattern_st 도 가방 -2.4, 까만색 2.1 로 평음 대비 경음이 약 4.5 semitone 높게 시작되어 위계가 일관적입니다. 다만 카드의 F0 측정이 비어 있어(f0_a_missing) 격음의 모음 시작 음높이는 단정하기 어렵고, 가방의 VOT 61ms 는 원어민과는 일치하지만 일반적 평음 기준(~20ms)으로 보면 다소 길게 나타나는 인상이 있어 발화 속도·강조 영향일 가능성도 있습니다.",
      "detail_vn": "가방 VOT 61ms (bản xứ 63ms), 까만색 4ms (bản xứ 8ms), 카드 91ms (bản xứ 83ms) — ba âm được phân tách rõ thành 4ms → 61ms → 91ms. Mẫu F0 nguyên âm ㅏ (pattern_st) của 가방 là -2.4, 까만색 là 2.1, tức 경음 bắt đầu cao hơn 평음 khoảng 4.5 semitone — trật tự rất nhất quán. Tuy nhiên F0 của 카드 không đo được (f0_a_missing) nên độ cao nguyên âm của 격음 chưa thể khẳng định; ngoài ra VOT 61ms của 가방 tuy khớp với bản xứ nhưng so với chuẩn 평음 thông thường (~20ms) có vẻ hơi dài, có thể do tốc độ phát âm hoặc nhấn mạnh.",
      "detail_explanation": ""
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어 보통 셋이 평탄해지는 경향이 나타나지만, 이 학습자는 그 평탄화를 측정상 거의 보이지 않습니다. VOT 폭과 모음 음높이를 동시에 조절하는 두 축의 감각이 이미 자리 잡혀 있다는 신호입니다. 다만 격음(카드)의 모음 음높이가 측정에서 빠져, 격음이 '기식만 강한지' 아니면 '기식+높은 모음'까지 갖췄는지가 마지막 확인 포인트입니다.",
    "cause_vn": "Tiếng Việt không có hệ phân biệt 3 cấp 평음·경음·격음 như tiếng Hàn nên người học Việt thường san bằng cả ba thành một, nhưng phép đo cho thấy bạn gần như không có hiện tượng san bằng đó. Đây là tín hiệu cho thấy bạn đã hình thành cảm giác điều chỉnh đồng thời cả hai trục: độ dài VOT và độ cao nguyên âm. Chỉ có F0 của 격음 (카드) bị thiếu trong phép đo, nên điểm cần kiểm tra cuối cùng là 격음 chỉ 'mạnh hơi bật' hay đã có cả 'hơi bật + nguyên âm cao'.",
    "correction": {
      "main_focus": "격음(카드)의 모음 ㅏ 가 평음(가방)의 ㅏ 보다 분명히 더 높은 톤으로 시작되는지를 본인 귀로 확인·고정하는 것.",
      "main_focus_vn": "Kiểm tra và cố định bằng tai của chính bạn rằng nguyên âm ㅏ trong 격음 (카드) bắt đầu ở cao độ rõ ràng cao hơn nguyên âm ㅏ trong 평음 (가방).",
      "steps": [
        "최소대립쌍 가–까–카 를 천천히 3회씩 반복하며 세 자음의 '바람 양 + 모음 높이' 두 축의 차이를 동시에 의식하기.",
        "손바닥을 입 앞 10cm 에 대고 가–까–카 를 발음해, 격음에서만 바람이 분명히 부딪히는 감각을 신체로 고정하기.",
        "원어민 음원과 본인 녹음을 번갈아 들으면서 모음 ㅏ 의 시작 음높이만 골라 비교하기(VOT 가 아니라 모음 첫 순간에 주의를 두기)."
      ],
      "steps_vn": [
        "Lặp lại chậm cặp tối thiểu 가–까–카, mỗi cặp 3 lần, đồng thời ý thức cả hai trục khác biệt: 'lượng hơi bật' và 'độ cao nguyên âm'.",
        "Đặt lòng bàn tay cách miệng 10cm và phát âm 가–까–카, ghi nhớ bằng cơ thể cảm giác chỉ riêng 격음 mới có luồng hơi đập rõ vào tay.",
        "Nghe luân phiên file người bản xứ và bản ghi của bạn, chỉ tập trung so sánh cao độ khởi đầu của nguyên âm ㅏ (chú ý vào thời điểm bắt đầu nguyên âm, không phải VOT)."
      ]
    },
    "overall": "베트남 학습자가 가장 어려워하는 평음·경음·격음 3중 구분의 골격이 이미 탄탄히 잡혀 있습니다. VOT 위계(4→61→91ms)는 원어민과 거의 일치하고, 가방과 까만색의 모음 높이 차이도 약 4.5 semitone 으로 일관적입니다. 마지막 한 칸은 카드의 모음 시작 음높이를 본인 귀로 한 번 더 확인해 격음의 두 축(기식+높은 모음)을 함께 굳히는 것입니다. 전체적으로 평탄화 경향을 잘 극복한, 매우 좋은 단계입니다.",
    "overall_vn": "Khung phân biệt 3 loại 평음·경음·격음 — phần khó nhất với người học Việt — đã được bạn dựng vững. Trật tự VOT (4→61→91ms) gần như khớp với người bản xứ, và độ chênh cao độ nguyên âm giữa 가방 và 까만색 (~4.5 semitone) cũng rất nhất quán. Mảnh ghép cuối cùng là tự tai mình kiểm tra lại cao độ khởi đầu của nguyên âm trong 카드, để cố định cả hai trục của 격음 (hơi bật + nguyên âm cao). Tổng thể đây là giai đoạn rất tốt, bạn đã vượt qua xu hướng 'san bằng' điển hình.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "PRAAT 파형에서 ㄱ 직후 모음 시작까지의 첫 칸(VOT)이 61ms 로, 원어민 63ms 와 거의 같은 폭으로 보일 것입니다. F0 ㅏ pattern 도 -2.4 st 로 본인 baseline 보다 낮게 시작되어 파란 곡선이 모음 초반에 살짝 처지는 평음다운 모양을 그립니다. 입술을 가볍게 닿았다 떼고, 그 직후 모음을 '편안하게 낮은 톤'으로 시작하는 감각이 이미 잘 잡혀 있으니 이 발음은 손댈 것이 거의 없습니다. 다른 단어를 연습할 때 가방을 기준점(anchor)으로 삼으세요.",
      "gabang_vn": "Trên dạng sóng PRAAT, khoảng đầu tiên từ sau ㄱ đến khi nguyên âm bắt đầu (VOT) là 61ms, gần bằng 63ms của người bản xứ. Pattern F0 nguyên âm ㅏ là -2.4 st — bắt đầu thấp hơn baseline của chính bạn, nên đường F0 màu xanh hơi võng xuống ở đầu nguyên âm, đúng hình dạng đặc trưng của 평음. Bạn đã giữ tốt cảm giác: chạm môi nhẹ rồi nhả, sau đó vào nguyên âm với tông thấp thoải mái. Hãy dùng 가방 làm điểm neo (anchor) khi luyện các từ khác.",
      "ggamansaek": "VOT 4ms 는 원어민 8ms 보다도 짧아, PRAAT 파형에서 ㄲ 직후 모음이 거의 곧바로 붙어 시작되는 모습으로 보입니다 — 후두 긴장이 잘 만들어졌다는 신호입니다. F0 ㅏ pattern 2.1 st 는 가방의 -2.4 보다 약 4.5 semitone 높아, 파란 곡선이 모음 초반에 위로 튀어 오르는 경음 특유의 모양을 그립니다. 짧고 단단하게 끊어서 시작하는 이 감각을 그대로 유지하세요.",
      "ggamansaek_vn": "VOT 4ms thậm chí ngắn hơn 8ms của người bản xứ — trên dạng sóng PRAAT, nguyên âm bắt đầu gần như ngay lập tức sau ㄲ, dấu hiệu cho thấy bạn đã tạo được lực căng thanh quản tốt. Pattern F0 nguyên âm ㅏ là 2.1 st, cao hơn -2.4 của 가방 khoảng 4.5 semitone, nên đường F0 màu xanh bật vọt lên ở đầu nguyên âm — đúng hình dáng đặc trưng của 경음. Hãy giữ nguyên cảm giác khởi đầu ngắn, gọn và chắc này.",
      "kadeu": "VOT 91ms 는 원어민 83ms 보다 약 8ms 더 길어, PRAAT 파형에서 ㅋ 직후 첫 칸이 가방보다 분명히 넓게 보이고 입 앞 손바닥에는 바람이 확실히 부딪혔을 것입니다 — 기식은 충분히 만들어졌습니다. 다만 카드의 ㅏ F0 측정이 비어(f0_a_missing) 모음 음높이는 단정하기 어렵고, 측정상 격음의 두 번째 축인 '높은 모음 시작'이 일관적인지는 확인이 필요한 인상입니다. 다음 연습에서 카드의 ㅏ 가 가방의 ㅏ 보다 분명히 더 높은 톤으로 시작되는지를 의식하며 3회 정도 다시 녹음해 보세요 — 손바닥 바람 시험과 동시에, 모음 첫 순간의 음높이를 함께 의식하는 것이 핵심입니다.",
      "kadeu_vn": "VOT 91ms dài hơn 83ms của người bản xứ khoảng 8ms — trên dạng sóng PRAAT, khoảng đầu tiên sau ㅋ rộng hơn rõ rệt so với 가방, và chắc bạn đã cảm nhận được luồng hơi đập rõ vào lòng bàn tay đặt trước miệng. Hơi bật như vậy là đủ. Tuy nhiên F0 nguyên âm ㅏ trong 카드 không đo được (f0_a_missing), nên cao độ nguyên âm chưa thể khẳng định, và có cảm giác cần kiểm tra lại xem trục thứ hai của 격음 — 'khởi đầu nguyên âm cao' — có nhất quán hay không. Trong buổi luyện tới, hãy ghi âm lại 카드 khoảng 3 lần với ý thức rõ ràng rằng nguyên âm ㅏ trong 카드 phải bắt đầu ở tông cao hơn rõ rệt so với ㅏ trong 가방 — kết hợp đồng thời thử bằng tay (luồng hơi) và ý thức cao độ ngay khoảnh khắc nguyên âm bắt đầu."
    },
    "encouragement": "베트남 학습자가 가장 어려워하는 3중 구분의 토대가 이미 탄탄합니다 — 카드 한 단어만 다듬으면 완성에 매우 가깝습니다!",
    "encouragement_vn": "Nền tảng phân biệt 3 cấp — phần khó nhất với người học Việt — của bạn đã rất vững. Chỉ cần trau chuốt thêm riêng từ 카드 là bạn đã rất gần với mức hoàn thiện!",
    "_source": "claude"
