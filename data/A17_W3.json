  "ai_feedback": {
    "error_analysis": {
      "summary": "평음과 경음은 잘 구분되지만, 격음 '카'의 기식이 거의 사라져 평음·경음과 합쳐지는 인상입니다.",
      "summary_vn": "Phát âm bình âm (평음) và cường âm (경음) đã phân biệt khá tốt, nhưng kích âm (격음) trong '카드' gần như mất hơi bật, khiến nó bị gộp với hai loại còn lại.",
      "detail": "가방(ㄱ)은 VOT 72ms로 원어민 63ms와 매우 가깝고, F0 패턴도 자기 baseline 대비 -0.5 st로 평음다운 낮은 톤이 잘 살아 있습니다. 까만색(ㄲ)은 VOT 8ms로 원어민과 동일하게 매우 짧아 후두 긴장이 잘 형성되었습니다. 그러나 카드(ㅋ)는 VOT가 단 2ms로 원어민 83ms 대비 80ms 가까이 짧아, 격음에 필수적인 강한 기식이 거의 만들어지지 않았습니다. F0 위계(평음 -0.5 / 경음 -1.3 / 격음 +1.7 st)는 격음만 약간 높게 올라가 톤은 격음의 흔적이 남아 있지만, VOT 축에서는 카드가 오히려 경음 까만색과 거의 같은 길이로 발음되고 있습니다.",
      "detail_vn": "가방(ㄱ) có VOT 72ms, rất gần với người bản ngữ (63ms), và mẫu F0 thấp hơn baseline -0.5 st cho thấy âm sắc bình âm được giữ tốt. 까만색(ㄲ) có VOT 8ms, trùng khớp hoàn toàn với người bản ngữ, chứng tỏ độ căng thanh quản đã được hình thành. Tuy nhiên 카드(ㅋ) chỉ có VOT 2ms, ngắn hơn người bản ngữ (83ms) gần 80ms, nghĩa là hơi bật mạnh – đặc trưng cốt lõi của kích âm – gần như không được tạo ra. Về F0 (평음 -0.5 / 경음 -1.3 / 격음 +1.7 st), kích âm có cao hơn một chút nên dấu vết âm điệu còn lại, nhưng trên trục VOT thì 카드 lại gần như trùng độ dài với 까만색."
    },
    "cause": "베트남어에는 한국어 격음처럼 길고 강한 기식을 동반하는 파열음이 없어, 학습자가 ㅋ을 발음할 때도 평음·경음과 비슷한 짧은 폐쇄로 끝내는 경향이 나타납니다. 특히 ㅋ은 입 안의 폐쇄 위치(연구개)가 깊어 베트남어 화자에게 기식을 길게 끌어내기가 더 어렵습니다. 다행히 후두 긴장(ㄲ)과 평음의 자연스러운 흐름(ㄱ)은 이미 자리 잡혀 있어, 격음만 따로 끌어올리면 3중 구분이 빠르게 완성될 단계입니다.",
    "cause_vn": "Trong tiếng Việt không có âm tắc đi kèm hơi bật dài và mạnh như kích âm tiếng Hàn, nên khi phát âm ㅋ, người học có xu hướng kết thúc bằng độ đóng ngắn giống bình âm và cường âm. Đặc biệt ㅋ có vị trí đóng sâu (ngạc mềm), khiến người Việt càng khó kéo dài hơi bật. May mắn là độ căng thanh quản (ㄲ) và dòng hơi tự nhiên của bình âm (ㄱ) đã được hình thành, nên chỉ cần kéo riêng kích âm lên là sự phân biệt ba bậc sẽ nhanh chóng hoàn thiện.",
    "correction": {
      "main_focus": "격음(ㅋ·ㅌ·ㅍ)의 '강한 바람'을 만들어내는 것 — 폐쇄를 풀 때 입 안의 공기를 길게 밀어내는 감각을 익히는 단계입니다.",
      "main_focus_vn": "Tạo ra 'luồng hơi mạnh' của kích âm (ㅋ·ㅌ·ㅍ) — luyện cảm giác đẩy hơi dài ra khỏi miệng ngay khi mở chỗ đóng.",
      "steps": [
        "손바닥을 입 앞 5cm에 두고 평음·경음·격음을 차례로 발음하며 바람의 양 차이를 체감하기 — 격음에서만 손바닥이 분명히 흔들려야 합니다.",
        "촛불이나 얇은 종이를 입 앞에 두고 격음을 발음할 때 불꽃·종이가 크게 흔들리도록 기식을 길게 유지하는 연습.",
        "최소대립쌍(가-까-카, 다-따-타, 바-빠-파)을 천천히 3회씩 반복하며 본인 녹음을 원어민 음원과 번갈아 들어 VOT 길이 차이를 귀로 확인하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm, lần lượt phát âm bình âm – cường âm – kích âm để cảm nhận sự khác biệt lượng hơi — chỉ với kích âm thì lòng bàn tay mới rung rõ rệt.",
        "Đặt một ngọn nến hoặc tờ giấy mỏng trước miệng và luyện sao cho khi phát kích âm, ngọn lửa hoặc tờ giấy rung mạnh, giữ hơi bật kéo dài.",
        "Lặp lại các cặp tối thiểu (가-까-카, 다-따-타, 바-빠-파) chậm rãi 3 lần mỗi cặp, rồi nghe xen kẽ bản ghi của bản thân và của người bản ngữ để xác nhận khác biệt VOT bằng tai."
      ]
    },
    "overall": "전체적으로 평음과 경음의 구분은 매우 안정적으로 자리 잡혀 있어 이미 베트남 학습자 평균보다 한 발 앞선 단계입니다. 특히 까만색의 VOT 8ms는 원어민과 동일한 수준으로, 후두 긴장 감각이 정확히 형성되었음을 보여줍니다. 남은 과제는 격음의 기식 길이 하나뿐이며, 이 한 축만 보강하면 3중 구분이 완성됩니다. 톤(F0) 위계에서 격음만 살짝 위로 올라간 것도 좋은 신호로, 학습자가 격음을 '다른 소리'로 인식하고는 있다는 뜻입니다.",
    "overall_vn": "Tổng thể, sự phân biệt giữa bình âm và cường âm đã rất ổn định, vượt trên mức trung bình của người học Việt Nam. Đặc biệt VOT 8ms của 까만색 trùng khớp với người bản ngữ, cho thấy cảm giác căng thanh quản đã được hình thành chính xác. Nhiệm vụ còn lại chỉ là độ dài hơi bật của kích âm – chỉ cần củng cố trục này là sự phân biệt ba bậc sẽ hoàn thiện. Việc F0 của kích âm hơi cao hơn cũng là tín hiệu tốt, chứng tỏ người học đã nhận thức được kích âm là một âm 'khác'.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "PRAAT 파형에서 ㄱ 폐쇄 직후 첫 칸 너비(VOT)가 72ms로, 원어민 63ms와 거의 같은 위치에 자리 잡고 있습니다. 파란 F0 곡선도 ㅏ 구간에서 자기 baseline 대비 -0.5 st로 살짝 가라앉아, 평음 특유의 부드러운 톤이 잘 살아 있습니다. 발음할 때 지금처럼 입술과 혀에 힘을 빼고 자연스럽게 흘려보내는 감각을 그대로 유지하세요. 평음은 이미 안정권이니, 이 단어를 다른 두 단어 연습의 기준점(anchor)으로 삼으면 좋습니다.",
      "gabang_vn": "Trên dạng sóng PRAAT, ô đầu tiên sau chỗ đóng ㄱ (VOT) rộng 72ms, gần như trùng vị trí với người bản ngữ (63ms). Đường F0 màu xanh ở đoạn ㅏ thấp hơn baseline -0.5 st, giữ được âm điệu mềm mại đặc trưng của bình âm. Khi phát âm, hãy duy trì cảm giác thả lỏng môi và lưỡi, để hơi tự nhiên chảy ra như hiện tại. Bình âm đã vững, nên có thể dùng từ này làm điểm neo (anchor) khi luyện hai từ còn lại.",
      "ggamansaek": "ㄲ 폐쇄 구간이 PRAAT 파형에서 매우 짧고 단단한 첫 칸(VOT 8ms)으로 나타나, 원어민과 정확히 같은 길이입니다. 이는 베트남 학습자에게 가장 어려운 후두 긴장이 제대로 만들어졌다는 뜻으로, 큰 강점입니다. 다만 F0 곡선이 baseline 대비 -1.3 st로 살짝 내려가 있는데, 원어민은 +1.3 st 부근에서 약간 올라갑니다 — 다음 단계로는 ㄲ을 낼 때 목에 힘을 준 채로 모음 ㅏ를 살짝 위로 띄워 시작해 보세요. 발음 직전 숨을 멈춘 뒤 짧고 단단하게 터뜨리는 지금의 감각은 그대로 유지하면 됩니다.",
      "ggamansaek_vn": "Trên dạng sóng PRAAT, đoạn đóng ㄲ rất ngắn và chắc (VOT 8ms), đúng bằng độ dài của người bản ngữ. Điều này có nghĩa độ căng thanh quản – phần khó nhất với người học Việt Nam – đã được hình thành chính xác, đây là một thế mạnh lớn. Tuy nhiên đường F0 lại thấp hơn baseline -1.3 st, trong khi người bản ngữ ở khoảng +1.3 st — bước tiếp theo, hãy thử giữ căng cổ và bắt đầu nguyên âm ㅏ ở cao độ hơi nhỉnh hơn. Cảm giác nín hơi rồi bật ra thật ngắn và chắc như hiện tại thì giữ nguyên.",
      "kadeu": "PRAAT 파형에서 ㅋ 폐쇄 직후 첫 칸(VOT)이 단 2ms로, 원어민 83ms의 한 칸짜리 긴 기식 구간이 거의 보이지 않습니다. 청각적으로는 카드가 까만색과 비슷한 짧은 폐쇄로 발음되어, 격음의 핵심인 '강한 바람'이 빠져 있는 상태입니다. 손바닥을 입 앞에 두고 '카'를 말했을 때 손바닥이 분명히 흔들리도록, 폐쇄를 풀 때 입 안의 공기를 한 박자 더 길게 밀어내 보세요. 다행히 F0 곡선은 +1.7 st로 원어민(+1.9 st)과 거의 같은 높이로 잘 올라가 있어, 톤은 이미 격음답습니다 — 이제 기식 길이만 따라오면 됩니다.",
      "kadeu_vn": "Trên dạng sóng PRAAT, ô đầu tiên sau chỗ đóng ㅋ (VOT) chỉ rộng 2ms, gần như không thấy được đoạn hơi bật dài 83ms của người bản ngữ. Về thính giác, 카드 nghe gần giống 까만색 với độ đóng ngắn, thiếu mất 'luồng hơi mạnh' – yếu tố cốt lõi của kích âm. Đặt lòng bàn tay trước miệng và khi nói '카', hãy đẩy hơi từ trong miệng dài thêm một nhịp sao cho lòng bàn tay rung rõ. May mắn là đường F0 ở +1.7 st, gần như trùng với người bản ngữ (+1.9 st), nên âm điệu đã đúng kiểu kích âm — giờ chỉ cần độ dài hơi bật bắt kịp là xong."
    },
    "encouragement": "평음과 경음의 구분은 이미 원어민 수준입니다 — 이제 격음의 '바람' 하나만 더해지면 3중 구분이 완성돼요!",
    "encouragement_vn": "Sự phân biệt bình âm và cường âm của bạn đã đạt mức người bản ngữ — chỉ cần thêm 'luồng hơi' của kích âm là ba bậc sẽ hoàn thiện!",
    "_source": "claude"
