  "ai_feedback": {
    "error_analysis": {
      "summary": "세 파열음의 VOT 위계가 거꾸로 뒤집혀, 평음·경음은 과도하게 길고 격음은 너무 짧게 발음됩니다.",
      "summary_vn": "Trật tự VOT của ba âm bật bị đảo ngược: 평음(âm thường)·경음(âm căng) phát âm quá dài, còn 격음(âm bật hơi) lại quá ngắn.",
      "detail": "다리(ㄷ)의 VOT가 182ms로 원어민 44ms보다 약 4배 길게 측정되었고, 타다(ㅌ)는 0ms로 원어민 84ms와 정반대 방향입니다. 따뜻하다(ㄸ)도 측정상 VOT가 166ms 부근으로 다소 길게 나타나는 경향이 있어, 결과적으로 평음·경음·격음의 VOT 위계(짧음<매우짧음<김)가 완전히 뒤바뀐 인상입니다. F0(ㅏ) 패턴을 보면 다리에서 +7.1st 차이로 평음을 지나치게 높게 시작하고, 타다는 -7.6st로 격음인데도 톤을 떨어뜨려, 두 축 모두에서 한국어 위계와 반대 방향으로 굳어 있습니다.",
      "detail_vn": "다리(ㄷ) có VOT 182ms, dài gấp khoảng 4 lần so với người bản ngữ (44ms); 타다(ㅌ) lại đo được 0ms, ngược hẳn so với 84ms của người bản ngữ. 따뜻하다(ㄸ) trên phép đo có xu hướng dài khoảng 166ms, kết quả là trật tự VOT của 평음·경음·격음 (ngắn<rất ngắn<dài) bị đảo ngược hoàn toàn. Về F0(ㅏ), ở 다리 bạn bắt đầu cao hơn +7.1st so với chuẩn — quá cao cho âm 평음; ở 타다 lại thấp hơn -7.6st — quá thấp cho âm 격음. Cả hai trục đều đi ngược hướng với hệ thống tiếng Hàn."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 파열음을 주로 '기식 없음 vs 기식 있음' 2분법으로 처리합니다. 그래서 평음 ㄷ을 베트남어식으로 안전하게 '약간 기식 있는 무성음'처럼 길게 만들고, 정작 강한 기식이 필요한 격음 ㅌ에서는 기식을 빼버리는 역전 현상이 일어났습니다. F0 패턴도 한국어식으로 평음을 낮게·격음을 높게 시작하는 습관이 아직 형성되지 않아 톤 방향이 반대로 나타납니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc 평음·경음·격음 như tiếng Hàn, mà chủ yếu phân biệt âm bật theo hai loại 'không bật hơi vs bật hơi'. Vì vậy bạn xử lý 평음 ㄷ theo kiểu tiếng Việt — kéo dài như một phụ âm vô thanh có chút hơi cho 'an toàn', còn ở 격음 ㅌ đáng lẽ cần luồng hơi mạnh thì lại bỏ hơi đi, gây ra hiện tượng đảo ngược. Thói quen tiếng Hàn 'bắt đầu 평음 thấp, bắt đầu 격음 cao' chưa hình thành nên hướng F0 cũng đang đi ngược.",
    "correction": {
      "main_focus": "VOT 위계를 바로 세우기 — 평음은 짧게, 격음은 강한 기식과 함께 길게 터뜨리는 감각을 몸에 새기는 것이 최우선입니다.",
      "main_focus_vn": "Dựng lại đúng trật tự VOT — ưu tiên hàng đầu là khắc vào cơ thể cảm giác: 평음 phát ngắn, 격음 bung ra dài kèm luồng hơi mạnh.",
      "steps": [
        "손바닥을 입 앞 5cm에 대고 다-따-타를 연속 발음하며 바람 양 차이(없음-없음-강함)를 직접 체감하기",
        "최소대립쌍(다·따·타)을 천천히 3회씩 반복하고, 매번 본인 녹음과 원어민 음원을 번갈아 들으며 VOT 길이와 시작 톤을 비교하기",
        "거울 앞에서 입술·혀 폐쇄 시간을 의식적으로 짧게 가져가고, 격음 차례에서는 종이 한 장을 입 앞에 두어 종이가 펄럭이는지 확인하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm, phát âm liên tục 다-따-타 và cảm nhận trực tiếp sự khác biệt về luồng hơi (không-không-mạnh)",
        "Lặp lại cặp tối thiểu (다·따·타) chậm rãi 3 lần mỗi từ, sau mỗi lần nghe xen kẽ bản ghi của mình và của người bản ngữ để so sánh độ dài VOT và cao độ khởi đầu",
        "Trước gương, chủ ý rút ngắn thời gian khép môi·lưỡi; đến lượt 격음 thì đặt một tờ giấy trước miệng và kiểm tra xem tờ giấy có rung lên không"
      ]
    },
    "overall": "현재 세 파열음이 한국어 위계와 반대 방향으로 정렬되어 있어, 청자에게는 평음이 가장 강하고 격음이 가장 약한 인상을 줍니다. 다만 다리와 타다 모두 측정 신뢰도가 확보되어 패턴이 분명히 보이는 만큼, 어느 방향으로 교정해야 할지가 명확하다는 점은 큰 강점입니다. VOT 축을 먼저 바로잡으면 F0 패턴은 자연스럽게 따라오는 경우가 많으니, 손·종이·거울을 활용한 신체 피드백부터 시작해 보세요. 한 달만 꾸준히 연습하면 위계가 분명히 살아날 수 있는 단계입니다.",
    "overall_vn": "Hiện tại ba âm bật của bạn đang sắp xếp ngược với trật tự tiếng Hàn, khiến người nghe có cảm giác 평음 lại mạnh nhất còn 격음 lại yếu nhất. Tuy nhiên, cả 다리 và 타다 đều có độ tin cậy đo lường tốt nên hướng cần sửa rất rõ ràng — đây là một lợi thế lớn. Nếu chỉnh được trục VOT trước, mẫu F0 thường sẽ tự nhiên đi theo, vì vậy hãy bắt đầu từ các phản hồi thân thể bằng tay·tờ giấy·gương. Chỉ cần luyện đều một tháng, trật tự ba âm hoàn toàn có thể được dựng lại rõ ràng.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "dari": "다리에서 VOT가 182ms로 측정되어 PRAAT 파형의 첫 칸(폐쇄 해제 후 모음 시작 전 구간)이 원어민 44ms 대비 4배 이상 넓게 펼쳐져 있습니다. 평음 ㄷ인데도 파란 F0 곡선이 +7.1st 더 높이 솟아 출발하고 있어, 청자에게는 '경음에 가까운 단단한 ㄷ'으로 들립니다. 손바닥을 입 앞에 두고 바람이 거의 안 나가도록 의식하면서, 혀끝을 잇몸에서 즉시 떼어 모음으로 빠르게 넘어가 보세요. 시작 톤도 한 호흡 낮춰 평평하게 출발해야 첫 칸이 좁아집니다.",
      "dari_vn": "Ở 다리, VOT đo được 182ms, nghĩa là ô đầu tiên trên dạng sóng PRAAT (khoảng giữa lúc nhả khép và lúc bắt đầu nguyên âm) rộng gấp hơn 4 lần so với 44ms của người bản ngữ. Dù là 평음 ㄷ, đường cong F0 màu xanh lại vọt lên cao hơn +7.1st khi khởi đầu, nên người nghe cảm thấy giống một 'ㄷ căng, gần với 경음'. Hãy đặt lòng bàn tay trước miệng, chủ ý không để hơi thoát ra, rồi nhả nhanh đầu lưỡi khỏi lợi để chuyển ngay sang nguyên âm. Đồng thời hạ cao độ khởi đầu xuống một bậc và bắt đầu thật phẳng — ô đầu tiên sẽ hẹp lại.",
      "ddatteut": "따뜻하다는 측정상 VOT가 약 166ms 부근으로 다소 길게 나타나는 경향이 있어, PRAAT 파형의 첫 칸이 경음치고는 비정상적으로 넓어 보일 가능성이 큽니다(원어민은 거의 0에 가깝게 좁음). F0 패턴은 -0.7st로 원어민과 매우 가까워, 톤 감각은 이미 잘 잡혀 있다는 인상이 있습니다. 경음 ㄸ의 핵심은 '혀를 윗잇몸에 한 박자 더 꽉 붙였다가 짧고 단단하게 터뜨리는 후두 긴장'이니, 목 안쪽이 살짝 조이는 느낌을 의식하며 손바닥에는 바람이 거의 안 닿게 발음해 보세요. 터뜨림 직후 모음으로 즉시 넘어가야 첫 칸이 좁아집니다.",
      "ddatteut_vn": "Ở 따뜻하다, phép đo cho thấy VOT có xu hướng khá dài, vào khoảng 166ms, nên ô đầu tiên trên dạng sóng PRAAT có khả năng rộng bất thường đối với một âm 경음 (trong khi người bản ngữ gần như bằng 0, rất hẹp). Mẫu F0 chỉ lệch -0.7st so với người bản ngữ — cho cảm giác cảm âm về cao độ đã khá tốt. Điểm cốt lõi của 경음 ㄸ là 'sức căng thanh quản: ép đầu lưỡi vào lợi trên thêm một nhịp rồi bung ra ngắn và chắc', nên hãy chú ý cảm giác hơi siết nhẹ phía sau cổ họng, đồng thời phát âm sao cho gần như không có luồng hơi chạm vào lòng bàn tay. Ngay sau khi bung, chuyển sang nguyên âm tức thì thì ô đầu tiên sẽ thu hẹp lại.",
      "tada": "타다에서 VOT가 0ms로 측정되어, PRAAT 파형에 격음 특유의 넓은 첫 칸(원어민 84ms)이 거의 보이지 않습니다 — 기식이 완전히 빠진 상태입니다. 파란 F0 곡선도 -7.0으로 푹 내려앉아 출발해, 격음인데도 '낮고 부드러운 평음'처럼 들립니다. 입 앞에 종이 한 장을 들고 'ㅌ' 발음에 종이가 분명히 펄럭일 때까지 폐에서 강하게 숨을 밀어 보내는 연습을 해 보세요. 동시에 시작 톤을 한 단계 올려 모음 ㅏ를 위에서 시작하면, 첫 칸과 F0 곡선이 한 번에 살아납니다.",
      "tada_vn": "Ở 타다, VOT đo được 0ms, nên trên dạng sóng PRAAT gần như không thấy ô đầu tiên rộng đặc trưng của 격음 (người bản ngữ là 84ms) — luồng hơi bị mất hoàn toàn. Đường cong F0 màu xanh cũng tụt xuống -7.0 khi khởi đầu, khiến một âm 격음 lại nghe giống 'một 평음 trầm và mềm'. Hãy cầm một tờ giấy trước miệng và luyện đẩy mạnh hơi từ phổi khi phát 'ㅌ' cho đến khi tờ giấy rung rõ rệt. Cùng lúc, nâng cao độ khởi đầu lên một bậc và bắt nguyên âm ㅏ từ trên xuống — ô đầu tiên và đường F0 sẽ sống lại đồng thời."
    },
    "encouragement": "위계 방향만 잡히면 빠르게 좋아질 단계이니, 손·종이·거울을 친구 삼아 차근차근 가 봅시다!",
    "encouragement_vn": "Bạn đang ở giai đoạn chỉ cần chỉnh đúng hướng trật tự là sẽ tiến bộ rất nhanh — hãy coi bàn tay·tờ giấy·gương là người bạn đồng hành và đi từng bước một nhé!",
