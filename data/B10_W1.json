  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 비교적 잘 구분되나, 평음 ㅂ과 경음 ㅃ이 모두 무기식·평탄한 영역으로 몰려 서로 분리되지 않는 상태입니다.",
      "summary_vn": "Âm bật hơi ㅍ được phân biệt tương đối tốt, nhưng âm thường ㅂ và âm căng ㅃ đều dồn về vùng không bật hơi, phẳng và không tách biệt được với nhau.",
      "detail": "바지(ㅂ)는 VOT 6ms 로 원어민 97ms 보다 훨씬 짧고, 빠르다(ㅃ)도 VOT 7ms 로 두 단어가 거의 같은 좌표에 놓여 있어 평음·경음 구분이 사라진 상태입니다. F0 패턴(semitone)에서도 ㅂ 은 +2.9 st, ㅃ 은 +1.1 st 만큼 원어민보다 평탄해 위계가 약합니다. 반면 파란색(ㅍ)은 VOT 148ms 로 원어민 60ms 보다 오히려 더 길게 나타나 강한 기식이 분명히 살아있어, 격음은 확실한 강점입니다. 다만 ㅍ 의 F0 가 -3.4 st 로 원어민의 상승 패턴(+3.4 st)과 반대로 가라앉아, 격음의 '높은 모음 시작'이 빠진 점이 보입니다.",
      "detail_vn": "바지(ㅂ) có VOT 6ms ngắn hơn nhiều so với 97ms của người bản ngữ, và 빠르다(ㅃ) cũng có VOT 7ms — hai từ nằm gần như cùng một tọa độ, khiến sự phân biệt âm thường·âm căng biến mất. Về mẫu F0 (semitone), ㅂ phẳng hơn người bản ngữ +2.9 st và ㅃ +1.1 st, nên thứ bậc rất yếu. Ngược lại, 파란색(ㅍ) có VOT 148ms thậm chí dài hơn 60ms của người bản ngữ, cho thấy hơi bật mạnh rất rõ — đây là điểm mạnh chắc chắn. Tuy nhiên F0 của ㅍ lại là -3.4 st, đi ngược với mẫu lên cao (+3.4 st) của người bản ngữ, nên thiếu phần 'khởi đầu nguyên âm ở vị trí cao' của âm bật hơi."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 베트남어 /b/ 가 무기식 유성음이라 한국어 ㅂ 과 ㅃ 둘 다 이 익숙한 자리로 흡수됩니다. 특히 ㅃ 에 필요한 후두 긴장은 베트남어에 없는 동작이라 자연스레 빠지게 됩니다. 격음 ㅍ 의 기식은 베트남어 'ph' 와 유사해 잘 살아남았지만, 한국어 격음 특유의 '높은 모음 시작' 위계는 아직 자리잡지 않아 톤이 따라오지 못한 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba âm âm thường·căng·bật hơi như tiếng Hàn, và /b/ trong tiếng Việt là âm hữu thanh không bật hơi, nên cả ㅂ và ㅃ đều bị hút về vị trí quen thuộc này. Đặc biệt, sự căng thanh quản cần cho ㅃ là động tác không có trong tiếng Việt nên dễ bị bỏ qua. Hơi bật của ㅍ giống 'ph' tiếng Việt nên được giữ tốt, nhưng thứ bậc 'khởi đầu nguyên âm ở vị trí cao' đặc trưng của âm bật hơi tiếng Hàn chưa hình thành, nên cao độ chưa theo kịp.",
    "correction": {
      "main_focus": "ㅂ 과 ㅃ 의 분리 — 특히 ㅃ 에서 입술을 한 박자 더 꽉 다물었다가 짧고 단단하게 터뜨리는 후두 긴장 감각 만들기.",
      "main_focus_vn": "Tách biệt ㅂ và ㅃ — đặc biệt là tạo cảm giác căng thanh quản ở ㅃ bằng cách mím môi chặt thêm một nhịp rồi bật ra ngắn và rắn chắc.",
      "steps": [
