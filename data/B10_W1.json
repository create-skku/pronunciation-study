  "ai_feedback": {
    "error_analysis": {
      "summary": "평음 ㅂ과 경음 ㅃ이 모두 무기식으로 평탄화되어 두 소리가 거의 같은 음가로 합쳐져 있고, 격음 ㅍ만 강한 기식으로 잘 분리되고 있습니다.",
      "summary_vn": "Âm thường ㅂ và âm căng ㅃ đều bị phát âm không bật hơi và trở nên rất giống nhau, chỉ có âm bật hơi ㅍ là được tách biệt rõ nhờ luồng hơi mạnh.",
      "detail": "바지의 VOT가 8ms, 빠르다의 VOT가 5ms로 두 소리가 사실상 같은 영역(0~10ms 무기식대)에 몰려 있어 ㅂ과 ㅃ의 구분이 사라졌습니다. 반면 파란색의 VOT는 97ms로 원어민 60ms를 오히려 넘어설 만큼 기식이 충분해 격음다움은 안정적으로 확보되고 있습니다. F0 패턴을 보면 빠르다에서 학습자가 +2.4 st로 원어민(-0.4 st)보다 모음을 더 높게 띄우긴 했지만, 정작 후두 긴장과 짧고 단단한 파열은 약해 'ㅃ다운 무게'가 부족합니다. 바지의 F0 패턴은 원어민과 0.9 st 차이로 거의 일치해 평음의 톤 감각은 잘 자리 잡혀 있습니다.",
      "detail_vn": "VOT của 바지 là 8ms và VOT của 빠르다 là 5ms, hai âm này thực tế đều nằm trong vùng không bật hơi (0~10ms) nên ranh giới giữa ㅂ và ㅃ đã biến mất. Ngược lại, VOT của 파란색 là 97ms, thậm chí còn dài hơn người bản ngữ (60ms), cho thấy luồng hơi đủ mạnh và tính cách của âm bật hơi đã ổn định. Về mặt F0, ở 빠르다 bạn nâng nguyên âm lên +2.4 st (người bản ngữ chỉ -0.4 st), nhưng độ căng thanh quản và sự bùng nổ ngắn-chắc lại yếu nên vẫn thiếu 'sức nặng của ㅃ'. Mẫu F0 ở 바지 chỉ chênh 0.9 st so với người bản ngữ, cho thấy cảm giác cao độ của âm thường đã rất tốt."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, /b/ 한 자리가 한국어 ㅂ과 ㅃ 영역을 모두 흡수해 버리기 때문에 두 소리가 자연스럽게 한 범주로 묶입니다. 특히 경음의 핵심 동작인 '입술과 후두를 한 박자 더 꽉 다물었다가 짧고 단단하게 터뜨리는 긴장'이 베트남어에는 존재하지 않아, 학습자가 ㅃ을 발음할 때도 평음과 같은 무기식 무긴장 자세로 굳어집니다. 반면 격음 ㅍ의 강한 기식은 베트남어 학습자들이 비교적 쉽게 모방할 수 있는 동작이라 잘 살아남았습니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba đối lập 평음·경음·격음 như tiếng Hàn, và một âm /b/ duy nhất 'hấp thụ' cả vùng của ㅂ lẫn ㅃ trong tiếng Hàn, nên hai âm này tự nhiên bị gộp thành một loại. Đặc biệt động tác cốt lõi của 경음 — 'mím chặt môi và thanh quản thêm một nhịp rồi bung ra ngắn và dứt khoát' — vốn không tồn tại trong tiếng Việt, nên khi bạn phát ㅃ vẫn giữ tư thế không bật hơi và không căng giống như 평음. Ngược lại, luồng hơi mạnh của 격음 ㅍ là động tác mà người Việt tương đối dễ bắt chước, nên nó được giữ tốt.",
    "correction": {
      "main_focus": "평음 ㅂ과 경음 ㅃ 사이의 '후두 긴장' 차이를 만들어 두 소리를 분리하는 것이 가장 시급합니다.",
      "main_focus_vn": "Việc tạo ra sự khác biệt về 'độ căng thanh quản' giữa 평음 ㅂ và 경음 ㅃ để tách hai âm này ra là điều cấp thiết nhất.",
      "steps": [
        "최소대립쌍 '바-빠-파'를 천천히 3회씩 반복하며 세 소리의 입술 압력·바람 양·목 긴장이 어떻게 달라지는지 한 가지씩 의식적으로 바꿔 보세요.",
        "손바닥을 입 앞 5cm에 두고 평음·경음·격음을 차례로 발음해 바람이 거의 없음 → 거의 없음+단단한 폭발음 → 강한 바람, 이 세 단계가 손에 명확히 다르게 느껴지는지 확인하세요.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 특히 경음 구간에서 '톡' 하고 끊어지는 단단함이 들리는지 비교하고, 거울로 입술이 한 박자 더 강하게 닫혔다가 열리는지 함께 점검하세요."
      ],
      "steps_vn": [
        "Lặp lại chậm cặp tối thiểu '바-빠-파' mỗi cụm 3 lần, ý thức thay đổi từng yếu tố một: áp lực môi, lượng hơi, độ căng cổ họng — xem ba âm khác nhau ở đâu.",
        "Đặt lòng bàn tay cách miệng 5cm rồi phát lần lượt 평음·경음·격음, kiểm tra xem tay có cảm nhận rõ ba mức khác nhau không: gần như không có hơi → gần như không có hơi nhưng có tiếng bung chắc → luồng hơi mạnh.",
        "Nghe xen kẽ giọng người bản ngữ và bản ghi của mình, đặc biệt ở đoạn 경음 lắng nghe xem có tiếng 'tách' dứt khoát hay không, đồng thời soi gương để kiểm tra môi có khép thêm một nhịp mạnh rồi mở ra hay không."
      ]
    },
    "overall": "격음 ㅍ의 강한 기식과 평음 ㅂ의 모음 톤 감각은 이미 안정적인 강점이며, 두 축이 잘 잡혀 있다는 것은 매우 좋은 출발점입니다. 다만 평음 ㅂ과 경음 ㅃ이 VOT 8ms와 5ms로 거의 한 자리에 겹쳐 있어, 현재 가장 큰 과제는 이 둘을 음향적으로 떼어내는 것입니다. 빠르다에서 모음을 높게 띄우려는 시도(+2.8 st 위로)가 이미 보이는 만큼, 여기에 후두 긴장과 짧고 단단한 파열만 더해지면 ㅃ다운 색깔이 빠르게 살아날 것입니다. 전반적으로 베트남어 화자가 흔히 겪는 전형적인 단계이지만, 격음이 이미 분리된 만큼 다음 단계로 넘어갈 준비가 충분히 되어 있습니다.",
    "overall_vn": "Luồng hơi mạnh của 격음 ㅍ và cảm giác cao độ nguyên âm ở 평음 ㅂ đã là hai điểm mạnh ổn định, việc hai trục này được giữ tốt là khởi điểm rất thuận lợi. Tuy nhiên 평음 ㅂ và 경음 ㅃ đang gần như chồng lên nhau ở VOT 8ms và 5ms, nên thách thức lớn nhất hiện tại là tách hai âm này ra về mặt âm thanh. Ở 빠르다 bạn đã có nỗ lực nâng nguyên âm lên cao (+2.8 st), chỉ cần bổ sung thêm độ căng thanh quản và tiếng bung ngắn-chắc là sắc thái của ㅃ sẽ sống dậy nhanh chóng. Nhìn chung đây là giai đoạn rất điển hình của người học gốc Việt, và vì 격음 đã được tách rời nên bạn đã sẵn sàng để bước sang bước tiếp theo.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지는 나침반에서 nặng 쪽(왼쪽)에 자리 잡고 있으며 VOT 8ms로 원어민 97ms보다 훨씬 왼쪽 깊숙이 들어가 있어 사실상 경음 영역에 가깝게 떨어져 있습니다. F0 패턴은 -2.8 st로 원어민의 -3.7 st와 거의 같은 ngang 아래 영역에 머물러 톤 감각은 잘 잡혀 있습니다. 다만 nặng 쪽으로 너무 깊이 들어가 있어, 입술 압력을 살짝 풀고 숨을 조금 더 흘리며 오른쪽(bật hơi 방향)으로 한 칸 이동시켜야 평음다운 부드러운 출발을 회복할 수 있습니다. 모음 톤은 그대로 두고, 자음 시작만 더 가볍게 열어 주세요.",
      "baji_vn": "Trên la bàn, 바지 đang nằm về phía nặng (bên trái) — VOT 8ms thấp hơn rất nhiều so với người bản ngữ 97ms, nên thực tế đã rơi sâu vào vùng gần với âm căng. Mẫu F0 ở mức -2.8 st gần như trùng với người bản ngữ -3.7 st, cho thấy cảm giác cao độ ở vùng dưới ngang đã rất tốt. Tuy nhiên vì lệch quá sâu về phía nặng, bạn cần nới nhẹ áp lực môi và để hơi thoát ra một chút, dịch tọa độ về phía phải (hướng bật hơi) một bước thì sẽ lấy lại được khởi đầu mềm mại của âm thường. Giữ nguyên cao độ nguyên âm, chỉ cần mở đầu phụ âm nhẹ nhàng hơn.",
      "bbareuda": "빠르다는 나침반의 위쪽(sắc 방향)으로는 잘 올라가서 학습자 F0 +2.4 st가 원어민 -0.4 st보다 +2.8 st 높이 떠 있어 경음 특유의 '높은 톤' 신호는 분명히 보냈습니다. 다만 nặng 축(왼쪽 깊은 곳)에서는 VOT 5ms로 원어민 0ms와 비슷한 위치지만, 정작 그 위치에서 요구되는 후두 긴장과 단단한 폭발음이 약해 바지와 거의 같은 좌표에 머물러 있는 점이 문제입니다. 즉 위쪽 이동은 성공했으나, 왼쪽으로 갈 때 필요한 '입술과 목의 한 박자 더 꽉 다묾'이 빠져 있습니다. 입술을 평음보다 한 박자 더 강하게 다문 뒤 짧게 '톡' 터뜨리는 감각을 더하면 바지와 분리된 진짜 ㅃ 좌표로 이동할 수 있습니다.",
      "bbareuda_vn": "Trên la bàn, 빠르다 đã lên được phía trên (hướng sắc): F0 của bạn +2.4 st cao hơn người bản ngữ (-0.4 st) tới +2.8 st, nên tín hiệu 'tông cao' đặc trưng của 경음 đã rõ ràng. Tuy nhiên ở trục nặng (sâu về bên trái), VOT 5ms tuy gần với người bản ngữ 0ms nhưng độ căng thanh quản và tiếng bung dứt khoát mà vị trí đó đòi hỏi lại yếu, nên tọa độ thực tế gần như trùng với 바지. Nghĩa là bạn đã thành công ở chiều đi lên, nhưng còn thiếu 'cú khép môi và cổ họng thêm một nhịp' cần thiết khi đi sang trái. Hãy mím môi chặt thêm một nhịp so với 평음 rồi bung ra ngắn gọn 'tách', tọa độ ㅃ thực sự — tách biệt khỏi 바지 — sẽ hiện ra.",
      "paransaek": "파란색은 나침반의 bật hơi 쪽(오른쪽)으로 시원하게 뻗어 나가 VOT 97ms가 원어민 클러스터 60ms보다 오히려 더 오른쪽까지 도달했습니다 — 격음의 정체성이 가장 안정적으로 표현된 단어입니다. F0 측정값은 잡히지 않았지만, VOT 만으로도 ㅂ·ㅃ 두 자매 단어와 명확히 다른 좌표에 위치한다는 인상이 있어 격음 구분은 강점으로 보아도 좋겠습니다. 다만 원어민보다 +37ms 더 오른쪽으로 나가 있어 약간 과하게 '후' 하고 부는 경향이 있을 수 있으니, 바람을 살짝만 줄여 60~80ms 부근으로 끌어오면 더 자연스러운 격음 좌표가 됩니다. 이 단어의 강점을 기준으로 다른 두 단어를 끌어올리는 전략을 권합니다.",
      "paransaek_vn": "Trên la bàn, 파란색 vươn rất tốt sang phía bật hơi (bên phải): VOT 97ms thậm chí còn đi xa hơn cụm người bản ngữ 60ms — đây là từ thể hiện rõ nhất bản sắc của 격음. Dù không đo được F0, riêng VOT cũng cho cảm giác tọa độ của từ này tách biệt hẳn so với hai 'từ chị em' ㅂ·ㅃ, nên có thể coi việc phân biệt 격음 là một điểm mạnh. Chỉ có điều bạn đang ra phía phải nhiều hơn người bản ngữ +37ms, có xu hướng 'phù' hơi hơi quá, vì vậy giảm bớt luồng hơi một chút để kéo về vùng 60~80ms sẽ cho tọa độ 격음 tự nhiên hơn. Nên dùng điểm mạnh ở từ này làm chuẩn để kéo hai từ còn lại lên theo."
    },
    "encouragement": "격음을 이미 또렷이 구분해 내고 있다는 건 가장 어려운 한 축을 정복했다는 뜻 — 이제 ㅂ과 ㅃ만 떼어내면 3중 구분이 완성됩니다!",
    "encouragement_vn": "Việc bạn đã phân biệt rõ 격음 nghĩa là bạn đã chinh phục được trục khó nhất — chỉ cần tách 평음 ㅂ và 경음 ㅃ nữa là hệ thống ba đối lập sẽ hoàn chỉnh!",
    "_source": "claude"
