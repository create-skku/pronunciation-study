  "ai_feedback": {
    "error_analysis": {
      "summary": "경음(ㅃ)은 잘 구분하지만, 평음 ㅂ과 격음 ㅍ의 VOT·음높이 위계가 평탄해진 상태입니다.",
      "summary_vn": "Âm căng (ㅃ) phát âm khá tốt, nhưng tương phản giữa âm thường ㅂ và âm bật hơi ㅍ về VOT và cao độ vẫn còn bằng phẳng.",
      "detail": "바지(ㅂ)의 VOT는 88ms로 원어민 97ms와 비슷하지만, 평음 기준에서는 매우 긴 편이라 격음에 가까운 인상을 줍니다. 반대로 파란색(ㅍ)의 VOT는 73ms로 원어민 60ms보다 길게 측정되지만 모음 ㅏ의 음높이가 원어민의 +3.4 st 대비 +0.6 st로 2.8 st 낮아 격음 특유의 '높이 솟는' 느낌이 약합니다. 빠르다(ㅃ)는 VOT 16ms, 음높이 패턴 차이도 +0.2 st로 원어민과 거의 일치해 매우 안정적입니다. 결국 ㅂ과 ㅍ 모두 'VOT가 길고 음높이는 낮은' 중간 영역에 모여 있어 둘이 잘 분리되지 않습니다.",
      "detail_vn": "VOT của 바지(ㅂ) là 88ms, gần với người bản ngữ 97ms, nhưng so với chuẩn âm thường thì khá dài, nghe gần giống âm bật hơi. Ngược lại 파란색(ㅍ) có VOT 73ms, dài hơn người bản ngữ (60ms), nhưng cao độ nguyên âm ㅏ chỉ +0.6 st so với +3.4 st của người bản ngữ — thấp hơn 2.8 st, nên cảm giác 'vút cao' đặc trưng của âm bật hơi bị yếu. 빠르다(ㅃ) có VOT 16ms và chênh lệch cao độ chỉ +0.2 st, gần như trùng khớp với người bản ngữ — rất ổn định. Kết quả là ㅂ và ㅍ đều rơi vào vùng 'VOT dài, cao độ thấp' nên hai âm chưa tách rời rõ ràng."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 학습자는 평음 ㅂ을 베트남어 /b/처럼 안정적으로 내려다 보니 길이를 줄이지 못하고, 격음 ㅍ에는 충분한 기식과 높은 음높이를 얹지 못합니다. 경음 ㅃ은 후두 긴장이라는 단일 특성이라 베트남 학습자가 비교적 빨리 익히는 편이고, 이 학습자도 그 경향을 따르고 있습니다. 즉 '길이' 차이는 어느 정도 보이지만 '음높이 위계'가 평탄해 ㅂ↔ㅍ 분리가 흐려진 상태입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc âm thường·căng·bật hơi như tiếng Hàn, nên người học phát âm ㅂ giống như /b/ tiếng Việt — ổn định nhưng không rút ngắn được độ dài, đồng thời chưa tạo đủ luồng hơi và cao độ cho ㅍ. Âm căng ㅃ chỉ cần một đặc trưng duy nhất là sự căng của thanh quản, nên người học Việt thường nắm được nhanh, và bạn cũng đang theo xu hướng đó. Nghĩa là khác biệt 'độ dài' đã xuất hiện phần nào, nhưng 'thứ bậc cao độ' còn bằng phẳng nên ranh giới ㅂ↔ㅍ vẫn mờ.",
    "correction": {
      "main_focus": "ㅍ을 발음할 때 강한 기식과 함께 모음 ㅏ를 평소보다 높게 시작해, ㅂ보다 명확히 '길고 높은' 자리에 두는 것이 가장 중요합니다.",
      "main_focus_vn": "Điều quan trọng nhất là khi phát âm ㅍ phải có luồng hơi mạnh kèm theo việc bắt đầu nguyên âm ㅏ ở cao độ cao hơn bình thường, để ㅍ rõ ràng nằm ở vị trí 'dài hơn và cao hơn' so với ㅂ.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 평음·경음·격음을 차례로 발음하며 손바닥에 닿는 바람 양의 차이를 체감하기",
        "최소대립쌍 '바-빠-파'를 천천히 반복하되, 평음은 짧고 낮게·경음은 짧고 단단하게·격음은 길고 높게 시작하는 패턴을 의식적으로 만들기",
        "원어민 음원과 본인 녹음을 번갈아 들으며 모음 ㅏ가 시작되는 음높이 차이에 집중해 비교하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm, lần lượt phát âm âm thường·căng·bật hơi để cảm nhận lượng hơi chạm vào lòng bàn tay khác nhau như thế nào",
        "Lặp lại chậm cặp tối thiểu '바-빠-파', cố ý tạo ra khuôn mẫu: âm thường ngắn và thấp, âm căng ngắn và chắc, âm bật hơi dài và bắt đầu cao",
        "Nghe xen kẽ bản thu của người bản ngữ và bản thu của chính bạn, tập trung so sánh sự khác biệt về cao độ tại điểm bắt đầu nguyên âm ㅏ"
      ]
    },
    "overall": "전체적으로 경음 ㅃ은 원어민 수준에 매우 가깝고, 평음·격음의 VOT도 어느 정도 길이 차이가 만들어지고 있습니다. 가장 아쉬운 점은 격음 ㅍ의 모음 음높이가 평음 수준에 머물러, ㅂ과 ㅍ 사이의 위계가 흐려진다는 것입니다. 길이는 이미 잡혀 있으니, 이제 '음높이'라는 두 번째 축을 추가하면 세 자음이 분명히 갈라질 수 있습니다. 빠르다에서 이미 안정적인 자기 baseline 톤을 갖고 있으니, 그 톤을 기준으로 ㅍ만 살짝 올리는 연습이 효과적입니다.",
    "overall_vn": "Nhìn chung, âm căng ㅃ của bạn đã rất gần mức người bản ngữ, và VOT của âm thường·bật hơi cũng đã tạo ra phần nào sự khác biệt về độ dài. Điểm tiếc nhất là cao độ nguyên âm của ㅍ vẫn ở mức tương đương âm thường, khiến thứ bậc giữa ㅂ và ㅍ bị mờ. Độ dài đã được nắm bắt rồi, giờ chỉ cần thêm trục thứ hai là 'cao độ' thì ba phụ âm sẽ tách rời rõ ràng. Vì ở 빠르다 bạn đã có một tông giọng baseline ổn định, hãy luyện tập nâng nhẹ ㅍ lên dựa trên tông đó — sẽ rất hiệu quả.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "PRAAT 파형에서 ㅂ의 첫 칸(파열~모음 시작 구간)이 88ms로 측정되어, 원어민 97ms와 비슷하지만 평음 기준으로는 다소 긴 편입니다. 파란 F0 곡선도 학습자 -0.4 st로 원어민 -3.7 st보다 위쪽에 떠 있어, 그래프상 '낮게 시작해 가라앉는' 평음 특유의 곡선 모양이 약합니다. 입술을 가볍게 붙였다 떼면서 숨을 거의 쓰지 않고, 모음 ㅏ를 본인 baseline보다 조금 낮은 톤으로 짧게 시작해 보세요. 손바닥을 입 앞에 두었을 때 바람이 거의 느껴지지 않아야 합니다.",
      "baji_vn": "Trên dạng sóng PRAAT, ô đầu tiên của ㅂ (đoạn từ lúc bật đến khi nguyên âm bắt đầu) đo được 88ms — gần với người bản ngữ 97ms nhưng hơi dài so với chuẩn âm thường. Đường F0 màu xanh của bạn ở mức -0.4 st, cao hơn người bản ngữ (-3.7 st), nên hình dạng đường cong 'bắt đầu thấp rồi chìm xuống' đặc trưng của âm thường chưa rõ. Hãy khép môi nhẹ rồi mở ra mà gần như không dùng hơi, và bắt đầu nguyên âm ㅏ ở tông hơi thấp hơn baseline của bạn một chút. Khi đặt lòng bàn tay trước miệng, gần như không cảm thấy luồng hơi nào.",
      "bbareuda": "빠르다의 PRAAT 파형 첫 칸이 16ms로 매우 짧고, F0 곡선도 학습자 -0.2 st로 원어민 -0.4 st와 거의 겹쳐 흐릅니다. 후두를 살짝 조이면서 짧게 끊어내는 경음 특유의 패턴이 잘 잡혀 있으니, 지금 감각을 그대로 유지하세요. 이 단어가 본인의 안정적 baseline 톤이므로, 다른 두 단어의 음높이 기준점으로 삼으면 좋습니다.",
      "bbareuda_vn": "Ô đầu tiên trong dạng sóng PRAAT của 빠르다 chỉ 16ms — rất ngắn, và đường F0 ở mức -0.2 st gần như trùng với người bản ngữ (-0.4 st). Khuôn mẫu đặc trưng của âm căng — siết nhẹ thanh quản và cắt ngắn — bạn đã nắm rất tốt, hãy giữ nguyên cảm giác này. Vì từ này là tông baseline ổn định của bạn, hãy dùng nó làm điểm chuẩn cao độ cho hai từ còn lại.",
      "paransaek": "파란색의 PRAAT 파형 첫 칸은 73ms로 원어민 60ms보다 오히려 길게 측정되어, 기식 자체는 충분히 만들고 있습니다. 그러나 파란 F0 곡선이 학습자 +0.6 st로 원어민 +3.4 st보다 2.8 st 낮게 시작해, 그래프상 '높이 솟구치는' 격음 특유의 모양이 만들어지지 않습니다. 손바닥을 입 앞 10cm에 두고 '파!'라고 했을 때 바람이 분명히 닿는 감각을 유지하면서, 동시에 ㅏ 모음을 빠르다보다 한 음 정도 더 높은 톤에서 시작해 보세요. 길이는 이미 충분하니, 음높이 하나만 더 얹으면 ㅂ과 또렷이 갈라집니다.",
      "paransaek_vn": "Ô đầu tiên trong dạng sóng PRAAT của 파란색 đo được 73ms — thậm chí dài hơn người bản ngữ (60ms), nghĩa là luồng hơi bạn tạo ra đã đủ. Tuy nhiên đường F0 màu xanh của bạn bắt đầu ở +0.6 st, thấp hơn người bản ngữ (+3.4 st) tới 2.8 st, nên hình dạng 'vút lên cao' đặc trưng của âm bật hơi chưa hình thành trên đồ thị. Hãy đặt lòng bàn tay cách miệng 10cm, khi nói '파!' phải cảm thấy luồng hơi chạm rõ vào tay, đồng thời bắt đầu nguyên âm ㅏ ở tông cao hơn 빠르다 khoảng một bậc. Độ dài đã đủ rồi — chỉ cần thêm cao độ là ㅍ sẽ tách rời rõ ràng khỏi ㅂ."
    },
