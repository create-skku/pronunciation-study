  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 어느 정도 구분되지만, 평음 ㅂ과 경음 ㅃ이 거의 같은 음가로 합쳐져 있습니다.",
      "summary_vn": "Âm bật hơi ㅍ (파) đã được phân biệt phần nào, nhưng âm thường ㅂ (바) và âm căng ㅃ (빠) gần như bị gộp thành cùng một âm.",
      "detail": "바지(ㅂ)의 VOT가 0ms, 빠르다(ㅃ)의 VOT가 3ms로 두 단어가 거의 같은 위치에 놓여 있어 평음과 경음의 구분이 사라진 상태입니다. 파란색(ㅍ)은 VOT 35ms로 원어민(60ms)보다는 짧지만 그래도 기식이 분명히 살아있어 격음의 정체성은 유지되고 있습니다. F0 위계를 보면 원어민은 평음(-3.7)<경음(-0.4)<격음(3.4) 순으로 깔끔하게 올라가는데, 학습자는 평음(1.6)>경음(-1.7), 격음(-0.1)으로 위계가 거꾸로 뒤집혀 있어 톤으로도 셋을 구분하지 못하고 있습니다. 특히 평음 ㅂ을 가장 높은 톤으로 시작한 점이 인상적입니다.",
      "detail_vn": "VOT của 바지 (ㅂ) là 0ms và 빠르다 (ㅃ) là 3ms, hai từ nằm gần như cùng một vị trí nên sự phân biệt giữa âm thường và âm căng đã biến mất. 파란색 (ㅍ) có VOT 35ms, ngắn hơn người bản ngữ (60ms) nhưng vẫn giữ được hơi bật rõ ràng nên đặc tính âm bật hơi vẫn còn. Về thứ bậc F0, người bản ngữ tăng dần gọn gàng theo thứ tự âm thường (-3.7) < âm căng (-0.4) < âm bật hơi (3.4), nhưng ở học viên lại là âm thường (1.6) > âm căng (-1.7), âm bật hơi (-0.1) — thứ bậc bị đảo ngược, tức là không phân biệt được ba âm bằng cao độ. Đặc biệt, việc bắt đầu âm thường ㅂ ở cao độ cao nhất là một điểm đáng chú ý."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 학습자가 ㅂ과 ㅃ을 모두 베트남어 /b/와 비슷한 무기식 음으로 인식해 한 범주로 흡수한 것입니다. 특히 경음의 핵심인 '후두 긴장'은 베트남어에 존재하지 않는 동작이라, ㅃ을 평음처럼 부드럽게 내게 됩니다. 반면 격음 ㅍ은 강한 기식이 베트남어 화자에게도 비교적 익숙해 어느 정도 살아남았습니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc âm thường·âm căng·âm bật hơi như tiếng Hàn, nên học viên nhận thức cả ㅂ và ㅃ như âm không bật hơi giống /b/ tiếng Việt và gộp chúng vào cùng một loại. Đặc biệt, 'sự căng thanh quản' — yếu tố cốt lõi của âm căng — là động tác không tồn tại trong tiếng Việt, nên ㅃ bị phát âm nhẹ nhàng giống âm thường. Trong khi đó, âm bật hơi ㅍ có hơi bật mạnh, vốn tương đối quen thuộc với người Việt, nên vẫn được giữ lại phần nào.",
    "correction": {
      "main_focus": "평음 ㅂ과 경음 ㅃ을 분리하는 것 — 특히 ㅃ에서 입술을 한 박자 더 꽉 다물었다가 짧고 단단하게 터뜨리는 후두 긴장 동작에 집중하세요.",
      "main_focus_vn": "Tách rời âm thường ㅂ và âm căng ㅃ — đặc biệt tập trung vào động tác căng thanh quản ở ㅃ: mím chặt môi thêm một nhịp rồi bật ra ngắn và dứt khoát.",
      "steps": [
        "거울 앞에서 입 모양과 입술 폐쇄 강도를 확인하며 최소대립쌍 '바-빠-파'를 천천히 반복해 발음하세요.",
        "손바닥을 입 앞 5cm에 두고 세 음을 차례로 발음하며 바람의 양을 직접 느껴 보세요 — ㅂ은 거의 무풍, ㅃ은 짧고 압축된 한 점, ㅍ은 길고 퍼지는 바람이어야 합니다.",
        "원어민 음원과 본인 녹음을 번갈아 들으며, 특히 모음 시작 톤의 높낮이 위계(평음<경음·격음)가 같은 방향으로 움직이는지 귀로 비교하세요."
      ],
      "steps_vn": [
        "Đứng trước gương, vừa kiểm tra khẩu hình và độ mím chặt của môi vừa lặp lại chậm cặp tương phản tối thiểu '바-빠-파'.",
        "Đặt lòng bàn tay cách miệng 5cm và phát âm lần lượt ba âm để cảm nhận trực tiếp lượng hơi — ㅂ gần như không có gió, ㅃ là một điểm gió ngắn và bị nén, ㅍ là luồng gió dài và lan tỏa.",
        "Nghe luân phiên giữa file người bản ngữ và bản ghi của mình, đặc biệt so sánh bằng tai xem thứ bậc cao độ ở đầu nguyên âm (âm thường < âm căng·âm bật hơi) có chuyển động cùng hướng hay không."
      ]
    },
    "overall": "격음 ㅍ에서 기식을 살려낸 점은 분명한 강점입니다 — 베트남 학습자에게 가장 어려운 격음 영역을 이미 절반 이상 잡고 계십니다. 다만 평음 ㅂ과 경음 ㅃ이 VOT 0ms·3ms로 거의 붙어 있고, F0 위계가 원어민과 반대 방향으로 뒤집혀 있어 이 두 음이 청자에게 같은 소리로 들릴 위험이 큽니다. 다음 단계의 핵심은 ㅃ의 후두 긴장을 새로 익히는 것 — 입술을 더 꽉 다물고, 모음을 한 톤 살짝 높여 시작하는 연습이 필요합니다. 격음에서 보여 주신 감각을 경음 쪽으로 옮겨오면 빠르게 위계가 잡힐 것입니다.",
    "overall_vn": "Việc giữ được hơi bật ở âm bật hơi ㅍ là một điểm mạnh rõ ràng — bạn đã làm chủ được hơn nửa vùng âm bật hơi, vốn là phần khó nhất với người học Việt Nam. Tuy nhiên, âm thường ㅂ và âm căng ㅃ gần như dính liền nhau ở VOT 0ms và 3ms, và thứ bậc F0 lại bị đảo ngược so với người bản ngữ, nên hai âm này có nguy cơ cao bị người nghe coi là cùng một âm. Trọng tâm của giai đoạn tiếp theo là học mới động tác căng thanh quản cho ㅃ — cần luyện mím môi chặt hơn và bắt đầu nguyên âm với cao độ nhỉnh hơn một bậc. Nếu bạn chuyển được cảm giác đã có ở âm bật hơi sang vùng âm căng, thứ bậc ba âm sẽ nhanh chóng được thiết lập.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)의 파형 첫 칸 너비가 0ms로 측정되어, 입술이 열리자마자 곧바로 모음이 시작된 상태입니다 — 원어민의 97ms와 비교하면 파형상 폐쇄 구간이 거의 보이지 않습니다. 파란 F0 곡선도 1.6 st로 평음치고는 높게 시작해, 평음 특유의 낮고 부드러운 출발이 아니라 경음·격음 자리에 가깝게 놓였습니다. 입술을 한 박자 더 부드럽게 다물었다가 살짝 열고, 모음 ㅏ를 평소 말소리보다 약간 낮은 톤으로 출발해 보세요. 손바닥을 입 앞에 댔을 때 거의 바람이 느껴지지 않아야 정상입니다.",
      "baji_vn": "Độ rộng ô đầu tiên của dạng sóng ở 바지 (ㅂ) đo được 0ms, tức là nguyên âm bắt đầu ngay khi môi vừa mở — so với 97ms của người bản ngữ, đoạn đóng môi gần như không thấy trên dạng sóng. Đường F0 màu xanh cũng bắt đầu ở 1.6 st, cao một cách bất thường đối với âm thường, nằm gần vùng của âm căng·âm bật hơi chứ không phải khởi đầu thấp và nhẹ đặc trưng của âm thường. Hãy mím môi thêm một nhịp một cách nhẹ nhàng, rồi hé mở, và bắt đầu nguyên âm ㅏ với cao độ thấp hơn giọng nói thường ngày một chút. Khi đặt lòng bàn tay trước miệng, gần như không cảm thấy gió mới là đúng.",
      "bbareuda": "빠르다(ㅃ)의 VOT는 3ms로 경음의 짧은 폐쇄 자체는 잘 잡혀 있지만, 문제는 바로 옆 바지(0ms)와 거의 구분되지 않는다는 점입니다 — 파형만 보면 두 단어가 형제처럼 닮았습니다. 게다가 F0가 -1.7 st로 평음(1.6)보다 오히려 더 낮아, 톤 위계도 원어민과 반대 방향(원어민은 경음이 평음보다 높음)으로 흐르고 있습니다. 입술을 한 박자 더 강하게 다물어 압력을 모은 뒤 짧고 단단하게 '뻥' 터뜨리는 느낌으로 발음하고, 뒤따르는 ㅏ는 평음보다 조금 더 높은 톤으로 시작해 보세요. 목 안쪽이 살짝 조이는 긴장감을 느끼는 것이 핵심입니다.",
      "bbareuda_vn": "VOT của 빠르다 (ㅃ) là 3ms, đoạn đóng ngắn đặc trưng của âm căng đã được giữ tốt, nhưng vấn đề là nó gần như không phân biệt được với 바지 (0ms) ngay bên cạnh — chỉ nhìn dạng sóng thôi cũng thấy hai từ giống như anh em sinh đôi. Hơn nữa, F0 ở -1.7 st lại còn thấp hơn cả âm thường (1.6), tức là thứ bậc cao độ đang đi ngược hướng so với người bản ngữ (ở người bản ngữ, âm căng cao hơn âm thường). Hãy mím môi chặt thêm một nhịp để dồn áp lực, rồi bật ra ngắn và dứt khoát kiểu 'bốp', và bắt đầu nguyên âm ㅏ theo sau với cao độ cao hơn âm thường một chút. Cảm giác cổ họng phía trong hơi siết lại căng lên là điểm cốt lõi.",
      "paransaek": "파란색(ㅍ)의 VOT 35ms는 원어민(60ms)에 비하면 짧은 편이지만, 파형 첫 칸이 분명히 비어 있고 기식 구간이 보일 만큼 격음의 특성을 충분히 살려내셨습니다 — 베트남 학습자에게 가장 어려운 음을 가장 잘 해내신 부분입니다. 다만 F0가 -0.1 st로 원어민의 3.4 st보다 낮아, 파란 F0 곡선이 격음치고는 들떠 오르지 못한 인상입니다. 입을 좀 더 크게 열어 폐 깊은 곳에서 바람을 길게 밀어내듯 발음하고, 손바닥에 닿는 바람이 ㅃ보다 확실히 길고 넓게 퍼지는지 확인해 보세요. 이어지는 ㅏ를 평소보다 살짝 높은 톤에서 시작하면 격음다움이 더 또렷해집니다.",
      "paransaek_vn": "VOT 35ms của 파란색 (ㅍ) ngắn hơn so với 60ms của người bản ngữ, nhưng ô đầu của dạng sóng có khoảng trống rõ ràng và đoạn hơi bật đủ nhìn thấy được, tức là bạn đã giữ được khá đầy đủ đặc tính âm bật hơi — đây chính là âm khó nhất với người học Việt Nam mà bạn lại làm tốt nhất. Tuy nhiên F0 ở -0.1 st, thấp hơn 3.4 st của người bản ngữ, nên đường F0 màu xanh trông như chưa bay lên đủ độ cao của một âm bật hơi. Hãy mở miệng rộng hơn một chút và phát âm như đẩy một luồng gió dài từ sâu trong phổi ra, kiểm tra xem luồng gió chạm vào lòng bàn tay có dài hơn và lan rộng hơn rõ rệt so với ㅃ hay không. Nếu bắt đầu nguyên âm ㅏ theo sau ở cao độ nhỉnh hơn bình thường một chút, đặc tính âm bật hơi sẽ càng rõ nét."
    },
    "encouragement": "가장 어려운 격음을 이미 잡고 계세요 — 이제 ㅃ의 후두 긴장 하나만 더하면 세 음의 위계가 완성됩니다!",
    "encouragement_vn": "Bạn đã làm chủ được âm bật hơi vốn khó nhất rồi — giờ chỉ cần thêm động tác căng thanh quản cho ㅃ nữa là thứ bậc ba âm sẽ hoàn chỉnh!",
    "_source": "claude"
  },
