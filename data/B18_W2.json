  "ai_feedback": {
    "error_analysis": {
      "summary": "경음(ㄸ)은 안정적으로 자리잡았으나, 평음(ㄷ)과 격음(ㅌ)이 VOT·음높이 모두에서 뒤집혀 있어 세 자음의 위계가 흐트러진 상태입니다.",
      "summary_vn": "Âm căng 경음(ㄸ) đã được phát âm ổn định, nhưng âm thường 평음(ㄷ) và âm bật hơi 격음(ㅌ) đang bị đảo ngược cả về VOT lẫn cao độ, khiến trật tự ba phụ âm bị xáo trộn.",
      "detail": "다리는 VOT 39ms 로 원어민 44ms 와 거의 같지만, 모음 ㅏ의 F0 가 자기 baseline 보다 +1.6 st 로 떠올라 평음 특유의 낮은 시작이 사라졌습니다. 따뜻하다는 VOT 0ms·F0 +2.1 st 로 원어민(0ms·+2.3 st)과 사실상 일치해 가장 안정적입니다. 반대로 타다는 VOT 가 30ms 에 그쳐 원어민 84ms 의 절반에도 못 미치고, F0 도 -4.4 st 로 푹 가라앉아 격음의 두 핵심 단서(긴 기식 + 높은 시작)가 모두 결여돼 있습니다. 결과적으로 학습자 좌표 상에서는 ㅌ가 ㄷ보다 더 '평음스럽게' 들리는 역전 현상이 발생합니다.",
      "detail_vn": "다리(dari) có VOT 39ms gần bằng người bản ngữ (44ms), nhưng F0 của nguyên âm ㅏ lại cao hơn baseline +1.6 st, làm mất đi cao độ thấp đặc trưng của âm thường. 따뜻하다(ddatteutada) đạt VOT 0ms và F0 +2.1 st, gần như trùng khớp với người bản ngữ (0ms·+2.3 st) — đây là điểm ổn định nhất. Ngược lại, 타다(tada) chỉ có VOT 30ms, chưa bằng một nửa của bản ngữ (84ms), và F0 lại tụt xuống -4.4 st, khiến cả hai dấu hiệu cốt lõi của âm bật hơi (hơi dài + cao độ cao) đều thiếu. Kết quả là trên trục tọa độ phát âm, ㅌ lại nghe 'thường' hơn cả ㄷ — hiện tượng đảo ngược thứ tự.",
      "detail_vn_note": ""
    },
    "cause": "베트남어에는 한국어식 평음/경음/격음 3중 구분이 없고, 특히 강한 기식을 동반하면서 동시에 모음을 높게 띄우는 격음 ㅌ 같은 자음 유형이 없습니다. 그래서 학습자는 ㅌ를 '조금 센 ㄷ' 정도로 처리하면서 기식을 짧게 끊고 모음도 낮게 시작하게 됩니다. 반대로 ㄷ는 모국어 영향으로 자음을 또렷이 내려다 보니 모음 시작 톤이 의도치 않게 올라가, 두 자음이 음향적으로 가까워졌습니다.",
    "cause_vn": "Trong tiếng Việt không có sự phân biệt ba bậc (thường/căng/bật hơi) như tiếng Hàn, đặc biệt là không có loại phụ âm nào vừa bật hơi mạnh vừa nâng cao độ nguyên âm như 격음 ㅌ. Vì vậy người học xử lý ㅌ như một 'ㄷ hơi mạnh', cắt ngắn luồng hơi và bắt đầu nguyên âm ở cao độ thấp. Ngược lại, khi phát âm ㄷ, ảnh hưởng tiếng mẹ đẻ khiến phụ âm rõ ràng hơn và vô tình đẩy cao độ nguyên âm lên — hai phụ âm vì thế tiến lại gần nhau về mặt âm học.",
    "correction": {
      "main_focus": "격음 ㅌ에 '긴 바람 + 높은 모음 시작'을 동시에 얹어 평음 ㄷ와 음향적으로 갈라놓기.",
      "main_focus_vn": "Đồng thời thêm 'luồng hơi dài + cao độ nguyên âm cao' cho âm bật hơi ㅌ để tách nó khỏi âm thường ㄷ về mặt âm học.",
      "steps": [
        "손바닥을 입에서 10cm 떨어진 곳에 대고 평음·경음·격음을 차례로 발음하며 손바닥에 닿는 바람 양의 차이를 몸으로 기억하기 — 격음에서만 바람이 길게 느껴져야 합니다.",
        "최소대립쌍 다–따–타를 천천히 3회씩 묶어 반복하되, 모음 ㅏ를 시작할 때의 음높이를 의식적으로 평음은 낮게·경음과 격음은 살짝 높게 출발시키기.",
        "본인 녹음과 원어민 음원을 한 문장씩 번갈아 듣고, 자음 직후 모음의 '톤이 위에서 시작하는지 아래에서 시작하는지' 청각적으로 비교 점검하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 10cm và phát âm lần lượt âm thường·căng·bật hơi, ghi nhớ bằng cơ thể sự khác biệt về lượng hơi chạm vào tay — chỉ ở âm bật hơi mới cảm thấy luồng hơi dài.",
        "Lặp lại cặp tối thiểu 다–따–타 chậm rãi, mỗi nhóm 3 lần, có ý thức bắt đầu nguyên âm ㅏ ở cao độ thấp với âm thường và hơi cao hơn với âm căng·bật hơi.",
        "Nghe luân phiên bản thu của mình và của người bản ngữ theo từng câu, kiểm tra bằng tai xem ngay sau phụ âm, cao độ nguyên âm bắt đầu 'từ trên xuống' hay 'từ dưới lên'."
      ]
    },
    "overall": "세 단어 중 따뜻하다(ㄸ)는 측정상 원어민과 거의 완벽히 겹쳐 이미 충분히 자리잡았다는 명확한 신호입니다. 다만 평음 ㄷ와 격음 ㅌ는 음높이와 기식이 서로 자리를 바꿔 들리는 상태라, 지금은 '두 자음을 서로 다른 방향으로 멀리 떼어놓는' 단계가 필요합니다. 특히 ㅌ는 VOT 와 F0 가 동시에 부족하므로, 두 단서를 분리해 연습하지 말고 한 번의 발화 안에서 같이 만드는 것이 핵심입니다. 경음을 안정적으로 발음하는 강점을 디딤돌 삼아 위계 전체를 다시 세우면 빠르게 개선될 것입니다.",
    "overall_vn": "Trong ba từ, 따뜻하다(ㄸ) gần như trùng khớp với người bản ngữ theo số đo — một dấu hiệu rõ ràng cho thấy âm này đã được làm chủ. Tuy nhiên, âm thường ㄷ và âm bật hơi ㅌ đang bị hoán đổi vị trí về cao độ và luồng hơi, nên giai đoạn hiện tại cần 'kéo hai phụ âm này ra xa nhau theo hai hướng khác nhau'. Đặc biệt với ㅌ, vì cả VOT và F0 đều thiếu, không nên luyện tách rời hai dấu hiệu mà phải tạo ra cả hai cùng lúc trong một lần phát âm. Lấy thế mạnh phát âm âm căng ổn định làm bàn đạp, toàn bộ trật tự ba bậc sẽ được dựng lại nhanh chóng.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "dari": "다리는 자음 자체는 nặng 쪽(VOT 39ms)으로 깔끔히 정리되어 원어민 위치와 거의 겹치지만, 모음 ㅏ가 baseline 보다 +1.6 st 위쪽 sắc 영역으로 떠올라 평음 클러스터의 '아래쪽' 자리에서 빠져나가 있습니다. 나침반으로 보면 가로축은 맞는데 세로축이 한 칸 위로 어긋난 상태입니다. 입을 살짝 더 이완하고, ㄷ 직후의 ㅏ를 평소 말소리보다 한 톤 낮춰 huyền 방향으로 가라앉히세요. 자음을 약하게 만들 필요는 없고, '모음 시작점만 아래로' 내린다는 감각이면 충분합니다.",
      "dari_vn": "다리(dari) có phụ âm đã nằm gọn về phía nặng (VOT 39ms), gần trùng với vị trí người bản ngữ, nhưng nguyên âm ㅏ lại trôi lên vùng sắc cao hơn baseline +1.6 st, thoát khỏi vị trí 'phía dưới' của cụm âm thường. Trên la bàn, trục ngang đã đúng nhưng trục dọc bị lệch lên một nấc. Hãy thả lỏng miệng hơn một chút và hạ ㅏ ngay sau ㄷ xuống một tông so với giọng nói thường ngày, hướng về phía huyền. Không cần làm phụ âm yếu đi — chỉ cần cảm giác 'kéo điểm bắt đầu nguyên âm đi xuống' là đủ.",
      "ddatteut": "따뜻하다는 좌표상 nặng 가장 깊은 구석(VOT 0ms)에 정확히 안착했고, 모음 ㅏ도 +2.1 st 로 원어민 +2.3 st 와 거의 같은 sắc 위치에 자리잡았습니다. 나침반 위에서 학습자 점과 원어민 점이 사실상 포개진, 가장 모범적인 단어입니다. 이 감각 — 후두를 단단히 잠그면서 모음을 살짝 위로 띄우는 — 을 다른 자음 연습 때 기준점으로 삼으세요. 특히 격음 ㅌ를 연습할 때 '바람만 더 길게, 위쪽 톤은 따뜻하다처럼' 가져가면 좋습니다.",
      "ddatteut_vn": "따뜻하다(ddatteutada) trên la bàn đã đáp chính xác vào góc nặng sâu nhất (VOT 0ms), và nguyên âm ㅏ cũng nằm ở vị trí sắc +2.1 st, gần như trùng với người bản ngữ (+2.3 st). Đây là từ mẫu mực nhất — điểm của người học và bản ngữ gần như chồng lên nhau trên la bàn. Hãy lấy cảm giác này — siết chặt thanh quản trong khi đẩy nguyên âm lên cao một chút — làm điểm chuẩn cho các phụ âm khác. Đặc biệt khi luyện ㅌ, hãy giữ 'cao độ phía trên giống 따뜻하다' và chỉ kéo dài luồng hơi thêm.",
      "tada": "타다는 가장 큰 교정 지점입니다. VOT 가 30ms 에 머물러 bật hơi(오른쪽) 영역까지 가지 못한 채 중앙 부근에 멈췄고, 모음 ㅏ는 -4.4 st 로 huyền 아래쪽으로 푹 가라앉아 격음이 가져야 할 '오른쪽 + 위쪽' 좌표에서 두 칸이나 어긋나 있습니다. 결과적으로 나침반에서 타다 점이 다리 점보다도 더 왼쪽-아래에 찍히는 역전이 일어났습니다. 손바닥에 바람이 길게 닿을 때까지 ㅌ를 '하–'에 가깝게 길게 내뱉으면서, 동시에 ㅏ를 따뜻하다의 모음과 같은 높이에서 시작한다고 생각해 보세요. 바람과 음높이를 따로따로가 아니라 한 호흡 안에서 같이 만드는 것이 핵심입니다.",
      "tada_vn": "타다(tada) là điểm cần sửa lớn nhất. VOT chỉ đạt 30ms, chưa với tới vùng bật hơi (bên phải) mà dừng lại gần trung tâm, còn nguyên âm ㅏ lại tụt xuống -4.4 st về phía huyền dưới — lệch hai nấc so với tọa độ 'phải + trên' mà âm bật hơi cần có. Hậu quả là trên la bàn, điểm 타다 lại nằm phía trái-dưới so với cả 다리, tạo thành sự đảo ngược. Hãy phát âm ㅌ kéo dài gần như 'h–' cho đến khi cảm thấy luồng hơi dài chạm vào lòng bàn tay, đồng thời bắt đầu ㅏ ở cùng cao độ với nguyên âm trong 따뜻하다. Mấu chốt là tạo ra luồng hơi và cao độ cùng nhau trong một hơi thở, không tách rời.",
      "tada_vn_note": ""
    },
    "encouragement": "ㄸ를 원어민 수준으로 안정시킨 것만으로도 큰 진전입니다 — 이 감각을 다리·타다로 옮겨가면 위계가 빠르게 자리잡을 거예요!",
    "encouragement_vn": "Việc phát âm ㄸ ở mức người bản ngữ đã là một bước tiến lớn — chỉ cần chuyển cảm giác này sang 다리 và 타다, trật tự ba bậc sẽ sớm được thiết lập!",
    "_source": "claude"
