  "ai_feedback": {
    "error_analysis": {
      "summary": "경음(빠)은 잘 구분하지만, 평음(바)과 격음(파) 모두 VOT가 길어져 두 음이 비슷하게 들리는 경향이 있습니다.",
      "summary_vn": "Phát âm 경음(빠) khá tốt, nhưng cả 평음(바) và 격음(파) đều có VOT dài, khiến hai âm này nghe gần giống nhau.",
      "detail": "바지에서 VOT가 129ms로 원어민 97ms보다 약 32ms 길게 나타났고, 파란색에서도 VOT가 103ms로 원어민 60ms보다 43ms 더 길었습니다. 즉 평음과 격음 모두 기식이 과하게 들어가, 두 자음의 VOT 차이가 거의 사라진 상태입니다(학습자 차이 약 26ms vs 원어민 약 37ms). 반면 빠르다는 VOT 7ms로 원어민 0ms와 거의 같고, F0도 baseline 대비 +2.0 st로 충분히 높게 시작되어 경음의 후두 긴장이 잘 구현되었습니다. 바지의 F0도 -2.3 st로 원어민 -3.7 st와 같은 '아래 방향' 패턴을 유지해 평음의 낮은 시작은 살아있는 편입니다.",
      "detail_vn": "Ở từ 바지, VOT là 129ms, dài hơn người bản ngữ (97ms) khoảng 32ms; ở 파란색, VOT là 103ms, dài hơn người bản ngữ (60ms) tới 43ms. Nghĩa là cả 평음 và 격음 đều có hơi bật quá mạnh, khiến khoảng cách VOT giữa hai phụ âm gần như biến mất (chênh lệch của bạn ~26ms so với ~37ms của người bản ngữ). Ngược lại, 빠르다 có VOT 7ms, gần như trùng với 0ms của người bản ngữ, và F0 cao hơn baseline +2.0 st — căng thanh hầu của 경음 đã được thực hiện rất tốt. F0 của 바지 là -2.3 st, vẫn giữ hướng 'đi xuống' giống người bản ngữ (-3.7 st), nên độ thấp đặc trưng của 평음 vẫn còn."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 학습자가 '평음 ㅂ'을 발음할 때도 모국어의 무성 파열음처럼 다소 강한 기식을 함께 내보내는 경향이 있습니다. 그 결과 ㅂ의 VOT가 격음 영역까지 늘어나고, 정작 ㅍ의 VOT는 평음과 구별될 만큼 더 길어지지 못해 두 음이 겹치게 됩니다. 빠르다가 잘 되는 이유는 경음의 '숨을 참고 짧게 터뜨리는' 동작이 베트남어 비기식 파열음과 비교적 닮아있기 때문입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống 3 phụ âm bật hơi như tiếng Hàn (평음·경음·격음), nên khi phát âm 평음 ㅂ, bạn vô thức thêm một chút hơi bật như phụ âm vô thanh trong tiếng Việt. Vì thế VOT của ㅂ kéo dài đến vùng của 격음, còn ㅍ lại không đủ dài để tách khỏi 평음 — hai âm bị chồng lên nhau. 빠르다 phát âm tốt vì động tác 'giữ hơi rồi bật ngắn' của 경음 khá gần với phụ âm không bật hơi trong tiếng Việt.",
    "correction": {
      "main_focus": "ㅂ의 기식을 줄여 짧고 부드럽게, ㅍ은 손바닥에 바람이 강하게 닿을 만큼 길게 — 두 자음 사이에 분명한 VOT·음높이 격차를 만드는 것이 최우선입니다.",
      "main_focus_vn": "Giảm hơi bật của ㅂ để phát âm ngắn và nhẹ, còn ㅍ thì bật hơi đủ mạnh để cảm nhận rõ trên lòng bàn tay — tạo khoảng cách VOT và độ cao rõ ràng giữa hai phụ âm là ưu tiên hàng đầu.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 최소대립쌍 '바-빠-파'를 천천히 반복하면서, 손바닥에 닿는 바람의 양이 '약함-거의 없음-강함' 순서로 분명히 달라지는지 직접 느껴 보세요.",
        "거울 앞에서 입 모양과 어깨·목의 긴장을 동시에 점검하세요. 평음은 어깨가 편안하고 입술이 짧게 떨어지는 느낌, 격음은 입에서 한숨이 길게 빠져나가는 느낌이어야 합니다.",
        "원어민 음원과 본인 녹음을 한 문장씩 번갈아 들으며, 자음의 길이와 모음 시작 음높이 두 가지를 동시에 비교하고 차이가 가장 큰 단어를 다시 녹음하세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm và lặp lại cặp tối thiểu '바-빠-파' thật chậm, cảm nhận trực tiếp lượng hơi chạm vào tay phải thay đổi rõ theo thứ tự 'yếu - gần như không có - mạnh'.",
        "Trước gương, cùng lúc kiểm tra khẩu hình và độ căng của vai/cổ. 평음 phải có cảm giác vai thả lỏng và môi mở ra ngắn gọn; 격음 phải có cảm giác một hơi thở dài thoát ra khỏi miệng.",
        "Nghe xen kẽ bản ghi của người bản ngữ và bản ghi của bạn từng câu một, so sánh đồng thời độ dài phụ âm và độ cao khởi đầu của nguyên âm, rồi ghi âm lại từ có chênh lệch lớn nhất."
      ]
    },
    "overall": "경음 ㅃ은 VOT와 F0 패턴 모두 원어민과 거의 일치할 만큼 안정적으로 자리잡았습니다 — 이는 분명한 강점입니다. 다만 평음 ㅂ의 VOT가 129ms까지 길어지고 격음 ㅍ도 103ms로 너무 길어, 두 음의 경계가 흐려져 있습니다. 평음의 기식을 줄여 짧게, 격음은 지금의 긴 VOT를 유지하되 모음 음높이를 살짝 더 높여 위계를 회복하면 3중 구분이 완성됩니다. 전반적으로 위계의 한 축(경음)이 이미 완성되어 있어, 나머지 두 축의 조정은 충분히 빠르게 진척될 수 있는 단계입니다.",
    "overall_vn": "경음 ㅃ đã rất ổn định, cả VOT và mẫu F0 gần như trùng với người bản ngữ — đây là điểm mạnh rõ ràng. Tuy nhiên VOT của 평음 ㅂ kéo dài tới 129ms và 격음 ㅍ cũng dài tới 103ms, khiến ranh giới giữa hai âm này bị mờ. Nếu bạn giảm hơi bật của 평음 để phát âm ngắn hơn, đồng thời giữ VOT dài của 격음 nhưng nâng độ cao nguyên âm lên một chút, hệ thống 3 bậc sẽ hoàn chỉnh. Nhìn chung, một trục của hệ thống (경음) đã hoàn thành, nên việc điều chỉnh hai trục còn lại có thể tiến triển khá nhanh.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지는 나침반에서 nặng(왼쪽·짧은 VOT) 영역에 있어야 하는데, VOT 129ms로 오른쪽 bật hơi 방향까지 밀려나 격음 ㅍ의 영역과 겹쳐 있습니다. 위아래 축에서는 본인 baseline 대비 -2.3 st로 ngang 아래쪽에 잘 머물러 있어 평음 특유의 낮은 시작은 살아있습니다. 다음 녹음에서는 입술을 부드럽게 떼고 숨을 거의 내보내지 않은 채 '바'를 짧게 발음해, 좌표를 왼쪽으로 끌어당겨 보세요. 손바닥을 입 앞에 댔을 때 바람이 거의 느껴지지 않아야 정상입니다.",
      "baji_vn": "바지 đáng lẽ phải nằm ở vùng nặng (bên trái, VOT ngắn) trên la bàn, nhưng với VOT 129ms, nó bị đẩy sang phải vùng bật hơi và chồng lên vùng của 격음 ㅍ. Theo trục dọc, F0 thấp hơn baseline -2.3 st nên vẫn nằm dưới đường ngang — độ thấp đặc trưng của 평음 vẫn còn. Lần ghi âm tới, hãy mở môi nhẹ nhàng, gần như không thở ra khi phát âm '바' thật ngắn, để kéo tọa độ về phía bên trái. Khi đặt lòng bàn tay trước miệng, gần như không nên cảm nhận được hơi.",
      "bbareuda": "빠르다는 나침반의 nặng(왼쪽 깊숙이) 영역에 정확히 안착했습니다 — VOT 7ms로 원어민 0ms와 거의 같고, 동시에 baseline 대비 +2.0 st로 sắc(위쪽) 방향까지 올라가 경음 특유의 '왼쪽 위 모서리' 좌표가 완벽히 형성되었습니다. 이 감각, 즉 숨을 꽉 잠그고 짧게 터뜨리면서 모음을 살짝 높게 시작하는 동작을 다른 자음의 기준점으로 삼으세요.",
      "bbareuda_vn": "빠르다 đã đáp xuống chính xác vùng nặng (sâu bên trái) của la bàn — VOT 7ms gần như trùng với 0ms của người bản ngữ, đồng thời F0 cao hơn baseline +2.0 st nên còn vươn lên hướng sắc (phía trên), tạo nên tọa độ 'góc trên bên trái' hoàn hảo cho 경음. Hãy giữ chính cảm giác này — khóa hơi rồi bật ngắn đồng thời nâng nhẹ độ cao nguyên âm — làm điểm tham chiếu cho các phụ âm khác.",
      "paransaek": "파란색은 나침반의 오른쪽 bật hơi 영역에 도달하긴 했지만(VOT 103ms로 원어민 60ms보다 더 오른쪽), 같은 축에서 바지의 좌표도 함께 오른쪽으로 끌려와 있어 두 단어가 거의 같은 가로 위치에 놓여 있습니다. 모음 F0는 이번에 측정이 부족해 위아래 위치를 확신할 수는 없지만, 베트남 학습자에게서 흔한 경향상 sắc(위쪽) 방향이 충분히 올라오지 못한 인상이 있습니다. 다음 연습에서는 VOT는 지금 길이를 유지하되, '파!' 직후의 ㅏ를 본인 평소 톤보다 한 음 정도 위에서 시작해 좌표를 오른쪽 위 모서리로 끌어올려 보세요. 그러면 평음 ㅂ과 가로·세로 두 축 모두에서 분리됩니다.",
      "paransaek_vn": "파란색 đã đi tới được vùng bật hơi bên phải của la bàn (VOT 103ms, thậm chí xa hơn mức 60ms của người bản ngữ), nhưng trên cùng trục, 바지 cũng bị kéo sang phải, nên hai từ gần như nằm cùng vị trí ngang. Lần này F0 của nguyên âm không đo được đầy đủ nên chưa thể khẳng định vị trí trên-dưới, nhưng theo xu hướng thường thấy ở người Việt học tiếng Hàn, có cảm giác hướng sắc (phía trên) chưa được nâng đủ. Lần luyện tới, hãy giữ nguyên độ dài VOT hiện tại, nhưng bắt đầu nguyên âm ㅏ ngay sau '파!' cao hơn giọng bình thường khoảng một bậc, để kéo tọa độ lên góc trên bên phải. Khi đó 파 sẽ tách khỏi 바 trên cả hai trục ngang và dọc."
    },
