  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 범주의 VOT 간격이 좁아져 위계가 평탄해진 상태입니다.",
      "summary_vn": "Khoảng cách VOT giữa ba loại 평음·경음·격음 đang bị thu hẹp, khiến hệ thống phân cấp trở nên phẳng.",
      "detail": "가방 ㄱ 의 VOT 는 68ms 로 원어민(63ms)과 거의 같아 평음 자체는 안정적입니다. 그런데 까만색 ㄲ 가 41ms (원어민 8ms), 카드 ㅋ 가 37ms (원어민 83ms)로 측정되어, 경음은 너무 길고 격음은 너무 짧아 세 음이 30~70ms 사이에 몰려 있습니다. F0 패턴(semitone)에서도 원어민은 평음 -3.7 / 경음 +1.3 / 격음 +1.9 로 평음<경음·격음 위계가 뚜렷하지만, 학습자는 평음 +0.7 / 경음 -1.2 / 격음 +0.4 로 오히려 평음이 가장 높고 경음이 가장 낮아 위계가 뒤집혀 있습니다.",
      "detail_vn": "VOT của 가방 ㄱ là 68ms, gần như trùng với người bản ngữ (63ms), nên 평음 khá ổn định. Tuy nhiên 까만색 ㄲ là 41ms (bản ngữ 8ms) và 카드 ㅋ là 37ms (bản ngữ 83ms), tức là 경음 quá dài còn 격음 lại quá ngắn, khiến cả ba âm dồn vào khoảng 30~70ms. Về mẫu F0 (semitone), người bản ngữ có 평음 -3.7 / 경음 +1.3 / 격음 +1.9, thể hiện rõ thứ bậc 평음<경음·격음, trong khi học viên lại là +0.7 / -1.2 / +0.4 — 평음 cao nhất, 경음 thấp nhất, tức là thứ bậc đang bị đảo ngược."
    },
    "cause": "베트남어에는 한국어처럼 VOT 와 후두 긴장으로 세 범주를 나누는 체계가 없어, 학습자가 ㄱ·ㄲ·ㅋ 를 모두 비슷한 무기식 폐쇄음으로 처리하는 경향이 있습니다. 그 결과 ㄲ 에 필요한 후두 긴장(짧고 단단한 터짐)이 부족해 VOT 가 길어지고, ㅋ 에 필요한 강한 기식(긴 호기)이 약해 VOT 가 짧아지면서 세 음이 평음 쪽으로 수렴합니다. F0 위계가 뒤집힌 것도 같은 원인 — 경음·격음에서 모음을 위로 띄우는 후두 조정이 함께 일어나지 않기 때문입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba loại bằng VOT và độ căng thanh quản như tiếng Hàn, nên học viên có xu hướng xử lý ㄱ·ㄲ·ㅋ như những âm tắc không bật hơi tương tự nhau. Vì vậy ㄲ thiếu độ căng thanh quản (bật ngắn và chắc) cần thiết nên VOT bị kéo dài, còn ㅋ thiếu luồng hơi mạnh nên VOT bị rút ngắn — cả ba âm cùng dồn về phía 평음. Việc thứ bậc F0 bị đảo ngược cũng do cùng nguyên nhân: điều chỉnh thanh quản để đẩy nguyên âm lên cao trong 경음·격음 chưa xảy ra đồng thời.",
    "correction": {
      "main_focus": "VOT 간격 벌리기 — 경음은 더 짧고 단단하게, 격음은 더 길고 거센 바람으로.",
      "main_focus_vn": "Mở rộng khoảng cách VOT — 경음 phải ngắn và chắc hơn, còn 격음 phải dài và bật hơi mạnh hơn.",
      "steps": [
        "손바닥을 입 앞 5cm 에 대고 가-까-카 를 천천히 발음하며 바람 양 차이를 체감하기 (까: 거의 무바람, 카: 강한 바람).",
        "최소대립쌍 '가-까-카' 를 원어민 음원과 본인 녹음을 번갈아 들으며 PRAAT 파형 첫 칸 너비가 어떻게 달라지는지 눈으로 확인하기.",
        "경음 연습 전 '으흠' 으로 목을 살짝 조였다가 모음을 시작해 후두 긴장을 몸에 익히고, 격음은 한숨 쉬듯 길게 'ㅎ-' 를 먼저 내보낸 뒤 모음으로 잇기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm và phát âm chậm 가-까-카 để cảm nhận sự khác biệt lượng hơi (까: hầu như không có hơi, 카: hơi bật mạnh).",
        "Nghe xen kẽ cặp tối thiểu '가-까-카' của người bản ngữ và bản ghi của mình, đồng thời quan sát bằng mắt cách độ rộng ô đầu tiên trên dạng sóng PRAAT thay đổi.",
        "Trước khi luyện 경음 hãy thử siết nhẹ cổ họng bằng âm '으흠' rồi mới vào nguyên âm để cơ thể quen với độ căng thanh quản; còn 격음 thì bật ra 'ㅎ-' dài như thở hắt trước, sau đó mới nối vào nguyên âm."
      ]
    },
    "overall": "평음 ㄱ 는 VOT·F0 모두 원어민과 매우 가까워 든든한 출발점입니다. 다만 경음과 격음이 평음 쪽으로 끌려와 세 범주가 좁은 띠 안에 몰려 있고, F0 위계도 뒤집혀 있어 한국인이 듣기에는 셋이 비슷하게 들릴 수 있습니다. 핵심 과제는 ㄲ 의 후두 긴장과 ㅋ 의 기식 강화 — 이 둘만 벌어지면 평음을 그대로 둔 채 위계가 자연스럽게 살아납니다. PRAAT 에서 파형 첫 칸 너비와 파란 F0 곡선의 시작 높이를 같이 확인하며 연습하면 변화가 눈에 보일 것입니다.",
    "overall_vn": "평음 ㄱ rất gần với người bản ngữ cả về VOT lẫn F0, đây là điểm khởi đầu vững chắc. Tuy nhiên 경음 và 격음 đang bị kéo về phía 평음, ba loại dồn trong một dải hẹp và thứ bậc F0 cũng bị đảo, nên người Hàn nghe có thể thấy ba âm khá giống nhau. Nhiệm vụ then chốt là tăng độ căng thanh quản của ㄲ và tăng luồng hơi của ㅋ — chỉ cần hai điểm này tách ra là thứ bậc sẽ tự nhiên sống lại mà không cần đụng đến 평음. Khi luyện, hãy quan sát đồng thời độ rộng ô đầu trên dạng sóng PRAAT và độ cao khởi đầu của đường F0 màu xanh, bạn sẽ thấy thay đổi bằng mắt.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방 ㄱ 의 VOT 68ms 는 원어민 63ms 와 5ms 차이밖에 나지 않아, PRAAT 파형에서 첫 무성 구간(첫 칸 너비)이 원어민과 거의 같은 폭으로 나타납니다. F0 도 학습자 baseline 기준 +0.7 semitone 으로 평음다운 '중간 톤' 영역에 있어 안정적입니다. 다만 평음의 자연스러운 '낮게 시작' 느낌을 더 살리려면, 모음 ㅏ 를 시작할 때 어깨와 턱의 힘을 한 번 빼고 한숨처럼 부드럽게 톤을 떨어뜨려 주세요. 이 단어는 학습자의 강점이니, 다른 두 단어를 교정할 때 비교 기준(anchor)으로 삼는 것이 좋습니다.",
      "gabang_vn": "VOT của 가방 ㄱ là 68ms, chỉ chênh 5ms so với người bản ngữ 63ms, nên trên dạng sóng PRAAT đoạn vô thanh đầu (độ rộng ô đầu tiên) có chiều rộng gần như bằng nhau. F0 cũng ở mức +0.7 semitone so với baseline của học viên, nằm trong vùng 'tông trung bình' đúng kiểu 평음, rất ổn định. Để làm nổi bật hơn cảm giác 'bắt đầu thấp' tự nhiên của 평음, khi vào nguyên âm ㅏ hãy thả lỏng vai và hàm một nhịp, hạ tông xuống nhẹ nhàng như tiếng thở. Từ này là điểm mạnh của bạn, hãy dùng nó làm chuẩn so sánh (anchor) khi luyện hai từ còn lại.",
      "ggamansaek": "까만색 ㄲ 의 VOT 가 41ms 로 원어민 8ms 의 다섯 배 가까이 측정되어, PRAAT 파형에서 첫 칸 너비가 ㄱ 와 거의 같은 폭으로 나타납니다 — 즉 경음의 '짧고 단단한 터짐' 이 살아나지 않은 상태입니다. F0 도 -1.2 semitone 으로 평음(+0.7)보다 오히려 낮아, 경음 특유의 '모음을 위로 띄우는' 위계가 반대로 작용하고 있습니다. 입술(또는 혀뿌리)을 평소보다 한 박자 더 꽉 다물고, 목 안쪽을 살짝 조인 상태에서 짧게 '딱!' 하고 터뜨려 주세요. 손바닥을 입 앞에 대도 거의 바람이 느껴지지 않아야 하고, 모음 ㅏ 는 ㄱ 때보다 살짝 더 높은 톤에서 시작하는 것이 핵심입니다.",
      "ggamansaek_vn": "VOT của 까만색 ㄲ đo được 41ms, gần gấp năm lần con số 8ms của người bản ngữ, nên trên dạng sóng PRAAT độ rộng ô đầu tiên gần bằng với ㄱ — tức là cảm giác 'bật ngắn và chắc' đặc trưng của 경음 chưa xuất hiện. F0 cũng chỉ -1.2 semitone, thậm chí thấp hơn 평음 (+0.7), nghĩa là thứ bậc 'nâng nguyên âm lên cao' của 경음 đang bị đảo ngược. Hãy mím môi (hoặc ép gốc lưỡi) chặt hơn 평음 một nhịp, siết nhẹ phía trong cổ họng rồi bật ra ngắn gọn như tiếng 'tách!'. Đặt lòng bàn tay trước miệng phải gần như không cảm thấy hơi, và nguyên âm ㅏ phải bắt đầu ở tông cao hơn so với khi phát âm ㄱ — đó là điểm mấu chốt.",
      "kadeu": "카드 ㅋ 의 VOT 가 37ms 로 원어민 83ms 의 절반에도 못 미쳐, PRAAT 파형에서 폐쇄 후 기식 구간(첫 칸 너비)이 격음이라기보다 평음에 가까운 폭으로 찍힙니다. F0 도 +0.4 semitone 으로 원어민(+1.9)에 비해 모음이 충분히 띄워지지 않았습니다. 손바닥을 입 앞 5cm 에 대고 발음했을 때 촛불이 꺼질 정도로 강한 바람이 나가야 하며, 'ㅎ-아' 처럼 기식을 길게 먼저 내보낸 뒤 모음으로 자연스럽게 연결한다고 상상해 보세요. 모음 ㅏ 는 한 톤 더 높은 자리에서 시작하면 VOT 와 F0 가 동시에 격음 쪽으로 따라옵니다.",
      "kadeu_vn": "VOT của 카드 ㅋ là 37ms, chưa đến một nửa so với 83ms của người bản ngữ, nên trên dạng sóng PRAAT đoạn bật hơi sau khi đóng (độ rộng ô đầu) hiện ra gần với 평음 hơn là 격음. F0 cũng chỉ +0.4 semitone, so với +1.9 của bản ngữ thì nguyên âm chưa được đẩy lên đủ cao. Hãy đặt lòng bàn tay cách miệng 5cm, khi phát âm hơi phải đủ mạnh để có thể thổi tắt ngọn nến, và hãy tưởng tượng bật ra 'ㅎ-아' với luồng hơi dài rồi mới nối tự nhiên vào nguyên âm. Nếu nguyên âm ㅏ bắt đầu ở tông cao hơn một bậc, cả VOT lẫn F0 sẽ cùng dịch về phía 격음."
    },
    "encouragement": "평음 ㄱ 가 이미 원어민 수준으로 안정적이니, 그 감각을 기준 삼아 ㄲ·ㅋ 만 양쪽으로 벌려주면 위계가 빠르게 살아날 거예요!",
    "encouragement_vn": "평음 ㄱ của bạn đã ổn định ngang mức người bản ngữ, nên chỉ cần lấy cảm giác đó làm chuẩn rồi tách ㄲ·ㅋ ra hai phía là thứ bậc sẽ sống lại rất nhanh!",
