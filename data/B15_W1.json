  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 강한 기식으로 잘 구분되지만, 평음 ㅂ과 경음 ㅃ이 모두 무기식 영역으로 몰려 두 음의 분리가 약합니다.",
      "summary_vn": "Âm bật hơi mạnh ㅍ (파란색) được phân biệt tốt, nhưng âm bình thường ㅂ (바지) và âm căng ㅃ (빠르다) đều rơi vào vùng không bật hơi, khiến hai âm này khó tách biệt.",
      "detail": "바지의 VOT가 13ms로 평음 기준(~20ms)보다 짧고, 빠르다의 VOT는 7ms로 둘이 거의 같은 영역에 머물러 있어 평음과 경음의 시간적 구분이 흐려집니다. 반면 파란색은 VOT 107ms로 원어민 60ms보다 오히려 더 강한 기식을 내보이며, 격음 자체는 안정적으로 구현됩니다. F0 패턴(semitone) 위계를 보면 원어민은 평음(-3.7) < 경음(-0.4) < 격음(+3.4)로 뚜렷한 계단을 만드는데, 학습자는 평음(-1.8), 경음(+0.8), 격음(+0.8)로 위로 갈수록 차이가 좁혀져 경음과 격음의 음높이 분리가 거의 사라졌습니다. 즉, ㅂ–ㅃ는 VOT·F0 양쪽 모두에서 가깝고, ㅃ–ㅍ는 F0에서 평탄해진 구조입니다.",
      "detail_vn": "VOT của 바지 là 13ms, ngắn hơn chuẩn âm bình thường (~20ms), còn 빠르다 chỉ 7ms — hai âm gần như nằm cùng một vùng, khiến sự phân biệt thời gian giữa âm bình thường và âm căng bị mờ đi. Ngược lại, 파란색 có VOT 107ms, thậm chí mạnh hơn mức người bản ngữ (60ms), cho thấy âm bật hơi được thực hiện ổn định. Về cao độ (semitone), người bản ngữ tạo bậc thang rõ ràng: bình thường (-3.7) < căng (-0.4) < bật hơi (+3.4), trong khi người học có bình thường (-1.8), căng (+0.8), bật hơi (+0.8) — tức là âm căng và âm bật hơi gần như bằng nhau về cao độ. Tóm lại, ㅂ–ㅃ gần nhau cả về VOT lẫn F0, còn ㅃ–ㅍ bị san phẳng ở phần cao độ."
    },
    "cause": "베트남어에는 한국어처럼 평음·경음·격음 3중 구분이 없어, 학습자에게 ㅂ과 ㅃ이 모두 베트남어 /b/ 영역으로 흡수되는 경향이 강합니다. 특히 경음의 핵심인 '후두 긴장 + 약간 높은 모음 시작'이라는 동작이 베트남어 음운 체계에 존재하지 않아, ㅃ이 ㅂ과 같은 무기식 음으로 평탄화되는 것입니다. 격음 ㅍ은 베트남어의 기식 자질과 어느 정도 대응이 가능하기에 비교적 잘 구현되고 있습니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc bình thường–căng–bật hơi như tiếng Hàn, nên với người học, cả ㅂ và ㅃ đều bị hấp thụ vào vùng /b/ của tiếng Việt. Đặc biệt, động tác cốt lõi của âm căng — 'siết chặt thanh quản + bắt đầu nguyên âm hơi cao hơn một chút' — không tồn tại trong hệ âm vị tiếng Việt, nên ㅃ bị san phẳng thành âm không bật hơi giống ㅂ. Trong khi đó, ㅍ có thể đối ứng phần nào với đặc trưng bật hơi của tiếng Việt, nên được thực hiện khá tốt.",
    "correction": {
      "main_focus": "평음 ㅂ과 경음 ㅃ을 분리하기 — 특히 ㅃ에서 입술을 한 박자 더 꽉 다물었다가 짧고 단단하게 터뜨리는 후두 긴장 감각을 만들어내는 것이 핵심입니다.",
      "main_focus_vn": "Tách biệt âm bình thường ㅂ và âm căng ㅃ — đặc biệt ở ㅃ, phải mím môi chặt thêm một nhịp rồi bung ra ngắn và dứt khoát, tạo cảm giác siết thanh quản; đây là điểm cốt lõi cần luyện.",
      "steps": [
        "거울 앞에서 최소대립쌍 '바–빠–파'를 천천히 반복하며 입술 닫힘 정도와 모음 시작 톤의 차이를 시각·청각으로 동시에 확인합니다.",
        "손바닥을 입 앞 5cm에 두고 세 음을 차례로 발음해, ㅂ은 약한 바람, ㅃ은 바람 거의 없음, ㅍ은 강한 바람이 느껴지는지 손으로 직접 체감합니다.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 경음에서 모음이 살짝 더 높게 시작되는지(반 음~한 음 차이)에 귀를 집중해 비교합니다."
      ],
      "steps_vn": [
        "Đứng trước gương, lặp lại chậm cặp tối thiểu '바–빠–파', đồng thời quan sát độ khép môi và lắng nghe cao độ bắt đầu của nguyên âm để cảm nhận sự khác biệt bằng cả mắt và tai.",
        "Đặt lòng bàn tay cách miệng khoảng 5cm, phát âm lần lượt ba âm: kiểm tra xem ㅂ có luồng hơi yếu, ㅃ gần như không có hơi, và ㅍ có luồng hơi mạnh hay không.",
        "Nghe xen kẽ giọng người bản ngữ và bản ghi của bản thân, tập trung tai vào việc âm căng có bắt đầu nguyên âm cao hơn một chút (chênh nửa đến một bậc cao độ) hay không."
      ]
    },
    "overall": "격음 ㅍ에서 보여주는 강한 기식 조절(VOT 107ms)은 분명한 강점이며, 베트남어권 학습자가 한국어 기식을 안정적으로 다루기 시작했다는 좋은 신호입니다. 다만 평음 ㅂ과 경음 ㅃ이 VOT(13ms vs 7ms)·F0 모두에서 거의 같은 자리에 있어, 듣는 사람 입장에서 두 음의 구분이 잘 들리지 않을 수 있습니다. 다음 단계는 ㅃ에 후두 긴장과 살짝 높은 모음 시작을 더해 ㅂ과의 거리를 벌리는 것입니다. 격음이 잘 되니, 그 감각을 기준선 삼아 경음의 '짧지만 단단한 터짐'을 만들어가면 빠르게 좋아질 것입니다.",
    "overall_vn": "Khả năng điều khiển luồng hơi mạnh ở âm bật hơi ㅍ (VOT 107ms) là một điểm mạnh rõ rệt, cho thấy bạn — một người học gốc Việt — đã bắt đầu xử lý ổn định đặc trưng bật hơi của tiếng Hàn. Tuy nhiên, âm bình thường ㅂ và âm căng ㅃ gần như cùng vị trí cả về VOT (13ms so với 7ms) lẫn cao độ, nên với người nghe, hai âm này có thể khó phân biệt. Bước tiếp theo là thêm sự siết thanh quản và khởi đầu nguyên âm hơi cao hơn ở ㅃ để kéo nó tách xa khỏi ㅂ. Vì âm bật hơi đã tốt, hãy lấy cảm giác đó làm mốc và xây dựng kiểu 'bung ra ngắn nhưng dứt khoát' cho âm căng — bạn sẽ tiến bộ rất nhanh.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지는 발음 나침반에서 nặng(왼쪽·짧고 긴장된 영역) 쪽으로 너무 깊이 들어가 있습니다 — VOT가 13ms로 원어민 평음 위치(97ms 부근의 부드러운 중앙)에서 멀리 떨어져 경음 영역에 가깝게 자리잡았고, F0도 본인 baseline 기준 -1.8 st로 원어민의 -3.7 st만큼 충분히 ngang 아래로 내려가지 못했습니다. 좌표를 오른쪽(조금 더 길고 부드러운 VOT)과 아래쪽(모음을 더 낮고 편안한 톤으로 시작)으로 동시에 이동시켜야 합니다. 연습 시 입술을 가볍게 닫았다가 힘을 빼며 풀어주고, 모음 ㅏ를 한숨처럼 낮게 시작해 보세요. '바'를 '빠'와 의식적으로 다르게 — 부드럽고 살짝 가라앉는 톤으로 — 발음하는 감각을 만드는 것이 핵심입니다.",
      "baji_vn": "바지 trên la bàn phát âm đang nằm quá sâu về phía nặng (bên trái — vùng ngắn và căng): VOT chỉ 13ms, cách xa vị trí âm bình thường của người bản ngữ (vùng trung tâm mềm khoảng 97ms) và lệch gần về vùng âm căng; cao độ cũng chỉ -1.8 st so với baseline của bạn, chưa hạ xuống đủ dưới ngang như mức -3.7 st của người bản ngữ. Bạn cần dịch tọa độ đồng thời sang phải (VOT dài và mềm hơn một chút) và xuống dưới (bắt đầu nguyên âm bằng cao độ thấp, thoải mái hơn). Khi luyện, hãy khép môi nhẹ rồi thả lỏng khi bung ra, và bắt đầu nguyên âm ㅏ bằng giọng thấp như một hơi thở. Cốt lõi là tạo cảm giác phát âm 바 khác hẳn 빠 — mềm mại và hơi trầm xuống.",
      "bbareuda": "빠르다는 발음 나침반에서 바지와 거의 같은 자리에 머물러 있어, 두 단어가 한 점에 겹쳐 있는 인상입니다 — VOT 7ms는 경음의 정상 영역(왼쪽 nặng)에 있지만, F0가 +0.8 st로 원어민의 -0.4 st보다 위쪽으로 올라가긴 했어도 격음과 같은 높이라 위계가 무너졌습니다. 좌표를 그대로 왼쪽 nặng 깊은 영역에 두되, 위쪽 sắc 방향의 긴장감을 더 또렷하게 만들어야 합니다. 입술을 평음보다 한 박자 더 꽉 다물었다가 짧고 단단하게 '톡' 터뜨리고, 모음 ㅏ를 살짝 조이듯 단단한 톤으로 시작해 보세요. 바지보다 모음이 미세하게 높고 단호하게 들리는지를 귀로 확인하는 것이 가장 큰 단서입니다.",
      "bbareuda_vn": "빠르다 trên la bàn gần như nằm chồng lên 바지, khiến hai từ trông như cùng một điểm: VOT 7ms thì đúng vùng âm căng (nặng — bên trái), nhưng cao độ +0.8 st, tuy có cao hơn mức -0.4 st của người bản ngữ, lại ngang bằng âm bật hơi nên trật tự bậc thang bị phá vỡ. Bạn nên giữ tọa độ ở vùng nặng sâu bên trái, đồng thời tăng rõ độ căng theo hướng sắc (lên trên). Hãy mím môi chặt hơn âm bình thường một nhịp, rồi bung ra ngắn và dứt khoát như tiếng 'tốc', và bắt đầu nguyên âm ㅏ với giọng siết, chắc. Manh mối lớn nhất là dùng tai kiểm tra xem nguyên âm có cao hơn 바지 một chút và nghe có vẻ kiên quyết hơn không.",
      "paransaek": "파란색은 발음 나침반에서 오른쪽 bật hơi 영역으로 시원하게 뻗어 있어 가장 안정적인 좌표를 보여줍니다 — VOT 107ms는 원어민(60ms)보다 오히려 더 멀리 오른쪽으로 나가 강한 기식이 잘 구현되었습니다. 다만 위쪽 sắc 방향이 약간 부족합니다: F0가 +0.8 st로, 원어민이 +3.4 st 위로 솟구치는 것에 비해 평탄하게 머물러 있어, 경음과 같은 높이로 묶여 위계가 흐려졌습니다. 기식은 이대로 유지하되, 모음 ㅏ를 시작할 때 평소 톤보다 두 음 정도 위에서 '밝게' 출발하는 감각을 더해 좌표를 위쪽으로 끌어올려 보세요. 격음의 강점은 분명하니, 톤만 살짝 띄우면 세 음 사이 위계가 훨씬 또렷해질 것입니다.",
      "paransaek_vn": "파란색 trên la bàn vươn rõ sang vùng bật hơi (bên phải) và là tọa độ ổn định nhất của bạn: VOT 107ms thậm chí còn xa hơn cả người bản ngữ (60ms), cho thấy luồng hơi mạnh được thực hiện tốt. Tuy nhiên, hướng sắc (lên trên) còn hơi yếu: cao độ chỉ +0.8 st, trong khi người bản ngữ vọt lên +3.4 st, khiến nó nằm ngang với âm căng và làm mờ trật tự bậc thang. Hãy giữ nguyên độ bật hơi, nhưng khi bắt đầu nguyên âm ㅏ, hãy xuất phát 'sáng' hơn, cao hơn giọng nói thường khoảng hai bậc, để kéo tọa độ lên trên. Thế mạnh ở âm bật hơi đã rõ, chỉ cần nâng cao độ một chút là trật tự giữa ba âm sẽ trở nên rất rõ ràng."
    },
    "encouragement": "격음 ㅍ에서 보여준 강한 기식은 정말 훌륭한 출발점이에요 — 이 감각을 기준 삼아 경음만 한 발짝 더 다듬으면 세 음의 위계가 또렷이 살아날 거예요!",
    "encouragement_vn": "Khả năng bật hơi mạnh ở ㅍ là một khởi đầu thực sự tuyệt vời — chỉ cần lấy cảm giác đó làm mốc và tinh chỉnh thêm một bước ở âm căng, trật tự giữa ba âm sẽ hiện ra rõ ràng!",
    "_source": "claude"
  },
