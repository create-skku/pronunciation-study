  "ai_feedback": {
    "error_analysis": {
      "summary": "세 파열음 모두 VOT가 원어민보다 짧고, 평음·격음의 F0 위계가 뒤집혀 세 자음이 평탄하게 모이는 경향이 보입니다.",
      "summary_vn": "Cả ba âm bật của bạn đều có VOT ngắn hơn người bản ngữ, và thứ bậc F0 giữa 평음(âm thường) và 격음(âm bật hơi) bị đảo ngược, khiến ba phụ âm có xu hướng nghe giống nhau.",
      "detail": "가방의 ㄱ은 VOT 50ms로 원어민 63ms보다 짧고, 뒤따르는 ㅏ의 F0 패턴이 +3.8 st 더 높아 평음치고 음높이가 떠 있습니다. 까만색의 ㄲ은 VOT 2ms로 원어민 8ms보다 더 짧지만 F0 패턴이 -2.2 st 낮아 경음 특유의 높은 모음 시작이 약합니다. 카드의 ㅋ은 VOT 70ms로 원어민 83ms보다 짧고 F0도 -1.2 st 낮아 기식과 모음 음높이 모두 격음 기준에 미달합니다. 결과적으로 원어민의 '평음 낮음 / 경음·격음 높음' F0 위계가 학습자에게서는 '평음 높음 / 경음 낮음 / 격음 낮음'으로 뒤집혀 있습니다.",
      "detail_vn": "Trong 가방, ㄱ có VOT 50ms (ngắn hơn 63ms của bản ngữ), và F0 của ㅏ cao hơn +3.8 st nên cao độ bị nâng quá mức đối với một 평음. Trong 까만색, ㄲ có VOT 2ms (ngắn hơn 8ms của bản ngữ) nhưng F0 lại thấp hơn -2.2 st, nên đặc trưng 'mở đầu nguyên âm cao' của 경음 chưa rõ. Trong 카드, ㅋ có VOT 70ms (ngắn hơn 83ms của bản ngữ) và F0 thấp hơn -1.2 st, nên cả luồng hơi lẫn cao độ nguyên âm đều chưa đạt chuẩn 격음. Kết quả là thứ bậc F0 của bản ngữ — 평음 thấp / 경음·격음 cao — bị đảo ngược ở bạn thành 평음 cao / 경음 thấp / 격음 thấp."
    },
    "cause": "베트남어에는 한국어식 평음–경음–격음 3중 구분이 없고, 자음 자체의 후두 긴장이나 강한 기식으로 음높이를 끌어올리는 습관이 약합니다. 그래서 격음의 기식이 짧아지고, 경음에 필요한 후두 긴장도 부족해져 세 범주가 중간 영역에 몰리는 경향이 생깁니다. 또한 한국어 화자가 자음의 단서로 사용하는 '모음 시작 음높이(F0)'를 베트남어 화자는 성조 단어로 따로 인식하기 때문에, 자음 구분의 신호로 활용하지 못하는 경우가 많습니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc 평음–경음–격음 như tiếng Hàn, và người Việt không có thói quen dùng độ căng thanh quản hay luồng hơi mạnh để nâng cao độ nguyên âm. Vì vậy luồng hơi của 격음 bị ngắn lại, độ căng thanh quản cần cho 경음 cũng yếu, khiến ba loại phụ âm dồn vào vùng giữa. Thêm nữa, người Hàn dùng 'cao độ mở đầu nguyên âm (F0)' làm tín hiệu phân biệt phụ âm, nhưng người Việt lại xử lý cao độ như một đặc trưng thanh điệu riêng của từ, nên thường không tận dụng được tín hiệu này.",
    "correction": {
      "main_focus": "격음(ㅋ)의 기식을 길게 늘리면서 동시에 모음 ㅏ를 평음보다 살짝 높게 시작해, 평음–격음의 음높이 위계를 뒤집어 세우는 것이 가장 중요합니다.",
      "main_focus_vn": "Điều quan trọng nhất là kéo dài luồng hơi của 격음(ㅋ) và đồng thời bắt đầu nguyên âm ㅏ ở cao độ hơi cao hơn 평음, để dựng lại đúng thứ bậc cao độ giữa 평음 và 격음.",
      "steps": [
        "손바닥을 입 앞 10cm에 두고 평음·경음·격음을 차례로 발음하며 손바닥에 닿는 바람 양 차이를 직접 체감하세요.",
        "최소대립쌍 '가–까–카'를 천천히 3회씩 반복하되, 각 자음 뒤 ㅏ의 음높이를 의식적으로 다르게 잡아 평음은 낮게·경음과 격음은 높게 시작하는 연습을 하세요.",
        "원어민 음원과 본인 녹음을 한 문장씩 번갈아 들으며, 자음의 바람 길이와 모음 첫 음높이를 항목별로 비교해 보세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 10cm, lần lượt phát âm 평음·경음·격음 và cảm nhận trực tiếp sự khác nhau về lượng hơi chạm vào tay.",
        "Lặp lại bộ tối thiểu '가–까–카' chậm rãi 3 lần mỗi âm, cố ý đặt cao độ ㅏ khác nhau: 평음 bắt đầu thấp, 경음 và 격음 bắt đầu cao hơn.",
        "Nghe xen kẽ bản ghi của bạn và bản ghi người bản ngữ theo từng câu, so sánh riêng biệt độ dài luồng hơi của phụ âm và cao độ mở đầu nguyên âm."
