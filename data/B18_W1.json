  "ai_feedback": {
    "error_analysis": {
      "summary": "VOT 위계는 부분적으로 잘 형성되어 있으나, 격음 ㅍ의 기식이 완전히 빠져 있고 경음 ㅃ과 격음 ㅍ의 F0 위계가 뒤바뀌어 있습니다.",
      "summary_vn": "Thứ tự VOT đã hình thành một phần, nhưng hơi bật của 격음 ㅍ hoàn toàn biến mất và thứ tự F0 giữa 경음 ㅃ và 격음 ㅍ bị đảo ngược.",
      "detail": "바지는 VOT 20ms로 평음 영역에 정확히 들어와 있고, 빠르다도 16ms로 경음 범위에 근접한 좋은 값입니다. 그러나 파란색은 VOT 0ms로 격음의 강한 기식이 완전히 사라져 평음·경음과 거의 구분되지 않습니다. F0 패턴(본인 baseline 기준)에서 빠르다는 +3.4 st로 높이 올라가는 반면, 정작 가장 높아야 할 파란색은 +0.8 st로 빠르다보다 낮아 위계가 뒤집힌 상태입니다.",
      "detail_vn": "바지 có VOT 20ms, nằm chính xác trong vùng 평음, và 빠르다 cũng có 16ms, gần với 경음 — đây là những giá trị tốt. Tuy nhiên, 파란색 có VOT 0ms, nghĩa là hơi bật mạnh đặc trưng của 격음 hoàn toàn biến mất, khiến nó gần như không phân biệt được với 평음·경음. Về mẫu F0 (so với baseline của chính học viên), 빠르다 lên đến +3.4 st, nhưng 파란색 — vốn phải cao nhất — lại chỉ ở +0.8 st, thấp hơn 빠르다, khiến thứ bậc bị đảo ngược."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 대립이 없어, 특히 격음의 강한 기식과 경음의 후두 긴장이 익숙하지 않습니다. 그래서 가장 큰 노력이 필요한 격음 ㅍ의 기식이 가장 먼저 빠지고, 대신 경음 ㅃ에 의도치 않게 더 강한 강세(F0 상승)가 실리면서 두 음의 역할이 뒤바뀌는 패턴이 나타납니다.",
    "cause_vn": "Tiếng Việt không có hệ thống đối lập ba bậc 평음·경음·격음 như tiếng Hàn, đặc biệt là hơi bật mạnh của 격음 và độ căng thanh quản của 경음 đều xa lạ với người Việt. Vì vậy, hơi bật của 격음 ㅍ — đòi hỏi nỗ lực lớn nhất — thường biến mất đầu tiên, và thay vào đó 경음 ㅃ vô tình bị nhấn mạnh hơn (F0 lên cao), làm vai trò của hai âm bị hoán đổi.",
    "correction": {
      "main_focus": "파란색의 ㅍ에 손바닥에 분명히 바람이 닿을 정도의 강한 기식을 넣고, 동시에 음높이도 빠르다보다 더 높게 끌어올리는 것에 집중하세요.",
      "main_focus_vn": "Hãy tập trung vào ㅍ của 파란색: bật hơi đủ mạnh để cảm nhận rõ luồng gió trên lòng bàn tay, đồng thời nâng cao độ cao hơn cả 빠르다.",
      "steps": [
        "손바닥을 입 앞 5cm에 두고 바·빠·파를 차례로 발음하며 바람의 양 차이를 의식적으로 만들기 (격음 > 평음 > 경음 순으로 바람이 강해야 합니다).",
        "거울 앞에서 최소대립쌍(바-빠-파)을 천천히 반복하면서, 격음을 낼 때만 가슴에서 숨을 미는 느낌으로 길게 내뱉는 동작을 몸에 익히기.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 경음과 격음의 음높이 순서가 제대로 나오는지 귀로 비교 점검하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm và lần lượt phát âm 바·빠·파, có ý thức tạo ra sự khác biệt về lượng hơi (격음 > 평음 > 경음, hơi mạnh dần theo thứ tự này).",
        "Đứng trước gương, lặp lại chậm rãi cặp tối thiểu 바-빠-파, chỉ khi phát âm 격음 mới đẩy hơi từ ngực ra dài để cơ thể quen với động tác đó.",
        "Nghe luân phiên bản ghi của người bản xứ và của chính mình, dùng tai kiểm tra xem thứ tự cao độ giữa 경음 và 격음 đã đúng chưa."
      ]
    },
    "overall": "세 단어 모두 측정이 안정적으로 잡혀 진단이 또렷한 상태이며, 평음 바지(VOT 20ms)와 경음 빠르다(VOT 16ms)는 이미 한국어 음성 범위 안에 잘 자리잡고 있습니다. 가장 큰 과제는 격음 파란색의 VOT가 0ms로 기식이 완전히 빠진 것과, F0 위계상 경음과 격음의 위치가 뒤바뀐 점입니다. 한 번에 셋을 다 고치려 하기보다, 이번 주는 '파'의 바람과 톤만 끌어올리면 전체 위계가 빠르게 자리 잡힐 것입니다. 베트남어에 없는 동작을 의식적으로 만들어내는 단계라 시간이 필요하지만, 이미 F0로 음의 차이를 만들고 있다는 점은 매우 좋은 출발입니다.",
    "overall_vn": "Cả ba từ đều được đo lường ổn định nên chẩn đoán rõ ràng, và VOT của 평음 바지 (20ms) cùng 경음 빠르다 (16ms) đã nằm trong khoảng phát âm tiếng Hàn. Thử thách lớn nhất là VOT của 격음 파란색 chỉ 0ms — hơi bật hoàn toàn biến mất — và thứ tự F0 giữa 경음 và 격음 bị đảo ngược. Đừng cố sửa cả ba cùng lúc; tuần này hãy tập trung vào 'pa' để tăng cả hơi lẫn cao độ, thứ bậc tổng thể sẽ nhanh chóng vào đúng chỗ. Đây là giai đoạn cần ý thức tạo ra động tác không có trong tiếng Việt nên cần thời gian, nhưng việc bạn đã tạo được khác biệt về cao độ là một khởi đầu rất tốt.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지는 VOT 20ms로 평음 영역의 적정 위치에 안착해 있어, 나침반 상으로는 중심에서 살짝 왼쪽 nặng 쪽으로 기울어 있습니다. F0는 -5.4 st로 본인 baseline보다 한 음 반 정도 huyền 아래쪽으로 내려가 있어 평음 특유의 낮은 톤은 잘 만들고 있습니다. 다만 원어민 평음(-3.7 st)보다 약간 더 깊이 가라앉아 있으니, 톤을 살짝만 들어 올려 baseline 근처에서 부드럽게 떨어지는 느낌으로 다듬어 보세요. 이미 좌표가 평음 영역 안에 들어와 있으므로 큰 수정은 필요 없고 미세 조정만 해주면 됩니다.",
      "baji_vn": "바지 với VOT 20ms đã ở đúng vùng phát âm của 평음, trên la bàn nó nằm lệch nhẹ về phía trái — vùng nặng. F0 ở -5.4 st, tức khoảng một bậc rưỡi dưới baseline của bạn — phía huyền — nên bạn tạo được tông thấp đặc trưng của 평음. Tuy nhiên hơi sâu hơn người bản xứ (-3.7 st), nên hãy nâng nhẹ tông lên để âm rơi nhẹ nhàng quanh baseline. Toạ độ đã nằm trong vùng 평음 rồi nên không cần sửa lớn, chỉ điều chỉnh nhẹ là đủ.",
      "bbareuda": "빠르다는 VOT 16ms로 nặng 왼쪽 영역에 잘 들어와 있고, F0도 +3.4 st로 sắc 위쪽으로 시원하게 올라가 있어 가장 균형이 좋은 단어입니다. 다만 이 높은 위치는 원래 격음 파란색이 차지해야 할 자리라서, 빠르다는 지금처럼 짧고 단단하게 유지하되 음높이를 살짝 낮춰 baseline 위 0~+1 st 정도 사이에서 머무는 연습을 해 보세요. 후두에 살짝 힘을 주고 '목을 닫는' 듯한 느낌을 잡으면 너무 솟구치지 않고 F0가 자연스럽게 안정됩니다.",
      "bbareuda_vn": "빠르다 có VOT 16ms nằm tốt trong vùng nặng bên trái, và F0 +3.4 st đi lên phía sắc mạnh mẽ — đây là từ cân bằng nhất. Tuy nhiên vị trí cao này thực ra là chỗ mà 격음 파란색 phải chiếm, nên hãy giữ 빠르다 ngắn và chắc như hiện tại, nhưng hạ cao độ một chút xuống khoảng baseline +0~+1 st. Siết nhẹ thanh quản với cảm giác như 'đóng cổ họng', F0 sẽ không vọt quá cao mà tự nhiên ổn định.",
      "paransaek": "파란색은 VOT 0ms로 격음이 머물러야 할 오른쪽 bật hơi 영역에서 완전히 벗어나 왼쪽 nặng 자리에 머물러 있고, F0도 +0.8 st로 sắc 위쪽 가장 높은 자리까지 올라가지 못한 상태입니다. 즉 나침반 좌표가 빠르다보다 오히려 안쪽에 있어 격음의 정체성이 거의 사라진 셈이라 가장 시급한 교정 대상입니다. 손바닥을 입 앞에 대고 '파!' 할 때 손이 흔들릴 만큼의 강한 바람을 내보내면서 동시에 음높이를 빠르다보다 더 높이 끌어 올려, 좌표를 오른쪽-위쪽 모서리 방향으로 크게 이동시키는 것이 핵심입니다.",
      "paransaek_vn": "파란색 với VOT 0ms hoàn toàn rời khỏi vùng bật hơi bên phải vốn dành cho 격음, và đang nằm trong vùng nặng bên trái; F0 cũng chỉ +0.8 st, chưa lên tới vị trí cao nhất phía sắc. Toạ độ trên la bàn còn nằm gần trung tâm hơn cả 빠르다, nên bản sắc 격음 gần như biến mất — đây là điểm cần sửa gấp nhất. Đặt lòng bàn tay trước miệng, phát 'pa!' với luồng hơi mạnh đến mức làm rung tay, đồng thời nâng cao độ lên cao hơn 빠르다 — kéo toạ độ về góc trên-bên phải chính là then chốt."
    },
