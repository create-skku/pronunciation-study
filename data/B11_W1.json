  "ai_feedback": {
    "error_analysis": {
      "summary": "평음(바지)의 짧은 VOT는 자리잡았지만, 경음(빠르다)이 격음보다 더 강한 기식으로 발음되고 평음·격음의 F0 위계가 뒤집혀 있습니다.",
      "summary_vn": "VOT ngắn của 평음(바지) đã hình thành tốt, nhưng 경음(빠르다) lại được phát âm với hơi bật còn mạnh hơn cả 격음, và thứ tự cao-thấp F0 giữa 평음·격음 đang bị đảo ngược.",
      "detail": "바지의 VOT는 39ms로 원어민 97ms보다 짧게 측정되어 평음 자체의 짧은 폐쇄 구간은 잘 만들고 있습니다. 다만 빠르다의 VOT가 132ms로, 경음 기준(0ms 근처)에서 크게 벗어나 오히려 파란색(93ms)보다 더 긴 기식을 동반하고 있어 사실상 강한 격음처럼 들립니다. F0 pattern_st 도 바지가 baseline 대비 +1.0 st(원어민 -3.7), 파란색이 -1.0 st(원어민 +3.4)로 측정되어, '평음은 낮게·격음은 높게' 가야 할 톤 위계가 정반대로 나타나고 있습니다.",
      "detail_vn": "VOT của 바지 đo được 39ms, ngắn hơn so với 97ms của người bản ngữ, cho thấy đoạn đóng ngắn đặc trưng của 평음 đã được tạo khá tốt. Tuy nhiên VOT của 빠르다 lên tới 132ms, lệch rất xa khỏi chuẩn 경음 (gần 0ms), thậm chí còn kèm hơi bật dài hơn cả 파란색 (93ms), nên nghe như một 격음 mạnh. F0 pattern_st cũng cho thấy 바지 ở mức +1.0 st so với baseline (người bản ngữ -3.7), còn 파란색 ở -1.0 st (người bản ngữ +3.4) — tức là thứ tự cao thấp 'ㅂ thấp · ㅍ cao' đang bị đảo ngược hoàn toàn."
    },
    "cause": "베트남어에는 한국어 경음 특유의 후두 긴장 동작이 없기 때문에, 학습자가 '짧고 단단한 막힘'을 만드는 대신 익숙한 '강한 기식'으로 대체하는 경향이 나타납니다. 또 베트남어의 성조는 단어 의미를 나누는 도구라 한국어 자음 종류에 따라 모음 시작 톤이 체계적으로 달라지는 패턴(평음 낮음·격음 높음)이 자연스럽게 형성되지 않아, F0 위계가 거꾸로 자리 잡은 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có động tác căng thanh môn (후두 긴장) đặc trưng của 경음 tiếng Hàn, nên người học có xu hướng thay 'sự đóng ngắn và căng' bằng 'hơi bật mạnh' vốn quen thuộc hơn. Ngoài ra, thanh điệu trong tiếng Việt dùng để phân biệt nghĩa từ chứ không gắn với loại phụ âm, nên hệ thống 'ㅂ thấp · ㅍ cao' của tiếng Hàn không tự nhiên hình thành, dẫn đến F0 bị đảo thứ tự.",
    "correction": {
      "main_focus": "경음 ㅃ을 '강한 바람'이 아니라 '거의 바람 없이 짧고 단단하게 끊는 소리'로 다시 잡는 것이 이번 학습의 가장 큰 한 가지입니다.",
      "main_focus_vn": "Điều quan trọng nhất lần này là phải định hình lại 경음 ㅃ thành 'âm ngắn, đóng chặt và gần như không có hơi bật' chứ không phải 'âm có hơi bật mạnh'.",
      "steps": [
        "거울 앞에서 입 모양을 확인하며 손바닥을 입 앞 5cm에 두고 ㅂ·ㅃ·ㅍ를 발음해, 손바닥에 닿는 바람의 양 차이(부드러움·거의 없음·강함)를 직접 체감하기.",
        "최소대립쌍 '바-빠-파'를 원어민 음원과 본인 녹음을 한 번씩 번갈아 들으며 천천히 5회 반복해, 세 자음의 길이·바람·톤 차이를 귀로 대조하기.",
        "녹음 전 자기 baseline 톤으로 워밍업한 뒤, 평음은 baseline보다 살짝 낮게·격음은 살짝 높게 시작하는 톤 위계 연습을 짧은 문장 단위로 반복하기."
      ],
      "steps_vn": [
        "Đứng trước gương quan sát khẩu hình, đặt lòng bàn tay cách miệng khoảng 5cm rồi phát âm ㅂ·ㅃ·ㅍ để cảm nhận trực tiếp sự khác biệt về lượng hơi chạm vào tay (nhẹ · gần như không có · mạnh).",
        "Luyện cặp tối thiểu '바-빠-파' bằng cách nghe xen kẽ một lần file người bản ngữ và một lần bản ghi của mình, lặp lại chậm 5 lần để tai phân biệt sự khác nhau về độ dài, hơi và tông giữa ba phụ âm.",
        "Trước khi ghi âm, khởi động giọng theo baseline của chính mình; sau đó lặp lại theo câu ngắn bài tập thứ tự tông: 평음 bắt đầu hơi thấp hơn baseline, 격음 bắt đầu hơi cao hơn."
      ]
    },
    "overall": "VOT 측정으로 보면 학습자는 '짧은 자음·긴 자음' 자체는 구분해서 만들고 있어, 베트남 학습자 초기 단계에서 자주 보이는 '셋이 다 평평해지는' 함정은 이미 벗어났습니다. 다만 경음의 자리가 격음 쪽으로 밀려나 있고 평음·격음의 톤 위계가 거꾸로 나타나, 길이는 세 갈래로 보이지만 청각 인상은 두 갈래(평음 vs 강한 기식음 두 종류)로 들릴 가능성이 큽니다. 즉 'VOT 길이'라는 한 축은 잘 잡혔고, 이제 '후두 긴장 유무'와 'F0 높낮이'라는 두 번째 축을 추가하는 단계입니다. 다음 녹음에서는 ㅃ를 ㅍ보다 더 짧고 더 단단하게 만드는 것 한 가지만 신경 써도 전체 청취 인상이 크게 달라질 것입니다.",
    "overall_vn": "Nhìn vào VOT, có thể thấy người học đã thực sự tạo ra sự phân biệt 'phụ âm ngắn — phụ âm dài', tức là đã vượt qua được cái bẫy phổ biến ở giai đoạn đầu của người Việt là 'cả ba âm bị san phẳng'. Tuy nhiên, vị trí của 경음 đang bị đẩy sang phía 격음, và thứ tự tông 평음·격음 đang ngược, nên dù về độ dài có vẻ chia ba, ấn tượng nghe có thể chỉ còn hai (평음 vs hai loại âm có hơi bật mạnh). Nghĩa là trục 'độ dài VOT' đã được nắm tốt, giờ là lúc thêm vào trục thứ hai: 'có/không có căng thanh môn' và 'cao/thấp F0'. Trong bản ghi tiếp theo, chỉ cần chú ý làm cho ㅃ ngắn hơn và đóng chặt hơn ㅍ, ấn tượng tổng thể sẽ thay đổi đáng kể.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 학습자 좌표는 VOT 39ms로 원어민(97ms)보다 nặng(왼쪽 짧은 VOT) 영역으로 더 들어가 있어, 평음치고는 '닫힘이 살짝 단단한' 위치에 자리합니다. 그런데 F0가 baseline 대비 +1.0 st 떠올라 sắc(위쪽) 방향으로 올라가 있어, 원어민 평음 클러스터가 위치한 huyền(아래쪽) 영역과는 위로 약 4.6 st 어긋나 있습니다. 즉 좌표를 살짝 '오른쪽으로 + 아래로' 옮기는 것이 과제이며, 입을 너무 빨리 떼지 말고 모음을 평소 말투보다 한 톤 낮게 깔며 시작하면 원어민 자리로 내려옵니다.",
      "baji_vn": "Tọa độ 바지 của bạn có VOT 39ms, nằm sâu hơn về phía nặng (vùng VOT ngắn bên trái) so với người bản ngữ (97ms), nghĩa là so với 평음 thì điểm đóng hơi 'chặt' hơn một chút. Đồng thời F0 vọt lên +1.0 st so với baseline, lệch lên phía sắc (phía trên), cách cụm 평음 ở vùng huyền (phía dưới) của người bản ngữ khoảng 4.6 st về phía trên. Nhiệm vụ là dịch chuyển tọa độ 'hơi sang phải và xuống dưới'; đừng nhả môi quá nhanh, và bắt đầu nguyên âm thấp hơn giọng nói thường ngày khoảng một bậc — bạn sẽ về đúng vị trí người bản ngữ.",
      "bbareuda": "빠르다는 가장 큰 격차가 나타나는 단어로, VOT 132ms는 경음이 있어야 할 nặng(왼쪽 끝) 영역이 아니라 오히려 격음(파란색 93ms)보다도 더 오른쪽 bật hơi 끝 영역에 좌표가 찍혀 있습니다. F0 측정이 빠졌지만 베트남 학습자 일반 경향상 톤도 sắc 위쪽까지 충분히 올라가지 않을 가능성이 있어, 입술을 강하게 다물고 숨을 거의 내보내지 말고 짧게 '빡!' 끊어주는 동작이 핵심입니다. 손을 입 앞에 댔을 때 파란색에서는 바람을 분명히 느끼지만 빠르다에서는 거의 안 느껴져야 좌표가 nặng 영역으로 돌아옵니다.",
      "bbareuda_vn": "빠르다 là từ có khoảng cách lớn nhất: VOT 132ms khiến tọa độ rơi vào tận cùng phía bật hơi (phía phải), thậm chí còn xa hơn cả 격음 파란색 (93ms), thay vì nằm ở vùng nặng (trái) như 경음 cần. F0 không đo được, nhưng theo xu hướng chung của người học Việt, có khả năng tông cũng chưa lên đủ cao tới vùng sắc; vì vậy điểm mấu chốt là khép chặt môi, gần như không thoát hơi và ngắt thật nhanh, dứt khoát kiểu 'bặp!'. Khi đặt tay trước miệng, ở 파란색 phải cảm rõ hơi, còn ở 빠르다 thì gần như không cảm thấy gì — lúc đó tọa độ mới trở lại đúng vùng nặng.",
      "paransaek": "파란색의 VOT 93ms는 원어민 60ms보다 더 오른쪽 bật hơi 영역으로 가 있어, 격음의 강한 기식 자체는 충분히 만들고 있습니다. 다만 F0가 baseline 대비 -1.0 st로 떨어져 huyền(아래쪽)에 내려와 있는데, 원어민 격음 클러스터는 sắc(위쪽) +3.4 st 자리에 있어 위로 약 4.4 st 어긋나 있습니다. 좌표를 '같은 오른쪽, 한 칸 위로' 끌어올리는 연습이 필요하며, 'ㅍ'을 발음할 때 강한 바람과 함께 모음 첫 머리의 톤을 평소보다 살짝 띄워 시작하면 정확한 격음 좌표로 들어갑니다.",
      "paransaek_vn": "VOT của 파란색 là 93ms, lệch sang phía bật hơi (phải) xa hơn cả người bản ngữ (60ms), nghĩa là hơi bật mạnh đặc trưng của 격음 thì bạn tạo rất tốt. Tuy nhiên F0 lại tụt -1.0 st so với baseline, rơi xuống vùng huyền (dưới), trong khi cụm 격음 của người bản ngữ nằm ở vùng sắc (+3.4 st), cách bạn khoảng 4.4 st về phía trên. Bạn cần luyện kéo tọa độ 'vẫn ở bên phải, nhưng nâng lên một bậc': khi phát âm ㅍ, hãy giữ hơi bật mạnh và đồng thời bắt đầu nguyên âm với tông cao hơn bình thường một chút — tọa độ sẽ trùng đúng vùng 격음 chuẩn."
    },
    "encouragement": "VOT를 길이별로 세 갈래로 나누는 감각은 이미 잡혀 있으니, 경음의 '단단함' 한 가지만 더하면 큰 도약이 옵니다 — Cố lên!",
    "encouragement_vn": "Cảm giác chia VOT thành ba độ dài khác nhau bạn đã có rồi, chỉ cần thêm 'độ căng chặt' của 경음 nữa là sẽ bứt phá rất nhanh — Cố lên!",
