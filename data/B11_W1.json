  "ai_feedback": {
    "error_analysis": {
      "summary": "ㅂ·ㅍ 모두 VOT 0ms 로 무기식 발음되어 평음과 격음이 합쳐졌고, 경음 ㅃ만 비교적 잘 구분됩니다.",
      "summary_vn": "ㅂ và ㅍ đều phát âm với VOT 0ms (không bật hơi), khiến âm 평음 và 격음 hòa lẫn vào nhau, chỉ có 경음 ㅃ là phân biệt tương đối tốt.",
      "detail": "바지의 VOT 가 0ms (원어민 97ms) 로 측정되었고, 파란색 또한 VOT 0ms (원어민 60ms) 로 두 단어 모두 기식이 거의 없습니다. 반면 빠르다는 VOT 51ms 로 원어민(0ms)보다 길긴 하지만, 학습자 내부에서는 ㅃ 가 가장 짧은 기식·긴장된 발성으로 다른 두 자음과 구분되는 위치에 있지 않고 오히려 가장 긴 VOT 를 가진 자음이 되어버렸습니다. F0 pattern_st 도 파란색이 0.5 st 로 원어민 3.4 st 보다 -2.9 st 낮아, 격음 특유의 높은 모음 시작이 거의 실현되지 않았습니다. 바지의 F0 는 -0.2 st 로 원어민 -3.7 st 보다 +3.4 st 높게 시작되어, 평음을 격음처럼 다소 띄워 발음하는 경향도 함께 보입니다.",
      "detail_vn": "바지 có VOT 0ms (người bản ngữ 97ms), 파란색 cũng có VOT 0ms (người bản ngữ 60ms), cả hai từ đều gần như không có hơi bật. Ngược lại, 빠르다 có VOT 51ms — dù dài hơn người bản ngữ (0ms), nhưng trong nội bộ phát âm của bạn, ㅃ lẽ ra phải là phụ âm có VOT ngắn nhất và căng thanh quản, thì lại trở thành phụ âm có VOT dài nhất trong ba từ. Về F0 pattern_st, 파란색 chỉ đạt 0.5 st so với 3.4 st của người bản ngữ (-2.9 st), nghĩa là phần khởi đầu nguyên âm cao đặc trưng của 격음 gần như không xuất hiện. 바지 có F0 -0.2 st, cao hơn người bản ngữ -3.7 st tới +3.4 st, cho thấy bạn đang phát âm 평음 hơi nhấc lên giống 격음."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 베트남어 /b/, /p/ 가 모두 무기식에 가깝기 때문에 ㅂ 와 ㅍ 가 동일하게 'VOT 0ms 무기식' 으로 합쳐졌습니다. 한국어 격음의 핵심인 강한 기식과 모음의 높은 시작점이라는 두 단서가 모두 모국어에 없어, 두 자음을 분리할 음향적 단서가 학습자에게 아직 형성되지 않은 단계입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba bậc 평음·경음·격음 như tiếng Hàn, và cả /b/ lẫn /p/ trong tiếng Việt đều gần như không bật hơi, nên ㅂ và ㅍ bị gộp chung lại thành 'VOT 0ms không bật hơi'. Hai dấu hiệu cốt lõi của 격음 trong tiếng Hàn — hơi bật mạnh và nguyên âm khởi đầu ở cao độ cao — đều không tồn tại trong tiếng mẹ đẻ, nên bạn chưa hình thành được dấu hiệu âm học để tách hai phụ âm này.",
    "correction": {
      "main_focus": "격음 ㅍ 에 강한 기식과 높은 모음 시작을 동시에 만들어, 평음 ㅂ 와의 거리를 벌리는 것이 가장 중요합니다.",
      "main_focus_vn": "Tạo đồng thời hơi bật mạnh và khởi đầu nguyên âm ở cao độ cao cho 격음 ㅍ để kéo nó tách xa khỏi 평음 ㅂ — đây là trọng tâm quan trọng nhất.",
      "steps": [
        "손바닥을 입 앞 10cm 에 두고 최소대립쌍 '바-빠-파' 를 천천히 반복하며 손바닥에 닿는 바람의 양 차이를 직접 체감하세요 — 바: 바람 거의 없음 / 빠: 짧고 막힌 느낌 / 파: 바람이 길게 분명히 나옴.",
        "녹음 전 평소 말할 때의 자기 baseline 톤을 한 번 짚고, 격음 단어는 그 baseline 보다 살짝 위에서 모음을 시작한다는 의식을 가지고 발음하세요.",
        "원어민 음원과 본인 녹음을 같은 단어끼리 번갈아 들으며, '기식 길이' 와 '모음 시작 높이' 두 가지에만 집중해 비교하세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm và lặp lại chậm cặp tối thiểu '바-빠-파', cảm nhận trực tiếp sự khác biệt về luồng hơi chạm vào lòng bàn tay — 바: gần như không có hơi / 빠: ngắn và bị chặn / 파: hơi thoát ra dài và rõ rệt.",
        "Trước khi thu âm, xác định cao độ baseline khi nói chuyện bình thường của bạn, rồi phát âm từ chứa 격음 với ý thức bắt đầu nguyên âm ở vị trí cao hơn baseline đó một chút.",
        "Nghe xen kẽ bản thu của người bản ngữ và bản thu của bạn theo từng từ giống nhau, chỉ tập trung so sánh hai yếu tố: 'độ dài hơi bật' và 'cao độ khởi đầu của nguyên âm'."
      ]
    },
    "overall": "현재 학습자는 T3 단계 — 경음은 어느 정도 분리되지만 평음과 격음이 같은 음가로 묶여 있는 전형적인 베트남 학습자 패턴을 보입니다. 측정값이 세 단어 모두 신뢰할 만하게 나왔고, 특히 빠르다에서 VOT 51ms 로 기식을 만들 수 있는 발성 능력 자체는 충분히 갖추고 있다는 점이 매우 긍정적입니다. 남은 과제는 그 기식 능력을 ㅃ 에서 ㅍ 쪽으로 옮기고, 동시에 ㅂ 는 짧고 부드럽게 가라앉히는 두 방향의 조정입니다. 위계만 잡히면 빠르게 개선될 단계입니다.",
    "overall_vn": "Hiện tại bạn đang ở giai đoạn T3 — đặc trưng điển hình của người Việt học tiếng Hàn: 경음 đã tách ra phần nào nhưng 평음 và 격음 vẫn bị gộp chung một âm. Cả ba từ đều có số đo đáng tin cậy, và đặc biệt việc bạn tạo được VOT 51ms ở 빠르다 cho thấy bạn hoàn toàn có khả năng phát âm có hơi bật — đây là điểm rất tích cực. Việc còn lại là chuyển khả năng tạo hơi này từ ㅃ sang ㅍ, đồng thời làm cho ㅂ ngắn và nhẹ hơn — hai hướng điều chỉnh song song. Một khi trật tự ba bậc được thiết lập, bạn sẽ tiến bộ rất nhanh.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지는 nặng 영역 깊숙이 (VOT 0ms) 머물러 있어 격음 영역과 거의 같은 좌표에 찍혀 있습니다. 동시에 모음 시작점은 본인 baseline 대비 -0.2 st 로 원어민 -3.7 st 보다 +3.4 st 위쪽으로 떠 있어, ngang 보다도 위로 올라간 상태입니다 — 평음인데 ngang 아래로 가라앉아야 할 위치에서 떠 있는 것이죠. 입술을 가볍게 붙였다 떼며 바람을 거의 내보내지 않고, 모음 ㅏ 도 평소 말할 때보다 한 단계 낮은 톤에서 부드럽게 시작하세요. nặng 의 왼쪽 + 아래쪽 방향으로 좌표를 옮기는 것이 목표입니다.",
      "baji_vn": "바지 đang nằm sâu trong vùng nặng (VOT 0ms), gần như trùng tọa độ với vùng 격음. Đồng thời, điểm khởi đầu nguyên âm ở -0.2 st so với baseline của bạn, cao hơn người bản ngữ (-3.7 st) tới +3.4 st — tức là đang nổi lên phía trên ngang, trong khi 평음 lẽ ra phải chìm xuống dưới ngang. Hãy chạm môi nhẹ rồi tách ra mà gần như không thoát hơi, và bắt đầu nguyên âm ㅏ ở cao độ thấp hơn giọng nói thường ngày một bậc. Mục tiêu là dịch tọa độ về phía trái + phía dưới của vùng nặng.",
      "bbareuda": "빠르다는 의도는 nặng 왼쪽 영역인데 실제 좌표는 VOT 51ms 로 bật hơi 오른쪽으로 밀려나 있어, 오히려 세 단어 중 가장 오른쪽에 위치합니다. F0 pattern_st 는 -0.2 로 원어민과 거의 일치 (+0.2 차이) — 모음 음높이는 훌륭하게 맞췄습니다. 다음에는 입술을 더 단단히 막고 후두를 살짝 긴장시킨 채 'ㅃ' 을 짧고 압축된 폭발로 터뜨려, 좌표를 왼쪽 nặng 깊은 곳으로 끌어당기세요. F0 가 이미 제자리에 있으니 VOT 만 줄이면 됩니다.",
      "bbareuda_vn": "빠르다 đáng lẽ phải nằm ở vùng nặng bên trái, nhưng tọa độ thực tế lại bị đẩy sang phải vùng bật hơi với VOT 51ms — thậm chí còn lệch phải nhất trong ba từ. F0 pattern_st là -0.2, gần như khớp hoàn toàn với người bản ngữ (chênh +0.2) — cao độ nguyên âm bạn đã thực hiện rất tốt. Lần tới, hãy khép môi chặt hơn và căng nhẹ thanh quản, bật 'ㅃ' thành một tiếng nổ ngắn và bị nén, kéo tọa độ về sâu trong vùng nặng bên trái. Vì F0 đã đúng vị trí, bạn chỉ cần giảm VOT là đủ.",
      "paransaek": "파란색은 sắc 오른쪽 위 (VOT 길고 F0 높음) 영역에 있어야 하는데 실제로는 VOT 0ms · F0 0.5 st 로 ngang 위 살짝, 거의 중앙에 멈춰 있어 바지와 거의 같은 좌표에 겹쳐 있습니다. 원어민은 같은 단어를 F0 3.4 st 위쪽 + VOT 60ms 오른쪽 영역에서 발음하는데, 학습자는 두 축 모두에서 그쪽으로 가지 못한 상태입니다. 손바닥에 바람을 길게 느끼며 'ㅍ' 의 기식을 만들고 (오른쪽 이동), 동시에 ㅏ 를 baseline 보다 분명히 높게 시작 (위쪽 이동) — 두 방향 이동이 동시에 일어나야 비로소 바지와 분리됩니다.",
      "paransaek_vn": "파란색 lẽ ra phải ở vùng sắc phía trên bên phải (VOT dài + F0 cao), nhưng thực tế chỉ có VOT 0ms và F0 0.5 st — dừng lại ngay phía trên ngang một chút, gần trung tâm, gần như trùng tọa độ với 바지. Người bản ngữ phát âm từ này ở vùng F0 3.4 st phía trên + VOT 60ms phía phải, còn bạn chưa di chuyển đến đó ở cả hai trục. Hãy tạo hơi bật dài cho 'ㅍ' cảm nhận được rõ trên lòng bàn tay (dịch sang phải), đồng thời bắt đầu nguyên âm ㅏ rõ ràng cao hơn baseline (dịch lên trên) — chỉ khi hai chuyển động này diễn ra cùng lúc thì 파란색 mới tách khỏi 바지."
    },
    "encouragement": "빠르다의 모음 음높이가 원어민과 거의 일치하는 것은 큰 강점입니다 — 이 감각을 파란색으로 옮기면 위계가 곧 잡힙니다!",
    "encouragement_vn": "Cao độ nguyên âm ở 빠르다 gần như khớp hoàn toàn với người bản ngữ — đây là điểm mạnh lớn của bạn. Chỉ cần chuyển cảm giác này sang 파란색 là trật tự ba bậc sẽ sớm hình thành!",
    "_source": "claude"
