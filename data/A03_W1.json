  "ai_feedback": {
    "error_analysis": {
      "summary": "평음 ㅂ과 경음 ㅃ이 거의 같은 영역에 모여 있고, 격음 ㅍ은 기식이 과하게 강조된 패턴입니다.",
      "summary_vn": "Âm thường ㅂ và âm căng ㅃ gần như nằm chung một vùng, còn âm bật hơi ㅍ thì hơi bật được nhấn quá mạnh.",
      "detail": "바지의 VOT 9ms, 빠르다의 VOT 11ms로 두 단어가 거의 구분되지 않고 모두 경음에 가까운 짧은 파형 첫 칸을 보입니다. 모음 ㅏ의 pattern_st는 바지 -1.8, 빠르다 +1.6 으로 두 단어 모두 원어민보다 약 +1.9~+2.0 semitone 위쪽에 있어 baseline 자체가 살짝 높게 시작되는 경향이 보입니다. 파란색 VOT 107ms는 원어민 60ms 보다 47ms 더 길어 격음 기식이 과하게 길게 끌리고, 모음 F0는 측정이 어려워(f0_a_missing) 단정은 어렵지만 파형상 기식 구간이 모음 영역을 잠식한 인상이 있습니다. 즉 ㅂ↔ㅃ 분리가 거의 없는 상태이고, ㅍ 은 '강하게 = 격음'이라는 의식이 과해진 모습입니다.",
      "detail_vn": "바지(quần) có VOT 9ms, 빠르다(nhanh) có VOT 11ms — hai từ gần như không phân biệt được và đều cho ô đầu sóng âm ngắn, gần với âm căng. Pattern_st của nguyên âm ㅏ là -1.8 ở 바지 và +1.6 ở 빠르다, cao hơn người bản xứ khoảng +1.9~+2.0 semitone, cho thấy người học khởi đầu giọng hơi cao so với baseline của chính mình. VOT của 파란색(màu xanh) là 107ms, dài hơn người bản xứ (60ms) đến 47ms — hơi bật được kéo quá dài, và do F0 của ㅏ không đo được (f0_a_missing) nên chưa thể khẳng định, nhưng trên sóng âm có cảm giác đoạn bật hơi lấn vào vùng nguyên âm. Tức là ㅂ và ㅃ gần như chưa tách ra, còn ㅍ thì do ý thức 'mạnh = bật hơi' đã hơi quá mức."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 대립이 없고 /b/-/p/ 정도의 2분 체계라, 평음 ㅂ과 경음 ㅃ이 같은 음가로 흡수되기 쉽습니다. 또한 '격음=세게 불기'라는 인식이 과보정으로 작용해 ㅍ 의 VOT 가 필요 이상으로 길어진 것으로 보입니다. 즉 문제의 핵심은 ㅃ 의 '후두 긴장(목 안쪽 조임)'이라는 베트남어에 없는 동작이 아직 자리잡지 않은 데 있습니다.",
    "cause_vn": "Tiếng Việt không có hệ đối lập ba âm (thường·căng·bật hơi) như tiếng Hàn mà chỉ có hệ /b/-/p/, nên ㅂ và ㅃ rất dễ bị nhập làm một âm. Đồng thời, ý nghĩ 'ㅍ là phát mạnh' đã tạo bù trừ quá mức khiến VOT của ㅍ dài hơn cần thiết. Vấn đề cốt lõi là động tác 'siết thanh môn (căng cổ họng)' của ㅃ — vốn không có trong tiếng Việt — chưa hình thành.",
    "correction": {
      "main_focus": "ㅂ과 ㅃ 의 분리 — 특히 ㅃ 에서 입술을 한 박자 더 꽉 다물고 후두를 살짝 조였다가 짧고 단단하게 터뜨리는 동작을 만드는 것이 이 학습자의 가장 큰 한 가지 과제입니다.",
      "main_focus_vn": "Tách biệt ㅂ và ㅃ — đặc biệt ở ㅃ, hãy mím môi chặt thêm một nhịp, siết nhẹ thanh môn rồi bật ra ngắn và rắn — đây là điểm trọng tâm lớn nhất của bạn.",
      "steps": [
        "거울 앞에서 최소대립쌍 '바-빠-파'를 천천히 반복하며 입술 폐쇄 시간과 모양을 눈으로 확인하기.",
        "손바닥을 입 앞 10cm 에 두고 세 음의 바람 양 차이(ㅂ 거의 없음 / ㅃ 짧고 약함 / ㅍ 길고 강함)를 체감하며 발음하기.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 파형 첫 칸 너비와 시작 톤을 비교, 같은 baseline 으로 워밍업한 뒤 다시 녹음하기."
      ],
      "steps_vn": [
        "Trước gương, lặp chậm cặp tối thiểu '바-빠-파', vừa phát âm vừa quan sát thời gian và hình dạng mím môi.",
        "Đặt lòng bàn tay cách miệng 10cm và cảm nhận lượng hơi khác nhau giữa ba âm (ㅂ gần như không có / ㅃ ngắn và yếu / ㅍ dài và mạnh).",
        "Nghe luân phiên âm thanh của người bản xứ và bản ghi của bạn, so sánh độ rộng ô đầu sóng âm và tông khởi đầu, khởi động giọng với baseline của chính mình rồi ghi lại."
      ]
    },
    "overall": "현재는 평음 ㅂ과 경음 ㅃ이 거의 동일하게 묶여 있고 격음 ㅍ만 분리되어 있는, 베트남 학습자의 전형적인 2단계 상태입니다. 강점은 ㅍ 의 기식을 분명히 만들 수 있다는 점 — 호흡 조절 능력 자체는 충분히 갖춰져 있다는 신호입니다. 다음 단계는 그 기식을 살짝 줄이는 동시에 ㅃ 에 '후두 긴장 + 짧은 폐쇄' 동작을 더해 ㅂ 과 떼어내는 일이며, 이것만 자리잡으면 위계가 빠르게 살아날 것입니다. F0 패턴이 원어민보다 다소 높게 시작되는 경향도 보이지만 위계 자체는 빠르다>바지로 나타나 방향성은 옳습니다.",
    "overall_vn": "Hiện tại ㅂ và ㅃ gần như được nhóm chung làm một, chỉ có ㅍ tách ra — đây là trạng thái 2 bậc điển hình của người học Việt Nam. Điểm mạnh là bạn tạo được hơi bật rõ ràng ở ㅍ — dấu hiệu cho thấy khả năng kiểm soát hơi thở của bạn đã đủ. Bước tiếp theo là giảm bớt hơi bật đó một chút, đồng thời thêm động tác 'siết thanh môn + mím môi ngắn' cho ㅃ để tách khỏi ㅂ; chỉ cần điều này ổn định thì hệ thứ bậc sẽ nhanh chóng hiện ra. Pattern F0 có khuynh hướng khởi đầu hơi cao hơn người bản xứ, nhưng thứ bậc thực tế là 빠르다 > 바지 nên hướng đi đã đúng.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 VOT 가 9ms 로 측정되어 파형 첫 칸이 거의 보이지 않을 정도로 짧게 나타납니다 — 평음이라기보다 경음에 가까운 시작입니다. 모음 ㅏ의 pattern_st 는 -1.8 로 원어민 -3.7 보다 +1.9 semitone 위에 있어, 파란 F0 곡선이 baseline 보다 살짝 높게 출발하는 모습입니다. 입술을 너무 단단하게 다물지 말고 살짝 느슨하게 닫았다가 부드럽게 열어주세요 — 손바닥에 바람이 거의 느껴지지 않는 정도면 평음 영역에 들어옵니다. 모음은 평소 말할 때의 자연스러운 톤으로 시작해 파란 곡선을 조금 낮춰주는 연습이 효과적입니다.",
      "baji_vn": "VOT của 바지 đo được 9ms, ô đầu sóng âm gần như không nhìn thấy được — khởi đầu này gần với âm căng hơn là âm thường. Pattern_st của nguyên âm ㅏ là -1.8, cao hơn người bản xứ (-3.7) đến +1.9 semitone, đường F0 màu xanh xuất phát hơi cao hơn baseline. Đừng mím môi quá chặt — hãy khép môi lỏng nhẹ rồi mở ra dịu dàng, sao cho lòng bàn tay gần như không cảm thấy hơi, lúc đó bạn đã vào vùng âm thường. Nguyên âm nên bắt đầu bằng tông tự nhiên khi nói bình thường để hạ đường cong xanh xuống một chút.",
      "bbareuda": "빠르다의 VOT 는 11ms 로 바지(9ms)와 거의 같은 짧은 첫 칸을 보입니다 — 측정상으로는 두 단어가 거의 구분되지 않습니다. 모음 ㅏ의 pattern_st 는 +1.6 으로 원어민 -0.4 보다 +2.0 semitone 위에 있어 톤은 충분히 높게 시작되고 있어요. 핵심은 입술 폐쇄와 후두 긴장 — 발음 직전 입술을 한 박자 더 꽉 다물고 목 안쪽을 살짝 조였다가 짧고 단단하게 터뜨려 보세요. '뽀뽀' 처럼 입술을 압축했다가 톡 떼는 느낌을 ㅃ 에 그대로 옮기면 VOT 는 짧게 유지하면서도 평음과 분리된 단단한 시작이 만들어집니다.",
      "bbareuda_vn": "VOT của 빠르다 là 11ms, ô đầu sóng âm gần như giống hệt 바지(9ms) — về mặt đo lường, hai từ gần như không phân biệt. Pattern_st của ㅏ là +1.6, cao hơn người bản xứ (-0.4) đến +2.0 semitone — tông khởi đầu đã đủ cao. Điểm cốt lõi là mím môi và siết thanh môn — ngay trước khi phát âm, hãy mím môi chặt thêm một nhịp, siết nhẹ phía trong cổ họng rồi bật ra ngắn và rắn. Hãy mang cảm giác 'nén môi rồi bật tách' giống như khi nói '뽀뽀' vào ㅃ — VOT vẫn giữ ngắn nhưng khởi đầu sẽ rắn chắc và tách khỏi âm thường.",
      "paransaek": "파란색의 VOT 는 107ms 로 원어민 60ms 보다 47ms 길게 나타나, 파형의 첫 칸(기식 구간)이 모음 영역까지 길게 끌리는 모습입니다 — 격음을 만들겠다는 의식이 다소 과해진 인상입니다. 모음 ㅏ의 F0 는 측정에 잡히지 않아(f0_a_missing) 톤은 단정하기 어렵지만, 기식이 길어진 만큼 모음 시작이 늦어지면서 곡선 자체가 짧아진 가능성이 있습니다. 손바닥을 입 앞에 두고 '강하게 한 번 훅'이 아니라 '짧고 분명한 훅'으로 바꿔 보세요 — VOT 를 80ms 부근까지 줄이면 격음의 또렷함은 유지하면서 모음이 더 살아납니다. ㅍ 은 이미 ㅂ·ㅃ 과 분명히 분리되는 강점이니, 길이만 조금 다듬으면 됩니다.",
      "paransaek_vn": "VOT của 파란색 là 107ms, dài hơn người bản xứ (60ms) đến 47ms — ô đầu sóng âm (đoạn bật hơi) bị kéo dài đến tận vùng nguyên âm, cho thấy ý thức 'phải tạo bật hơi' đã hơi quá. F0 của ㅏ không đo được (f0_a_missing) nên chưa thể khẳng định về tông, nhưng vì đoạn bật hơi dài nên nguyên âm bắt đầu muộn, đường cong có thể bị ngắn lại. Đặt lòng bàn tay trước miệng và chuyển từ 'một hơi thật mạnh' sang 'một hơi ngắn và rõ' — nếu giảm VOT về khoảng 80ms, độ rõ của âm bật hơi vẫn giữ được mà nguyên âm sẽ sống lại. ㅍ vốn đã tách rõ khỏi ㅂ·ㅃ, đây là điểm mạnh — bạn chỉ cần tinh chỉnh độ dài thôi."
    },
    "encouragement": "격음 ㅍ을 또렷이 만들 수 있다는 건 이미 호흡 조절이 잘 된다는 증거예요 — 이제 ㅃ 의 후두 긴장 하나만 더해지면 세 음이 멋지게 살아납니다!",
    "encouragement_vn": "Việc bạn tạo được ㅍ rõ ràng đã chứng minh khả năng điều khiển hơi thở của bạn rất tốt — chỉ cần thêm động tác siết thanh môn cho ㅃ là cả ba âm sẽ bừng sáng!",
    "_source": "claude"
