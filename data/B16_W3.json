  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 모두 VOT가 길어지는 방향으로 치우쳐 세 음의 간격이 좁아진 패턴입니다.",
      "summary_vn": "Cả ba âm 평음·경음·격음 đều có xu hướng VOT dài hơn chuẩn, khiến khoảng cách giữa ba âm bị thu hẹp.",
      "detail": "가방(ㄱ)의 VOT가 91ms로 원어민 63ms보다 약 28ms 길게 나타나 평음이 격음 쪽으로 끌려가고 있습니다. 까만색(ㄲ)은 29ms로 원어민 8ms 대비 약 21ms 길어 후두 긴장이 충분히 잡히지 않은 인상입니다. 카드(ㅋ)는 145ms로 원어민 83ms의 거의 두 배에 달해 기식은 풍부하지만 과하게 길어진 상태입니다. F0 위계는 평음 -2.8 st, 경음 +2.4 st 로 평음<경음 패턴 자체는 살아 있어 음높이 감각의 기반은 형성되어 있습니다.",
      "detail_vn": "가방(ㄱ) có VOT 91ms, dài hơn người bản xứ (63ms) khoảng 28ms, khiến 평음 bị kéo về phía 격음. 까만색(ㄲ) là 29ms so với 8ms của người bản xứ, dài hơn khoảng 21ms, cho thấy độ căng thanh hầu chưa đủ. 카드(ㅋ) lên tới 145ms, gần gấp đôi 83ms của người bản xứ — luồng hơi dồi dào nhưng kéo dài quá mức. Về F0, 평음 -2.8 st và 경음 +2.4 st cho thấy thứ tự 평음<경음 vẫn được giữ, nghĩa là cảm giác cao độ đã có nền tảng."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 모든 파열음을 '길고 분명하게' 발음하려는 보상 전략이 자주 나타납니다. 그 결과 평음의 짧은 VOT와 경음의 후두 긴장이 충분히 구현되지 못하고, 격음은 오히려 과장되어 세 음 사이의 상대적 간격이 무너집니다.",
    "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba bậc 평음·경음·격음 như tiếng Hàn, nên người học thường dùng chiến lược bù trừ là phát âm 'dài và rõ' cho mọi âm bật. Hệ quả là VOT ngắn của 평음 và độ căng thanh hầu của 경음 không được hiện thực hóa đầy đủ, còn 격음 lại bị kéo dài quá mức, làm sụp đổ khoảng cách tương đối giữa ba âm.",
    "correction": {
      "main_focus": "세 음의 VOT 간격을 '짧음-매우 짧음-매우 김'의 세 단계로 명확히 분리하는 감각 회복이 가장 중요합니다.",
      "main_focus_vn": "Điều quan trọng nhất là khôi phục cảm giác phân tách rõ ràng VOT của ba âm theo ba mức: 'ngắn — rất ngắn — rất dài'.",
      "steps": [
        "손바닥을 입 앞 10cm에 두고 평음·경음·격음을 차례로 발음하며 바람 양의 차이를 손으로 체감하기",
        "최소대립쌍(가-까-카)을 느린 속도로 반복하며 한 음에서 다음 음으로 넘어갈 때 입의 긴장도 변화를 의식하기",
        "원어민 음원과 본인 녹음을 번갈아 들으며 세 음 사이의 '간격'이 균등하게 벌어졌는지 귀로 점검하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm, lần lượt phát âm 평음·경음·격음 và cảm nhận sự khác biệt về lượng hơi bằng tay",
        "Lặp lại cặp đối lập tối thiểu (가-까-카) ở tốc độ chậm, chú ý sự thay đổi độ căng của miệng khi chuyển từ âm này sang âm khác",
        "Nghe xen kẽ giọng người bản xứ và bản ghi của mình, kiểm tra bằng tai xem 'khoảng cách' giữa ba âm có giãn ra đều nhau không"
      ]
    },
    "overall": "세 음 모두에서 VOT가 길어지는 일관된 경향이 보이지만, 평음<경음의 F0 위계가 살아 있다는 점은 분명한 강점입니다. 가장 시급한 과제는 평음 ㄱ의 VOT를 짧게 끊는 감각과 경음 ㄲ의 후두 긴장 강화이며, 격음 ㅋ은 오히려 약간 줄여야 균형이 잡힙니다. 음높이 감각이 이미 형성된 만큼, VOT 길이만 다듬으면 세 음의 구분이 빠르게 또렷해질 가능성이 큽니다.",
    "overall_vn": "Cả ba âm đều có xu hướng VOT dài, nhưng thứ tự F0 평음<경음 vẫn được giữ — đây là một điểm mạnh rõ rệt. Nhiệm vụ cấp thiết nhất là cảm giác ngắt ngắn VOT của 평음 ㄱ và tăng độ căng thanh hầu cho 경음 ㄲ, còn 격음 ㅋ thì cần rút bớt một chút để cân bằng. Vì cảm giác cao độ đã hình thành, chỉ cần điều chỉnh độ dài VOT là sự phân biệt ba âm sẽ nhanh chóng trở nên rõ ràng.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방(ㄱ)은 VOT 91ms로 원어민 63ms보다 28ms 길어, nặng 왼쪽 평음 영역에 머물러야 할 좌표가 오른쪽 bật hơi 방향으로 끌려간 상태입니다. F0는 -2.8 st로 본인 baseline 아래 huyền 영역에 잘 가라앉아 있어 음높이 축은 제자리에 있습니다. 다만 가로축에서 격음 영역으로 새어 나가고 있으니, 'ㄱ'을 발음할 때 입술을 떼자마자 모음을 바로 시작한다는 느낌으로 VOT를 짧게 끊어주세요. 손바닥에 바람이 거의 느껴지지 않을 정도가 평음의 좌표입니다.",
      "gabang_vn": "가방(ㄱ) có VOT 91ms, dài hơn 63ms của người bản xứ 28ms — tọa độ lẽ ra phải nằm ở vùng 평음 bên trái nặng lại đang bị kéo sang phía bật hơi bên phải. F0 ở -2.8 st, chìm tốt xuống vùng huyền dưới baseline của chính bạn, nên trục cao độ đã đúng vị trí. Vấn đề là trục ngang đang rò rỉ sang vùng 격음 — khi phát âm 'ㄱ', hãy ngắt VOT thật ngắn với cảm giác bắt đầu nguyên âm ngay khi môi vừa mở. Tọa độ 평음 đúng là khi lòng bàn tay gần như không cảm nhận được hơi.",
      "ggamansaek": "까만색(ㄲ)은 VOT 29ms로 원어민 8ms보다 21ms 길어, 좌표가 가장 왼쪽 nặng 깊은 영역에 닿지 못하고 가운데 쪽으로 떠 있습니다. F0는 +2.4 st로 본인 baseline 위쪽 sắc 영역에 잘 올라가 있어 세로축은 경음의 위치를 정확히 잡고 있습니다. 다만 좌표를 더 왼쪽으로 끌어오려면 'ㄲ' 직전에 목구멍을 살짝 조이고 숨을 한 박자 멈춘 뒤 터뜨리는 느낌이 필요합니다. 후두 긴장이 들어가면 VOT가 자연스럽게 한 자릿수까지 짧아집니다.",
      "ggamansaek_vn": "까만색(ㄲ) có VOT 29ms, dài hơn 8ms của người bản xứ 21ms — tọa độ chưa chạm tới vùng nặng sâu nhất bên trái mà đang lơ lửng ở giữa. F0 ở +2.4 st, lên tốt vùng sắc phía trên baseline của bạn, nghĩa là trục dọc đã định vị 경음 chính xác. Để kéo tọa độ về bên trái hơn, ngay trước 'ㄲ' cần khẽ siết cổ họng, nín hơi một nhịp rồi mới bật ra. Khi có độ căng thanh hầu, VOT sẽ tự nhiên rút xuống chỉ còn một chữ số.",
      "kadeu": "카드(ㅋ)는 VOT 145ms로 원어민 83ms의 거의 두 배에 달해, 좌표가 bật hơi 오른쪽 영역을 한참 지나쳐 끝으로 밀려나 있습니다. F0 측정이 누락되어 세로축은 추정이 필요하지만, T3 유형의 경향상 격음의 음높이 시작이 아직 충분히 올라가지 않았을 인상이 있습니다. 가로축은 오히려 너무 멀리 갔으니 손바닥에 닿는 바람의 길이를 절반 정도로 줄이고, 대신 'ㅏ' 모음의 시작 음높이를 평음보다 분명히 높게 잡아 세로축으로 이동시키세요. 격음의 정체성은 '바람의 길이'가 아니라 '바람+높은 음 시작'의 조합에서 나옵니다.",
      "kadeu_vn": "카드(ㅋ) có VOT 145ms, gần gấp đôi 83ms của người bản xứ — tọa độ đã vượt qua vùng bật hơi bên phải và bị đẩy ra tận cùng. Do thiếu đo F0 nên trục dọc phải ước lượng, nhưng theo xu hướng kiểu T3, có ấn tượng rằng cao độ khởi đầu của 격음 vẫn chưa được nâng đủ. Trục ngang đang đi quá xa, hãy rút độ dài luồng hơi chạm vào lòng bàn tay còn khoảng một nửa, đồng thời nâng rõ cao độ khởi đầu của nguyên âm 'ㄏ' cao hơn 평음 để dịch chuyển theo trục dọc. Bản sắc của 격음 không nằm ở 'độ dài luồng hơi' mà ở sự kết hợp 'luồng hơi + cao độ khởi đầu cao'.",
      "kadeu_vn_note": ""
    },
    "encouragement": "음높이 위계가 이미 자리잡혀 있다는 점은 큰 자산이니, VOT만 다듬으면 세 음의 색깔이 빠르게 또렷해질 거예요.",
    "encouragement_vn": "Việc thứ tự cao độ đã được thiết lập là một tài sản lớn — chỉ cần tinh chỉnh VOT, màu sắc của ba âm sẽ nhanh chóng trở nên rõ ràng.",
