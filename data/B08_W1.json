  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 어느 정도 구분되지만, 평음 ㅂ과 경음 ㅃ이 거의 같은 무기식 영역에 모여 위계가 평탄해진 상태입니다.",
      "summary_vn": "ㅍ (âm bật hơi) đã được phân biệt phần nào, nhưng ㅂ (âm thường) và ㅃ (âm căng) gần như nằm chung một vùng không bật hơi, khiến hệ thống ba bậc bị san phẳng.",
      "detail": "바지(ㅂ)의 VOT가 0ms, 빠르다(ㅃ)의 VOT가 6ms로 두 음의 VOT 거리가 6ms에 불과해 청자에게는 거의 같은 소리로 들립니다. 파란색(ㅍ)은 VOT 43ms로 원어민의 60ms보다 짧지만 평음·경음과는 분명히 구분되는 위치를 잡았습니다. F0 패턴(semitone)을 보면 ㅂ -3.4 / ㅃ +1.2 / ㅍ +1.8 로 ‘평음 낮음 → 경음·격음 높음’ 위계 자체는 살아있어, 음의 ‘방향 감각’은 이미 갖추어졌습니다. 다만 ㅃ과 ㅍ의 F0 차이가 0.6 st밖에 안 되어 위쪽 두 음의 톤 분리도 다소 흐립니다.",
      "detail_vn": "VOT của 바지(ㅂ) là 0ms và 빠르다(ㅃ) là 6ms — khoảng cách chỉ 6ms khiến người nghe gần như nghe thành cùng một âm. 파란색(ㅍ) có VOT 43ms, ngắn hơn người bản ngữ (60ms) nhưng vẫn tách bạch rõ với hai âm còn lại. Về F0 pattern (semitone): ㅂ -3.4 / ㅃ +1.2 / ㅍ +1.8 — thứ tự ‘âm thường thấp → âm căng và bật hơi cao’ đã hình thành, tức cảm giác ‘hướng cao thấp’ của âm đã có. Tuy nhiên ㅃ và ㅍ chỉ cách nhau 0,6 st nên hai âm phía trên còn hơi gần nhau về cao độ.",
      "detail_vn_": ""
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고 무기식 /b/ 한 종류로 흡수되기 때문에, ㅂ과 ㅃ이 같은 베트남어 /b/ 영역으로 모이게 됩니다. 특히 경음 ㅃ에 필요한 ‘후두를 단단히 조이며 입술을 한 박자 더 꽉 다물었다 짧게 터뜨리는’ 동작이 베트남어에는 존재하지 않아, ㅃ이 평음과 같은 무기식 영역으로 굳어진 것입니다. 반면 ㅍ은 강한 기식이라는 청각적 단서가 뚜렷해 베트남 학습자도 비교적 일찍 잡아내는 편이며, 이 학습자도 그 경향을 그대로 보여줍니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc平/căng/bật hơi như tiếng Hàn, mà chỉ có một âm /b/ không bật hơi, nên cả ㅂ và ㅃ đều bị hút về vùng /b/ tiếng Việt. Đặc biệt động tác cần thiết cho ㅃ — ‘siết chặt thanh quản, mím môi thêm một nhịp rồi bật ra ngắn và chắc’ — không tồn tại trong tiếng Việt, nên ㅃ bị cố định ở vùng không bật hơi giống ㅂ. Ngược lại, ㅍ có tín hiệu bật hơi mạnh rất rõ nên người Việt học tiếng Hàn thường nắm được sớm, và bạn đang thể hiện đúng xu hướng đó.",
    "correction": {
      "main_focus": "이번 단계의 최우선 과제는 ㅂ과 ㅃ을 ‘무기식 한 덩어리’에서 ‘부드러운 ㅂ’과 ‘짧고 단단한 ㅃ’ 두 개로 갈라내는 것입니다.",
      "main_focus_vn": "Mục tiêu quan trọng nhất ở giai đoạn này là tách ㅂ và ㅃ — vốn đang nằm chung một khối ‘không bật hơi’ — thành hai âm rõ ràng: ㅂ ‘mềm, thả lỏng’ và ㅃ ‘ngắn, căng, chắc’.",
      "steps": [
        "손바닥을 입 앞 5cm에 대고 ‘바-빠-파’ 최소대립쌍을 천천히 발음하며, 바람이 거의 없음(바) → 바람 없지만 입술이 ‘툭’(빠) → 바람 확 터짐(파) 세 가지 촉감 차이를 직접 확인하세요.",
        "거울 앞에서 ㅃ 발음 직전에 입술을 한 박자 더 꽉 다물고 목 안쪽을 살짝 조였다가 짧게 터뜨리는 동작을 분리 연습한 뒤, 같은 동작에 모음을 살짝 더 높은 톤으로 얹어 ㅂ과 톤·긴장 모두에서 거리를 벌리세요.",
        "원어민 음원과 본인 녹음을 한 문장씩 번갈아 들으며 ㅂ-ㅃ 쌍이 정말 ‘다른 두 소리’로 들리는지 귀로 점검하고, 안 들리면 step 1·2로 돌아가 다시 녹음하세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm và phát âm chậm cặp tối thiểu ‘바-빠-파’: cảm nhận trực tiếp ba mức hơi — gần như không có hơi (바) → không có hơi nhưng môi bật ‘tách’ (빠) → hơi bung mạnh (파).",
        "Đứng trước gương, trước khi phát âm ㅃ hãy mím môi chặt thêm một nhịp và siết nhẹ phía trong cổ họng rồi bật ra thật ngắn; sau đó thêm nguyên âm với cao độ hơi cao hơn một chút để ㅃ tách khỏi ㅂ cả về độ căng lẫn cao độ.",
        "Nghe xen kẽ từng câu của người bản ngữ và bản ghi âm của chính bạn, kiểm tra bằng tai xem cặp ㅂ-ㅃ có thực sự nghe thành ‘hai âm khác nhau’ không; nếu chưa, quay lại bước 1·2 và ghi âm lại."
      ]
    },
    "overall": "전체적으로 ‘평음 낮음 → 경음·격음 높음’이라는 한국어 위계의 큰 방향은 이미 잡혔고, 격음 ㅍ은 위치와 톤 모두 원어민에 꽤 가까워 강점으로 활용할 수 있는 단계입니다. 다만 평음 ㅂ과 경음 ㅃ의 VOT 차이가 6ms에 그쳐, 한국인 청자에게는 두 음이 거의 같은 소리로 들리는 점이 가장 큰 과제입니다. F0 위계가 살아있다는 것은 ‘귀’가 이미 한국어 체계를 받아들이기 시작했다는 신호이므로, 이제 입과 후두의 동작 차이만 보태면 됩니다. 다음 단계는 ㅍ을 기준점(anchor)으로 삼아 ㅃ을 ㅂ에서 떼어내는 작업입니다.",
    "overall_vn": "Nhìn tổng thể, hướng lớn của hệ thống tiếng Hàn — ‘âm thường thấp → âm căng/bật hơi cao’ — đã hình thành ở bạn, và ㅍ (bật hơi) đang khá gần người bản ngữ cả về vị trí lẫn cao độ, có thể coi là điểm mạnh để khai thác. Vấn đề lớn nhất là khoảng cách VOT giữa ㅂ và ㅃ chỉ 6ms, khiến người Hàn nghe thấy gần như cùng một âm. Việc F0 đã có đúng thứ tự cho thấy ‘tai’ của bạn đã bắt đầu tiếp nhận hệ thống tiếng Hàn, giờ chỉ cần bổ sung sự khác biệt ở miệng và thanh quản. Bước tiếp theo là lấy ㅍ làm điểm neo (anchor) và tách ㅃ ra khỏi ㅂ.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 ㅂ은 나침반 상에서 nặng(왼쪽) 깊숙이, 그리고 본인 baseline보다 -3.4 st 아래(huyền 방향)로 내려가 있어 위치 자체는 평음의 ‘아래–왼쪽’ 영역에 잘 맞춰져 있습니다. VOT 0ms는 원어민의 97ms와 차이가 크지만, 평음의 핵심은 ‘짧은 VOT + 낮은 톤’이라 위치상으로는 오히려 평음다움이 잘 살아 있습니다. 다만 너무 왼쪽 끝까지 들어가 ㅃ과 겹쳐 있는 것이 문제이므로, ㅂ은 지금 위치에서 거의 움직이지 말고 ‘부드럽게, 모음 톤을 살짝만 낮춰’ 유지하면서 ㅃ 쪽이 위·오른쪽으로 떨어져 나가도록 두는 전략이 좋습니다. 입술 긴장은 빼고, 시작 톤은 자연스러운 baseline보다 살짝 낮게.",
      "baji_vn": "Trong la bàn phát âm, ㅂ của 바지 nằm sâu về phía nặng (bên trái) và thấp hơn baseline của bạn -3,4 st (hướng huyền), tức đã đúng vùng ‘dưới – bên trái’ của âm thường. VOT 0ms chênh nhiều so với người bản ngữ (97ms), nhưng do bản chất âm thường là ‘VOT ngắn + cao độ thấp’, vị trí này thực ra khá đúng chất ‘평음’. Vấn đề chỉ là bạn đi quá sát mép trái nên chồng lên ㅃ; chiến lược tốt là giữ ㅂ gần như không di chuyển — ‘mềm, hạ cao độ nguyên âm xuống một chút thôi’ — để ㅃ tách lên trên và sang phải. Thả lỏng môi, bắt đầu nguyên âm hơi thấp hơn baseline tự nhiên một chút.",
      "bbareuda": "빠르다의 ㅃ은 지금 나침반 상에서 ㅂ과 거의 같은 nặng(왼쪽) 자리에 머물러 있고(VOT 6ms), 위쪽으로는 baseline 대비 +1.2 st만 떠 있어 본인의 평음(-3.4 st)에서 위로 약 4.6 st 올라가긴 했지만 격음 ㅍ(+1.8 st)과는 0.6 st 차이밖에 안 됩니다. 즉 좌표상 ‘왼쪽 위’ — ㅃ이 있어야 할 정확한 자리 — 인데, 왼쪽으로 충분히 깊지 않고 위쪽으로도 ㅍ과 너무 가까워 ‘위쪽 두 음끼리 또 뭉치는’ 새로운 문제가 보이기 시작합니다. 입술을 ㅂ보다 한 박자 더 꽉 다물어 더 왼쪽으로 밀고, 후두를 살짝 조여 톤을 한 단계 더 또렷이 올린 뒤 ‘짧고 단단하게’ 끊어 터뜨리세요. 바람은 거의 새지 않아야 합니다(오른쪽으로 가면 ㅍ).",
      "bbareuda_vn": "Trên la bàn, ㅃ của 빠르다 đang gần như nằm cùng vị trí với ㅂ ở vùng nặng (bên trái, VOT 6ms); về cao độ chỉ cao hơn baseline +1,2 st, tức đã nhô lên khoảng 4,6 st so với âm thường (-3,4 st) nhưng chỉ cách ㅍ (+1,8 st) đúng 0,6 st. Tọa độ ‘trên – trái’ này chính là vị trí đúng của ㅃ, nhưng bạn chưa đủ sâu về bên trái và lại quá gần ㅍ phía trên, nên bắt đầu nảy ra vấn đề mới: hai âm phía trên dính vào nhau. Hãy mím môi chặt hơn ㅂ thêm một nhịp để đẩy sang trái hơn nữa, đồng thời siết nhẹ thanh quản để cao độ rõ lên một bậc, rồi bật ra ‘ngắn và chắc’. Hầu như không được có hơi bật ra (có hơi là rơi sang phải, thành ㅍ).",
      "paransaek": "파란색의 ㅍ은 나침반에서 bật hơi(오른쪽, VOT 43ms)와 sắc(위, +1.8 st)의 ‘오른쪽 위’ 영역에 안정적으로 자리 잡아, 이번 세 단어 중 원어민 클러스터에 가장 가깝게 들어와 있습니다. 다만 VOT가 원어민(60ms)보다 17ms 짧고 F0도 -1.6 st 낮아 클러스터의 살짝 안쪽 가장자리에 있는 모양이라, 좌표를 오른쪽·위로 한 칸씩만 더 밀어주면 됩니다. 입 앞에 손바닥을 대고 ‘하-’ 하는 바람이 분명히 느껴질 만큼 기식을 더 길게 빼고, 그 강한 숨에 실려 모음 첫 부분이 자연스럽게 더 높이 시작되도록 두세요. 지금처럼 ‘오른쪽 위 영역’에 자리 잡은 ㅍ을 anchor 로 삼아 ㅃ을 그 왼쪽으로 분리해내는 것이 다음 단계 전략입니다.",
      "paransaek_vn": "Trên la bàn, ㅍ của 파란색 đã định vị ổn định ở vùng ‘phải – trên’: bật hơi (bên phải, VOT 43ms) và sắc (phía trên, +1,8 st), gần cụm người bản ngữ nhất trong ba từ hôm nay. Chỉ có điều VOT ngắn hơn người bản ngữ 17ms và F0 thấp hơn 1,6 st nên bạn đang ở rìa trong của cụm; chỉ cần đẩy tọa độ thêm một nấc sang phải và lên trên là vừa. Đặt lòng bàn tay trước miệng và kéo hơi ‘ha-’ dài hơn cho đến khi cảm nhận luồng hơi rõ ràng, rồi để nguyên âm tự nhiên bắt đầu cao hơn nhờ luồng hơi mạnh đó. Hãy dùng chính ㅍ đang nằm đúng ‘phải – trên’ này làm điểm neo (anchor), rồi tách ㅃ sang bên trái của nó — đó là chiến lược cho bước tiếp theo."
    },
    "encouragement": "F0 위계와 ㅍ의 위치가 이미 한국어 쪽으로 와 있다는 건 ‘귀와 감각’이 자라고 있다는 강력한 신호예요 — 이제 ㅃ 하나만 떼어내면 풍경이 확 달라집니다!",
    "encouragement_vn": "Thứ tự F0 và vị trí của ㅍ đã nghiêng hẳn về phía tiếng Hàn — đó là tín hiệu rõ ràng rằng ‘tai và cảm giác’ của bạn đang lớn lên; giờ chỉ cần tách riêng ㅃ ra là cả bức tranh sẽ thay đổi hẳn!",
    "_source": "claude"
  },
