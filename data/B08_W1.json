  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 비교적 구분되지만 평음 ㅂ과 경음 ㅃ이 모두 베트남어 /b/ 영역으로 흡수되어 셋의 위계가 평탄해진 상태입니다.",
      "summary_vn": "Âm bật hơi ㅍ tương đối phân biệt được, nhưng âm thường ㅂ và âm căng ㅃ đều bị hút về vùng /b/ tiếng Việt, khiến hệ thống ba bậc trở nên phẳng.",
      "detail": "바지의 VOT가 0ms로 측정되어 한국어 평음의 평균(약 20ms)보다 짧고, 빠르다의 VOT는 6ms로 경음 범위에 들어와 있지만 바지와의 차이가 단 6ms뿐이라 두 음소가 사실상 같은 자리에 겹쳐 있습니다. 파란색의 VOT 43ms는 격음 기준(약 80ms)에는 못 미치지만 평음·경음과는 분명히 분리되어 있어 격음의 정체성은 살아 있습니다. F0 pattern_st를 보면 빠르다는 +1.6 st로 본인 baseline 위로 올라가 있지만 파란색은 -1.6 st로 오히려 baseline 아래에 머물러, 위계가 '평음(-3.4) < 격음(1.8) < 경음(1.2)' 처럼 격음과 경음의 톤 위계가 뒤바뀐 양상입니다.",
      "detail_vn": "바지 có VOT đo được 0ms, ngắn hơn mức trung bình của âm thường tiếng Hàn (~20ms); 빠르다 có VOT 6ms nằm trong vùng âm căng, nhưng chỉ cách 바지 đúng 6ms nên hai âm vị trên thực tế chồng lên nhau cùng một vị trí. VOT của 파란색 là 43ms, chưa đạt chuẩn âm bật hơi (~80ms) nhưng đã tách rõ khỏi nhóm âm thường·âm căng, nên bản sắc âm bật hơi vẫn còn. Về F0 pattern_st, 빠르다 lên +1.6 st so với baseline của người học, còn 파란색 lại tụt xuống -1.6 st, khiến trật tự cao độ trở thành 'âm thường(-3.4) < âm bật hơi(1.8) < âm căng(1.2)' — vị trí của âm bật hơi và âm căng bị đảo ngược."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 학습자에게 가장 익숙한 베트남어 /b/가 평음·경음 영역을 모두 흡수합니다. 특히 경음의 후두 긴장(thanh quản căng cứng)은 베트남어에 존재하지 않는 동작이라 자연스럽게 평음과 같은 음가로 굳어지며, 격음의 강한 기식은 베트남어 /pʰ/와 어느 정도 대응되어 그나마 분리되어 들립니다. 또한 한국어 화자는 격음을 평음보다 톤을 높여 시작하는 경향이 있는데, 학습자에게는 이 '격음=고음 시작' 연결이 아직 정착되지 않아 격음의 F0가 오히려 낮게 나타났습니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc âm thường·âm căng·âm bật hơi như tiếng Hàn, và âm /b/ tiếng Việt quen thuộc nhất với người học đã hút trọn cả vùng âm thường lẫn âm căng. Đặc biệt, động tác căng cứng thanh quản của âm căng vốn không tồn tại trong tiếng Việt nên dễ bị định hình giống hệt âm thường; trong khi đó, luồng hơi mạnh của âm bật hơi tương ứng phần nào với /pʰ/ tiếng Việt nên còn tách ra được. Ngoài ra, người Hàn thường khởi đầu âm bật hơi với cao độ cao hơn âm thường, nhưng liên kết 'âm bật hơi = khởi đầu cao' chưa hình thành ở người học, nên F0 của 파란색 lại bị hạ xuống.",
    "correction": {
      "main_focus": "평음 ㅂ과 경음 ㅃ을 분리하는 것 — 특히 ㅃ에서 입술을 한 박자 더 꽉 다물었다가 짧고 단단하게 터뜨리는 후두 긴장을 몸에 익히는 것이 최우선입니다.",
      "main_focus_vn": "Tách biệt âm thường ㅂ và âm căng ㅃ — đặc biệt ưu tiên rèn động tác mím chặt môi thêm một nhịp rồi bật ra ngắn và cứng để cảm nhận sự căng cứng của thanh quản ở ㅃ.",
      "steps": [
        "최소대립쌍 '바-빠-파'를 거울 앞에서 입 모양을 확인하며 천천히 반복하고, 셋의 입술 긴장도와 터지는 세기 차이를 시각적으로 점검하세요.",
        "손바닥을 입 앞 10cm에 두고 세 음을 발음하며 바람 양을 체감하기 — ㅂ은 거의 안 느껴지고, ㅃ은 짧고 단단한 압력, ㅍ은 강한 바람이 닿아야 합니다.",
        "원어민 음원을 듣고 본인 녹음을 번갈아 재생하며 모음 시작 부분의 톤(높낮이)을 귀로 비교하기 — 평음은 낮게, 경음·격음은 baseline보다 위로 시작합니다."
      ],
      "steps_vn": [
        "Lặp lại chậm cặp tối thiểu '바-빠-파' trước gương, quan sát hình dáng môi và kiểm tra trực quan độ căng môi cùng sức bật của ba âm.",
        "Đặt lòng bàn tay cách miệng khoảng 10cm và phát âm ba âm để cảm nhận lượng hơi — ㅂ gần như không có, ㅃ là áp lực ngắn và cứng, ㅍ phải có luồng hơi mạnh phả vào tay.",
        "Nghe xen kẽ bản gốc người bản ngữ và bản ghi của mình, so sánh bằng tai cao độ ở đầu nguyên âm — âm thường khởi đầu thấp, âm căng·âm bật hơi bắt đầu cao hơn baseline."
      ]
    },
    "overall": "현재 발음의 가장 큰 강점은 격음 ㅍ을 평음·경음과 분명히 분리해내고 있다는 점입니다 — VOT 43ms는 아직 원어민 수준(~80ms)에 못 미치지만 격음의 정체성은 확실히 살아 있어, 이 감각을 기준점으로 활용할 수 있습니다. 가장 시급한 과제는 ㅂ과 ㅃ을 분리하는 것으로, 두 음의 VOT 차이가 6ms에 불과해 사실상 같은 음으로 발음되고 있습니다. 경음의 후두 긴장은 베트남어에 없는 동작이라 처음에는 어색하겠지만, 입술을 더 꽉 다무는 작은 변화만으로도 위계가 빠르게 잡힙니다. 베트남 학습자가 흔히 겪는 단계이니 너무 자책하지 말고, 격음에서 이미 만든 감각을 평음·경음 분리에 옮겨오는 데 집중해 보세요.",
    "overall_vn": "Điểm mạnh lớn nhất trong cách phát âm hiện tại là bạn đã tách rõ âm bật hơi ㅍ khỏi âm thường·âm căng — VOT 43ms tuy chưa đạt mức người bản ngữ (~80ms) nhưng bản sắc của âm bật hơi vẫn rõ, có thể dùng làm điểm tựa. Nhiệm vụ cấp thiết nhất là tách ㅂ và ㅃ, vì chênh lệch VOT chỉ 6ms khiến hai âm thực tế phát ra gần như giống nhau. Động tác căng cứng thanh quản của âm căng vốn không có trong tiếng Việt nên ban đầu sẽ thấy lạ, nhưng chỉ cần thay đổi nhỏ là mím môi chặt hơn cũng đủ giúp trật tự ba bậc hình thành nhanh chóng. Đây là giai đoạn người Việt học tiếng Hàn nào cũng trải qua, đừng tự trách mình — hãy tập trung mang cảm giác bạn đã có ở âm bật hơi sang việc tách âm thường và âm căng.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지는 nặng 깊은 영역의 거의 끝자락(VOT 0ms)에 위치하면서 본인 baseline 대비 -3.4 st로 ngang 아래쪽 깊은 곳까지 가라앉아 있어, F0 패턴 자체는 평음다운 '아래쪽' 좌표를 잘 잡고 있습니다. 다만 nặng 축에서 너무 왼쪽 끝까지 가버려 원어민 평음 클러스터(VOT ~20ms, 약간 오른쪽 안쪽)보다 한참 바깥에 있고, 바로 옆에 있어야 할 빠르다와 거의 겹쳐 있는 것이 문제입니다. 좌표를 오른쪽으로 살짝 이동시켜 입술이 풀리는 순간 짧은 무성 구간을 한 박자만 더 두는 느낌으로 발음하면, 경음과의 간격이 자연스럽게 벌어집니다. 톤은 지금처럼 baseline 아래 부드럽게 유지하세요 — 이 부분은 이미 잘하고 있습니다.",
      "baji_vn": "바지 (cái quần) nằm gần cuối vùng nặng sâu (VOT 0ms) và tụt xuống tận -3.4 st so với baseline, tức là phía dưới ngang khá sâu, nên về mặt cao độ bạn đã chọn đúng vị trí 'phía dưới' của âm thường. Tuy nhiên trên trục nặng bạn đi quá xa về bên trái, nằm xa hẳn cụm âm thường của người bản ngữ (VOT ~20ms, hơi lệch sang phải), và gần như chồng lên 빠르다 đáng lẽ phải ở bên cạnh chứ không trùng. Hãy dịch tọa độ sang phải một chút, tạo thêm một nhịp khoảng lặng vô thanh ngắn ngay khi môi mở, khoảng cách với âm căng sẽ tự nới ra. Cao độ vẫn giữ nhẹ nhàng dưới baseline như hiện tại — phần này bạn đã làm rất tốt.",
      "bbareuda": "빠르다는 좌표상으로는 nặng 영역의 왼쪽(VOT 6ms)에 잘 들어와 있고 baseline보다 +1.2 st 위로 떠올라 sắc 쪽 위계도 어느 정도 잡혀 있지만, 바로 옆 칸에 있는 바지와 VOT가 6ms밖에 차이 나지 않아 두 좌표가 사실상 한 점에 뭉쳐 있는 것이 가장 큰 문제입니다. 나침반에서 ㅃ은 nặng 축의 끝까지 더 깊이 들어가야 하는데, 이는 VOT를 더 줄이라는 뜻이 아니라 입술을 한 박자 더 꽉 다물어 후두에 단단한 압력을 모은 뒤 짧고 단단하게 터뜨리라는 의미입니다. 톤은 지금 +1.2 st로 위쪽 방향을 맞췄으니, 거기에 후두 긴장만 더 얹으면 빠르다 좌표가 바지에서 분리되어 본래 자리(왼쪽 깊은 곳, 위쪽)로 옮겨갑니다.",
      "bbareuda_vn": "빠르다 (nhanh) về tọa độ thì đã nằm khá tốt ở phía trái vùng nặng (VOT 6ms) và cao hơn baseline +1.2 st, tức là đã chọn đúng hướng sắc phía trên, nhưng vấn đề lớn nhất là chỉ cách 바지 đúng 6ms VOT nên hai tọa độ gần như dồn vào một điểm. Trên la bàn, ㅃ cần đi sâu hơn nữa về phía trái trên trục nặng — không phải bằng cách giảm VOT thêm, mà bằng cách mím môi chặt thêm một nhịp để tích áp lực căng cứng ở thanh quản rồi bật ra ngắn và cứng. Cao độ bạn đã chỉnh đúng hướng lên +1.2 st rồi, chỉ cần cộng thêm động tác căng thanh quản là tọa độ 빠르다 sẽ tách khỏi 바지 và quay về đúng chỗ của nó (sâu bên trái, phía trên).",
      "paransaek": "파란색은 bật hơi 오른쪽 영역으로 분명히 진입해(VOT 43ms) 평음·경음 클러스터와 깔끔하게 분리된 좌표를 잡아냈고, 이는 이번 녹음 전체에서 가장 강력한 강점입니다. 다만 원어민 격음 클러스터(VOT ~80ms)보다 안쪽에 머물러 있고, 무엇보다 톤이 baseline +1.8 st로 sắc 쪽에 있긴 하지만 빠르다(+1.2 st)보다 위로 충분히 올라가지 못해 격음·경음의 톤 위계가 살짝 흐릿합니다. 손바닥에 닿는 바람이 ㅃ보다 확실히 더 세고 길게 느껴질 때까지 기식을 늘리고, 모음 ㅏ를 시작할 때 톤을 한 단계 더 위로 끌어올려 sắc 영역의 더 높은 자리로 좌표를 이동시켜 보세요. 격음 감각은 이미 자리 잡았으니 여기서 한 걸음만 더 가면 됩니다.",
      "paransaek_vn": "파란색 (màu xanh) đã đi rõ vào vùng bật hơi bên phải (VOT 43ms) và tách sạch khỏi cụm âm thường·âm căng, đây là điểm mạnh nổi bật nhất trong toàn bộ bản ghi này. Tuy nhiên tọa độ vẫn nằm phía trong so với cụm âm bật hơi của người bản ngữ (VOT ~80ms), và quan trọng hơn là cao độ chỉ ở mức baseline +1.8 st — đúng là đã thuộc vùng sắc nhưng chưa vượt lên cao hơn 빠르다 (+1.2 st), khiến trật tự cao độ giữa âm bật hơi và âm căng hơi mờ. Hãy kéo dài luồng hơi đến khi cảm nhận rõ bằng lòng bàn tay rằng gió mạnh và dài hơn hẳn so với ㅃ, đồng thời nâng cao độ đầu nguyên âm ㅏ lên thêm một bậc để tọa độ dịch lên vị trí cao hơn trong vùng sắc. Cảm giác âm bật hơi bạn đã có rồi, chỉ cần tiến thêm một bước nữa thôi."
    },
    "encouragement": "격음을 또렷이 살려낸 감각이 이미 손에 있으니, 그 감각을 ㅃ의 후두 긴장으로 옮겨오기만 하면 세 음의 위계가 빠르게 잡힐 거예요. 한 걸음씩 함께 가요!",
    "encouragement_vn": "Bạn đã có sẵn cảm giác để dựng rõ âm bật hơi rồi, chỉ cần chuyển cảm giác đó sang động tác căng thanh quản của ㅃ là trật tự ba bậc sẽ hình thành rất nhanh thôi. Mình đi từng bước cùng nhau nhé!",
    "_source": "claude"
