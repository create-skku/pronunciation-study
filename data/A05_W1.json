  "ai_feedback": {
    "error_analysis": {
      "summary": "격음은 기식이 과도하게 길고, 평음과 경음의 VOT·F0 위계가 거꾸로 뒤집혀 셋의 구분이 흐려진 상태입니다.",
      "summary_vn": "Âm bật hơi (격음) có hơi quá dài, còn trật tự VOT·F0 giữa 평음 và 경음 đang bị đảo ngược, khiến ba âm khó phân biệt.",
      "detail": "바지(ㅂ)의 VOT 가 38ms 로 원어민 97ms 보다 짧게 측정되어 파형 첫 칸이 좁게 보이고, 빠르다(ㅃ)는 21ms 로 원어민 0ms 보다 오히려 길어 평음 ㅂ 보다도 큰 값입니다. 즉 VOT 위계가 ㅃ(21) > ㅂ(38) 이어야 할 ㅂ > ㅃ 관계가 뒤집혀 두 음이 같은 영역에 머물러 있습니다. 파란색(ㅍ)은 VOT 181ms 로 원어민 60ms 의 약 3배에 달해 기식이 과하게 길게 터지고, 모음 시작 F0 도 +3.4 st 여야 할 자리에 +1.2 st 로 충분히 높지 않아 격음 특유의 '높고 단단한 시작'이 약합니다. F0 패턴(semitone)에서도 ㅂ(+2.1) 이 ㅃ(+0.6) 보다 높게 시작해, 평음<경음·격음의 정상 위계가 학습자에게서는 거의 평탄하거나 역전된 모습입니다.",
      "detail_vn": "바지(ㅂ) có VOT 38ms, ngắn hơn người bản ngữ (97ms), nên ô đầu của dạng sóng nhìn hẹp; còn 빠르다(ㅃ) lại đạt 21ms, dài hơn cả mức 0ms của người bản ngữ và thậm chí dài hơn ㅂ của chính bạn. Nghĩa là trật tự VOT đang bị đảo: lẽ ra ㅃ phải ngắn hơn ㅂ, nhưng ở đây ㅃ(21) > ㅂ(38) bị lật, làm hai âm rơi vào cùng một vùng. 파란색(ㅍ) có VOT 181ms, gấp khoảng 3 lần mức 60ms của người bản ngữ, hơi bật ra quá dài; đồng thời F0 đầu nguyên âm chỉ +1.2 st (đáng lẽ +3.4 st), nên thiếu cảm giác 'mở đầu cao và chắc' đặc trưng của 격음. Về mẫu F0 (semitone), ㅂ(+2.1) lại cao hơn ㅃ(+0.6), khiến trật tự bình thường 평음<경음·격음 ở bạn gần như phẳng hoặc bị đảo."
    },
    "cause": "베트남어에는 한국어식 평음/경음/격음 3중 구분이 없어, 학습자가 ㅂ과 ㅃ 을 모두 베트남어 /b/ 영역으로 흡수해 후두 긴장이 들어가지 않은 채 발음하고 있습니다. 반면 격음 ㅍ 은 '한국어다움'을 의식해 숨을 과도하게 길게 내보내며 보상하고 있어 VOT 가 원어민의 3배에 이릅니다. 결과적으로 ㅂ 은 약해서 ㅃ 쪽으로, ㅍ 은 과해서 위로 튀어 셋의 균형이 깨진 상태입니다.",
    "cause_vn": "Tiếng Việt không có hệ ba âm 평음/경음/격음 như tiếng Hàn, nên bạn đang hấp thụ cả ㅂ và ㅃ vào vùng /b/ tiếng Việt, phát âm mà không kèm căng thanh quản. Ngược lại, với 격음 ㅍ bạn cố gắng thể hiện 'chất Hàn' bằng cách đẩy hơi quá dài, khiến VOT gấp 3 lần người bản ngữ. Kết quả là ㅂ thì quá yếu nên trôi về phía ㅃ, còn ㅍ thì quá mạnh nên vọt lên trên, làm mất cân bằng giữa ba âm.",
    "correction": {
      "main_focus": "경음 ㅃ 의 후두 긴장과 짧고 단단한 폐쇄를 만들어 평음 ㅂ 과 분명히 분리하는 것이 이번 단계의 핵심입니다.",
      "main_focus_vn": "Trọng tâm giai đoạn này là tạo độ căng thanh quản và một cú khép môi ngắn–chắc cho 경음 ㅃ, để tách rõ nó khỏi 평음 ㅂ.",
      "steps": [
        "거울 앞에서 입 모양을 보며 평음–경음–격음을 천천히 발음하고, 손바닥을 입 앞 5cm 에 두어 바람 양의 차이를 직접 체감하기.",
        "최소대립쌍(바–빠–파)을 한 세트로 묶어 느리게 → 보통 속도 → 빠르게 단계적으로 반복하며 세 음이 서로 다른 자리에 놓이도록 연습하기.",
        "원어민 음원과 본인 녹음을 번갈아 듣고 PRAAT 파형의 첫 칸 너비·파란 F0 곡선의 시작 높이를 시각적으로 비교해 위계를 점검하기."
      ],
      "steps_vn": [
        "Đứng trước gương quan sát khẩu hình, phát âm chậm 평음–경음–격음, đồng thời đặt lòng bàn tay cách miệng 5cm để cảm nhận trực tiếp sự khác biệt về luồng hơi.",
        "Gom cặp tối thiểu (바–빠–파) thành một bộ và luyện theo từng bước chậm → vừa → nhanh, để ba âm nằm ở ba vị trí khác nhau rõ ràng.",
        "Nghe xen kẽ audio của người bản ngữ và bản ghi của mình, so sánh trực quan độ rộng ô đầu của dạng sóng PRAAT và độ cao điểm bắt đầu của đường F0 màu xanh để kiểm tra trật tự ba âm."
      ]
    },
    "overall": "현재 학습자는 VOT 위계가 ㅂ(38ms) > ㅃ(21ms) 로 뒤집히고 ㅍ(181ms) 은 과도하게 길어, 평음–경음–격음 3중 구분의 균형이 흐트러진 단계입니다. F0 패턴에서도 평음<경음·격음의 정상 위계가 학습자 baseline 기준 거의 평탄해 셋이 비슷하게 들릴 수 있습니다. 다만 격음 ㅍ 에서 강한 기식을 만들어 낼 줄 안다는 점은 분명한 강점이며, 이를 '덜어내는' 방향으로 다듬으면서 ㅃ 의 후두 긴장을 새로 만드는 데 집중하면 빠르게 좋아질 수 있는 위치입니다. 셋을 한꺼번에 고치려 하기보다 ㅂ–ㅃ 분리에 우선 초점을 두는 것이 효율적입니다.",
    "overall_vn": "Hiện tại trật tự VOT ở bạn bị đảo ㅂ(38ms) > ㅃ(21ms), còn ㅍ(181ms) thì quá dài, nên thế cân bằng giữa 평음–경음–격음 đang bị lệch. Về mẫu F0, trật tự bình thường 평음<경음·격음 cũng gần như phẳng so với baseline của chính bạn, khiến ba âm dễ nghe na ná nhau. Tuy vậy, việc bạn đã biết tạo được luồng hơi mạnh cho 격음 ㅍ là một điểm mạnh rõ ràng; chỉ cần 'bớt đi' một chút và dồn sức tạo độ căng thanh quản cho ㅃ là sẽ tiến nhanh. Thay vì sửa cả ba cùng lúc, nên ưu tiên tách rõ ㅂ và ㅃ trước.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)의 VOT 가 38ms 로 원어민 97ms 보다 짧아 PRAAT 파형의 첫 칸이 눈에 띄게 좁게 그려졌고, 모음 ㅏ 의 F0 시작점은 baseline 대비 +2.1 st 정도로 평음치고 다소 높게 들어왔습니다. 입술을 너무 단단히 다물지 말고 한 박자 가볍게 닫았다가 부드럽게 떼는 느낌으로 발음해 보세요. 손바닥을 입 앞에 두었을 때 거의 바람이 느껴지지 않을 만큼만, 모음 톤도 자연스러운 중간 높이로 시작하는 것이 평음 ㅂ 의 자리입니다. 파란 F0 곡선이 시작 부분에서 너무 솟지 않도록 톤을 살짝 내려 주는 것이 다음 목표입니다.",
      "baji_vn": "바지(ㅂ) có VOT 38ms, ngắn hơn người bản ngữ (97ms), nên ô đầu trên dạng sóng PRAAT trông rõ ràng hẹp hơn; điểm bắt đầu F0 của nguyên âm ㅏ ở +2.1 st so với baseline, hơi cao đối với một 평음. Đừng mím môi quá chặt, hãy khép môi nhẹ trong một nhịp rồi nhả ra một cách mềm mại. Khi đặt lòng bàn tay trước miệng, gần như không cảm thấy hơi, và mở đầu nguyên âm bằng độ cao tự nhiên ở mức trung — đó mới là vị trí của 평음 ㅂ. Mục tiêu tiếp theo là hạ nhẹ tông để đường F0 màu xanh không vọt lên ở đoạn đầu.",
      "bbareuda": "빠르다(ㅃ)의 VOT 가 21ms 로 측정되어 원어민 0ms 와 비교했을 때 PRAAT 파형 첫 칸이 너무 넓게 그려졌고, 오히려 평음 ㅂ(38ms) 과 거의 같은 영역에 들어왔습니다. F0(ㅏ) 시작점도 +0.6 st 로 평음 ㅂ(+2.1) 보다 낮아 경음 특유의 '높고 단단한 시작'이 아직 만들어지지 않은 상태입니다. 입술을 한 박자 더 꽉 다물어 살짝 압력을 쌓은 뒤, 숨을 거의 흘리지 않고 짧고 단단하게 '딱!' 터뜨리는 느낌으로 연습해 보세요. 모음 ㅏ 는 평음보다 살짝 더 높은 톤에서 시작해 파란 F0 곡선이 첫 부분에서 위로 올라오도록 의식하면 ㅂ 과 분명히 갈라집니다.",
      "bbareuda_vn": "빠르다(ㅃ) có VOT đo được 21ms, so với 0ms của người bản ngữ thì ô đầu trên dạng sóng PRAAT bị vẽ quá rộng, và rơi gần như cùng vùng với 평음 ㅂ (38ms). Điểm bắt đầu F0 của ㅏ chỉ +0.6 st, thấp hơn cả ㅂ (+2.1), nên 'mở đầu cao và chắc' đặc trưng của 경음 vẫn chưa hình thành. Hãy mím môi chặt hơn một nhịp để dồn một chút áp lực, rồi 'tách!' bật ra ngắn và chắc, gần như không để hơi thoát. Mở đầu nguyên âm ㅏ ở tông hơi cao hơn 평음 một chút, để đường F0 màu xanh nhô lên ở đoạn đầu — như thế ㅃ sẽ tách rõ khỏi ㅂ.",
      "paransaek": "파란색(ㅍ)의 VOT 가 181ms 로 원어민 60ms 의 약 3배에 달해 PRAAT 파형의 첫 칸이 지나치게 넓게 펼쳐졌습니다. 손바닥을 입 앞에 두었을 때 바람이 강하게 느껴지는 것은 좋은 신호이지만, 지금은 그 바람을 너무 길게 끌고 있으니 '한 번 짧고 굵게 훅!' 정도로 줄여 보세요. 또한 F0(ㅏ) 시작점이 +1.2 st 로 원어민 +3.4 st 에 비해 낮아 파란 F0 곡선이 충분히 위에서 출발하지 않으니, 모음을 처음부터 또렷이 높은 톤으로 띄워 주면 격음다움이 살아납니다. 기식을 '늘리기'가 아니라 '강하지만 짧게 터뜨리기' 로 방향만 바꾸면 빠르게 정돈됩니다.",
      "paransaek_vn": "파란색(ㅍ) có VOT 181ms, gấp khoảng 3 lần mức 60ms của người bản ngữ, khiến ô đầu trên dạng sóng PRAAT trải ra quá rộng. Việc bạn cảm thấy luồng hơi mạnh khi đặt lòng bàn tay trước miệng là dấu hiệu tốt, nhưng hiện tại luồng hơi đang bị kéo quá dài — hãy rút ngắn thành một cú 'hú!' ngắn và mạnh. Ngoài ra, điểm bắt đầu F0 của ㅏ chỉ +1.2 st, thấp hơn nhiều so với +3.4 st của người bản ngữ, nên đường F0 màu xanh không xuất phát đủ cao; hãy đẩy nguyên âm lên tông cao rõ ràng ngay từ đầu để chất 격음 hiện ra. Chỉ cần đổi hướng từ 'kéo dài hơi' sang 'bật hơi mạnh nhưng ngắn' là sẽ gọn lại nhanh."
    },
    "encouragement": "격음에서 강한 기식을 만들어 낼 줄 안다는 것은 이미 큰 자산입니다 — 이제 그 힘을 ㅃ 의 '짧고 단단한 폐쇄'로 옮겨오기만 하면 됩니다!",
    "encouragement_vn": "Việc bạn đã biết tạo luồng hơi mạnh cho 격음 đã là một tài sản lớn — giờ chỉ cần chuyển sức mạnh đó sang cú 'khép môi ngắn và chắc' của ㅃ là được!",
    "_source": "claude"
