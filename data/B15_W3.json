  "ai_feedback": {
    "error_analysis": {
      "summary": "평음 ㄱ과 경음 ㄲ의 VOT 경계가 흐려져 두 소리가 가까워지고 있으며, 격음 ㅋ은 기식이 오히려 과한 편입니다.",
      "summary_vn": "Ranh giới VOT giữa âm thường ㄱ và âm căng ㄲ đang bị mờ khiến hai âm trở nên gần nhau, trong khi âm bật hơi ㅋ lại có luồng hơi hơi quá mạnh.",
      "detail": "가방의 ㄱ은 VOT 37ms로 원어민 63ms보다 짧게 나타나 평음치고는 다소 단단하게 들립니다. 까만색의 ㄲ은 VOT 22ms로 원어민 8ms보다 길어 후두 긴장이 충분하지 않고 평음 쪽으로 밀려와 있습니다. 두 단어의 VOT 간격이 15ms 정도밖에 안 되어 평음·경음 대비가 좁아진 것이 핵심입니다. 카드의 ㅋ은 VOT 110ms로 원어민 83ms보다 길어 기식 자체는 충분하지만, F0 측정이 빠져 음높이 동반 여부는 단정하기 어렵습니다.",
      "detail_vn": "ㄱ trong 가방 có VOT 37ms, ngắn hơn người bản ngữ (63ms), nghe hơi căng so với một âm thường. ㄲ trong 까만색 có VOT 22ms, dài hơn người bản ngữ (8ms), cho thấy độ căng thanh quản chưa đủ và bị kéo về phía âm thường. Khoảng cách VOT giữa hai từ chỉ khoảng 15ms, nghĩa là sự đối lập âm thường – âm căng đang bị thu hẹp. ㅋ trong 카드 có VOT 110ms, dài hơn bản ngữ (83ms) nên luồng hơi đủ mạnh, nhưng do thiếu dữ liệu F0 nên chưa thể khẳng định cao độ đi kèm có phù hợp hay không."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 학습자가 ㄱ과 ㄲ을 같은 무성 파열음 범주로 인식해 중간 지점에서 발음하는 경향이 강합니다. 특히 ㄲ에 필요한 후두 긴장(성문 닫힘)은 베트남어에 없는 동작이라 평음 영역으로 밀려나기 쉽고, 반대로 ㄱ은 그 차이를 만들려고 살짝 단단하게 내려는 보상이 나타난 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống đối lập ba bậc (âm thường – âm căng – âm bật hơi) như tiếng Hàn, nên người học có xu hướng xếp ㄱ và ㄲ vào cùng một nhóm âm tắc vô thanh và phát âm ở vùng trung gian. Đặc biệt, động tác siết thanh quản (đóng thanh môn) cần cho ㄲ không tồn tại trong tiếng Việt nên dễ bị kéo về phía âm thường, ngược lại ㄱ lại có thể được phát âm hơi căng hơn như một sự bù trừ.",
    "correction": {
      "main_focus": "평음 ㄱ과 경음 ㄲ의 VOT 거리를 넓혀, 두 소리 사이 경계를 분명히 만드는 것이 가장 중요합니다.",
      "main_focus_vn": "Trọng tâm quan trọng nhất là mở rộng khoảng cách VOT giữa âm thường ㄱ và âm căng ㄲ để tạo ra ranh giới rõ ràng giữa hai âm.",
      "steps": [
        "손바닥을 입 앞에 두고 ㄱ-ㄲ-ㅋ 최소대립쌍을 천천히 반복하며 바람 양의 세 단계 차이를 체감하기.",
        "거울 앞에서 ㄲ을 낼 때 목 아래에 살짝 힘이 들어가는지(후두 긴장) 확인하며 발음하기.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 평음과 경음의 시작 순간 차이에 귀를 집중하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay trước miệng và lặp lại chậm các cặp tối thiểu ㄱ-ㄲ-ㅋ để cảm nhận ba mức khác biệt về luồng hơi.",
        "Đứng trước gương và phát âm ㄲ, kiểm tra xem có lực siết nhẹ ở phần dưới cổ (siết thanh quản) hay không.",
        "Nghe luân phiên bản thu của người bản ngữ và bản thu của mình, tập trung tai vào khác biệt ở khoảnh khắc bắt đầu của âm thường và âm căng."
      ]
    },
    "overall": "가장 큰 과제는 평음과 경음의 거리 확보이며, 격음 ㅋ의 기식은 이미 충분히 살아 있다는 점이 분명한 강점입니다. 현재 ㄱ과 ㄲ이 모두 VOT 20~40ms 부근에 몰려 있어 청자에게는 두 소리가 비슷하게 들릴 가능성이 큽니다. ㄱ은 조금 더 부드럽게 풀어주고, ㄲ은 후두를 한 박자 더 조였다가 짧고 단단하게 터뜨리는 연습을 통해 두 소리의 간격을 벌리면 위계가 빠르게 자리잡을 것입니다. 격음의 안정된 기식을 기준점으로 삼아 나머지 두 소리를 재배치한다는 감각으로 접근해 보세요.",
    "overall_vn": "Thử thách lớn nhất là tạo khoảng cách giữa âm thường và âm căng, còn luồng hơi của âm bật hơi ㅋ đã được duy trì tốt – đây là điểm mạnh rõ ràng. Hiện tại cả ㄱ và ㄲ đều tập trung quanh vùng VOT 20–40ms nên người nghe dễ cảm thấy hai âm na ná nhau. Nếu thả lỏng ㄱ một chút và siết thanh quản chặt hơn một nhịp trước khi bật ㄲ thật ngắn và chắc, khoảng cách giữa hai âm sẽ được mở rộng và hệ thống đối lập sẽ nhanh chóng hình thành. Hãy lấy luồng hơi ổn định của âm bật hơi làm điểm tựa và sắp xếp lại hai âm còn lại quanh nó.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 ㄱ은 VOT 37ms로 측정되어, 발음 나침반 위에서 평음 ngang 위치에 머물러야 할 좌표가 nặng(왼쪽·짧고 단단함) 쪽으로 살짝 끌려간 상태입니다. 원어민 평음 클러스터는 더 오른쪽(bật hơi 방향)의 60ms 부근에 있으니, 입술과 혀 뿌리의 힘을 한 단계 풀어 공기를 좀 더 흘려보낸다는 느낌으로 발음해 보세요. F0 패턴도 원어민보다 +1.4 st 위에 떠 있어 가방의 ㅏ를 평소 말하는 톤보다 살짝 낮게, 가라앉히듯 시작하면 ngang 중앙 영역으로 좌표가 자연스럽게 이동합니다.",
      "gabang_vn": "ㄱ trong 가방 đo được VOT 37ms, trên la bàn phát âm tọa độ đang bị kéo nhẹ về phía nặng (bên trái – ngắn và căng) thay vì nằm ở vị trí ngang của âm thường. Cụm âm thường của người bản ngữ nằm xa hơn về bên phải (hướng bật hơi), quanh 60ms, nên hãy thả lỏng môi và gốc lưỡi thêm một bậc, để luồng khí thoát ra nhiều hơn. Mẫu F0 cũng cao hơn bản ngữ +1.4 st, vì vậy nếu bắt đầu ㅏ trong 가방 ở tông hơi thấp hơn giọng nói thường ngày, tọa độ sẽ tự nhiên dịch về vùng trung tâm ngang.",
      "ggamansaek": "까만색의 ㄲ은 VOT 22ms로 측정되어, 나침반 위에서 nặng(왼쪽·짧고 긴장된) 깊은 영역에 있어야 할 좌표가 ngang 중앙 쪽으로 밀려나 가방과 거의 같은 위치에 겹쳐 있습니다. 원어민 경음 클러스터는 훨씬 더 왼쪽(VOT 10ms 부근, 위쪽)으로 떨어져 있으니, 입술을 한 박자 더 꽉 다물고 목 안쪽을 살짝 조였다가 짧고 단단하게 터뜨려야 그 좌표로 이동할 수 있습니다. F0 패턴은 +0.7 st 차이로 위계 자체는 맞는 방향이라 강점입니다 — 음높이 감각은 살아 있으니 후두 긴장과 짧은 폭발만 보완하면 됩니다.",
      "ggamansaek_vn": "ㄲ trong 까만색 có VOT 22ms, trên la bàn tọa độ lẽ ra phải nằm sâu về phía nặng (bên trái – ngắn và căng) nhưng lại bị đẩy vào vùng ngang trung tâm, gần như trùng với 가방. Cụm âm căng của người bản ngữ nằm xa hơn nhiều về bên trái và lên trên (VOT khoảng 10ms), nên bạn cần mím môi thêm một nhịp, siết nhẹ phía trong cổ rồi bật ra thật ngắn và chắc thì tọa độ mới dịch tới đó. Mẫu F0 chỉ chênh +0.7 st nên hướng cao độ đã đúng – đây là điểm mạnh; chỉ cần bổ sung độ siết thanh quản và cú bật ngắn là đủ.",
      "kadeu": "카드의 ㅋ은 VOT 110ms로 측정되어, 나침반 위에서 bật hơi(오른쪽·기식이 긴) 영역에 안정적으로 들어가 있고 오히려 원어민 클러스터(83ms)보다 더 오른쪽으로 나가 있는 상태입니다. F0 측정이 빠져 위·아래 좌표는 확정하기 어렵지만, 베트남 학습자가 격음을 비교적 잘 만들어내는 일반 경향과 일치하므로 강점으로 활용하기 좋습니다. 다만 기식을 과하게 길게 빼면 다음 모음이 늦게 시작되어 단어가 늘어지는 인상을 줄 수 있으니, 'ㅋ'에서 'ㅏ'로 넘어가는 순간을 조금 더 빠르게 이어 발음해 보세요.",
      "kadeu_vn": "ㅋ trong 카드 đo được VOT 110ms, trên la bàn tọa độ nằm vững trong vùng bật hơi (bên phải – luồng hơi dài) và thậm chí còn lệch xa hơn về bên phải so với cụm bản ngữ (83ms). Do thiếu dữ liệu F0 nên chưa xác định chắc chắn được trục trên–dưới, nhưng điều này khớp với xu hướng chung là người học Việt Nam thường tạo âm bật hơi tương đối tốt – một điểm mạnh nên tận dụng. Tuy nhiên nếu kéo luồng hơi quá dài, nguyên âm tiếp theo sẽ vào muộn và làm từ bị ngân, vì vậy hãy nối nhanh hơn từ 'ㅋ' sang 'ㅏ'."
    },
    "encouragement": "격음 ㅋ의 기식이 이미 안정적으로 자리잡혀 있어 좋은 출발점이 있습니다 — 이 감각을 기준 삼아 평음과 경음을 양옆으로 벌려나가면 됩니다!",
    "encouragement_vn": "Luồng hơi của âm bật hơi ㅋ đã được giữ ổn định nên bạn có một điểm khởi đầu rất tốt – hãy lấy cảm giác này làm chuẩn và mở rộng âm thường, âm căng sang hai bên là được!",
    "_source": "claude"
  },
