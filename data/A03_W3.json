  "ai_feedback": {
    "error_analysis": {
      "summary": "세 파열음 모두 VOT가 길고, 평음에서 음높이가 오히려 높아 위계가 뒤집힌 패턴입니다.",
      "summary_vn": "Cả ba âm tắc đều có VOT dài, và ở 평음(âm thường) cao độ lại cao hơn, khiến trật tự 평음<경음·격음 bị đảo ngược.",
      "detail": "가방의 ㄱ은 VOT 113ms로 원어민 63ms보다 약 50ms 더 길고, F0(ㅏ) pattern_st가 +1.4로 원어민 -3.7보다 5.1 semitone이나 높게 시작됩니다. 카드의 ㅋ은 VOT 139ms로 원어민 83ms보다 56ms 길지만, F0 pattern_st가 -1.5로 평음 가방(+1.4)보다 오히려 낮습니다. 까만색의 ㄲ은 VOT 13ms로 원어민 8ms와 거의 같아 가장 안정적이고, F0 패턴도 -0.1로 비교적 잘 잡혀 있습니다. 결과적으로 학습자의 위계는 '경음(까)<격음(카)<평음(가)'로 원어민 패턴과 어긋나 있습니다.",
      "detail_vn": "Ở 가방, ㄱ có VOT 113ms, dài hơn người bản ngữ (63ms) khoảng 50ms, và F0(ㅏ) pattern_st là +1.4 — cao hơn người bản ngữ (-3.7) tới 5.1 semitone. Ở 카드, ㅋ có VOT 139ms (dài hơn bản ngữ 83ms khoảng 56ms), nhưng F0 pattern_st chỉ -1.5, thấp hơn cả 평음 가방 (+1.4). Ở 까만색, ㄲ có VOT 13ms gần như trùng với bản ngữ (8ms), và pattern F0 -0.1 cũng khá ổn định. Kết quả là trật tự cao độ của bạn thành '경음(까)<격음(카)<평음(가)', ngược với mẫu chuẩn của người Hàn."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 모국어의 무기/유기 대립을 한국어 파열음에 그대로 옮기면서 평음에도 격음 수준의 강한 기식과 높은 음높이를 같이 얹는 경향이 생깁니다. 반대로 격음에서는 '바람을 더 길게'에만 집중하다 보니 모음 시작 음높이를 충분히 올리지 못해, 결과적으로 평음과 격음의 음높이 단서가 뒤바뀌게 됩니다. 까만색의 ㄲ이 가장 잘 나오는 것도 베트남어 무기·후두 긴장 자질과 가까워 자연스럽게 가져올 수 있었기 때문으로 보입니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc 평음·경음·격음 như tiếng Hàn, nên bạn có xu hướng áp dụng đối lập có/không bật hơi của tiếng mẹ đẻ lên cả ba âm, khiến 평음 cũng bị thêm hơi mạnh và cao độ cao như 격음. Ngược lại, ở 격음 bạn tập trung 'thổi hơi dài hơn' mà chưa nâng đủ cao độ đầu nguyên âm, khiến tín hiệu cao độ giữa 평음 và 격음 bị đảo ngược. Việc ㄲ trong 까만색 phát âm tốt nhất là vì đặc trưng không bật hơi và căng thanh quản của ㄲ gần với tiếng Việt nên bạn tự nhiên làm được.",
    "correction": {
      "main_focus": "평음의 기식과 음높이를 동시에 낮춰서 격음과 분리되는 '아래쪽 닻'을 만드는 것이 최우선입니다.",
      "main_focus_vn": "Ưu tiên số một là đồng thời giảm hơi và hạ cao độ của 평음 để tạo 'điểm neo phía dưới' tách bạch khỏi 격음.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 평음·경음·격음을 차례로 발음하며, 평음에서는 바람이 거의 느껴지지 않아야 하고 격음에서는 길고 분명한 바람이 느껴져야 함을 손으로 확인합니다.",
        "최소대립쌍(가-까-카, 다-따-타, 바-빠-파)을 천천히 반복하면서, 평음을 낮은 음으로 시작하고 격음·경음을 한 단계 올려서 음높이 위계를 몸에 익힙니다.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 평음의 모음 시작 음높이가 격음보다 낮은지 매번 점검합니다."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm, lần lượt phát âm 평음·경음·격음 và kiểm tra bằng tay: 평음 hầu như không có gió, còn 격음 phải có luồng gió dài và rõ ràng.",
        "Lặp lại chậm các cặp tối thiểu (가-까-카, 다-따-타, 바-빠-파), bắt đầu 평음 ở cao độ thấp và nâng 경음·격음 lên một bậc để cơ thể quen với trật tự cao độ.",
        "Nghe xen kẽ giọng người bản ngữ và bản ghi của mình, mỗi lần đều kiểm tra xem cao độ đầu nguyên âm của 평음 có thấp hơn 격음 hay không."
      ]
    },
    "overall": "경음 ㄲ은 VOT 13ms로 원어민과 거의 일치하고 F0 패턴도 잘 잡혀 있어 분명한 강점입니다. 다만 평음 ㄱ의 VOT가 113ms로 격음 수준까지 길어졌고 모음 음높이도 +1.4st로 가장 높게 시작해, 정작 격음 ㅋ보다 더 격음스럽게 들리는 역전이 일어났습니다. 격음 ㅋ은 바람의 길이는 충분하지만 모음 음높이가 -1.5st로 떨어져 두 음의 구분이 흐려졌습니다. 강점인 경음을 기준 닻으로 두고 평음을 '짧고 낮게'로 끌어내리는 작업부터 시작하면 빠르게 위계가 회복될 것입니다.",
    "overall_vn": "경음 ㄲ với VOT 13ms gần như trùng với người bản ngữ và mẫu F0 cũng ổn định — đây là điểm mạnh rõ rệt của bạn. Tuy nhiên, ㄱ trong 가방 có VOT 113ms dài ngang 격음 và cao độ nguyên âm cao nhất (+1.4st), khiến nó nghe còn '격음' hơn cả ㅋ thật. Trong khi đó, ㅋ ở 카드 có hơi đủ dài nhưng cao độ lại tụt xuống -1.5st, làm ranh giới giữa 평음 và 격음 mờ đi. Hãy lấy 경음 mạnh sẵn làm điểm neo và bắt đầu kéo 평음 về 'ngắn và thấp', trật tự ba âm sẽ phục hồi rất nhanh.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 ㄱ은 VOT 113ms로 파형 첫 칸이 원어민(63ms)보다 거의 두 배 넓게 펼쳐져 있어, 평음이 아니라 격음처럼 들립니다. 동시에 파란 F0 곡선이 pattern_st +1.4로 가장 높은 자리에서 출발해, 셋 중 가장 '높고 센' 소리가 되어버렸습니다. 교정할 때는 입술을 가볍게 닫았다가 살짝만 떼면서 손바닥에 바람이 거의 닿지 않을 정도로 부드럽게 시작하고, 모음 ㅏ도 평소 말투보다 한 톤 낮게 내려서 시작하세요. '가'를 짧고 낮게, 거의 흘리듯 내는 연습이 이 단어의 핵심입니다.",
      "gabang_vn": "Ở 가방, ㄱ có VOT 113ms — ô đầu của sóng âm rộng gần gấp đôi người bản ngữ (63ms), nên nghe giống 격음 hơn là 평음. Đồng thời, đường F0 màu xanh bắt đầu ở pattern_st +1.4 — vị trí cao nhất trong ba âm, khiến nó thành âm 'cao và mạnh' nhất. Khi luyện, hãy khép môi nhẹ rồi mở ra rất nhẹ sao cho lòng bàn tay gần như không cảm thấy gió, và bắt đầu nguyên âm ㅏ thấp hơn giọng nói thường một bậc. Tập phát '가' ngắn, thấp, gần như lướt qua — đó là chìa khóa của từ này.",
      "ggamansaek": "까만색의 ㄲ은 VOT 13ms로 파형 첫 칸이 원어민(8ms)과 거의 같은 폭으로 짧게 끊겨 있고, F0 pattern_st -0.1도 원어민(1.3)과 큰 차이가 없어 가장 잘 만들어진 단어입니다. 이 단어에서 느껴지는 짧은 폐쇄와 후두의 단단한 긴장감을 몸으로 기억해 두세요. 앞으로 평음·격음 연습을 할 때마다 '까'를 먼저 한 번 발음해서 baseline을 잡고 시작하면, 다른 두 자음과의 거리를 체감하기 훨씬 쉬워집니다.",
      "ggamansaek_vn": "Ở 까만색, ㄲ có VOT 13ms — ô đầu sóng âm ngắn gần bằng người bản ngữ (8ms), và F0 pattern_st -0.1 cũng rất gần với bản ngữ (1.3), nên đây là từ bạn phát âm tốt nhất. Hãy ghi nhớ bằng cơ thể cảm giác khép môi ngắn và sự căng chắc ở thanh quản trong từ này. Mỗi khi luyện 평음·격음, hãy phát '까' một lần trước để lấy baseline, rồi bạn sẽ cảm nhận khoảng cách với hai âm còn lại dễ hơn rất nhiều.",
      "kadeu": "카드의 ㅋ은 VOT 139ms로 파형 첫 칸이 원어민(83ms)보다 더 길게 늘어져, 바람의 양 자체는 격음으로서 충분하다 못해 과한 편입니다. 그런데 파란 F0 곡선이 pattern_st -1.5로 내려앉아, 격음인데도 평음 가방(+1.4)보다 낮은 음으로 시작하는 역전이 일어났습니다. 손바닥은 그대로 두되, '카!' 하고 발음할 때 모음 ㅏ를 평소보다 분명하게 높여서 시작해 보세요. 바람의 길이는 약간 줄여도 좋으니, 대신 모음을 한 톤 올려서 '높고 산뜻한 카'를 만드는 것이 이 단어의 과제입니다.",
      "kadeu_vn": "Ở 카드, ㅋ có VOT 139ms — ô đầu sóng âm còn dài hơn cả người bản ngữ (83ms), nên lượng hơi của 격음 thực ra đã đủ, thậm chí hơi quá. Nhưng đường F0 màu xanh lại tụt xuống pattern_st -1.5, khiến 격음 này bắt đầu ở cao độ còn thấp hơn cả 평음 가방 (+1.4) — một sự đảo ngược. Hãy giữ nguyên lòng bàn tay kiểm tra gió, nhưng khi phát '카!' hãy nâng nguyên âm ㅏ lên rõ ràng hơn bình thường. Có thể giảm bớt độ dài của hơi một chút, đổi lại nâng cao độ một bậc để tạo ra một 'ㅋ cao và tươi' — đó là nhiệm vụ của từ này."
