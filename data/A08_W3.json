  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·격음의 VOT가 지나치게 길어 셋의 위계가 흐려지고, 경음만 비교적 잘 구분되는 단계입니다.",
      "summary_vn": "VOT của 평음(âm thường) và 격음(âm bật hơi) quá dài khiến thứ bậc giữa ba âm bị mờ, chỉ có 경음(âm căng) là tương đối phân biệt được.",
      "detail": "까만색은 VOT 0ms 로 원어민 8ms 와 거의 일치해 경음의 핵심 특징인 '거의 동시 개방'을 잘 살렸고, F0 도 +4.2 st 로 높게 시작해 경음 위계가 분명합니다. 반면 가방은 VOT 195ms 로 원어민 63ms 의 약 3배에 달해 평음이 아닌 격음에 가깝게 들리고, 카드 역시 VOT 172ms 로 격음치고도 다소 길게 측정되는 경향이 있습니다. 결과적으로 가방과 카드 두 단어의 VOT 가 모두 길어, 학습자 안에서 평음과 격음이 비슷한 음가로 합쳐지는 인상이 있습니다. 자기 baseline 대비 F0 위계는 경음에서만 명확히 살아 있는 상태입니다.",
      "detail_vn": "까만색 có VOT 0ms gần như trùng với người bản ngữ (8ms), thể hiện đúng đặc trưng cốt lõi của 경음 là 'mở gần như đồng thời', và F0 cũng bắt đầu cao ở +4.2 st nên thứ bậc của 경음 rất rõ. Ngược lại, 가방 có VOT 195ms — gần gấp 3 lần mức 63ms của người bản ngữ — nên nghe gần với 격음 hơn là 평음, và 카드 cũng có VOT 172ms, có xu hướng dài hơn so với mức bình thường của 격음. Kết quả là cả hai từ 가방 và 카드 đều có VOT dài, tạo ấn tượng rằng trong cách phát âm của bạn, 평음 và 격음 đang bị gộp lại thành âm tương tự nhau. Thứ bậc F0 so với baseline của chính bạn chỉ thực sự rõ ràng ở 경음."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음의 3중 대립이 없어, 평음 ㄱ을 발음할 때 무의식적으로 강한 기식을 함께 내보내 격음에 가깝게 만드는 경향이 있습니다. 또한 격음 ㅋ에서도 기식의 '강도'보다 '길이'에 의존해 VOT 가 지나치게 길어지는 패턴이 나타납니다. 경음만 베트남어 무성 무기음과 유사해 비교적 자연스럽게 산출되고 있는 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có sự đối lập ba bậc 평음·경음·격음 như tiếng Hàn, nên khi phát âm 평음 ㄱ, bạn thường vô thức kèm theo luồng hơi mạnh, khiến nó nghe gần với 격음. Ngoài ra, ở 격음 ㅋ, bạn cũng có xu hướng dựa vào 'độ dài' của luồng hơi hơn là 'độ mạnh', làm cho VOT bị kéo quá dài. Chỉ có 경음 là gần với phụ âm vô thanh không bật hơi trong tiếng Việt, nên bạn phát âm tương đối tự nhiên.",
    "correction": {
      "main_focus": "평음 ㄱ을 짧고 부드럽게 — 기식을 빼서 VOT 를 절반 이하로 줄이는 것이 이번 주의 가장 큰 과제입니다.",
      "main_focus_vn": "Phát âm 평음 ㄱ ngắn và nhẹ — giảm luồng hơi để VOT rút xuống dưới một nửa là nhiệm vụ lớn nhất của tuần này.",
      "steps": [
        "손바닥을 입 앞 10cm 에 대고 가-까-카 를 순서대로 발음하며, 가 에서는 바람이 거의 느껴지지 않고 카 에서만 분명히 느껴지도록 기식 양을 분리해 체감하기.",
        "최소대립쌍 가-까-카 를 천천히 5회 반복한 뒤 본인 녹음을 원어민 음원과 번갈아 들으며, 첫 자음의 길이 차이가 귀로 들리는지 확인하기.",
        "거울 앞에서 평음을 발음할 때 목과 어깨에 힘이 들어가는지 관찰하고, 의식적으로 후두를 이완시킨 상태에서 짧게 끊어 발음하는 워밍업하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm và lần lượt phát âm 가-까-카, cảm nhận rõ sự khác biệt về luồng hơi: ở 가 hầu như không thấy hơi, chỉ ở 카 mới thấy hơi rõ ràng.",
        "Phát âm chậm cặp đối lập tối thiểu 가-까-카 lặp lại 5 lần, sau đó nghe xen kẽ giữa bản ghi của mình và bản gốc của người bản ngữ để kiểm tra xem tai mình có nghe được sự khác biệt về độ dài của phụ âm đầu hay không.",
        "Đứng trước gương quan sát xem cổ và vai có bị căng khi phát âm 평음 hay không, rồi chủ động thả lỏng thanh quản và tập phát âm ngắn, dứt khoát như một bài khởi động."
      ]
    },
    "overall": "경음 까만색은 VOT·F0 두 축 모두 원어민 패턴에 매우 가까워 명확한 강점입니다. 다만 평음 가방과 격음 카드 모두 VOT 가 길게 측정되어, 학습자 내부에서 두 음이 비슷한 영역에 머무는 단계로 보입니다. 다음 단계의 핵심은 평음의 기식을 '빼는' 연습 — 격음을 약하게 만드는 것이 아니라 평음을 더 짧고 부드럽게 만들어 셋 사이의 거리를 벌리는 것입니다. 이미 경음 위계를 만들 수 있다는 점은, 평음·격음 분리도 충분히 가능하다는 신호입니다.",
    "overall_vn": "경음 까만색 rất gần với mẫu của người bản ngữ ở cả hai trục VOT và F0, đây là điểm mạnh rõ ràng của bạn. Tuy nhiên, cả 평음 가방 lẫn 격음 카드 đều có VOT đo được khá dài, cho thấy hiện tại trong cách phát âm của bạn, hai âm này đang nằm ở vùng tương tự nhau. Trọng tâm của bước tiếp theo là luyện 'bớt' luồng hơi của 평음 — không phải làm yếu 격음 đi, mà là làm cho 평음 ngắn và nhẹ hơn để kéo giãn khoảng cách giữa ba âm. Việc bạn đã tạo được thứ bậc rõ ràng cho 경음 là tín hiệu cho thấy bạn hoàn toàn có thể phân tách 평음 và 격음.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 ㄱ은 VOT 가 195ms 로 측정되어, PRAAT 파형에서 첫 자음 구간(첫 칸)이 원어민(63ms) 대비 약 3배 가까이 넓게 펼쳐진 모양입니다. 평음이라기보다 강한 격음에 가까운 인상으로, 입술이 떨어진 직후 바람이 너무 오래 새어 나오고 있다는 뜻입니다. 손바닥을 입 앞에 두고 '가' 를 발음했을 때 바람이 거의 느껴지지 않을 만큼 짧게 끊어 보세요. F0(ㅏ) 도 -5.5 st 로 원어민보다 1.8 st 더 낮게 시작하는 경향이 있어, 약간 더 가볍고 자연스러운 톤으로 모음을 시작하면 평음 다움이 한층 살아납니다.",
      "gabang_vn": "Phụ âm ㄱ của 가방 có VOT đo được 195ms, nghĩa là trên dạng sóng PRAAT, đoạn phụ âm đầu (ô đầu tiên) trải rộng gần gấp 3 lần so với người bản ngữ (63ms). Nghe không giống 평음 mà gần với 격음 mạnh, tức là sau khi môi mở ra, luồng hơi vẫn tiếp tục thoát ra quá lâu. Hãy đặt lòng bàn tay trước miệng và phát âm '가' ngắn dứt khoát đến mức gần như không cảm thấy hơi. F0(ㅏ) cũng có xu hướng bắt đầu ở -5.5 st, thấp hơn người bản ngữ 1.8 st, nên nếu bạn vào nguyên âm bằng giọng nhẹ và tự nhiên hơn một chút thì chất 평음 sẽ rõ hơn nhiều.",
      "ggamansaek": "까만색의 ㄲ은 VOT 0ms 로 측정되어, PRAAT 파형에서 첫 자음 칸이 거의 보이지 않을 만큼 좁고, 폐쇄 직후 모음이 바로 시작되는 이상적인 경음 형태를 보여줍니다. 원어민 8ms 와 사실상 동일한 수준이고, F0(ㅏ) 도 +4.2 st 로 파란 곡선이 위쪽에서 시작해 경음의 높은 톤 특징이 분명합니다. 이 감각 — 입술을 꽉 다물었다가 거의 동시에 모음으로 진입하는 짧고 단단한 느낌 — 을 그대로 기억해 두고, 다른 단어를 연습할 때 비교 기준점으로 삼으세요. 학습자의 가장 큰 강점입니다.",
      "ggamansaek_vn": "Phụ âm ㄲ của 까만색 có VOT 0ms, nghĩa là trên dạng sóng PRAAT, ô phụ âm đầu hẹp đến mức gần như không thấy, và nguyên âm bắt đầu ngay sau khi bật môi — đúng mẫu lý tưởng của 경음. Mức này thực tế trùng với người bản ngữ (8ms), và F0(ㅏ) ở +4.2 st cũng cho thấy đường cong F0 màu xanh bắt đầu ở vị trí cao, đặc trưng rõ rệt của 경음. Hãy nhớ thật kỹ cảm giác này — môi mím chặt rồi gần như đồng thời mở ra để vào nguyên âm, ngắn và chắc — và dùng nó làm chuẩn so sánh khi luyện các từ khác. Đây là điểm mạnh lớn nhất của bạn.",
      "kadeu": "카드의 ㅋ은 VOT 172ms 로, 원어민 83ms 대비 약 2배로 측정되는 경향이 있어 PRAAT 파형에서 첫 자음 구간이 다소 과하게 길게 펼쳐진 인상입니다. F0(ㅏ) 측정이 어려워 모음 톤은 확정하기 어렵지만, 격음 자체의 기식은 충분 이상으로 나오고 있다는 점은 분명합니다. 다만 기식의 '길이'에 의존하기보다 '강도' 를 살리는 방향으로 — 짧고 폭발적인 바람 한 번으로 끊어 발음해 보세요. 손바닥을 입 앞에 댔을 때 길게 새어 나오는 바람이 아니라 짧고 세게 부딪치는 바람이 느껴지는 것이 격음의 이상적 감각입니다.",
      "kadeu_vn": "Phụ âm ㅋ của 카드 có VOT 172ms, có xu hướng dài gần gấp đôi so với người bản ngữ (83ms), nên trên dạng sóng PRAAT, đoạn phụ âm đầu trải dài hơi quá mức. Vì khó đo F0(ㅏ) nên chưa thể khẳng định chắc về tông của nguyên âm, nhưng có thể thấy rõ rằng luồng hơi của 격음 đã được tạo ra dư dả. Vấn đề là bạn đang dựa vào 'độ dài' của luồng hơi thay vì 'độ mạnh' — hãy thử phát âm dứt khoát bằng một luồng hơi ngắn và bùng nổ. Khi đặt lòng bàn tay trước miệng, cảm giác lý tưởng của 격음 không phải là luồng hơi rỉ ra dài, mà là một cú đập hơi ngắn và mạnh."
    },
    "encouragement": "경음 까만색에서 보여준 깨끗한 위계는 정말 훌륭합니다 — 이 감각을 평음·격음으로 옮기면 세 음의 거리가 곧 분명해질 거예요!",
    "encouragement_vn": "Thứ bậc rất sạch mà bạn thể hiện ở 경음 까만색 thật sự tuyệt vời — chỉ cần chuyển cảm giác này sang 평음 và 격음, khoảng cách giữa ba âm sẽ sớm trở nên rõ ràng!",
