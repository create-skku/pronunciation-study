  "ai_feedback": {
    "error_analysis": {
      "summary": "평음 ㄱ과 격음 ㅋ은 비교적 잘 구분되지만, 경음 ㄲ의 후두 긴장이 부족해 평음 쪽으로 가까워지는 경향이 보입니다.",
      "summary_vn": "ㄱ (âm thường) và ㅋ (âm bật hơi) được phân biệt khá tốt, nhưng ㄲ (âm căng) thiếu sự căng thanh quản nên có xu hướng gần với âm thường.",
      "detail": "가방의 VOT 27ms는 평음 영역에 잘 들어왔고, 카드는 VOT 98ms로 강한 기식을 충분히 실현했습니다. 그러나 까만색의 VOT 17ms는 원어민 8ms보다 두 배 가까이 길어 경음 특유의 짧고 단단한 폐쇄가 약합니다. F0 패턴에서는 평음(+1.1 st)과 경음(+1.8 st)이 자기 baseline 보다 위로 올라가 위계 자체는 보이지만, 카드에서 -2.9 st로 음이 오히려 떨어지면서 격음에서 기대되는 높은 시작점이 무너졌습니다.",
      "detail_vn": "VOT của 가방 là 27ms nằm tốt trong vùng âm thường, và 카드 đạt 98ms thể hiện đủ luồng hơi mạnh. Tuy nhiên VOT của 까만색 là 17ms, dài gần gấp đôi so với người bản ngữ (8ms), nên sự khép môi ngắn và chắc đặc trưng của âm căng còn yếu. Về mẫu F0, âm thường (+1.1 st) và âm căng (+1.8 st) đều cao hơn baseline của bạn nên thứ bậc có hiện ra, nhưng ở 카드 thì F0 lại tụt xuống -2.9 st, làm mất điểm khởi đầu cao mà âm bật hơi cần có."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 특히 경음에 필요한 '후두 긴장'이라는 동작이 모국어에 존재하지 않습니다. 그래서 ㄲ을 발음할 때 성대를 충분히 조이지 못해 평음 ㄱ 영역으로 끌려가게 됩니다. 격음 카드의 F0가 낮아진 것은, 강한 기식을 만드는 데 집중하다 모음의 시작 톤을 챙길 여유가 없었기 때문입니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc kiểu Hàn Quốc (âm thường·âm căng·âm bật hơi), và đặc biệt động tác 'căng thanh quản' cần cho âm căng thì không tồn tại trong tiếng mẹ đẻ. Vì vậy khi phát âm ㄲ, bạn chưa siết đủ thanh đới nên âm bị kéo về vùng âm thường ㄱ. F0 của 카드 bị thấp là do bạn tập trung tạo luồng hơi mạnh nên chưa kịp giữ tông mở đầu của nguyên âm cao lên.",
    "correction": {
      "main_focus": "경음 ㄲ의 후두 긴장 — 입을 한 박자 더 꽉 잠갔다가 짧고 단단하게 터뜨리는 동작에 집중하세요.",
      "main_focus_vn": "Sự căng thanh quản của âm căng ㄲ — hãy tập trung khóa miệng chặt thêm một nhịp rồi bật ra thật ngắn và chắc.",
      "steps": [
        "최소대립쌍(가-까-카)을 천천히 반복하며 세 음의 차이를 입과 귀로 동시에 느끼기.",
        "손바닥을 입 앞에 대고 평음·경음·격음 사이의 바람 양 차이를 직접 체감하기.",
        "원어민 음원과 자기 녹음을 번갈아 들으며 음의 시작 톤과 폐쇄 길이를 비교 점검하기."
      ],
      "steps_vn": [
        "Lặp lại chậm cặp đối lập tối thiểu (가-까-카) để cảm nhận sự khác biệt của ba âm bằng cả miệng và tai cùng lúc.",
        "Đặt lòng bàn tay trước miệng để trực tiếp cảm nhận sự khác biệt lượng hơi giữa âm thường, âm căng và âm bật hơi.",
        "Nghe luân phiên âm thanh của người bản ngữ và bản ghi của chính mình để so sánh tông khởi đầu và độ dài khép môi."
      ]
    },
    "overall": "전체적으로 평음과 격음의 큰 틀은 잡혀 있고, 자기 baseline 대비 F0 위계도 부분적으로 나타나는 점이 분명한 강점입니다. 가장 시급한 부분은 경음 ㄲ의 후두 긴장이며, 동시에 격음 ㅋ에서는 기식과 함께 모음 시작 톤을 위로 올리는 연습이 필요합니다. 지금처럼 세 음을 의식적으로 구분하려는 시도가 유지된다면 빠르게 안정될 단계입니다.",
    "overall_vn": "Nhìn chung, khung lớn của âm thường và âm bật hơi đã được nắm bắt, và thứ bậc F0 so với baseline của chính bạn cũng đã xuất hiện một phần — đây là điểm mạnh rõ ràng. Phần cấp bách nhất là sự căng thanh quản của âm căng ㄲ, đồng thời ở âm bật hơi ㅋ bạn cần luyện đưa tông khởi đầu của nguyên âm lên cao cùng với luồng hơi mạnh. Nếu bạn duy trì nỗ lực phân biệt ba âm có ý thức như hiện nay thì giai đoạn này sẽ sớm ổn định.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 ㄱ은 VOT 27ms로 nặng(왼쪽)과 ngang(가운데) 사이 평음 영역에 자연스럽게 안착해 있고, F0도 baseline 대비 +1.1 st로 약간 위쪽에 머물러 원어민 클러스터에서 크게 벗어나지 않습니다. 나침반 위에서 보면 거의 정확한 자리에 도달한 상태이니, 이 감각을 anchor 로 삼아 다른 두 단어를 비교해 보세요. 다만 ㅏ 모음을 너무 힘주어 시작하면 경음 영역으로 끌려갈 수 있으니, 입술을 가볍게 풀고 부드럽게 터뜨리는 느낌을 유지하면 좋습니다.",
      "gabang_vn": "ㄱ của 가방 với VOT 27ms đã đặt đúng giữa vùng nặng (bên trái) và ngang (giữa) của âm thường, và F0 cũng cao hơn baseline +1.1 st nên không lệch nhiều khỏi cụm điểm của người bản ngữ. Trên la bàn phát âm, bạn gần như đã đến đúng vị trí, vì vậy hãy lấy cảm giác này làm điểm neo để so sánh với hai từ còn lại. Tuy nhiên nếu bạn mở nguyên âm ㅏ quá mạnh ngay từ đầu thì có thể bị kéo sang vùng âm căng, nên hãy thả lỏng môi và giữ cảm giác bật ra nhẹ nhàng.",
      "ggamansaek": "까만색의 ㄲ은 VOT 17ms로 nặng(왼쪽) 깊숙한 영역에 도달하지 못하고 가운데 평음 쪽으로 밀려나 있습니다. F0는 +1.8 st로 위쪽으로 올라가 있어 톤 감각은 잘 잡혀 있지만, 좌표로 보면 '위쪽인데 왼쪽이 부족한' 상태입니다. 더 왼쪽으로 이동하려면 입술과 혀뿌리를 한 박자 더 꽉 잠갔다가 아주 짧고 단단하게 터뜨리는 동작이 필요합니다. 손가락으로 목 앞쪽을 살짝 짚고 발음하면서, ㄱ 발음 때보다 더 단단한 압력이 느껴지는지 확인해 보세요.",
      "ggamansaek_vn": "ㄲ của 까만색 với VOT 17ms chưa đi sâu vào vùng nặng (bên trái) mà bị đẩy về phía âm thường ở giữa. F0 +1.8 st cho thấy cảm giác về tông cao đã được nắm bắt tốt, nhưng trên tọa độ thì đang ở trạng thái 'phía trên nhưng thiếu bên trái'. Để di chuyển sang bên trái hơn, bạn cần khóa môi và gốc lưỡi chặt thêm một nhịp rồi bật ra thật ngắn và chắc. Hãy đặt nhẹ ngón tay lên phía trước cổ khi phát âm và kiểm tra xem có cảm thấy áp lực căng chắc hơn so với khi phát âm ㄱ không.",
      "kadeu": "카드의 ㅋ은 VOT 98ms로 bật hơi(오른쪽) 영역에 깊이 도달해 기식 자체는 매우 훌륭하지만, F0가 -2.9 st로 ngang 아래로 가라앉으면서 좌표가 '오른쪽인데 아래쪽'에 찍혔습니다. 원어민 클러스터는 오른쪽 위에 있으므로, 같은 강한 바람을 유지하면서 모음 ㅏ의 시작 톤만 위로 끌어올리면 됩니다. '카!' 하고 외칠 때처럼 첫 순간의 음을 살짝 높게 잡는 연습을 해보세요 — 바람의 양은 지금 그대로면 충분합니다.",
      "kadeu_vn": "ㅋ của 카드 với VOT 98ms đã đi sâu vào vùng bật hơi (bên phải), luồng hơi rất tốt, nhưng F0 -2.9 st lại chìm xuống dưới ngang nên tọa độ rơi vào vị trí 'bên phải nhưng phía dưới'. Cụm điểm của người bản ngữ nằm ở phía trên bên phải, vì vậy bạn chỉ cần giữ nguyên luồng hơi mạnh như hiện tại và nâng tông khởi đầu của nguyên âm ㅏ lên cao. Hãy luyện như khi hô 'ㅋ!' — bắt đầu âm đầu tiên ở tông hơi cao một chút; lượng hơi giữ nguyên như bây giờ là đủ."
    },
    "encouragement": "세 음의 큰 방향은 이미 잡혔으니, 경음의 '꽉 잠그는 한 박자'만 더하면 훨씬 또렷해질 거예요!",
    "encouragement_vn": "Hướng lớn của ba âm bạn đã nắm rồi, chỉ cần thêm 'một nhịp khóa chặt' của âm căng nữa là phát âm sẽ rõ ràng hơn rất nhiều!",
