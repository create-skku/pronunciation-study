  "ai_feedback": {
    "error_analysis": {
      "summary": "세 파열음 모두 VOT가 과도하게 길어 평음·경음·격음의 시간 위계가 무너졌고, 음높이 위계는 격음만 두드러지게 솟아 있습니다.",
      "summary_vn": "Cả ba âm bật (가방·까만색·카드) đều có VOT quá dài khiến trật tự thời gian giữa 평음·경음·격음 bị xáo trộn, còn về cao độ thì chỉ riêng 격음 (카드) vọt lên rõ rệt.",
      "detail": "가방(평음)의 VOT가 176ms로 원어민 63ms의 약 2.8배에 달하고, 까만색(경음)도 106ms로 원어민 8ms 대비 13배 가까이 길게 측정됩니다. 카드(격음)의 VOT 153ms는 원어민 83ms보다 길긴 하나, 세 단어를 나란히 보면 평음>경음<격음이라는 시간 순서 자체가 뒤집혀 평음이 가장 긴 비정상적 패턴이 나타납니다. F0 패턴(semitone)에서는 가방 -6.0 st, 까만색 -3.2 st로 둘 다 baseline 아래에 머무는 반면 카드만 +6.6 st로 솟아, 격음의 고음 시작은 잘 살리지만 경음의 후두 긴장에 따른 상승은 부족합니다.",
      "detail_vn": "가방 (평음) có VOT 176ms — gấp khoảng 2.8 lần người bản ngữ (63ms), và 까만색 (경음) là 106ms — gấp gần 13 lần so với 8ms của bản ngữ. 카드 (격음) là 153ms, dài hơn bản ngữ 83ms, nhưng khi so ba từ thì thứ tự thời gian 평음>경음<격음 bị đảo ngược — 평음 lại là âm dài nhất, một mẫu hình bất thường. Về F0 (semitone), 가방 -6.0 st và 까만색 -3.2 st đều nằm dưới baseline, trong khi 카드 vọt lên +6.6 st — tức bạn tạo được cao độ cho 격음 nhưng chưa nâng được 경음 lên do thiếu căng thanh quản."
    },
    "cause": "베트남어에는 한국어식 평음/경음/격음 3중 구분이 없어 모든 무성 파열음을 '기식이 있는 하나의 범주'로 처리하는 습관이 굳어 있고, 그 결과 평음에도 격음 수준의 강한 기식을 얹어 VOT가 길어진 것으로 보입니다. 또한 경음을 만들 때 필요한 후두 긴장(목 조임) 동작이 베트남어 자음 체계에 없기 때문에, 까만색에서 VOT를 짧게 끊지 못하고 음높이도 올리지 못합니다. 격음의 음높이만 잘 올라가는 점은 베트남어 sắc 성조 감각이 살아있다는 신호로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ ba bậc 평음/경음/격음 như tiếng Hàn nên bạn thường xử lý mọi âm bật vô thanh thành 'một loại có hơi bật', dẫn đến cả 평음 cũng bị thêm hơi mạnh và VOT kéo dài. Ngoài ra, động tác căng thanh quản (siết cổ họng) cần cho 경음 không tồn tại trong tiếng Việt, nên ở 까만색 bạn không cắt ngắn được VOT và cũng không nâng được cao độ. Việc 격음 lên cao độ tốt cho thấy cảm giác thanh sắc (sắc) của tiếng Việt vẫn đang giúp bạn — đây là điểm mạnh.",
    "correction": {
      "main_focus": "평음의 기식을 과감히 줄여 '짧고 부드럽게' 시작하는 감각을 먼저 회복하는 것이 가장 시급합니다.",
      "main_focus_vn": "Ưu tiên hàng đầu là giảm mạnh hơi bật ở 평음 để khôi phục cảm giác 'bắt đầu ngắn và nhẹ'.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 평음·경음·격음을 번갈아 발음해, 평음에서는 바람이 거의 안 느껴지고 격음에서만 바람이 분명히 느껴지도록 차이를 몸으로 체감하기",
        "최소대립쌍(가-까-카)을 거울 앞에서 천천히 반복하며, 경음에서는 목에 가볍게 손을 얹어 후두가 조여지는 긴장감을 손끝으로 확인하기",
        "원어민 음원과 본인 녹음을 한 문장씩 번갈아 들으며 '평음이 가장 짧다'는 시간 순서를 귀로 비교·교정하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm, phát âm 평음·경음·격음 xen kẽ — ở 평음 hơi gần như không chạm tay, còn ở 격음 phải cảm nhận rõ luồng hơi đập vào tay; dùng cảm giác cơ thể để phân biệt.",
        "Lặp lại chậm cặp tối thiểu (가-까-카) trước gương, đặt nhẹ tay lên cổ ở 경음 để cảm nhận thanh quản siết lại bằng đầu ngón tay.",
        "Nghe xen kẽ từng câu của bản ngữ và bản ghi của chính mình, dùng tai để xác nhận và sửa lại trật tự '평음 là ngắn nhất'."
      ]
    },
    "overall": "전반적으로 모든 자음에 기식을 과하게 싣는 베트남어식 습관이 강하게 남아 있지만, 카드에서 음높이를 +6.6 st나 끌어올린 점은 격음의 음향적 특징을 이미 직관적으로 파악하고 있다는 분명한 강점입니다. 가장 큰 과제는 평음의 VOT를 절반 이하로 줄이는 것이고, 그다음이 경음의 후두 긴장을 살려 음높이를 baseline 위로 올리는 일입니다. 시간(VOT) 위계와 음높이(F0) 위계를 한 번에 다 잡으려 하지 말고, 먼저 평음을 '짧고 낮게'로 고정한 뒤 경음·격음으로 확장하는 순서가 효율적입니다. 지금 패턴은 T3(평음·격음 혼동) 유형에 가깝지만, 격음의 고음 감각이 살아 있어 회복 속도는 빠를 것으로 기대됩니다.",
    "overall_vn": "Nhìn chung, thói quen tiếng Việt 'thêm hơi mạnh vào mọi phụ âm' vẫn còn rõ, nhưng việc bạn nâng được cao độ 카드 lên +6.6 st cho thấy bạn đã trực giác nắm bắt được đặc trưng âm học của 격음 — đây là điểm mạnh rõ ràng. Nhiệm vụ lớn nhất là giảm VOT của 평음 xuống còn dưới một nửa, sau đó là tạo độ căng thanh quản cho 경음 để đẩy cao độ lên trên baseline. Đừng cố sửa cùng lúc cả trật tự thời gian (VOT) và trật tự cao độ (F0) — hãy cố định 평음 thành 'ngắn và thấp' trước rồi mới mở rộng sang 경음·격음. Mẫu hình hiện tại gần với loại T3 (lẫn 평음 với 격음), nhưng vì cảm giác cao độ cho 격음 đã có sẵn nên tốc độ tiến bộ sẽ nhanh.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방은 나침반의 ngang 중심에서 오른쪽(bật hơi)으로 크게 밀려나 있고, 동시에 아래쪽(huyền)으로 -6.0 st까지 가라앉아 '오른쪽 아래' 사분면에 자리 잡았습니다. 원어민 클러스터는 중앙에서 살짝 왼쪽 아래(VOT 63ms, -3.7 st)에 모여 있으므로, 좌표를 왼쪽으로 약 110ms만큼 당겨오는 것이 핵심입니다. 입술을 가볍게 떼면서 'ㄱ' 직후에 바람을 거의 흘리지 말고, 모음 'ㅏ'를 본인 baseline보다 살짝만 낮게 두세요. 손바닥에 바람이 거의 닿지 않을 정도로 짧고 부드럽게 시작하면 좌표가 자연스럽게 중앙 쪽으로 이동합니다.",
      "gabang_vn": "가방 hiện nằm lệch mạnh sang bên phải (bật hơi) khỏi trung tâm ngang, đồng thời chìm xuống phía dưới (huyền) tới -6.0 st — tức đang ở góc 'phải dưới' của la bàn. Cụm bản ngữ nằm hơi lệch trái-dưới trung tâm (VOT 63ms, -3.7 st), nên việc cốt lõi là kéo tọa độ sang trái khoảng 110ms. Hãy tách môi nhẹ, gần như không thả hơi sau 'ㄱ', và đặt nguyên âm 'ㅏ' chỉ thấp hơn baseline một chút. Khi hơi gần như không chạm vào lòng bàn tay — bắt đầu ngắn và nhẹ — tọa độ sẽ tự dịch về phía trung tâm.",
      "ggamansaek": "까만색은 nặng(왼쪽) 깊은 영역에 있어야 할 단어인데, 측정상 오른쪽(VOT 106ms)으로 한참 밀려나 있고 음높이도 -3.2 st로 ngang 아래에 머물러 '경음다움'이 두 축 모두에서 부족합니다. 원어민은 거의 왼쪽 끝(VOT 8ms)에 +1.3 st 위쪽으로 자리하므로, 좌표를 왼쪽-위 대각선으로 크게 당겨야 합니다. 발음 직전 목구멍을 살짝 조이고 숨을 잠시 멈춘 뒤 'ㄲ'을 짧게 터뜨리면 VOT가 줄어들고, 그 긴장 덕분에 'ㅏ'의 음높이도 자연스럽게 baseline 위로 올라옵니다. 손가락을 목에 가볍게 대 후두 떨림과 조임을 직접 확인하며 연습하세요.",
      "ggamansaek_vn": "까만색 lẽ ra phải nằm sâu ở vùng nặng (bên trái), nhưng đo được lại bị đẩy hẳn sang phải (VOT 106ms) và cao độ cũng chỉ -3.2 st — chìm dưới ngang, tức 'chất 경음' đang thiếu ở cả hai trục. Bản ngữ nằm gần như sát trái (VOT 8ms) và lên phía trên +1.3 st, nên cần kéo tọa độ theo đường chéo trái-trên rất mạnh. Hãy siết nhẹ cổ họng và nín hơi một khoảnh khắc trước khi bật ngắn 'ㄲ' — VOT sẽ giảm, và chính độ căng đó kéo cao độ 'ㅏ' lên trên baseline. Đặt nhẹ ngón tay lên cổ để cảm nhận trực tiếp độ rung và độ siết của thanh quản khi luyện.",
      "kadeu": "카드는 bật hơi(오른쪽) + sắc(위쪽)의 '오른쪽 위' 사분면이 정답인데, 좌표가 VOT 153ms·+6.6 st로 원어민 클러스터(83ms, +1.9 st)보다 더 바깥쪽으로 튀어나가 있습니다. 즉 방향은 정확히 맞췄지만 강도를 과하게 쓴 상태입니다. 음높이 감각은 격음의 핵심을 이미 잡고 있다는 분명한 강점이니, 이 톤은 유지하면서 기식만 70ms 정도 짧게 다듬으면 됩니다. 손바닥에 바람을 강하게 한 번 보내되 그 시간을 약간 짧게 끊는다고 상상하며 '카!'를 발음해 보세요.",
      "kadeu_vn": "카드 đúng phải nằm ở góc 'phải trên' — bật hơi (phải) + sắc (trên) — nhưng tọa độ của bạn (VOT 153ms, +6.6 st) đã vọt ra xa ngoài cụm bản ngữ (83ms, +1.9 st). Nghĩa là hướng hoàn toàn đúng, chỉ là cường độ hơi quá. Cảm giác cao độ đã nắm trúng cốt lõi của 격음 — đây rõ ràng là điểm mạnh, hãy giữ nguyên tông này và chỉ cần rút ngắn hơi bật khoảng 70ms. Hãy tưởng tượng vẫn thổi một luồng hơi mạnh vào lòng bàn tay nhưng cắt thời gian ngắn lại một chút, rồi phát âm '카!'."
    },
    "encouragement": "카드에서 격음의 고음 감각을 이미 정확히 잡고 계세요 — 이 강점을 기반으로 평음만 짧고 낮게 다듬으면 세 음이 빠르게 분리될 거예요!",
    "encouragement_vn": "Bạn đã nắm chính xác cảm giác cao độ của 격음 ở 카드 — chỉ cần dựa trên điểm mạnh này và làm 평음 ngắn-thấp lại, ba âm sẽ tách rời rất nhanh thôi!",
    "_source": "claude"
