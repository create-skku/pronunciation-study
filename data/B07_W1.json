  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 거의 원어민에 근접했으나, 평음 ㅂ과 경음 ㅃ이 둘 다 무기·평탄한 영역으로 모여 서로 구분되지 않습니다.",
      "summary_vn": "Âm bật hơi ㅍ (파) gần như đạt mức người bản ngữ, nhưng âm thường ㅂ (바) và âm căng ㅃ (빠) đều dồn vào vùng không bật hơi và bằng phẳng, không tách biệt được với nhau.",
      "detail": "바지의 VOT는 18ms 로 평음 기준치(약 20ms)에 잘 맞아 그 자체로는 적절하지만, F0 패턴이 baseline 보다 -5.3 st 로 원어민(-3.7 st)보다 더 깊게 가라앉아 있습니다. 빠르다는 VOT 0ms 로 경음의 무기 조건은 정확히 충족했고, F0 도 +2.6 st 로 위로 올라가 위계 방향은 맞으나 원어민(-0.4 st)에 비해 과하게 높이 띄워 부자연스러운 인상이 있습니다. 파란색은 VOT 66ms·F0 +1.6 st 로 원어민(60ms·+3.4 st)과 거의 일치해 가장 안정된 단어입니다. 결과적으로 ㅍ은 잘 분리되지만, ㅂ과 ㅃ 사이의 VOT 차이(18ms vs 0ms)는 작고 F0 격차에 의존하고 있어 위계가 불안정합니다.",
      "detail_vn": "VOT của 바지 là 18ms, khớp tốt với chuẩn âm thường (khoảng 20ms), nhưng đường F0 lại chìm xuống -5.3 st so với baseline, sâu hơn cả người bản ngữ (-3.7 st). 빠르다 có VOT 0ms — đáp ứng chính xác điều kiện không bật hơi của âm căng, và F0 lên +2.6 st cho thấy hướng phân cấp đúng, nhưng cao hơn người bản ngữ (-0.4 st) khá nhiều nên hơi gượng. 파란색 với VOT 66ms và F0 +1.6 st gần như trùng khít với người bản ngữ (60ms·+3.4 st), đây là từ ổn định nhất. Tóm lại, ㅍ phân tách tốt, nhưng khoảng cách VOT giữa ㅂ và ㅃ (18ms vs 0ms) khá hẹp và đang phụ thuộc vào F0, khiến trật tự phân cấp chưa vững."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음의 3중 구분이 없고 /b/ 와 /pʰ/ 두 범주만 존재하기 때문에, 강한 기식이 있는 ㅍ은 베트남어 /pʰ/ 에 대응시켜 쉽게 익혔지만 ㅂ과 ㅃ은 둘 다 베트남어 /b/ 영역으로 흡수되어 분리가 잘 되지 않습니다. 특히 경음의 핵심인 '후두 긴장(thanh môn căng)' 동작이 베트남어에 없어, ㅃ을 VOT 만 짧게 가져가고 후두 압력으로 단단함을 만들지 못해 F0 만 과하게 올려 보상하는 양상이 보입니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc như tiếng Hàn (평음·경음·격음), chỉ có /b/ và /pʰ/, nên ㅍ (có bật hơi mạnh) dễ ánh xạ sang /pʰ/ tiếng Việt và được học tốt, trong khi ㅂ và ㅃ đều bị hút vào vùng /b/ tiếng Việt và khó tách rời. Đặc biệt, động tác 'căng thanh môn (후두 긴장)' — yếu tố cốt lõi của âm căng — không tồn tại trong tiếng Việt, nên bạn chỉ rút ngắn VOT của ㅃ mà chưa tạo được độ chắc bằng áp lực thanh môn, và đang bù trừ bằng cách đẩy F0 lên quá cao.",
    "correction": {
      "main_focus": "ㅂ과 ㅃ을 '후두 긴장의 유무'로 분리하는 것 — VOT 길이 차이가 아니라 입술·후두의 단단함 차이로 구분하세요.",
      "main_focus_vn": "Tập trung tách ㅂ và ㅃ bằng 'có/không căng thanh môn' — phân biệt bằng độ chắc của môi và thanh môn, không phải bằng độ dài VOT.",
      "steps": [
        "거울 앞에서 입술 다물기 강도를 3단계(ㅂ 가볍게 / ㅃ 한 박자 더 꽉 / ㅍ 강하게 터뜨림)로 의식적으로 다르게 만들며 발음하기",
        "손바닥을 입 앞 5cm 에 두고 ㅂ·ㅃ·ㅍ 순서로 발음하며 바람 양 차이(거의 없음 → 거의 없음 → 강한 바람) 체감하기",
        "최소대립쌍 '바-빠-파' 를 본인 baseline 톤으로 워밍업한 뒤 천천히 반복하고, 본인 녹음과 원어민 음원을 번갈아 듣기"
      ],
      "steps_vn": [
        "Đứng trước gương và phát âm với 3 mức độ mím môi khác nhau một cách có ý thức (ㅂ nhẹ / ㅃ mím chặt thêm một nhịp / ㅍ bật mạnh)",
        "Đặt lòng bàn tay cách miệng 5cm, phát âm theo thứ tự ㅂ·ㅃ·ㅍ và cảm nhận sự khác biệt về luồng hơi (gần như không có → gần như không có → luồng hơi mạnh)",
        "Khởi động bằng tông baseline của chính bạn, sau đó lặp lại chậm cặp tối thiểu '바-빠-파', và nghe xen kẽ giữa bản ghi của bạn với bản của người bản ngữ"
      ]
    },
    "overall": "격음 ㅍ(파)은 VOT·F0 모두 원어민과 거의 일치하는 큰 강점이며, 경음 ㅃ도 VOT 무기 조건을 정확히 지키고 위계 방향을 위로 잡은 점은 매우 인상적입니다. 다만 평음 ㅂ과 경음 ㅃ이 VOT 측면에서 너무 가까워 F0 차이에만 기대고 있어, 후두 긴장이 더해지면 위계가 훨씬 안정될 것입니다. 베트남 학습자에게 가장 어려운 부분에서 격음을 거의 완성했다는 점은 청각 변별력이 이미 잘 자라고 있다는 신호입니다. 다음 단계는 ㅃ의 후두 단단함과 ㅂ의 자연스러운 톤 회복입니다.",
    "overall_vn": "Âm bật hơi ㅍ (파) gần như trùng khít với người bản ngữ ở cả VOT lẫn F0 — đây là điểm mạnh lớn, và việc bạn giữ chính xác điều kiện không bật hơi của ㅃ cùng với hướng phân cấp đi lên cũng rất ấn tượng. Tuy nhiên ㅂ và ㅃ đang quá gần nhau về VOT và chỉ dựa vào chênh lệch F0, nên nếu thêm được độ căng thanh môn, trật tự phân cấp sẽ vững hơn nhiều. Việc bạn gần như hoàn thiện được âm bật hơi — phần khó nhất với người Việt — cho thấy khả năng phân biệt thính giác của bạn đã phát triển tốt. Bước tiếp theo là độ chắc thanh môn của ㅃ và phục hồi tông tự nhiên cho ㅂ.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)는 나침반의 ngang 중앙에서 약간 왼쪽(VOT 18ms, nặng 쪽 가벼운 영역)에 자리잡았으나, 세로축으로는 baseline 보다 -5.3 st 까지 huyền 방향으로 깊이 내려가 원어민 좌표(-3.7 st)보다 한 칸 더 가라앉아 있습니다. 위치 자체는 평음 영역에 가깝지만 너무 아래로 처지면서 경음 ㅃ과 톤 차이로만 겨우 구분되는 상태입니다. 입술을 가볍게 떼고 모음 ㅏ를 본인의 자연스러운 말소리 톤(ngang) 으로 띄우듯 발음해, 좌표를 위로 약 1-2 st 끌어올리세요. 너무 단단히 다물지 말고 '편안한 인사말' 같은 톤을 떠올리면 좋습니다.",
      "baji_vn": "바지 (ㅂ) nằm hơi lệch trái khỏi tâm ngang của la bàn (VOT 18ms, vùng nặng nhẹ), nhưng trên trục dọc lại chìm xuống -5.3 st so với baseline theo hướng huyền, thấp hơn một bậc so với toạ độ người bản ngữ (-3.7 st). Vị trí thuộc đúng vùng âm thường, nhưng vì rơi quá sâu nên chỉ còn phân biệt được với ㅃ nhờ chênh lệch tông. Hãy nhả môi nhẹ và phát âm nguyên âm ㅏ ở tông nói chuyện tự nhiên (ngang) của bạn để kéo toạ độ lên khoảng 1-2 st. Đừng mím môi quá chặt — hãy nghĩ đến tông của một câu chào thoải mái.",
      "bbareuda": "빠르다(ㅃ)는 나침반 왼쪽 끝 nặng 영역(VOT 0ms) 에 정확히 안착했지만, 세로축이 +2.6 st 까지 sắc 방향으로 과하게 솟아 원어민 좌표(-0.4 st)보다 3 st 위로 떠 있습니다. 위계 방향(평음보다 위) 은 옳지만 톤만으로 경음을 만들고 있어, 입술 단단함과 후두 압력이 부족하다는 신호입니다. 입술을 한 박자 더 꽉 다물어 안에 압력을 모은 뒤 짧고 단단하게 터뜨리고, 모음은 평음보다 살짝만 높게 시작하세요. 좌표를 +1 st 부근으로 내려 원어민 클러스터에 가깝게 이동시키는 것이 목표입니다.",
      "bbareuda_vn": "빠르다 (ㅃ) đậu chính xác ở vùng nặng phía cực tả của la bàn (VOT 0ms), nhưng trục dọc lại vọt lên +2.6 st theo hướng sắc, cao hơn toạ độ người bản ngữ (-0.4 st) tới 3 st. Hướng phân cấp (cao hơn âm thường) là đúng, nhưng bạn đang tạo âm căng chỉ bằng tông — đây là dấu hiệu thiếu độ chắc của môi và áp lực thanh môn. Hãy mím môi thêm một nhịp để dồn áp lực bên trong rồi bật ra ngắn và chắc, nguyên âm chỉ cần bắt đầu cao hơn âm thường một chút. Mục tiêu là kéo toạ độ xuống khoảng +1 st để gần với cụm người bản ngữ hơn.",
      "paransaek": "파란색(ㅍ)은 나침반 오른쪽 bật hơi 영역(VOT 66ms) 과 위쪽 sắc 영역(+1.6 st) 이 모두 원어민 클러스터(60ms·+3.4 st) 안에 들어와 있어, 세 단어 중 가장 안정된 좌표입니다. F0 가 약 1.7 st 낮은 점만 미세 조정하면 거의 완벽합니다. 발음할 때 입술을 떼는 순간 배에서 짧게 '하' 하는 숨을 함께 밀어내며 모음 ㅏ를 baseline 보다 한 톤 높게 시작해 보세요. 이 단어는 본인 강점이므로 다른 단어 연습 전 워밍업으로 자주 사용하면 좋습니다.",
      "paransaek_vn": "파란색 (ㅍ) có cả VOT bên phải vùng bật hơi (66ms) lẫn F0 phía trên vùng sắc (+1.6 st) đều nằm trong cụm người bản ngữ (60ms·+3.4 st) — đây là toạ độ ổn định nhất trong ba từ. Chỉ cần tinh chỉnh F0 (đang thấp hơn khoảng 1.7 st) là gần như hoàn hảo. Khi phát âm, hãy đẩy ra một hơi 'ha' ngắn từ bụng ngay lúc nhả môi, và bắt đầu nguyên âm ㅏ cao hơn baseline một tông. Đây là điểm mạnh của bạn nên hãy dùng từ này làm bài khởi động trước khi luyện các từ khác."
    },
    "encouragement": "베트남 학습자가 가장 어려워하는 격음 ㅍ을 거의 원어민 수준으로 발음하고 있어요 — 청각이 이미 한국어 위계를 잡아가고 있다는 증거입니다!",
    "encouragement_vn": "Bạn đã phát âm ㅍ — âm khó nhất với người Việt — gần như ở trình độ người bản ngữ, đây là minh chứng rõ ràng rằng thính giác của bạn đang nắm bắt được trật tự phân cấp của tiếng Hàn!",
    "_source": "claude"
  },
