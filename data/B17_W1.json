  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음이 서로 가까운 음가로 모여 있어, 특히 격음의 기식과 평음의 짧은 VOT 가 반대 방향으로 어긋나 있습니다.",
      "summary_vn": "Ba âm bật bình(평음)·căng(경음)·bật hơi(격음) đang nằm quá gần nhau, đặc biệt là hơi bật của 격음 và VOT ngắn của 평음 đang lệch ngược hướng.",
      "detail": "바지(ㅂ)는 VOT 146ms 로 원어민 97ms 보다 약 50ms 길게 나와, 평음이라기보다 오히려 격음에 가까운 기식이 실리고 있습니다. 반대로 파란색(ㅍ)은 VOT 0ms 로 원어민 60ms 와 큰 차이가 있어, 격음에서 있어야 할 강한 바람이 거의 빠져 있습니다. 빠르다(ㅃ)는 VOT 0ms 로 경음의 짧은 VOT 자체는 잘 만들어졌습니다. F0 패턴(semitone)을 보면 평음 +3.5 st, 경음 +0.8 st, 격음 -3.5 st 로, 원어민이 보여주는 '평음 낮음 / 격음 높음' 위계가 학습자에게서는 거의 뒤집혀 있는 점이 가장 두드러집니다.",
      "detail_vn": "바지(ㅂ) có VOT 146ms, dài hơn người bản ngữ (97ms) khoảng 50ms, nên thay vì là 평음, nó lại mang nhiều hơi giống 격음 hơn. Ngược lại 파란색(ㅍ) có VOT 0ms, cách xa người bản ngữ (60ms), tức là hơi bật mạnh cần có ở 격음 gần như biến mất. 빠르다(ㅃ) có VOT 0ms — riêng phần VOT ngắn của âm căng thì làm khá tốt. Về F0 (semitone), 평음 +3.5 st, 경음 +0.8 st, 격음 -3.5 st — trật tự 'bình thấp / bật hơi cao' của người bản ngữ ở học viên gần như bị đảo ngược, đây là điểm nổi bật nhất."
    },
    "cause": "베트남어에는 한국어식 평·경·격 3중 구분이 없어, 학습자가 세 자음을 같은 범주로 인식하기 쉽습니다. 특히 베트남어 /b/ 의 영향으로 ㅂ에 과한 기식이 실리는 한편, 격음 ㅍ의 강한 기식과 그에 동반되는 높은 음높이는 베트남어에 없는 동작이라 자연스럽게 빠지게 됩니다. 그 결과 VOT 위계뿐 아니라 F0 위계까지 함께 뒤집히는 모습이 나타납니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc 평음·경음·격음 như tiếng Hàn, nên học viên dễ xếp cả ba phụ âm vào cùng một loại. Đặc biệt do ảnh hưởng của /b/ tiếng Việt, ㅂ bị thêm hơi quá mức, trong khi hơi bật mạnh của 격음 ㅍ cùng cao độ đi kèm — vốn không tồn tại trong tiếng Việt — lại bị lược bỏ một cách tự nhiên. Kết quả là không chỉ trật tự VOT mà cả trật tự F0 cũng bị đảo ngược.",
    "correction": {
      "main_focus": "ㅂ의 기식을 줄이고 ㅍ의 기식을 키워, 평음은 부드럽게·격음은 강하게 라는 '바람의 위계' 를 먼저 몸으로 만드는 것이 가장 시급합니다.",
      "main_focus_vn": "Ưu tiên hàng đầu là giảm hơi ở ㅂ và tăng hơi ở ㅍ, để cơ thể cảm nhận được 'thứ tự sức gió' — 평음 nhẹ nhàng, 격음 mạnh — trước tiên.",
      "steps": [
        "손바닥을 입 앞 약 5cm 에 두고 같은 모음(ㅏ) 으로 바·빠·파를 발음하며, 평음(부드러운 바람)·경음(거의 바람 없음)·격음(강한 바람) 세 종류의 바람 양 차이를 손으로 직접 확인하기.",
        "최소대립쌍 '바-빠-파' 를 천천히, 같은 모음 위에서 반복 녹음한 뒤, 원어민 음원과 본인 녹음을 번갈아 들으며 어느 자음에서 차이가 가장 큰지 귀로 비교하기.",
        "거울 앞에서 발음 직전 입술의 긴장도와 숨을 모으는 정도를 시각적으로 점검하기 — 평음은 입술을 가볍게, 경음은 입술과 목을 단단히 잡고 짧게, 격음은 숨을 충분히 모은 뒤 한 번에 내보내기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm, phát âm 바·빠·파 trên cùng nguyên âm ㅏ, dùng tay cảm nhận trực tiếp ba mức gió khác nhau: 평음 (gió nhẹ), 경음 (gần như không có gió), 격음 (gió mạnh).",
        "Lặp lại chậm cặp tối thiểu '바-빠-파' trên cùng nguyên âm và ghi âm, sau đó nghe xen kẽ với bản người bản ngữ để so sánh bằng tai xem phụ âm nào lệch nhiều nhất.",
        "Trước gương, kiểm tra trực quan độ căng môi và lượng hơi tích trước khi phát âm — 평음 môi thả lỏng, 경음 môi và cổ siết chặt và phát ngắn, 격음 tích đủ hơi rồi thả ra một lần."
      ]
    },
    "overall": "현재는 평음·경음·격음 세 자음이 서로 가까이 모여 있고, VOT 와 F0 위계 모두 원어민과 반대 방향으로 기울어 있는 상태입니다. 다만 빠르다(ㅃ)의 VOT 0ms 는 경음의 짧은 VOT 핵심을 이미 잘 잡은 부분으로, 이 감각을 anchor 로 삼아 양옆의 평음·격음을 다듬으면 빠르게 좋아질 수 있습니다. 가장 중요한 것은 셋을 동시에 신경 쓰지 않고, '바람의 양' 이라는 단일 축에서 위계를 먼저 만드는 것입니다. 발음 자체보다 손바닥과 거울을 활용한 신체 감각 훈련이 지금 단계에서는 훨씬 효과적입니다.",
    "overall_vn": "Hiện tại ba phụ âm 평음·경음·격음 đang nằm gần nhau, và cả trật tự VOT lẫn F0 đều nghiêng ngược lại so với người bản ngữ. Tuy vậy, VOT 0ms của 빠르다(ㅃ) cho thấy bạn đã nắm được điểm cốt lõi — VOT ngắn của âm căng — nên có thể dùng cảm giác này làm điểm neo để chỉnh hai bên 평음 và 격음, tiến bộ sẽ đến nhanh. Quan trọng nhất là không cố để ý cả ba cùng lúc, mà tạo thứ tự trên một trục duy nhất: 'lượng gió' trước. Ở giai đoạn này, luyện cảm giác cơ thể bằng lòng bàn tay và gương sẽ hiệu quả hơn nhiều so với việc chỉ chăm chăm vào âm thanh.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)는 나침반에서 본래 nặng 영역(VOT 짧고 부드러움) 근처에 있어야 하지만, 학습자 좌표는 VOT 146ms 로 오른쪽 bật hơi 영역까지 깊숙이 밀려 들어가 있습니다. 게다가 F0 도 본인 baseline 보다 +3.5 st 위로 떠올라, 위쪽 sắc 방향으로도 함께 이동해 있어 원어민 ㅂ 클러스터(왼쪽-약간 아래)에서 사선으로 멀리 벗어난 위치입니다. 입술을 가볍게 떼고 숨을 모으지 않은 채 짧게 끊어 발음하여, 좌표를 왼쪽 아래(짧은 VOT, 낮은 톤) 방향으로 끌어내려야 합니다. 손바닥에 닿는 바람을 '거의 느껴지지 않는 정도' 로 줄이는 것이 가장 직접적인 단서입니다.",
      "baji_vn": "바지(ㅂ) lẽ ra phải nằm gần vùng nặng (VOT ngắn, mềm) trên la bàn, nhưng tọa độ học viên với VOT 146ms đã bị đẩy sâu sang phải, vào vùng bật hơi. Thêm vào đó, F0 cao hơn baseline của chính bạn +3.5 st, tức là cũng dịch lên vùng sắc, khiến điểm này lệch chéo xa khỏi cụm ㅂ của người bản ngữ (trái-hơi dưới). Hãy mở môi nhẹ, không tích hơi, phát âm ngắt ngắn để kéo tọa độ về phía dưới-trái (VOT ngắn, cao độ thấp). Dấu hiệu trực tiếp nhất là giảm lượng gió chạm vào lòng bàn tay xuống mức 'gần như không cảm thấy'.",
      "bbareuda": "빠르다(ㅃ)는 VOT 0ms 로 나침반 왼쪽 nặng 영역의 핵심 좌표를 정확히 잡았습니다 — 가장 잘 발음된 자음입니다. 다만 F0 가 본인 baseline 위 +0.4 st, 원어민 패턴(-0.4 st)보다 살짝 위쪽으로 떠 있어, 위계상 위쪽 sắc 보다는 ngang(가운데) 부근에서 약간만 더 단단히 눌러 주는 느낌이 필요합니다. 입술과 목구멍을 동시에 단단히 잡은 뒤 짧게 터뜨리는 현재의 감각을 그대로 유지하면서, 톤만 너무 올리지 않도록 신경 쓰면 됩니다. 이 감각이 바로 평음·격음을 다듬을 때의 기준점이 됩니다.",
      "bbareuda_vn": "빠르다(ㅃ) với VOT 0ms đã bắt đúng tọa độ cốt lõi vùng nặng phía trái trên la bàn — đây là phụ âm bạn phát âm tốt nhất. Chỉ có F0 cao hơn baseline +0.4 st, hơi nhỉnh hơn so với mẫu người bản ngữ (-0.4 st), nên về trật tự, thay vì lên hẳn vùng sắc, hãy giữ ở gần ngang (giữa) rồi chỉ siết chặt thêm một chút. Hãy duy trì cảm giác hiện tại — môi và cổ họng siết đồng thời rồi bật ngắn — và chỉ chú ý đừng đẩy cao độ lên quá. Cảm giác này chính là điểm chuẩn để chỉnh hai âm còn lại.",
      "paransaek": "파란색(ㅍ)은 나침반에서 오른쪽 bật hơi 영역 깊숙이, 동시에 위쪽 sắc 영역에 있어야 하지만, 학습자 좌표는 VOT 0ms·F0 -0.2 st 로 오히려 빠르다(ㅃ)와 거의 같은 왼쪽-가운데 자리에 머물러 있습니다. 격음에서 가장 중요한 '강한 기식 + 높은 톤' 두 축이 모두 빠져 있는 상태입니다. 발음 직전 가슴 위쪽에 숨을 한 번 가득 모은 뒤, 입술을 열면서 그 숨을 한꺼번에 손바닥까지 닿게 내보내는 동작으로 좌표를 오른쪽 위로 끌어올리세요. 같은 ㅏ 모음 위에서 '빠 — 파' 를 번갈아 발음하며, 파에서만 손바닥에 확실한 바람이 닿는지 매번 확인하는 것이 좋은 점검 방법입니다.",
      "paransaek_vn": "파란색(ㅍ) lẽ ra phải nằm sâu trong vùng bật hơi bên phải, đồng thời ở vùng sắc phía trên trên la bàn, nhưng tọa độ học viên với VOT 0ms và F0 -0.2 st lại đang ở vị trí trái-giữa gần như trùng với 빠르다(ㅃ). Cả hai trục quan trọng nhất của 격음 — 'hơi bật mạnh + cao độ cao' — đều đang thiếu. Trước khi phát âm, hãy hít đầy hơi ở phần ngực trên một lần, rồi khi mở môi đẩy toàn bộ hơi đó ra cho đến khi chạm lòng bàn tay, để kéo tọa độ lên phía trên-phải. Một cách kiểm tra tốt là phát âm xen kẽ '빠 — 파' trên cùng nguyên âm ㅏ và mỗi lần đều xác nhận chỉ có 파 mới làm lòng bàn tay cảm nhận rõ gió."
    },
    "encouragement": "빠르다(ㅃ)의 짧은 VOT 를 이미 잡았다는 건 큰 출발점입니다 — 이 감각을 anchor 로 양옆을 다듬으면 빠르게 좋아질 거예요!",
    "encouragement_vn": "Việc bạn đã nắm được VOT ngắn của 빠르다(ㅃ) là một điểm khởi đầu rất lớn — dùng cảm giác này làm điểm neo để chỉnh hai âm còn lại, bạn sẽ tiến bộ rất nhanh!",
    "_source": "claude"
  },
