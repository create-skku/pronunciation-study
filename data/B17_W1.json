  "ai_feedback": {
    "error_analysis": {
      "summary": "세 파열음의 VOT가 모두 짧고 평탄해, 평음·경음·격음의 구분이 아직 형성되지 않은 단계입니다.",
      "summary_vn": "VOT của ba âm bật (바지·빠르다·파란색) đều ngắn và phẳng, sự phân biệt giữa 평음·경음·격음 vẫn chưa hình thành rõ ràng.",
      "detail": "바지(평음)의 VOT가 60ms로 원어민 97ms보다 짧게 측정되었고, 파란색(격음)의 VOT는 21ms로 원어민 60ms의 1/3 수준에 머물렀습니다. 빠르다(경음)는 VOT 16ms로 원어민 0ms보다 오히려 길게 나와 후두 긴장 없이 살짝 풀린 상태로 발음된 것으로 보입니다. F0 패턴(semitone)을 보면 평음 -3.5 / 경음 1.5 / 격음 1.5로, 경음과 격음이 같은 높이에 머물러 위계의 상단이 분리되지 않았습니다. 결과적으로 세 자음의 VOT가 16~60ms 구간에 몰려 있어 청각적으로 비슷하게 들릴 가능성이 큽니다.",
      "detail_vn": "VOT của 바지(평음) đo được 60ms, ngắn hơn người bản xứ (97ms); 파란색(격음) chỉ đạt 21ms, bằng khoảng 1/3 của người bản xứ (60ms). 빠르다(경음) có VOT 16ms, thậm chí dài hơn người bản xứ (0ms), cho thấy thanh quản chưa được căng đủ. Về F0 (semitone): 평음 -3.5 / 경음 1.5 / 격음 1.5 — 경음 và 격음 nằm cùng một độ cao, phần trên của hệ thống phân tầng chưa tách ra. Kết quả là VOT của cả ba âm dồn vào khoảng 16~60ms, nghe sẽ khá giống nhau."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 대립이 없고, 베트남어 /b/·/p/ 체계는 기식의 양과 후두 긴장으로 음소를 가르지 않습니다. 그래서 평음은 베트남어 /b/처럼 무기식으로 짧아지고, 격음은 강한 기식이 부족해 평음 쪽으로 끌려오며, 경음은 후두를 단단히 잠그는 동작 자체가 모국어에 없어 평음과 잘 분리되지 않습니다. 결국 세 자음이 비슷한 VOT·F0 구간으로 수렴하는 'T1 — 3지 미변별' 패턴이 나타나고 있습니다.",
    "cause_vn": "Tiếng Việt không có hệ thống đối lập ba bậc 평음·경음·격음 như tiếng Hàn, và /b/·/p/ trong tiếng Việt không phân biệt nhau bằng lượng hơi bật hay độ căng thanh quản. Vì vậy 평음 bị rút ngắn giống /b/ tiếng Việt (không bật hơi), 격음 thiếu luồng hơi mạnh nên bị kéo về phía 평음, còn 경음 thì do động tác khóa chặt thanh quản vốn không có trong tiếng mẹ đẻ nên khó tách khỏi 평음. Kết quả là cả ba âm hội tụ về cùng vùng VOT·F0 — đúng kiểu 'T1 — chưa phân biệt 3 bậc'.",
    "correction": {
      "main_focus": "세 자음을 동시에 고치기보다, 입 앞 손바닥에 닿는 '바람의 양' 차이부터 몸으로 만들어 격음·평음·경음의 위계를 먼저 세우세요.",
      "main_focus_vn": "Thay vì sửa cả ba âm cùng lúc, hãy bắt đầu bằng cách dùng lòng bàn tay đặt trước miệng để cảm nhận sự khác biệt 'lượng hơi' — từ đó xây dựng trật tự 격음 > 평음 > 경음 trước.",
      "steps": [
        "손바닥을 입 앞 5cm에 대고 '파–바–빠'를 천천히 반복하며, 파에서 가장 강한 바람·바에서 부드러운 바람·빠에서 거의 바람이 없는 짧고 단단한 느낌의 세 단계 차이를 손으로 확인하세요.",
        "거울 앞에서 최소대립쌍(바–빠–파)을 발음할 때 입술이 떨어지는 순간과 그 직후의 숨 길이를 눈으로 비교하고, 격음은 입을 연 뒤에도 'h'가 더 길게 이어지는 모양을 만드세요.",
        "원어민 음원과 본인 녹음을 한 쌍씩 번갈아 들으며, 자기 baseline 톤을 기준으로 경음·격음을 한 음 정도 위로 띄우는 워밍업을 발화 직전에 짧게 하세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm và lặp lại chậm '파–바–빠', cảm nhận bằng tay ba mức khác nhau: 파 — luồng hơi mạnh nhất, 바 — hơi nhẹ vừa, 빠 — gần như không có hơi, ngắn và chắc.",
        "Trước gương, phát âm cặp tối thiểu (바–빠–파), quan sát khoảnh khắc môi tách ra và độ dài luồng hơi sau đó; với 격음 hãy tạo hình miệng sao cho âm 'h' kéo dài rõ hơn sau khi môi mở.",
        "Nghe xen kẽ giọng người bản xứ và bản ghi của bạn theo từng cặp; trước khi nói, làm động tác khởi động ngắn để nâng 경음·격음 lên cao hơn baseline của chính bạn khoảng một bậc."
      ]
    },
    "overall": "현재는 세 파열음의 VOT가 16~60ms 좁은 구간에 몰려 있고 F0 상단도 분리되지 않아 'T1 — 3지 미변별' 단계에 가깝습니다. 다만 평음에서 F0가 다른 두 자음보다 약 5 st 낮게 안정적으로 내려가 있다는 점은 분명한 강점입니다 — 음정 위계의 '바닥'은 이미 잡혀 있다는 뜻입니다. 앞으로는 격음의 기식량과 경음의 후두 긴장, 이 두 가지 위쪽 동작을 키우는 데 집중하면 위계가 빠르게 펼쳐질 것입니다. 측정이 세 단어 모두 안정적으로 잡힌 만큼, 다음 녹음에서 변화도 또렷이 확인할 수 있을 거예요.",
    "overall_vn": "Hiện tại VOT của cả ba âm bật đều dồn vào khoảng hẹp 16~60ms và phần trên của F0 cũng chưa tách ra — gần với giai đoạn 'T1 — chưa phân biệt 3 bậc'. Tuy nhiên, việc F0 ở 평음 hạ xuống thấp hơn hai âm còn lại khoảng 5 semitone một cách ổn định là một điểm mạnh rõ ràng — 'phần đáy' của hệ thống cao độ đã được thiết lập. Tiếp theo, hãy tập trung vào hai động tác phía trên: tăng luồng hơi cho 격음 và tăng độ căng thanh quản cho 경음 — hệ thống sẽ mở ra nhanh chóng. Vì cả ba từ đều đo được ổn định, bạn sẽ dễ dàng thấy được sự thay đổi trong bản ghi lần sau.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)는 VOT 60ms로 원어민 97ms보다 짧아, 나침반에서 nặng(왼쪽) 쪽으로 다소 치우쳐 있는 위치입니다. F0 패턴은 baseline 대비 -3.5 st로 원어민(-3.7 st)과 거의 같은 깊이의 아래쪽(huyền 영역)에 잘 안착해 있다는 점이 강점입니다. 위치를 오른쪽(bật hơi 방향)으로 살짝만 더 옮긴다고 생각하면서, 입술이 떨어진 뒤 'ㅂ' 다음의 'ㅏ'가 시작되기까지 한 박자만 더 부드럽게 늘려 보세요. 그러면 평음다운 여유 있는 무게감이 살아납니다.",
      "baji_vn": "바지(ㅂ) có VOT 60ms, ngắn hơn người bản xứ (97ms), nên trên la bàn vị trí hơi lệch về phía nặng (bên trái). Tuy nhiên, mẫu F0 ở mức -3.5 st so với baseline gần như trùng với người bản xứ (-3.7 st) — bạn đã 'đậu' rất tốt ở vùng huyền (phía dưới), đây là điểm mạnh. Hãy hình dung kéo vị trí dịch nhẹ sang phải (về phía bật hơi): sau khi môi mở, kéo dài thêm một nhịp nhỏ trước khi 'ㅏ' bắt đầu. Khi đó cảm giác trọng lượng thong thả của 평음 sẽ hiện ra.",
      "bbareuda": "빠르다(ㅃ)는 VOT 16ms로 원어민 0ms보다 길게 나와, 나침반의 nặng 깊은 영역(왼쪽 끝)에 닿지 못하고 가운데 쪽으로 떠 있는 상태입니다. F0는 baseline 대비 +1.5 st로 원어민(-0.4 st)보다 오히려 약간 위쪽에 있는데, 이는 후두 긴장 대신 톤만 올라간 모양새입니다. 좌표를 더 왼쪽으로 끌어오려면 발음 직전 목을 살짝 닫아 두었다가 입술을 '톡' 짧고 단단하게 터뜨리세요 — 바람이 거의 안 나가야 정상입니다. 그러면 가운데서 왼쪽 끝으로 위치가 옮겨집니다.",
      "bbareuda_vn": "빠르다(ㅃ) có VOT 16ms, dài hơn người bản xứ (0ms), nên trên la bàn vị trí chưa chạm tới vùng sâu nặng (đầu mút bên trái) mà còn nổi ở giữa. F0 +1.5 st so với baseline thậm chí hơi cao hơn người bản xứ (-0.4 st) — tức là bạn nâng cao độ thay vì căng thanh quản. Để kéo tọa độ về phía trái hơn, hãy khép nhẹ thanh quản trước khi phát âm rồi bật môi thật ngắn và chắc — gần như không có hơi bay ra mới đúng. Khi đó vị trí sẽ dịch từ giữa sang đầu mút bên trái.",
      "paransaek": "파란색(ㅍ)은 VOT 21ms로 원어민 60ms의 약 1/3 수준이라, 나침반에서 bật hơi(오른쪽 끝)로 충분히 뻗어 나가지 못하고 평음 영역 근처에 머물러 있습니다. F0는 +1.5 st로 baseline보다는 위쪽이지만 원어민(+3.4 st)보다 약 2 st 낮아, sắc(위) 방향으로도 한 칸 더 올라가야 할 위치입니다. 손바닥을 입 앞에 대고 'ㅍ' 직후 'h' 소리가 손에 또렷이 닿을 만큼 바람을 길게 보내면서, 모음 'ㅏ'를 평소보다 한 음 위에서 시작하세요. 오른쪽-위 대각선으로 좌표를 동시에 이동시키는 느낌입니다.",
      "paransaek_vn": "파란색(ㅍ) có VOT 21ms, chỉ bằng khoảng 1/3 người bản xứ (60ms), nên trên la bàn vị trí chưa vươn tới đầu mút bật hơi (bên phải) mà còn loanh quanh vùng 평음. F0 +1.5 st tuy cao hơn baseline nhưng vẫn thấp hơn người bản xứ (+3.4 st) khoảng 2 st — bạn cần đi thêm một nấc theo hướng sắc (phía trên). Hãy đặt lòng bàn tay trước miệng và đẩy luồng hơi đủ dài để âm 'h' sau 'ㅍ' chạm rõ vào tay, đồng thời bắt đầu nguyên âm 'ㅏ' cao hơn bình thường một bậc. Cảm giác như đang dịch tọa độ theo đường chéo phải-trên cùng lúc."
    },
    "encouragement": "평음의 낮은 톤이 이미 안정적으로 자리 잡혀 있으니, 위쪽 두 자리(격음·경음)만 채우면 위계가 빠르게 완성될 거예요 — 충분히 해낼 수 있습니다!",
    "encouragement_vn": "Cao độ thấp của 평음 đã được thiết lập rất ổn định rồi — chỉ cần lấp đầy hai vị trí phía trên (격음·경음) là hệ thống sẽ hoàn chỉnh nhanh chóng. Bạn nhất định làm được!",
