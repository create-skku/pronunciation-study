  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음이 비슷한 음가로 모여 위계가 거의 형성되지 않은 단계입니다.",
      "summary_vn": "Ba phụ âm 평음·경음·격음 đang phát âm gần giống nhau, hệ thống phân biệt ba bậc gần như chưa hình thành.",
      "detail": "다리는 VOT 0ms 로 원어민 44ms 보다 훨씬 짧고 F0 가 baseline 보다 +4.3 st 위로 떠 있어 평음이 오히려 경음·격음 영역으로 들어가 있습니다. 따뜻하다는 VOT 0ms 로 경음 목표 자체에는 부합하지만 F0 가 -4.1 st 로 아래로 가라앉아 후두 긴장 대신 낮은 톤으로 처리한 인상입니다. 타다는 VOT 19ms 로 원어민 84ms 의 1/4 수준이라 격음 특유의 강한 기식이 거의 없고, 결과적으로 세 단어 VOT 가 0·0·19ms 로 거의 한 점에 모여 있습니다.",
      "detail_vn": "다리 có VOT 0ms, ngắn hơn nhiều so với 44ms của người bản ngữ, và F0 cao hơn baseline +4.3 st, khiến âm 평음 lại rơi vào vùng của 경음·격음. 따뜻하다 có VOT 0ms phù hợp mục tiêu 경음, nhưng F0 lại tụt -4.1 st xuống dưới, cho thấy bạn dùng giọng thấp thay vì thắt thanh hầu. 타다 chỉ có VOT 19ms, bằng khoảng 1/4 so với 84ms của người bản ngữ, gần như không có luồng hơi mạnh đặc trưng của 격음, và kết quả là VOT của ba từ (0·0·19ms) gần như chụm lại một điểm."
    },
    "cause": "베트남어에는 한국어식 평·경·격 3중 대립이 없고 유·무성 2중 대립만 있어, 세 자음을 같은 무기식 범주로 묶어 발음하기 쉽습니다. 특히 후두 긴장(경음)과 강한 기식(격음)은 베트남어에 존재하지 않는 동작이라 동시에 약하게 나타나며, 그 결과 VOT 차이가 거의 없는 평탄한 발음이 됩니다. 위계가 무너지면서 F0 가 자음 식별의 보조 단서 역할을 못 하고 단어마다 들쭉날쭉 움직이는 것도 이 단계의 전형적인 모습입니다.",
    "cause_vn": "Tiếng Việt không có hệ đối lập ba bậc 평·경·격 như tiếng Hàn mà chỉ có đối lập hữu thanh/vô thanh, nên người học dễ gộp cả ba phụ âm vào cùng một nhóm vô khí. Đặc biệt động tác thắt thanh hầu (경음) và bật hơi mạnh (격음) đều không tồn tại trong tiếng Việt, nên cả hai đều yếu cùng lúc, dẫn đến VOT gần như không khác nhau. Khi hệ phân bậc sụp đổ, F0 mất vai trò hỗ trợ nhận diện phụ âm và dao động lộn xộn giữa các từ — đây là dấu hiệu điển hình của giai đoạn này.",
    "correction": {
      "main_focus": "셋을 한꺼번에 고치려 하지 말고, 손바닥 앞 바람의 양으로 '격음(타) 강한 바람 — 평음(다) 부드러운 바람 — 경음(따) 거의 바람 없음' 이 세 단계 차이부터 몸으로 만드는 것이 가장 중요합니다.",
      "main_focus_vn": "Đừng cố sửa cả ba cùng lúc — quan trọng nhất là dùng lòng bàn tay trước miệng để cảm nhận ba mức luồng hơi: 격음(타) hơi mạnh — 평음(다) hơi nhẹ — 경음(따) gần như không có hơi.",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 '타-다-따' 를 천천히 반복하며 바람의 양 차이를 손으로 느끼기",
        "최소대립쌍 '다-따-타' 를 원어민 음원과 본인 녹음을 번갈아 들으며 VOT 길이 차이를 귀로 비교하기",
        "녹음 전 '아—' 로 본인 baseline 톤을 잡은 뒤, 경음은 톤을 살짝 올리고 후두를 단단히 조이는 워밍업하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm, đọc chậm '타-다-따' và cảm nhận sự khác nhau của luồng hơi bằng tay",
        "Đọc cặp tối thiểu '다-따-타', luân phiên nghe bản người bản ngữ và bản ghi của bạn để so sánh độ dài VOT bằng tai",
        "Trước khi ghi âm, phát âm '아—' để lấy baseline giọng của mình, sau đó luyện 경음 bằng cách nâng nhẹ tông và siết chặt thanh hầu"
      ]
    },
    "overall": "현재는 평·경·격 세 자음이 한 점에 모여 있는 T1 단계로, 가장 흔한 베트남 학습자 출발점입니다. 다만 따뜻하다에서 VOT 0ms 를 정확히 짚어낸 점은 경음의 무기식 목표를 이미 몸이 알고 있다는 좋은 신호이고, 여기에 후두 긴장 한 가지만 더 얹으면 경음이 먼저 분리됩니다. 다음으로 타다의 기식을 키워 격음을 오른쪽으로 밀어내면 자연히 평음 다리가 가운데 자리를 찾게 됩니다. 셋을 동시에 고치기보다 경음→격음→평음 순으로 한 단계씩 분리하는 전략이 효과적입니다.",
    "overall_vn": "Hiện tại bạn đang ở giai đoạn T1, nơi ba phụ âm 평·경·격 chụm lại một điểm — đây là điểm xuất phát phổ biến nhất của người học Việt Nam. Tuy nhiên, việc bạn giữ chính xác VOT 0ms ở 따뜻하다 là tín hiệu tốt cho thấy cơ thể đã nắm được mục tiêu vô khí của 경음; chỉ cần thêm động tác thắt thanh hầu là 경음 sẽ tách ra trước. Tiếp theo, tăng luồng hơi ở 타다 để đẩy 격음 sang phải, và 평음 다리 sẽ tự nhiên tìm được vị trí ở giữa. Hãy tách từng bậc theo thứ tự 경음 → 격음 → 평음, thay vì sửa cả ba cùng lúc.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "dari": "다리는 나침반에서 nặng 쪽 왼편 깊은 영역에 머물러 있습니다. VOT 0ms 로 원어민 44ms 보다 훨씬 왼쪽이고, F0 가 baseline 보다 +4.3 st 위로 떠 있어 좌표가 위쪽 sắc 방향으로도 밀려 있습니다. 평음 다리는 본래 나침반 가운데, 약간 huyền 아래쪽에 자리해야 합니다 — 입술을 부드럽게 떼면서 손바닥에 닿는 바람을 살짝만 만들고, 톤은 평탄하게 살짝 내려 보세요. '다' 의 모음을 시작할 때 목을 조이지 말고 편안하게 두는 것이 핵심입니다.",
      "dari_vn": "다리 đang nằm sâu về phía bên trái nặng trên la bàn phát âm. VOT 0ms khiến nó lệch hẳn về trái so với 44ms của người bản ngữ, và F0 cao hơn baseline +4.3 st đẩy tọa độ lên phía trên sắc. Vốn dĩ 평음 다리 phải nằm gần trung tâm, hơi chếch xuống huyền — hãy mở môi nhẹ nhàng, tạo một luồng hơi nhỏ chạm vào lòng bàn tay, và hạ tông xuống một chút cho phẳng. Điểm cốt lõi là không siết cổ họng khi bắt đầu nguyên âm '다'.",
      "ddatteut": "따뜻하다는 나침반 왼쪽 nặng 영역에는 잘 들어와 있습니다 — VOT 0ms 로 원어민과 정확히 일치합니다. 하지만 F0 가 baseline 보다 -4.1 st 아래로 떨어져 huyền 깊은 곳에 가라앉아 있는데, 경음 목표 위치는 왼쪽이면서 동시에 살짝 sắc 위쪽이어야 합니다. 후두를 단단히 조이고 톤을 살짝 올린 채로 '따' 를 짧고 단단하게 끊어 내 보세요. 가슴이 아니라 목 안쪽 깊은 곳에서 작은 '꽉' 하는 잠금을 만든 뒤 터뜨리는 느낌이 도움이 됩니다.",
      "ddatteut_vn": "따뜻하다 đã vào đúng vùng nặng bên trái la bàn — VOT 0ms khớp chính xác với người bản ngữ. Tuy nhiên F0 tụt xuống -4.1 st dưới baseline, chìm sâu vào vùng huyền, trong khi vị trí mục tiêu của 경음 phải vừa lệch trái vừa hơi nhích lên phía sắc. Hãy siết chặt thanh hầu, nâng nhẹ tông và bật âm '따' thật ngắn, thật rắn. Cảm giác đúng là tạo một cái 'khoá' nhỏ sâu trong cổ họng (không phải ngực) rồi mới bung ra.",
      "tada": "타다는 나침반 오른쪽 bật hơi 영역으로 가야 하는데 아직 가운데 부근에 머물러 있습니다. VOT 19ms 는 원어민 84ms 의 1/4 수준이라 격음에 필요한 강한 바람이 거의 없는 상태입니다. F0 는 원어민과 +0.2 st 로 거의 일치해 위계의 톤 축은 잘 잡고 있다는 점이 강점입니다 — 이제 톤은 그대로 두고 오직 바람의 양만 더 키우면 됩니다. 손바닥을 입 앞 5cm 에 두고 '타' 를 발음할 때 손바닥이 확실히 흔들릴 정도로 'ㅌ' 직후 숨을 한 번에 강하게 내보내 보세요.",
      "tada_vn": "타다 cần đi sang vùng bật hơi bên phải la bàn, nhưng hiện vẫn loanh quanh khu trung tâm. VOT 19ms chỉ bằng 1/4 mức 84ms của người bản ngữ, gần như chưa có luồng hơi mạnh cần thiết cho 격음. Điểm tốt là F0 lệch chỉ +0.2 st so với người bản ngữ — trục tông của hệ phân bậc bạn đã nắm được; giờ chỉ cần giữ nguyên tông và tăng mạnh lượng hơi. Đặt lòng bàn tay cách miệng 5cm và khi đọc '타', bật một luồng hơi đủ mạnh ngay sau 'ㅌ' để lòng bàn tay rung rõ rệt."
    },
    "encouragement": "따뜻하다의 VOT 와 타다의 톤 축은 이미 정확합니다 — 남은 한 조각씩만 채우면 위계가 빠르게 살아납니다.",
    "encouragement_vn": "VOT của 따뜻하다 và trục tông của 타다 đã chính xác rồi — chỉ cần bổ sung từng mảnh còn lại là hệ phân bậc sẽ nhanh chóng hiện ra.",
