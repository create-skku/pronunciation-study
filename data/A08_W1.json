  "ai_feedback": {
    "error_analysis": {
      "summary": "세 파열음의 VOT 와 F0 위계가 거의 형성되지 않아 평음·경음·격음이 한 범주로 모이는 단계입니다.",
      "summary_vn": "VOT và F0 của ba âm tắc gần như chưa có thứ bậc, nên 평음·경음·격음 (âm thường·âm căng·âm bật hơi) đang gộp thành một nhóm.",
      "detail": "바지(ㅂ) 의 VOT 는 1ms, 빠르다(ㅃ) 9ms, 파란색(ㅍ) 0ms 로 측정되어, 원어민 기준(97 / 0 / 60ms) 과 비교하면 격음의 기식이 거의 사라지고 평음·격음이 똑같이 0ms 부근에서 만나고 있습니다. F0(ㅏ) pattern_st 도 -4.4 / -3.7 / 6.0 으로 평음과 경음의 톤 차이가 거의 없고(원어민은 -3.7 / -0.4), 격음만 +2.7 ST 정도 위로 도드라집니다. 즉 'ㅂ ≈ ㅃ' 이 한 덩어리, 'ㅍ' 만 톤으로 살짝 띄워서 구분하는 패턴입니다. 기식의 축은 전반적으로 무너졌고, 톤의 축은 격음에만 부분적으로 작동하고 있는 상태입니다.",
      "detail_vn": "VOT của 바지(ㅂ) là 1ms, 빠르다(ㅃ) 9ms, 파란색(ㅍ) 0ms, so với chuẩn người bản ngữ (97 / 0 / 60ms) thì hơi bật của âm 격음 gần như biến mất và 평음 và 격음 cùng tụ về khoảng 0ms. F0(ㅏ) pattern_st cũng là -4.4 / -3.7 / 6.0 — chênh lệch cao độ giữa 평음 và 경음 gần như bằng không (người bản ngữ là -3.7 / -0.4), chỉ có 격음 nhô lên khoảng +2.7 ST. Nghĩa là 'ㅂ ≈ ㅃ' đang dính làm một, chỉ có 'ㅍ' được nhấc lên bằng cao độ. Trục hơi bật về tổng thể đã sụp, còn trục cao độ chỉ hoạt động một phần ở 격음."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 대립이 없어 셋을 비슷한 자음으로 인식하기 쉽습니다. 특히 격음의 강한 기식과 경음의 후두 긴장 둘 다 베트남어에 없는 동작이라, 학습자는 자연스럽게 베트남어 /b/ 에 가까운 무기식·짧은 폐쇄로 세 자음을 모두 만들게 됩니다. 그 결과 VOT 가 모두 0ms 부근으로 평탄해지고, 부족한 자음 구분을 톤(F0) 에 의지해 격음만 살짝 띄우는 보상 전략이 나타납니다.",
    "cause_vn": "Tiếng Việt không có sự đối lập 3 chiều 평음·경음·격음 như tiếng Hàn, nên người học dễ tri nhận cả ba thành một loại phụ âm gần giống nhau. Hơi bật mạnh của 격음 và độ căng thanh quản của 경음 đều là động tác không có trong tiếng Việt, nên người học tự nhiên phát âm cả ba bằng kiểu vô hơi, đóng môi ngắn gần như /b/ tiếng Việt. Kết quả là VOT đều phẳng quanh 0ms, và để bù cho sự thiếu phân biệt phụ âm, người học dựa vào cao độ (F0) để chỉ nhấc 격음 lên một chút.",
    "correction": {
      "main_focus": "기식의 양(바람 세기)에 평음·경음·격음 3단계 차이를 만드는 것 — 특히 격음 ㅍ 에 강한 바람을 다시 넣는 일이 1순위입니다.",
      "main_focus_vn": "Tạo ra sự khác biệt 3 cấp về lượng hơi bật giữa 평음·경음·격음 — đặc biệt ưu tiên số 1 là đưa hơi bật mạnh trở lại cho 격음 ㅍ.",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 '바-빠-파' 를 천천히 발음하며 바람의 양이 '부드럽게-거의 없음-세게' 세 단계로 다르게 느껴지는지 매번 확인하기.",
        "최소대립쌍 '바-빠-파' 를 한 호흡에 묶어 연습하되, 본인 녹음을 PRAAT 파형으로 열어 폐쇄 직후 첫 칸의 너비가 짧음-짧음-넓음 순으로 보이는지 시각으로 점검하기.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 격음의 'h 같은 숨' 길이를 의식적으로 흉내내고, 경음은 목에 살짝 힘을 준 뒤 멈췄다가 짧고 단단하게 터뜨리는 감각을 반복 연습하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm và phát âm chậm '바-빠-파', mỗi lần kiểm tra xem lượng hơi có khác nhau theo 3 cấp 'nhẹ - gần như không có - mạnh' hay không.",
        "Luyện cặp tối thiểu '바-빠-파' trong một hơi, mở bản ghi của bản thân bằng PRAAT và kiểm tra bằng mắt xem độ rộng ô đầu tiên ngay sau khi đóng môi có theo thứ tự ngắn-ngắn-rộng hay không.",
        "Nghe luân phiên âm của người bản ngữ và bản ghi của mình, mô phỏng có ý thức độ dài của 'tiếng h' trong 격음, còn với 경음 thì hơi gồng nhẹ cổ họng, dừng lại rồi bật ra ngắn và chắc — lặp đi lặp lại cảm giác này."
      ]
    },
    "overall": "현재는 평음 ㅂ 과 경음 ㅃ 의 VOT 가 1ms·9ms 로 거의 같아 한 덩어리로 들리고, 격음 ㅍ 도 0ms 라 평음과 분리되지 않는 'T1 — 3지 미변별' 단계입니다. 다만 격음에서 F0 가 +6.0 ST 까지 올라가 톤으로 구분을 시도하고 있다는 점은 좋은 신호이며, 청취 변별력 자체는 형성되어 있다고 볼 수 있습니다. 이제 톤에만 의지하지 말고 기식의 양 차이를 입과 손으로 만들어내는 단계로 넘어가면, 같은 시도를 VOT 축에 옮겨 빠르게 위계가 잡힐 것입니다. 격음→평음→경음 순으로 바람 세기를 의식하는 것이 가장 빠른 길입니다.",
    "overall_vn": "Hiện tại VOT của 평음 ㅂ và 경음 ㅃ là 1ms·9ms gần như bằng nhau nên nghe thành một khối, còn 격음 ㅍ cũng 0ms nên không tách được khỏi 평음 — đây là giai đoạn 'T1 — chưa phân biệt 3 chiều'. Tuy nhiên việc F0 của 격음 vọt lên +6.0 ST cho thấy bạn đang cố phân biệt bằng cao độ, đây là tín hiệu tốt và năng lực tri nhận thính giác cơ bản đã hình thành. Bây giờ thay vì chỉ dựa vào cao độ, hãy chuyển sang giai đoạn tạo ra khác biệt về lượng hơi bằng miệng và tay — nỗ lực tương tự khi chuyển sang trục VOT sẽ giúp thứ bậc hình thành nhanh chóng. Con đường nhanh nhất là ý thức lượng hơi theo thứ tự 격음→평음→경음.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 VOT 가 1ms 로 측정되어 PRAAT 파형의 첫 칸이 거의 보이지 않을 만큼 짧고, 폐쇄 해제 직후 곧바로 모음이 시작되는 형태입니다. 원어민의 97ms 와 차이가 크지만 평음은 본래 짧은 자음이라 너무 길게 가려 하지 말고, 입술을 살짝 부드럽게 떼면서 베트남어 /b/ 보다 조금 더 약한 숨 한 줄기를 흘려보내는 느낌으로 발음해 보세요. F0 pattern_st 는 -4.4 로 원어민(-3.7) 과 거의 같은 낮은 위치라 평음다운 안정된 톤은 이미 잡혀 있습니다 — 이 톤을 유지한 채 살짝의 기식만 더하면 됩니다.",
      "baji_vn": "VOT của 바지 được đo là 1ms, ô đầu tiên trên dạng sóng PRAAT gần như không thấy vì quá ngắn, và ngay sau khi mở môi nguyên âm bắt đầu liền. So với 97ms của người bản ngữ thì chênh lệch lớn, nhưng vì 평음 vốn là phụ âm ngắn nên đừng cố kéo dài quá — hãy mở môi nhẹ nhàng và thoát ra một luồng hơi yếu hơn một chút so với /b/ tiếng Việt. F0 pattern_st là -4.4, gần như trùng với người bản ngữ (-3.7) ở vị trí thấp, nên cao độ kiểu 평음 đã ổn định — chỉ cần giữ cao độ này và thêm chút hơi bật là được.",
      "bbareuda": "빠르다의 VOT 는 9ms 로 경음으로서는 거의 이상적인 짧은 값이지만, 문제는 F0 pattern_st 가 -3.7 로 평음 바지(-4.4) 와 거의 같은 낮은 톤에 머물러 있다는 점입니다(원어민은 -0.4 로 평음보다 +3.3 ST 위). PRAAT 의 파란 F0 곡선이 평음과 똑같은 높이에서 출발하니, 청자에게는 'ㅃ' 이 아닌 'ㅂ' 으로 들리기 쉽습니다. 발음 직전 목 안쪽을 살짝 조이고(긴장), 모음 시작 순간의 톤을 평음보다 분명히 한 칸 위에서 출발시켜 보세요. 입술을 더 단단히 닫았다가 짧고 야무지게 터뜨리는 폐쇄 강도가 후두 긴장을 자동으로 끌어옵니다.",
      "bbareuda_vn": "VOT của 빠르다 là 9ms — với 경음 thì gần như lý tưởng, nhưng vấn đề là F0 pattern_st chỉ -3.7, gần như bằng 평음 바지(-4.4) ở cao độ thấp (người bản ngữ là -0.4, cao hơn 평음 +3.3 ST). Đường cong F0 màu xanh trên PRAAT xuất phát cùng độ cao với 평음, nên người nghe dễ nghe thành 'ㅂ' chứ không phải 'ㅃ'. Hãy hơi siết nhẹ phía trong cổ họng (gồng) ngay trước khi phát âm, và khởi đầu cao độ của nguyên âm rõ ràng cao hơn 평음 một bậc. Đóng môi chắc hơn rồi bật ra ngắn và gọn — chính độ chắc của khâu đóng môi sẽ tự kéo theo độ căng thanh quản.",
      "paransaek": "파란색의 VOT 가 0ms 로 측정되어 PRAAT 파형에서 격음의 핵심인 폐쇄 해제 후 'h 구간'(긴 무성 기식) 이 통째로 사라진 모양입니다 — 원어민은 60ms 의 넓은 첫 칸을 보이는데, 학습자의 파형은 평음 바지(1ms) 와 거의 같은 모습입니다. 다행히 F0 pattern_st 는 +6.0 으로 원어민(+3.4) 보다도 높게 올라가 톤으로는 격음을 분명히 구분하려 노력하고 있으니, 청각 인식은 잘 잡혀 있습니다. 손바닥을 입 앞에 두고 'ㅍ' 발음 시 촛불 끄듯 강한 바람이 한 번 더 길게 나가는지 매번 확인하고, 입술을 떼는 순간 '하~' 하는 숨 길이를 의식적으로 늘려보세요.",
      "paransaek_vn": "VOT của 파란색 đo được 0ms, trên dạng sóng PRAAT 'đoạn h' (hơi vô thanh dài) — yếu tố cốt lõi của 격음 sau khi mở môi — đã biến mất hoàn toàn. Người bản ngữ có ô đầu rộng 60ms, còn dạng sóng của bạn gần như giống hệt 평음 바지(1ms). May là F0 pattern_st đạt +6.0, thậm chí cao hơn người bản ngữ (+3.4) — bạn đang nỗ lực phân biệt 격음 rõ ràng bằng cao độ, tức là khả năng tri nhận đã rất tốt. Hãy đặt lòng bàn tay trước miệng và mỗi lần phát âm 'ㅍ' kiểm tra xem có một luồng hơi mạnh thổi ra dài như khi thổi nến không, và cố ý kéo dài tiếng 'ha~' ngay khi mở môi."
    },
    "encouragement": "격음을 톤으로 구분하려는 시도가 이미 보입니다 — 이제 바람의 양만 보태면 빠르게 자리잡을 거예요!",
    "encouragement_vn": "Bạn đã có nỗ lực phân biệt 격음 bằng cao độ — bây giờ chỉ cần thêm lượng hơi nữa thôi là sẽ vào nếp rất nhanh!",
