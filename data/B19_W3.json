  "ai_feedback": {
    "error_analysis": {
      "summary": "평음은 약하고 격음은 과하게 터뜨려, 세 파열음의 거리감이 한쪽으로 쏠려 있습니다.",
      "summary_vn": "평음 (âm thường) phát ra hơi yếu còn 격음 (âm bật hơi) lại bật quá mạnh, khiến khoảng cách giữa ba âm bị lệch về một phía.",
      "detail": "가방의 ㄱ은 VOT 41ms로 원어민 63ms보다 짧아 평음 영역에서도 다소 무기식 쪽으로 치우쳐 있고, 까만색의 ㄲ은 VOT 17ms로 원어민 8ms보다 길어 경음 특유의 짧고 단단한 터짐이 약간 풀려 있습니다. 카드의 ㅋ은 VOT 132ms로 원어민 83ms보다 50ms 가까이 길어 기식을 매우 강하게 내뱉고 있습니다. F0 패턴(semitone)을 보면 평음 -1.6 / 경음 +2.1 / 격음 -0.8로, 원어민의 평음 낮음·경음·격음 높음 위계 중 격음 톤이 오히려 가라앉아 위계가 일부 흐트러져 있습니다.",
      "detail_vn": "Ở 가방, ㄱ có VOT 41ms ngắn hơn người bản ngữ (63ms), nghiêng về phía ít hơi hơn ngay trong vùng 평음. Ở 까만색, ㄲ có VOT 17ms dài hơn người bản ngữ (8ms), nên cú bật ngắn-căng đặc trưng của 경음 bị lỏng đi một chút. Còn ㅋ trong 카드 có VOT tới 132ms, dài hơn người bản ngữ (83ms) gần 50ms, tức là bạn đang đẩy hơi ra rất mạnh. Về F0 (semitone): 평음 -1.6 / 경음 +2.1 / 격음 -0.8 — trong khi người bản ngữ có thứ bậc 평음 thấp · 경음 và 격음 cao, thì ở bạn 격음 lại bị tụt xuống, làm trật tự cao-thấp hơi lệch."
    },
    "cause": "베트남어에는 한국어처럼 평음·경음·격음을 후두 긴장과 기식량으로 3단 구분하는 체계가 없습니다. 그래서 '구분해야 한다'는 의식이 격음에서는 '바람을 더 많이 불자'로, 경음에서는 후두 긴장보다 호흡으로 처리되어 VOT가 길어지는 식으로 과보정됩니다. 동시에 평음은 베트남어 무기 자음에 가깝게 짧아져, 결과적으로 세 음의 균형이 어긋난 채 자리잡습니다.",
    "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba bậc 평음·경음·격음 bằng độ căng thanh quản và lượng hơi như tiếng Hàn. Vì vậy, ý thức 'phải phân biệt' khiến bạn xử lý 격음 bằng cách 'thổi nhiều hơi hơn', và xử lý 경음 bằng hơi thở thay vì căng thanh quản, làm VOT bị kéo dài quá mức. Cùng lúc đó, 평음 lại bị rút ngắn giống phụ âm không bật hơi của tiếng Việt, khiến cân bằng giữa ba âm bị lệch đi.",
    "correction": {
      "main_focus": "격음의 기식량은 줄이고, 경음의 후두 긴장을 강화해 '평음은 부드럽게·경음은 짧고 단단하게·격음은 적당히 강하게'의 3단 거리감을 또렷이 세우는 것입니다.",
      "main_focus_vn": "Điều cần tập trung nhất là giảm bớt lượng hơi của 격음 và tăng độ căng thanh quản cho 경음, để dựng rõ ba bậc khoảng cách: 평음 mềm · 경음 ngắn-căng · 격음 mạnh vừa đủ.",
      "steps": [
        "손바닥을 입 앞 10cm에 대고 가-까-카를 천천히 발음하며 바람의 양 차이를 직접 느껴 보세요 — 가에서는 거의 안 닿게, 까에서는 거의 안 닿지만 목이 살짝 조이게, 카에서는 닿되 너무 세게는 아니게.",
        "최소대립쌍 '가-까-카'를 거울 앞에서 세 번씩 반복하며, 본인 녹음과 원어민 음원을 한 쌍씩 번갈아 듣고 톤 위계(평음 낮음 → 경음·격음 높음)가 자기 발화에도 보이는지 확인하세요.",
        "녹음 전 자연스러운 baseline 톤으로 '아~'를 한 번 길게 내고, 그 톤을 기준으로 평음은 살짝 아래, 경음과 격음은 살짝 위에서 시작하도록 워밍업하세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 10cm và phát âm chậm 가-까-카, cảm nhận trực tiếp sự khác biệt về lượng hơi — ở 가 gần như không chạm tay, ở 까 cũng gần như không chạm nhưng cổ họng hơi căng lại, ở 카 thì có chạm nhưng không quá mạnh.",
        "Lặp lại cặp tối thiểu '가-까-카' ba lần trước gương, rồi nghe xen kẽ từng cặp giữa bản ghi của bạn và giọng người bản ngữ, kiểm tra xem trật tự cao-thấp (평음 thấp → 경음·격음 cao) có xuất hiện trong giọng bạn không.",
        "Trước khi ghi âm, hãy ngân dài 'a~' ở tông tự nhiên của bạn để làm baseline, rồi khởi động sao cho 평음 bắt đầu hơi thấp hơn tông đó, còn 경음 và 격음 bắt đầu hơi cao hơn."
      ]
    },
    "overall": "세 단어 모두 측정이 안정적으로 잡혔다는 점이 큰 강점입니다 — 발음이 흔들리지 않고 일관적이라는 뜻입니다. 평음·경음·격음을 구별하려는 의도는 분명히 보이지만, 격음에서는 기식이 과해지고 경음에서는 긴장이 살짝 부족한 양극단으로 나타나 위계가 조금 평탄해졌습니다. 특히 격음 톤이 가라앉은 점은 '강하게 불어야 한다'는 의식이 호흡에만 집중되어 톤까지 챙기지 못한 결과로 보입니다. 호흡량과 후두 긴장의 분배만 조정하면 충분히 자연스러운 3중 구분에 도달할 수 있는 단계입니다.",
    "overall_vn": "Việc cả ba từ đều cho ra kết quả đo ổn định là một điểm mạnh lớn — nghĩa là cách phát âm của bạn không bị dao động, có tính nhất quán. Ý thức phân biệt 평음·경음·격음 thể hiện rõ, nhưng lại đi về hai cực: 격음 quá nhiều hơi còn 경음 hơi thiếu độ căng, khiến trật tự ba bậc bị san phẳng đi một chút. Đặc biệt việc tông 격음 bị tụt xuống cho thấy ý thức 'phải thổi mạnh' chỉ tập trung vào hơi mà chưa chăm sóc được tông giọng. Chỉ cần điều chỉnh lại sự phân bổ giữa lượng hơi và độ căng thanh quản, bạn hoàn toàn có thể đạt tới sự phân biệt ba bậc tự nhiên.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 ㄱ은 VOT 41ms로 측정되어, 나침반 위에서 평음 자리(왼쪽 nặng 영역의 부드러운 가장자리)에서 살짝 더 왼쪽으로 밀려나 있는 인상입니다. F0 패턴은 -1.6 st로 본인 baseline에서 약하게 내려와 평음다운 낮은 톤은 잘 잡고 있지만, 원어민의 -3.7 st만큼 깊이 내려오지는 않아 ngang 선 바로 아래 정도에서 멈춰 있습니다. 즉 위치는 옳은 사분면이지만, 기식이 조금 더 풀어져 오른쪽(약간만 bật hơi 쪽)으로 한두 칸 움직여 줘야 원어민 클러스터에 더 가까워집니다. 발음할 때 입술과 혀끝의 힘을 빼고, 모음 'ㅏ'를 자연스럽게 내려놓듯 시작해 보세요.",
      "gabang_vn": "Ở 가방, ㄱ có VOT đo được 41ms, trên la bàn nó đang nằm ở vùng 평음 (mép mềm bên trái 영역 nặng) nhưng bị lệch thêm một chút sang trái. Tông F0 ở mức -1.6 st cho thấy bạn đã hạ giọng đúng kiểu 평음, nhưng chưa xuống sâu được như người bản ngữ (-3.7 st), nên chỉ dừng lại ngay dưới đường ngang. Tức là bạn đang ở đúng góc phần tư, nhưng cần dịch chuyển một-hai ô sang phải (hơi nhiều hơi hơn một chút theo hướng bật hơi) để gần hơn với cụm người bản ngữ. Khi phát âm, hãy thả lỏng môi và đầu lưỡi, bắt đầu nguyên âm 'ㅏ' nhẹ nhàng như đặt xuống.",
      "ggamansaek": "까만색의 ㄲ은 VOT 17ms, F0 +2.1 st로 측정되었습니다 — 나침반 위에서 보면 왼쪽 nặng·위쪽 sắc 사분면, 즉 경음의 본거지에 들어와 있어 위치 자체는 정확합니다. 다만 원어민 8ms보다 9ms 정도 오른쪽(bật hơi 쪽)으로 밀려 있어, 경음의 '한 박자 더 꽉 다문 뒤 짧게 터뜨림'이 살짝 풀려 있는 인상입니다. 발음할 때 혀뿌리와 목구멍을 한 박자 더 조였다가, 바람보다는 '딱' 하는 짧은 터짐으로 빠져나오게 해 보세요. 톤은 이미 잘 올라가 있으니, 긴장 한 가지만 더 챙기면 됩니다.",
      "ggamansaek_vn": "Ở 까만색, ㄲ đo được VOT 17ms và F0 +2.1 st — trên la bàn nó nằm ở góc phần tư bên trái 영역 nặng và phía trên sắc, đúng 'nhà' của 경음, nên vị trí về cơ bản là chính xác. Tuy nhiên, so với người bản ngữ (8ms) thì bạn lệch sang phải khoảng 9ms (hướng bật hơi), khiến cú 'mím chặt thêm một nhịp rồi bật ngắn' của 경음 bị lỏng đi một chút. Khi phát âm, hãy siết gốc lưỡi và cổ họng thêm một nhịp, rồi bật ra bằng cú 'tách' ngắn gọn thay vì bằng hơi. Tông giọng đã lên đúng rồi, bạn chỉ cần bổ sung thêm độ căng là đủ.",
      "kadeu": "카드의 ㅋ은 VOT 132ms로 원어민 83ms보다 50ms 가까이 길어, 나침반 위에서 오른쪽 bật hơi 영역의 가장 끝까지 밀려 나와 있습니다. 동시에 F0는 -0.8 st로 본인 baseline 아래에 머물러, 격음이라면 sắc 위쪽 방향이어야 할 톤이 오히려 아래로 가라앉은 상태입니다 — 위치가 '오른쪽 아래'로 빠져 원어민 클러스터(오른쪽 위 sắc·bật hơi)에서 대각선으로 멀어져 있습니다. 강하게 불려는 의식을 절반 정도로 줄이고, 그 에너지를 톤을 살짝 위로 올리는 데 옮겨 보세요. 입술/혀의 터짐은 분명히 하되, 바로 이어지는 'ㅏ'를 baseline보다 한 단계 높은 톤에서 시작하면 좌표가 위쪽으로 올라옵니다.",
      "kadeu_vn": "Ở 카드, ㅋ có VOT 132ms, dài hơn người bản ngữ (83ms) gần 50ms, trên la bàn bị đẩy ra tận mép xa nhất bên phải vùng bật hơi. Đồng thời F0 ở mức -0.8 st, tức là tông giọng đang nằm dưới baseline của bạn — trong khi 격음 lẽ ra phải nghiêng lên phía sắc thì lại bị chìm xuống, làm tọa độ rơi xuống 'phải-dưới', tức là chéo góc và xa cụm người bản ngữ ('phải-trên', sắc · bật hơi). Hãy giảm ý thức 'phải thổi mạnh' xuống khoảng một nửa, và chuyển phần năng lượng đó sang việc nâng tông giọng lên một chút. Cú bật của môi/lưỡi vẫn rõ ràng, nhưng nguyên âm 'ㅏ' liền sau hãy bắt đầu ở tông cao hơn baseline một bậc — tọa độ sẽ tự nhiên dịch lên trên."
    },
    "encouragement": "세 단어 모두 안정적으로 측정될 만큼 일관된 발음을 갖춘 점이 정말 큰 자산입니다 — 방향만 조금 다듬으면 빠르게 좋아질 거예요!",
    "encouragement_vn": "Việc bạn phát âm đủ nhất quán để cả ba từ đều cho kết quả đo ổn định là một tài sản rất lớn — chỉ cần chỉnh lại hướng một chút thôi là sẽ tiến bộ rất nhanh!",
    "_source": "claude"
  },
