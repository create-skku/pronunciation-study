  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 비교적 잘 구분되지만, 평음 ㅂ과 경음 ㅃ이 둘 다 길고 기식이 있는 소리로 합쳐지고 있습니다.",
      "summary_vn": "Âm bật hơi ㅍ (파) phân biệt khá tốt, nhưng âm thường ㅂ (바) và âm căng ㅃ (빠) đang bị hòa làm một thành âm dài có hơi.",
      "detail": "빠르다의 VOT가 86ms로 측정되어 원어민 0ms와 크게 차이가 납니다 — 경음이어야 할 ㅃ이 오히려 격음에 가까운 긴 기식을 갖고 있습니다. 파란색은 VOT 65ms로 원어민 60ms와 매우 비슷해 격음 ㅍ은 잘 구현됐습니다. 바지는 F0 측정이 빠져 있지만 VOT 97ms는 원어민과 일치합니다. F0 패턴(semitone)을 보면 빠르다 +0.5st, 파란색 -0.5st 로 경음과 격음 사이의 톤 위계가 거의 평탄해, 한국어 3중 구분의 핵심인 '경음·격음이 평음보다 높게 시작'하는 패턴이 아직 자리잡지 못했습니다.",
      "detail_vn": "VOT của 빠르다 đo được 86ms, chênh lệch lớn so với người bản ngữ 0ms — đáng lẽ là âm căng ㅃ nhưng lại có hơi dài gần giống âm bật hơi. 파란색 có VOT 65ms, rất gần với bản ngữ 60ms, nên âm bật hơi ㅍ được thực hiện tốt. 바지 thiếu đo F0 nhưng VOT 97ms trùng khớp với bản ngữ. Xét mẫu F0 (semitone), 빠르다 +0.5st và 파란색 -0.5st cho thấy thứ bậc cao độ giữa âm căng và âm bật hơi gần như bằng phẳng — mẫu cốt lõi của tiếng Hàn là 'âm căng·bật hơi bắt đầu cao hơn âm thường' vẫn chưa được định hình."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 학습자는 세 소리를 변별할 음운 범주가 부족합니다. 특히 경음 ㅃ에 필요한 '후두 긴장 + 짧고 단단한 폐쇄 + 높은 모음 시작'이라는 동작이 베트남어 자음 체계에 존재하지 않아, 결과적으로 ㅃ을 만들려고 할 때 입술을 오래 다물었다가 강하게 터뜨려 오히려 격음 ㅍ에 가까운 긴 기식이 생기는 것으로 보입니다. 격음 ㅍ이 잘 구현된 이유도 베트남어 /pʰ/에 유사한 동작이 있기 때문입니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc âm thường·âm căng·âm bật hơi như tiếng Hàn, nên học viên thiếu phạm trù âm vị để phân biệt ba âm này. Đặc biệt động tác cần cho âm căng ㅃ — 'căng thanh hầu + ngậm môi ngắn và chắc + nguyên âm bắt đầu cao' — không tồn tại trong hệ thống phụ âm tiếng Việt, nên khi cố tạo ㅃ, học viên ngậm môi lâu rồi bật mạnh, vô tình tạo ra hơi dài giống âm bật hơi ㅍ. Âm bật hơi ㅍ thực hiện tốt cũng vì tiếng Việt có /pʰ/ với động tác tương tự.",
    "correction": {
      "main_focus": "경음 ㅃ을 격음 ㅍ에서 떼어내기 — '긴 기식'이 아니라 '짧고 단단한 후두 긴장'으로 다시 만들기.",
      "main_focus_vn": "Tách âm căng ㅃ ra khỏi âm bật hơi ㅍ — tạo lại ㅃ bằng 'thanh hầu căng, ngắn và chắc' chứ không phải 'hơi dài'.",
      "steps": [
        "손바닥을 입 앞 5cm에 두고 바-빠-파를 번갈아 발음하며 바람 양을 비교: 바(거의 없음) / 빠(거의 없음, 단 단단함) / 파(강한 바람) — 빠에서 손바닥에 바람이 느껴지면 기식이 과한 것입니다.",
        "최소대립쌍 '바-빠' 를 천천히 반복하되, 빠를 발음하기 직전 0.5초간 입술을 꽉 다물고 목에 힘을 준 뒤 짧게 터뜨리는 연습을 합니다. 모음 'ㅏ'는 평소 baseline 보다 약간 높은 톤으로 시작합니다.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 PRAAT 파형의 첫 칸 너비(=VOT)를 시각적으로 비교 — 빠르다의 첫 칸이 파란색보다 분명히 좁아야 합니다."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm và phát âm luân phiên 바-빠-파, so sánh lượng hơi: 바 (gần như không có) / 빠 (gần như không có, nhưng chắc) / 파 (hơi mạnh) — nếu cảm thấy hơi ở lòng bàn tay khi phát ㅃ là hơi quá nhiều.",
        "Lặp lại chậm cặp tối thiểu '바-빠', ngay trước khi phát 빠 hãy ngậm chặt môi 0.5 giây và căng cổ họng rồi bật ra ngắn gọn. Nguyên âm 'ㅏ' bắt đầu hơi cao hơn baseline thông thường một chút.",
        "Nghe luân phiên giọng bản ngữ và bản ghi của mình, so sánh trực quan độ rộng ô đầu tiên (=VOT) trên dạng sóng PRAAT — ô đầu của 빠르다 phải hẹp hơn rõ rệt so với 파란색."
      ]
    },
    "overall": "격음 ㅍ은 VOT·F0 패턴 모두 원어민에 매우 가까워 분명한 강점입니다. 다만 경음 ㅃ이 격음 쪽으로 끌려가 있고 평음과의 위계도 아직 평탄해, 현재 가장 큰 과제는 ㅃ의 재구성입니다. ㅍ에서 이미 성공한 입술·기식 조절 감각을 갖고 있으므로, 여기에 '후두 긴장 + 짧은 폐쇄'만 더하면 ㅃ도 빠르게 자리잡을 수 있습니다. 단어별 의미는 전달되는 수준이며, 다음 단계는 '음운 변별' 입니다.",
    "overall_vn": "Âm bật hơi ㅍ rất gần với bản ngữ cả về VOT lẫn mẫu F0, đây là điểm mạnh rõ ràng. Tuy nhiên âm căng ㅃ đang bị kéo về phía âm bật hơi và thứ bậc với âm thường vẫn còn bằng phẳng, nên thử thách lớn nhất hiện tại là tái cấu trúc ㅃ. Bạn đã có cảm giác điều chỉnh môi·hơi thành công ở ㅍ, chỉ cần thêm 'thanh hầu căng + ngậm môi ngắn' là ㅃ cũng sẽ nhanh chóng định hình. Ý nghĩa từng từ vẫn truyền đạt được, bước tiếp theo là 'phân biệt âm vị'.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 VOT 97ms는 원어민과 동일해 평음 ㅂ의 입술 폐쇄 시간 자체는 자연스럽습니다. 다만 F0(ㅏ) 측정이 빠져 모음 시작 톤은 확인이 어려운데, 베트남 학습자에게서 흔히 보이는 경향상 평음 ㅂ을 베트남어 /b/처럼 무기식으로 발음했을 가능성이 큽니다. PRAAT 파형에서 바지의 첫 칸이 빠르다의 첫 칸보다 분명히 좁게 보여야 하며, 입술을 살짝만 다물었다가 부드럽게 떼고 모음 'ㅏ'는 본인 baseline 톤으로 자연스럽게 시작하세요. 빠르다와 입술 긴장도가 다르다는 점을 의식적으로 구분해 발음해 보세요.",
      "baji_vn": "VOT của 바지 là 97ms, trùng khớp với bản ngữ nên thời gian ngậm môi cho âm thường ㅂ tự nhiên. Tuy nhiên do thiếu đo F0(ㅏ) nên khó xác nhận cao độ bắt đầu của nguyên âm; theo xu hướng thường gặp ở học viên Việt, có khả năng cao bạn đã phát ㅂ giống /b/ tiếng Việt (không có hơi). Trên dạng sóng PRAAT, ô đầu tiên của 바지 phải hẹp hơn rõ rệt so với 빠르다; hãy ngậm môi nhẹ rồi mở ra mềm mại, nguyên âm 'ㅏ' bắt đầu tự nhiên ở baseline của bạn. Hãy ý thức phân biệt độ căng môi với 빠르다 khi phát âm.",
      "bbareuda": "빠르다의 VOT 86ms는 원어민 0ms와 비교하면 매우 길어, PRAAT 파형의 첫 칸이 마치 격음 파란색처럼 넓게 보일 것입니다 — 경음이 아닌 격음에 가까운 소리가 나고 있다는 신호입니다. F0(ㅏ)도 +0.5st로 원어민 -0.4st 대비 큰 차이는 아니지만, 경음의 핵심인 '모음을 약간 더 높게 시작'하는 위계는 어느 정도 살아있습니다. 입술을 0.5초 더 꽉 다물고 목에 힘을 준 채 짧고 단단하게 터뜨리되, 손바닥에 바람이 거의 느껴지지 않을 만큼 기식을 줄이세요. 파형의 첫 칸을 의식적으로 좁히는 것이 가장 중요한 한 가지 동작입니다.",
      "bbareuda_vn": "VOT của 빠르다 là 86ms, so với bản ngữ 0ms là rất dài — ô đầu tiên trên dạng sóng PRAAT trông rộng như âm bật hơi 파란색, đây là dấu hiệu bạn đang phát ra âm gần với âm bật hơi chứ không phải âm căng. F0(ㅏ) +0.5st so với bản ngữ -0.4st không chênh lệch lớn, và thứ bậc cốt lõi của âm căng — 'nguyên âm bắt đầu hơi cao hơn' — đã có phần nào. Hãy ngậm môi chặt thêm 0.5 giây, căng cổ họng và bật ra ngắn gọn chắc chắn, đồng thời giảm hơi sao cho lòng bàn tay gần như không cảm thấy gió. Việc thu hẹp có ý thức ô đầu tiên trên dạng sóng là động tác quan trọng nhất.",
      "paransaek": "파란색의 VOT 65ms는 원어민 60ms와 거의 일치해, PRAAT 파형의 첫 칸 너비가 원어민과 시각적으로도 매우 비슷합니다 — 격음 ㅍ의 강한 기식이 잘 구현된 명백한 강점입니다. 다만 F0(ㅏ)가 -0.5st로 원어민 +3.4st보다 3.9st 낮게 시작하고 있어, 모음의 시작 톤이 평음 영역으로 내려가 있습니다. 손바닥에 강한 바람을 그대로 유지하면서, 모음 'ㅏ'를 본인 baseline 보다 분명히 높은 톤으로 시작해 보세요. 파란 F0 곡선의 시작점이 더 위로 올라오면 격음의 위계까지 완성됩니다.",
      "paransaek_vn": "VOT của 파란색 là 65ms, gần như trùng khớp với bản ngữ 60ms, độ rộng ô đầu trên dạng sóng PRAAT trông rất giống bản ngữ — đây là điểm mạnh rõ ràng, hơi mạnh của âm bật hơi ㅍ được thực hiện tốt. Tuy nhiên F0(ㅏ) là -0.5st, thấp hơn bản ngữ +3.4st đến 3.9st, nghĩa là cao độ bắt đầu của nguyên âm đang nằm trong vùng âm thường. Hãy giữ nguyên hơi mạnh trên lòng bàn tay, đồng thời bắt đầu nguyên âm 'ㅏ' ở cao độ rõ ràng cao hơn baseline của bạn. Khi điểm bắt đầu của đường cong F0 xanh nhô lên cao hơn, thứ bậc của âm bật hơi sẽ được hoàn thiện."
    },
    "encouragement": "격음 ㅍ을 원어민 수준으로 만든 감각이 이미 몸에 있어요 — 그 감각에 '짧고 단단함' 하나만 더하면 ㅃ도 곧 자리잡습니다!",
    "encouragement_vn": "Bạn đã có sẵn cảm giác phát âm bật hơi ㅍ ở mức bản ngữ — chỉ cần thêm 'ngắn và chắc' vào cảm giác đó, ㅃ cũng sẽ sớm vào đúng vị trí!",
