  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 카드는 잘 구분되지만, 평음 가방과 경음 까만색이 서로 가까워져 위계가 평탄해진 상태입니다.",
      "summary_vn": "Âm bật hơi 카드 đã được phân biệt khá tốt, nhưng âm thường 가방 và âm căng 까만색 đang xích lại gần nhau khiến hệ thống ba bậc bị san phẳng.",
      "detail": "가방의 VOT가 19ms로 원어민 63ms보다 훨씬 짧아, 평음이라기보다 거의 경음에 가까운 짧은 폐쇄 해제로 발음되고 있습니다. 까만색은 VOT 15ms로 원어민 8ms와 큰 차이는 없지만, 가방(19ms)과 거의 같은 길이라서 평음·경음의 VOT 대비가 사라졌습니다. 카드는 VOT 74ms로 원어민 83ms에 근접해 격음다운 기식이 잘 살아 있습니다. F0 패턴(semitone)에서도 원어민은 평음(-3.7) < 경음(1.3)·격음(1.9)의 위계가 뚜렷한 반면, 학습자는 평음(-1.8) < 경음(0.8) = 격음(0.8)로 평음이 충분히 낮지 않고 경음·격음이 같은 높이에 머물러 있습니다.",
      "detail_vn": "VOT của 가방 chỉ 19ms, ngắn hơn nhiều so với người bản ngữ 63ms, nên thay vì là âm thường thì nghe gần như âm căng với khoảng bục ngắn. 까만색 có VOT 15ms, không cách xa 8ms của người bản ngữ, nhưng lại gần bằng 가방 (19ms) khiến tương phản VOT giữa âm thường và âm căng biến mất. 카드 có VOT 74ms, sát mức 83ms của người bản ngữ, cho thấy hơi bật của âm bật hơi được giữ tốt. Về cao độ F0 (semitone), người bản ngữ có thứ bậc rõ: âm thường (-3.7) < âm căng (1.3)·bật hơi (1.9), còn người học là âm thường (-1.8) < âm căng (0.8) = bật hơi (0.8), tức âm thường chưa đủ thấp và âm căng·bật hơi nằm cùng độ cao."
    },
    "cause": "베트남어에는 한국어처럼 평음·경음·격음 3중 대립이 없고, 평음 ㄱ에 해당하는 약한 무성 폐쇄음은 베트남어 /k/ 화자에게 자연스럽지 않아 무의식적으로 후두를 살짝 긴장시켜 짧고 단단하게 터뜨리게 됩니다. 그 결과 평음 가방의 VOT가 짧아지면서 경음 까만색과 영역이 겹치고, F0도 충분히 낮게 시작하지 못합니다. 반면 격음 ㅋ는 강한 기식이 베트남어 /kh/와 유사해 비교적 쉽게 정확하게 산출됩니다.",
    "cause_vn": "Tiếng Việt không có hệ ba bậc âm thường·âm căng·bật hơi như tiếng Hàn, và âm tắc vô thanh nhẹ tương ứng với 평음 ㄱ không tự nhiên với người nói tiếng Việt /k/, nên người học vô thức siết nhẹ thanh quản và bục ngắn, mạnh. Hệ quả là VOT của 평음 가방 bị rút ngắn, chồng lấn vùng với 경음 까만색, và F0 cũng không đủ thấp ở chỗ bắt đầu. Ngược lại, 격음 ㅋ có luồng hơi mạnh giống /kh/ tiếng Việt nên được phát âm khá chính xác.",
    "correction": {
      "main_focus": "평음 ㄱ을 '더 부드럽고, 더 낮은 톤으로, 후두 긴장 없이' 시작해 경음 ㄲ과 분리하는 것에 가장 집중하세요.",
      "main_focus_vn": "Hãy tập trung nhất vào việc tách 평음 ㄱ khỏi 경음 ㄲ bằng cách bắt đầu 'mềm hơn, ở cao độ thấp hơn, không siết thanh quản'.",
      "steps": [
        "손바닥을 입 앞 5cm에 대고 가-까-카를 천천히 반복하며 바람 양의 차이(거의 없음 / 거의 없음 / 강함)를 체감해 격음만 손에 닿게 합니다.",
        "최소대립쌍 가-까를 한 쌍씩 발음하되, 가는 한숨을 내쉬듯 후두를 풀고 모음을 낮은 톤에서, 까는 입 안쪽을 한 박자 더 꽉 조였다가 짧고 단단하게 터뜨리며 모음을 살짝 높은 톤에서 시작합니다.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 PRAAT 파형의 첫 칸(폐쇄~모음 시작 구간) 너비와 파란 F0 곡선의 시작 높이를 시각적으로 비교·교정합니다."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm, lặp chậm 가-까-카 để cảm nhận chênh lệch luồng hơi (gần như không / gần như không / mạnh), sao cho chỉ 격음 mới chạm tay.",
        "Phát âm từng cặp tối thiểu 가-까: 가 thì thả lỏng thanh quản như thở ra và bắt đầu nguyên âm ở cao độ thấp, 까 thì siết chặt vùng miệng thêm một nhịp rồi bục ngắn và chắc, bắt đầu nguyên âm ở cao độ hơi cao hơn.",
        "Nghe luân phiên âm thanh người bản ngữ và bản ghi của mình, so sánh trực quan độ rộng ô đầu tiên (đoạn từ bục đến bắt đầu nguyên âm) trên dạng sóng PRAAT và độ cao bắt đầu của đường F0 màu xanh để hiệu chỉnh."
      ]
    },
    "overall": "격음 카드는 VOT와 기식 모두 원어민과 매우 가까워 분명한 강점이고, 베트남어 /kh/ 감각을 잘 활용하고 있습니다. 다만 평음 가방이 너무 짧고 단단하게 터지면서 경음 까만색과 같은 영역으로 겹쳤고, F0 위계에서도 경음·격음이 같은 높이에 머물러 3단 구분이 2단으로 축소된 모습입니다. 다음 단계의 가장 큰 과제는 '평음을 더 풀어 주는 것' — 후두를 이완하고 낮은 톤으로 시작하면 자연스럽게 경음과 거리가 벌어집니다. 격음이 이미 자리 잡혀 있어 평음만 교정되면 3단 위계가 빠르게 회복될 수 있는 좋은 출발선입니다.",
    "overall_vn": "격음 카드 rất gần người bản ngữ cả về VOT lẫn luồng hơi, đây là điểm mạnh rõ ràng và bạn đang tận dụng tốt cảm giác /kh/ tiếng Việt. Tuy nhiên 평음 가방 bị bục quá ngắn và chắc nên chồng lấn vùng với 경음 까만색, và trong thứ bậc F0 thì âm căng·bật hơi nằm cùng cao độ, khiến hệ ba bậc bị thu thành hai bậc. Nhiệm vụ lớn nhất ở bước tiếp theo là 'thả lỏng 평음 hơn nữa' — khi thanh quản được thả lỏng và bắt đầu ở cao độ thấp, khoảng cách với 경음 sẽ tự nhiên mở ra. Vì 격음 đã ổn định, chỉ cần chỉnh 평음 là hệ ba bậc sẽ phục hồi nhanh — đây là một xuất phát điểm rất tốt.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 VOT는 19ms로 원어민 63ms의 약 1/3에 그쳐, PRAAT 파형에서 폐쇄 해제부터 모음 시작까지의 첫 칸이 원어민보다 눈에 띄게 좁게 보입니다. F0(ㅏ) 패턴이 -1.8 semitone으로 원어민의 -3.7보다 약 2 semitone 높아, 파란 F0 곡선의 시작점도 다른 두 단어와 거의 같은 높이에서 출발합니다. 발음할 때 혀뿌리와 후두를 한숨 쉬듯 풀고, '가'의 모음을 평소 말소리보다 낮은 톤으로 천천히 흘려보내듯 시작해 보세요. 그러면 첫 칸이 자연스럽게 넓어지고 F0 곡선도 아래로 내려옵니다.",
      "gabang_vn": "VOT của 가방 chỉ 19ms, khoảng 1/3 so với 63ms của người bản ngữ, nên trên dạng sóng PRAAT ô đầu tiên từ lúc bục đến lúc bắt đầu nguyên âm trông hẹp hơn rõ rệt. Pattern F0(ㅏ) là -1.8 semitone, cao hơn người bản ngữ (-3.7) khoảng 2 semitone, và điểm bắt đầu của đường F0 màu xanh nằm gần như cùng cao độ với hai từ còn lại. Khi phát âm, hãy thả lỏng cuống lưỡi và thanh quản như đang thở ra, bắt đầu nguyên âm '가' ở cao độ thấp hơn giọng nói bình thường và để nó trôi ra từ từ. Nhờ vậy ô đầu tiên sẽ mở rộng tự nhiên và đường F0 cũng hạ xuống.",
      "ggamansaek": "까만색의 VOT는 15ms로 원어민 8ms보다 약간 길지만 경음 범위 안에 있어 절댓값 자체는 큰 문제가 아닙니다. 문제는 평음 가방(19ms)과 거의 같은 너비라서 PRAAT 파형의 첫 칸 너비만으로는 두 단어가 거의 구분되지 않고, F0도 0.8 semitone으로 원어민(1.3)보다 약 0.5 낮아 격음과도 같은 높이에 있다는 점입니다. 입술과 입 안쪽을 한 박자 더 꽉 다물어 압력을 모은 뒤 짧고 단단하게 터뜨리고, 모음 '아'를 평음보다 분명히 높은 톤에서 시작해 보세요. 손은 입 앞에 둬도 거의 바람이 닿지 않아야 정확한 경음입니다.",
      "ggamansaek_vn": "VOT của 까만색 là 15ms, hơi dài hơn 8ms của người bản ngữ nhưng vẫn nằm trong khoảng âm căng nên bản thân con số không phải vấn đề lớn. Vấn đề là độ rộng gần như bằng 평음 가방 (19ms), nên chỉ nhìn ô đầu tiên trên PRAAT thì khó phân biệt hai từ, và F0 0.8 semitone cũng thấp hơn người bản ngữ (1.3) khoảng 0.5, đứng cùng cao độ với âm bật hơi. Hãy mím chặt môi và siết phía trong miệng thêm một nhịp để dồn áp lực rồi bục ngắn và chắc, đồng thời bắt đầu nguyên âm 'ㅏ' ở cao độ cao hơn rõ rệt so với 평음. Đặt tay trước miệng gần như không cảm nhận được luồng hơi thì mới đúng là âm căng.",
      "kadeu": "카드의 VOT는 74ms로 원어민 83ms에 매우 가까워, PRAAT 파형의 첫 칸이 다른 두 단어보다 눈에 띄게 넓게 잘 나타나는 가장 안정된 단어입니다. 다만 F0(ㅏ) 패턴이 0.8 semitone으로 원어민(1.9)보다 약 1 semitone 낮아 파란 F0 곡선이 살짝 덜 올라가 있고, 경음 까만색과 높이가 겹칩니다. 손바닥을 입 앞에 댔을 때 분명히 바람이 느껴지는 강점은 유지하면서, '카'의 모음만 평음 '가'보다 확실히 더 높은 톤으로 시작하면 격음 위치가 더 또렷해집니다.",
      "kadeu_vn": "VOT của 카드 là 74ms, rất gần 83ms của người bản ngữ, nên ô đầu tiên trên dạng sóng PRAAT rộng hơn rõ rệt so với hai từ còn lại — đây là từ ổn định nhất. Tuy nhiên, pattern F0(ㅏ) ở mức 0.8 semitone, thấp hơn người bản ngữ (1.9) khoảng 1 semitone, nên đường F0 màu xanh chưa lên đủ cao và đang chồng lấn cao độ với 경음 까만색. Hãy giữ nguyên điểm mạnh là cảm nhận được luồng hơi rõ ràng khi đặt tay trước miệng, đồng thời bắt đầu nguyên âm '카' ở cao độ rõ ràng cao hơn 평음 '가' để vị trí âm bật hơi nổi bật hơn."
    },
    "encouragement": "격음이 이미 원어민에 가깝게 잘 자리 잡혀 있으니, 평음만 한 단계 풀어주면 3단 위계가 금방 살아납니다 — 아주 좋은 출발선입니다!",
    "encouragement_vn": "Âm bật hơi của bạn đã rất gần với người bản ngữ, chỉ cần thả lỏng 평음 thêm một bước là hệ ba bậc sẽ sống dậy ngay — đây là một xuất phát điểm rất tốt!",
    "_source": "claude"
