  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅍ은 잘 구분하지만, 평음 ㅂ과 경음 ㅃ이 둘 다 약하게 발음되어 서로 분리되지 않는 단계입니다.",
      "summary_vn": "Bạn phân biệt tốt âm bật hơi ㅍ (파), nhưng âm thường ㅂ (바) và âm căng ㅃ (빠) đều phát âm yếu và chưa tách biệt rõ ràng.",
      "detail": "바지의 VOT는 25ms로 원어민(97ms)보다 짧고, 빠르다의 VOT는 0ms로 원어민과 동일하게 잘 나왔습니다. 그러나 두 단어 모두 VOT가 매우 짧은 영역에 몰려 있어 ㅂ과 ㅃ의 경계가 흐려졌습니다. F0 패턴(semitone)을 보면 바지 -5.7 / 빠르다 +1.4 / 파란색 +3.1로 위계는 어느 정도 살아 있지만, 경음 빠르다의 후두 긴장이 약해 평음 영역과 가깝게 들립니다. 반면 파란색의 VOT는 119ms로 원어민(60ms)보다 길어, 격음의 강한 기식은 오히려 매우 또렷합니다.",
      "detail_vn": "VOT của 바지 là 25ms, ngắn hơn nhiều so với người bản ngữ (97ms), còn 빠르다 đạt 0ms — trùng khớp với người bản ngữ. Tuy nhiên cả hai từ đều có VOT rất ngắn nên ranh giới giữa ㅂ và ㅃ trở nên mờ. Về F0 (semitone): 바지 -5.7 / 빠르다 +1.4 / 파란색 +3.1 — thứ tự cao thấp có giữ được, nhưng độ căng thanh quản của âm căng 빠르다 còn yếu nên nghe gần với âm thường. Ngược lại, VOT của 파란색 là 119ms, dài hơn người bản ngữ (60ms), cho thấy hơi bật của âm bật hơi rất rõ ràng."
    },
    "cause": "베트남어에는 한국어처럼 평음·경음·격음의 3중 대립이 없고, 한국어 ㅂ과 ㅃ가 모두 베트남어 /b/ 음역대에 흡수되는 경향이 강합니다. 특히 경음 ㅃ의 핵심인 '후두 긴장'은 베트남어에 존재하지 않는 동작이라 평음처럼 발음되기 쉽습니다. 반면 격음 ㅍ의 강한 기식은 베트남어 /pʰ/와 비슷해 오히려 과하게 실현된 것입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống đối lập ba bậc như tiếng Hàn (âm thường, âm căng, âm bật hơi), và cả ㅂ lẫn ㅃ thường bị gộp vào vùng /b/ của tiếng Việt. Đặc biệt, 'sự căng thanh quản' — yếu tố cốt lõi của âm căng ㅃ — không tồn tại trong tiếng Việt nên dễ bị phát âm giống âm thường. Ngược lại, hơi bật mạnh của âm bật hơi ㅍ tương tự /pʰ/ tiếng Việt nên lại được thể hiện hơi quá mức.",
    "correction": {
      "main_focus": "평음 ㅂ과 경음 ㅃ의 분리 — 특히 경음에서 입술을 한 박자 더 꽉 다물고 후두를 긴장시키는 동작을 익히는 것이 핵심입니다.",
      "main_focus_vn": "Tách biệt âm thường ㅂ và âm căng ㅃ — đặc biệt cần luyện động tác mím môi chặt thêm một nhịp và căng thanh quản khi phát âm âm căng.",
      "steps": [
        "최소대립쌍 '바-빠-파'를 거울 앞에서 천천히 반복하며 입 모양과 입술 긴장도의 차이를 시각적으로 확인하기",
        "손바닥을 입 앞 5cm에 두고 세 음을 발음해 바람의 양 차이를 체감하기 — ㅂ은 약한 바람, ㅃ은 거의 없음(대신 입술 압력), ㅍ은 강한 바람",
        "원어민 음원과 본인 녹음을 번갈아 들으며 PRAAT 파형 첫 칸의 너비와 F0 곡선의 시작 높이를 직접 비교하기"
      ],
      "steps_vn": [
        "Luyện cặp tối thiểu '바-빠-파' chậm rãi trước gương, quan sát sự khác biệt về hình miệng và độ căng môi",
        "Đặt lòng bàn tay cách miệng 5cm và phát âm ba âm để cảm nhận sự khác biệt về lượng hơi — ㅂ hơi yếu, ㅃ gần như không có hơi (thay vào đó là áp lực môi), ㅍ hơi rất mạnh",
        "Nghe xen kẽ giọng người bản ngữ và bản ghi của mình, so sánh trực tiếp độ rộng ô đầu tiên của sóng âm và độ cao ban đầu của đường F0 trong PRAAT"
      ]
    },
    "overall": "격음 ㅍ의 강한 기식과 높은 F0 시작점은 이미 원어민 수준에 가까운 강점입니다. 다만 평음 ㅂ과 경음 ㅃ가 모두 VOT 0~25ms 구간에 몰려 있어 두 음의 청각적 구분이 어려운 상태입니다. F0 위계(낮음-중간-높음)는 살아 있으니, 이제 VOT와 후두 긴장이라는 '입술 동작'에 집중하면 빠르게 좋아질 단계입니다. 전체적으로 베트남 학습자의 전형적인 T2 단계이며, 다음 한 달이 가장 효과적인 시기입니다.",
    "overall_vn": "Hơi bật mạnh và F0 khởi đầu cao của âm bật hơi ㅍ đã đạt mức gần như người bản ngữ — đây là điểm mạnh rõ rệt. Tuy nhiên, cả âm thường ㅂ và âm căng ㅃ đều tập trung ở vùng VOT 0~25ms nên rất khó phân biệt bằng tai. Thứ tự F0 (thấp - trung bình - cao) thì đã hình thành, nên giờ chỉ cần tập trung vào 'động tác môi' liên quan đến VOT và độ căng thanh quản là sẽ tiến bộ nhanh. Đây là giai đoạn T2 điển hình của người học Việt Nam, và một tháng tới sẽ là thời điểm luyện tập hiệu quả nhất.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 VOT는 25ms로 원어민 97ms보다 훨씬 짧아, PRAAT 파형에서 'ㅂ' 직후 첫 칸이 거의 보이지 않을 정도로 좁게 나타납니다. F0(ㅏ)는 semitone 기준 -5.7로 원어민 -3.7보다 다소 낮게 시작했는데, 평음으로서는 자연스러운 방향이지만 '너무 낮게 누른' 인상이 있습니다. 입술을 가볍게 붙였다가 부드럽게 떼면서, 모음 ㅏ는 본인의 자연스러운 평소 톤으로 시작해 보세요. 손바닥을 입 앞에 두면 약한 바람이 살짝 느껴지는 정도가 적당합니다.",
      "baji_vn": "VOT của 바지 là 25ms, ngắn hơn nhiều so với 97ms của người bản ngữ, nên trên sóng âm PRAAT, ô đầu tiên ngay sau 'ㅂ' gần như không nhìn thấy vì quá hẹp. F0 (ㅏ) là -5.7 semitone, thấp hơn -3.7 của người bản ngữ — tuy hướng đi đúng với âm thường, nhưng cho cảm giác 'bị nhấn xuống quá thấp'. Hãy chạm nhẹ hai môi rồi tách ra mềm mại, và bắt đầu nguyên âm ㅏ ở tông tự nhiên hàng ngày của bạn. Đặt lòng bàn tay trước miệng — chỉ cần cảm nhận một luồng hơi nhẹ là vừa đủ.",
      "bbareuda": "빠르다의 VOT는 0ms로 원어민과 정확히 일치해 PRAAT 파형에서 'ㅃ' 직후 무음 구간이 거의 없이 바로 모음이 시작됩니다 — 이 부분은 훌륭합니다. 다만 F0(ㅏ)가 +1.4 semitone으로 원어민 -0.4보다 오히려 약간 높게 나왔지만, 청각적으로 후두 긴장감(짧고 단단한 터짐)이 부족해 평음 ㅂ과 비슷하게 들립니다. 입술을 한 박자 더 꽉 다물고, 안에서 압력이 차오른 뒤 짧고 단단하게 '뽝' 터뜨리듯 발음해 보세요. 이때 손바닥에는 바람이 거의 느껴지지 않아야 정상입니다.",
      "bbareuda_vn": "VOT của 빠르다 là 0ms, trùng khớp hoàn toàn với người bản ngữ — trên sóng âm PRAAT, gần như không có khoảng lặng sau 'ㅃ' mà nguyên âm bắt đầu ngay. Đây là điểm rất tốt. Tuy nhiên, F0 (ㅏ) là +1.4 semitone, cao hơn -0.4 của người bản ngữ, nhưng vì độ căng thanh quản (sự bật ra ngắn và chắc) còn yếu nên nghe gần giống âm thường ㅂ. Hãy mím môi chặt thêm một nhịp, để áp lực tích tụ bên trong rồi bật ra ngắn và mạnh như tiếng 'pụp'. Lúc này, lòng bàn tay gần như không cảm nhận được luồng hơi nào — đó là đúng.",
      "paransaek": "파란색의 VOT는 119ms로 원어민 60ms보다 거의 두 배 길게 나와, PRAAT 파형에서 'ㅍ' 직후 기식 구간이 매우 넓게 보입니다 — 격음의 핵심인 강한 기식이 분명하게 살아 있습니다. F0(ㅏ)도 +3.1 semitone으로 원어민 +3.4와 거의 동일해 모음 시작 톤도 자연스럽습니다. 이 단어는 학습자의 가장 큰 강점이니, ㅂ·ㅃ 연습 시 기준점(anchor)으로 활용하세요. 다만 기식이 다소 과한 편이라, 손바닥에 닿는 바람을 조금만 줄이면 더 자연스러워집니다.",
      "paransaek_vn": "VOT của 파란색 là 119ms, gần gấp đôi 60ms của người bản ngữ — trên sóng âm PRAAT, vùng hơi bật sau 'ㅍ' hiện ra rất rộng, cho thấy hơi bật mạnh — yếu tố cốt lõi của âm bật hơi — đã rất rõ ràng. F0 (ㅏ) là +3.1 semitone, gần như trùng khớp +3.4 của người bản ngữ, nên tông khởi đầu của nguyên âm cũng rất tự nhiên. Đây là điểm mạnh lớn nhất của bạn — hãy dùng từ này làm điểm neo (anchor) khi luyện ㅂ·ㅃ. Chỉ cần giảm bớt một chút lượng hơi chạm vào lòng bàn tay là sẽ tự nhiên hơn nữa."
    },
    "encouragement": "격음 ㅍ은 이미 원어민에 매우 가깝습니다 — 그 감각을 기준 삼아 ㅂ과 ㅃ도 곧 또렷해질 거예요!",
    "encouragement_vn": "Âm bật hơi ㅍ của bạn đã rất gần với người bản ngữ — dùng cảm giác đó làm chuẩn, ㅂ và ㅃ cũng sẽ sớm trở nên rõ ràng thôi!",
