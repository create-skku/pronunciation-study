  "ai_feedback": {
    "error_analysis": {
      "summary": "경음 ㄲ은 잘 구분되지만, 평음 ㄱ의 VOT가 과도하게 길어 격음 ㅋ과 거의 같은 영역에 머물러 있습니다.",
      "summary_vn": "Âm căng ㄲ (까만색) phân biệt khá tốt, nhưng VOT của âm thường ㄱ (가방) quá dài, gần như trùng với âm bật hơi ㅋ (카드).",
      "detail": "가방(ㄱ 평음)의 VOT가 91ms로 측정되어 원어민 평균 63ms보다 약 28ms 길고, 카드(ㅋ 격음)의 93ms와 거의 동일한 영역에 위치합니다. 반면 까만색(ㄲ 경음)의 VOT는 45ms로 원어민 8ms보다는 길지만 평음·격음과는 분명히 떨어진 위치에 자리잡아 3중 위계 중 경음 축은 유지되고 있습니다. F0 패턴(semitone)을 보면 가방 -3.8 / 까만색 +1.3 / 카드 +1.9 로 원어민 -3.7 / +1.3 / +1.9 와 거의 일치하여 음높이 위계는 이미 완성되어 있습니다. 결국 문제는 음높이가 아니라 평음 ㄱ의 기식(VOT) 과잉 — 즉 ㄱ을 ㅋ처럼 발음하는 것입니다.",
      "detail_vn": "VOT của 가방 (ㄱ âm thường) đo được 91ms, dài hơn người bản xứ (63ms) khoảng 28ms, gần như trùng với 카드 (ㅋ, 93ms). Trong khi đó, VOT của 까만색 (ㄲ âm căng) là 45ms — tuy dài hơn người bản xứ (8ms) nhưng vẫn tách biệt rõ với âm thường và bật hơi, nên trục âm căng vẫn được giữ. Mẫu F0 (semitone): 가방 -3.8 / 까만색 +1.3 / 카드 +1.9, gần như khớp hoàn toàn với người bản xứ (-3.7 / +1.3 / +1.9), nghĩa là thứ bậc cao độ đã hoàn chỉnh. Vấn đề không nằm ở cao độ mà ở hơi bật (VOT) thừa của ㄱ — bạn đang phát âm ㄱ giống như ㅋ."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 단어 첫머리의 무성 파열음은 보통 약간의 기식을 동반합니다. 그래서 베트남 학습자는 한국어 평음 ㄱ을 '기식이 살짝 있는 자음'으로 발음하기 쉬워 VOT가 자연스럽게 길어집니다. 이 학습자의 경우 음높이(F0) 위계는 이미 원어민 수준으로 자리잡았지만, ㄱ의 기식만 과도하게 남아 평음·격음 두 축이 겹치는 상태입니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc âm thường · âm căng · âm bật hơi như tiếng Hàn, và các phụ âm tắc vô thanh đầu từ thường có một chút hơi bật. Vì vậy người học Việt dễ phát âm âm thường ㄱ thành 'phụ âm có hơi nhẹ', khiến VOT tự nhiên kéo dài. Ở bạn, thứ bậc cao độ (F0) đã đạt mức gần người bản xứ, nhưng riêng hơi bật của ㄱ vẫn quá nhiều, khiến hai trục âm thường và âm bật hơi bị chồng lên nhau.",
    "correction": {
      "main_focus": "평음 ㄱ에서 '바람'을 빼고 짧고 부드럽게 — 격음 ㅋ과의 VOT 간격을 벌리는 것이 최우선입니다.",
      "main_focus_vn": "Loại bỏ 'hơi gió' khỏi âm thường ㄱ, phát âm ngắn và mềm — ưu tiên hàng đầu là nới rộng khoảng cách VOT giữa ㄱ và ㅋ.",
      "steps": [
        "손바닥을 입에서 10cm 앞에 두고 평음·격음을 번갈아 발음하며, 평음 차례에는 손바닥에 바람이 거의 닿지 않도록 조절합니다.",
        "최소대립쌍(가-까-카)을 한 호흡에 천천히 발음하며 세 자음이 '짧고 긴장 / 짧고 이완 / 길고 바람' 세 가지로 분리되는지 거울과 녹음으로 점검합니다.",
        "원어민 음원과 본인 녹음을 한 쌍씩 번갈아 들으며, 평음과 격음 사이에 명확한 길이 차이가 들리는지 매일 1-2분 비교 훈련합니다."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm, lần lượt phát âm âm thường và âm bật hơi; ở lượt âm thường, điều chỉnh sao cho gần như không có hơi chạm vào tay.",
        "Phát âm cặp đối lập tối thiểu (가-까-카) chậm rãi trong một hơi thở, dùng gương và bản ghi để kiểm tra ba phụ âm có tách thành 'ngắn-căng / ngắn-thả lỏng / dài-có hơi' hay không.",
        "Mỗi ngày nghe luân phiên 1-2 phút bản ghi của người bản xứ và của chính mình theo từng cặp, xác nhận có nghe rõ sự khác biệt về độ dài giữa âm thường và âm bật hơi."
      ]
    },
    "overall": "음높이(F0) 위계가 원어민과 거의 동일하게 자리잡은 점은 이 학습자의 큰 강점이며, 경음 ㄲ도 평음·격음과 분명히 구분되는 위치에 있습니다. 다만 평음 ㄱ의 VOT가 91ms로 격음 ㅋ(93ms)과 거의 같아 두 음이 청각적으로 합쳐지는 상태입니다. 교정 방향은 단순합니다 — ㄱ에서 기식만 빼면 위계가 완성됩니다. F0 패턴이 이미 안정적이므로 VOT 한 축만 다듬으면 단기간에 큰 진전이 가능합니다.",
    "overall_vn": "Việc thứ bậc cao độ (F0) gần như trùng khớp với người bản xứ là điểm mạnh lớn của bạn, và âm căng ㄲ cũng nằm ở vị trí tách biệt rõ với âm thường và âm bật hơi. Tuy nhiên, VOT của âm thường ㄱ là 91ms — gần như bằng âm bật hơi ㅋ (93ms), khiến hai âm bị nghe thành một. Hướng sửa rất đơn giản — chỉ cần bỏ hơi bật khỏi ㄱ là thứ bậc sẽ hoàn chỉnh. Vì mẫu F0 đã ổn định, chỉ cần tinh chỉnh trục VOT là bạn có thể tiến bộ rõ rệt trong thời gian ngắn.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방(ㄱ)은 나침반에서 본래 huyền 아래쪽·nặng 왼쪽 영역(짧고 낮은 음)에 머물러야 하는데, 현재 좌표가 nặng 축은 잘 지키지만 VOT 91ms로 bật hơi 오른쪽 끝까지 밀려나 카드와 거의 겹쳐 있습니다. F0 패턴(-3.8 st)은 원어민(-3.7)과 사실상 같아 세로축은 완벽하니, 가로축만 왼쪽으로 약 30ms 되돌리면 됩니다. 입술을 살짝만 떼고 '바람을 만들지 않겠다'는 의식으로 ㄱ을 짧게 끊어보세요. 손바닥을 입 앞에 두었을 때 바람이 거의 느껴지지 않아야 평음 영역에 정확히 안착합니다.",
      "gabang_vn": "가방 (ㄱ) lẽ ra phải ở vùng huyền phía dưới · nặng bên trái của la bàn (ngắn và thấp), nhưng tọa độ hiện tại tuy giữ tốt trục nặng lại bị đẩy sang tận đầu bật hơi bên phải với VOT 91ms, gần như chồng lên 카드. Mẫu F0 (-3.8 st) gần như trùng với người bản xứ (-3.7), nên trục dọc đã hoàn hảo — chỉ cần kéo trục ngang lùi sang trái khoảng 30ms. Hãy mở môi thật ít và phát âm ㄱ ngắn gọn với ý thức 'không tạo ra hơi'. Khi đặt lòng bàn tay trước miệng mà gần như không cảm nhận được hơi, bạn đã đáp đúng vào vùng âm thường.",
      "ggamansaek": "까만색(ㄲ)은 나침반에서 nặng 왼쪽 깊은 영역에 잘 자리잡았습니다. VOT 45ms는 원어민 8ms보다 다소 오른쪽으로 치우쳐 있지만, 평음(91ms)·격음(93ms)과는 분명히 떨어진 위치라 경음 축은 살아 있습니다. F0 패턴(+1.3 st)도 원어민과 정확히 일치해 sắc 위쪽 영역에도 제대로 올라와 있습니다. 더 완성도를 높이려면 발음 직전 목 안쪽을 한순간 잠그듯 긴장시켜 VOT를 10ms 부근까지 더 짧게 끌어당겨 보세요 — 이 단어가 학습자의 가장 큰 강점입니다.",
      "ggamansaek_vn": "까만색 (ㄲ) đã định vị tốt ở vùng nặng sâu bên trái của la bàn. VOT 45ms tuy hơi lệch phải so với người bản xứ (8ms), nhưng vẫn tách biệt rõ với âm thường (91ms) và âm bật hơi (93ms), nên trục âm căng được giữ vững. Mẫu F0 (+1.3 st) trùng khớp với người bản xứ, đã lên đúng vùng sắc phía trên. Để hoàn thiện hơn, hãy thử siết nhẹ phía trong cổ họng ngay trước khi phát âm, kéo VOT về khoảng 10ms — đây là điểm mạnh lớn nhất của bạn.",
      "kadeu": "카드(ㅋ)는 나침반에서 bật hơi 오른쪽 + sắc 위쪽 영역에 정확히 자리잡았습니다. VOT 93ms로 원어민 83ms와 거의 같고, F0 패턴(+1.9 st)도 원어민(+1.9)과 완벽히 일치합니다. 격음 자체는 매우 잘 발음하고 있다는 뜻입니다. 다만 문제는 카드가 가방(91ms)과 너무 가까워 두 음이 겹치는 것 — 카드를 더 손볼 필요는 없고, 오히려 가방을 왼쪽(짧은 VOT)으로 끌어당겨 격음과의 거리를 확보하는 것이 핵심입니다.",
      "kadeu_vn": "카드 (ㅋ) đã đáp chính xác vào vùng bật hơi bên phải + sắc phía trên của la bàn. VOT 93ms gần như bằng người bản xứ (83ms), và mẫu F0 (+1.9 st) trùng khớp hoàn toàn với người bản xứ (+1.9). Nghĩa là bản thân âm bật hơi bạn phát âm rất tốt. Vấn đề chỉ là 카드 quá gần với 가방 (91ms) nên hai âm chồng lên nhau — bạn không cần chỉnh thêm 카드, mà nên kéo 가방 sang trái (VOT ngắn lại) để tạo khoảng cách với âm bật hơi."
    },
    "encouragement": "음높이 위계가 이미 원어민 수준으로 자리잡은 것은 정말 큰 성과예요 — 평음의 바람만 살짝 줄이면 곧 세 음이 또렷이 분리됩니다!",
    "encouragement_vn": "Việc thứ bậc cao độ đã đạt mức gần như người bản xứ là một thành tựu rất lớn — chỉ cần giảm bớt một chút hơi ở âm thường, ba âm sẽ sớm tách biệt rõ ràng!",
    "_source": "claude"
