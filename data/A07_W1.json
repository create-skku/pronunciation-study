  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음의 VOT가 모두 길어지고 경음의 F0 위계가 무너져, 세 소리의 구분이 약하게 형성된 단계입니다.",
      "summary_vn": "Ba phụ âm 평음·경음·격음 đều có VOT dài hơn chuẩn và 경음 không nâng cao tông như mong đợi, khiến sự phân biệt giữa ba âm còn yếu.",
      "detail": "바지(ㅂ)는 VOT가 다소 길게 나타나는 인상이 있어 평음 특유의 짧고 부드러운 시작이 아직 자리잡지 못한 것으로 보입니다. 빠르다(ㅃ)는 VOT 74ms로 원어민 0ms 대비 매우 길게 측정되었고, F0 패턴도 -3.2 st로 원어민 -0.4 st보다 2.9 st 더 낮아 경음의 핵심인 '짧은 VOT + 높은 F0' 위계가 거꾸로 형성되어 있습니다. 파란색(ㅍ)은 VOT 92ms로 원어민 60ms보다 길지만 격음으로서의 기식은 일정 부분 확보되었고, F0 패턴 2.7 st도 원어민 3.4 st와 -0.6 st 차이로 비교적 가깝게 따라가고 있어 셋 중 가장 안정적입니다. 종합하면 격음 톤은 유지하되 경음의 후두 긴장이 부족해 격음 쪽으로 끌려간 양상입니다.",
      "detail_vn": "바지(ㅂ) có cảm giác VOT hơi dài, chưa giữ được đặc trưng 'ngắn và nhẹ' của 평음. 빠르다(ㅃ) đo được VOT 74ms so với người bản ngữ 0ms — dài hơn rất nhiều — và F0 ở mức -3.2 st, thấp hơn người bản ngữ -0.4 st đến 2.9 st, tức là trật tự 'VOT ngắn + F0 cao' của 경음 đang bị đảo ngược. 파란색(ㅍ) có VOT 92ms (người bản ngữ 60ms) — dài hơn nhưng vẫn giữ được đặc tính 기식 của 격음, và F0 pattern 2.7 st rất gần với chuẩn 3.4 st (chênh -0.6 st), nên đây là âm ổn định nhất trong ba âm. Tổng thể, bạn giữ được tông của 격음 nhưng 경음 thiếu 후두 긴장 nên bị kéo về phía 격음.",
      "summary_audit": "ok"
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 특히 후두를 단단히 조여 만드는 경음의 발성 방식이 모국어에 존재하지 않습니다. 그래서 ㅃ를 발음할 때 후두 긴장 대신 익숙한 기식(공기 뿜기)으로 대체하면서 VOT가 길어지고 F0가 떨어지는 현상이 나타난 것으로 보입니다. 반면 격음은 베트남어 기식음과 비교적 비슷해서 톤 위계는 잘 따라가고 있는 것이 특징입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba bậc 평음·경음·격음 như tiếng Hàn, đặc biệt là cách tạo 경음 bằng cách siết chặt thanh quản hoàn toàn không tồn tại trong tiếng mẹ đẻ của bạn. Vì vậy khi phát âm ㅃ, bạn thay thế 후두 긴장 bằng động tác quen thuộc là phun hơi (기식), khiến VOT bị kéo dài và F0 bị tụt xuống. Ngược lại, 격음 lại khá giống các âm bật hơi trong tiếng Việt nên bạn giữ được trật tự tông khá tốt.",
    "correction": {
      "main_focus": "경음 ㅃ의 후두 긴장 — 숨을 멈춘 채 짧고 단단하게 '톡' 터뜨리는 감각을 만드는 것이 이번 단계의 최우선 과제입니다.",
      "main_focus_vn": "후두 긴장 của 경음 ㅃ — ưu tiên hàng đầu lúc này là tạo được cảm giác 'nén hơi rồi bật ra ngắn và chắc' mà không phun hơi.",
      "steps": [
        "손바닥을 입 앞 5cm에 두고 바-빠-파 최소대립쌍을 천천히 반복하며, 파(강한 바람) → 바(부드러운 바람) → 빠(거의 바람 없음) 세 단계의 바람 양 차이를 손으로 직접 느끼기",
        "경음 발음 직전에 숨을 살짝 멈추고 목 안쪽을 단단히 조이는 감각을 만든 뒤, 입술을 짧게 '톡' 끊어 터뜨리는 연습 — 이때 거울로 입술이 풀리지 않고 단단히 유지되는지 확인",
        "원어민 음원과 본인 녹음을 번갈아 들으며, 경음에서 음높이가 살짝 올라가는지(평음보다 높은지) 귀로 비교하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm, lặp lại chậm cặp tối thiểu 바-빠-파, cảm nhận trực tiếp ba mức gió: 파 (gió mạnh) → 바 (gió nhẹ) → 빠 (gần như không có gió) bằng bàn tay",
        "Trước khi phát âm 경음, nín hơi một chút và tạo cảm giác siết chặt phía trong cổ họng, sau đó bật môi ra ngắn gọn 'tốc' — dùng gương kiểm tra môi vẫn căng chắc chứ không buông lỏng",
        "Nghe xen kẽ bản ghi người bản ngữ và bản ghi của bản thân, dùng tai so sánh xem tông của 경음 có nhích cao hơn so với 평음 không"
      ]
    },
    "overall": "파란색(ㅍ)에서 격음의 톤 위계를 거의 원어민 수준으로 잡아낸 것은 이번 녹음의 가장 큰 강점입니다. 다만 경음 빠르다는 VOT가 길고 F0가 낮아져 격음 쪽으로 끌려간 형태이고, 바지의 평음도 살짝 길어져 세 소리의 간격이 충분히 벌어지지 않은 상태입니다. 우선 경음의 후두 긴장 한 가지에 집중하면 자연스럽게 세 소리가 분리되기 시작할 것입니다. 지금도 격음 톤이 안정적이라는 점은 분명한 진전이니, 그 감각을 기준 삼아 나머지 두 소리를 잡아가시면 됩니다.",
    "overall_vn": "Điểm mạnh lớn nhất trong bản ghi này là 파란색(ㅍ) — bạn đã giữ được trật tự tông của 격음 gần như ở mức người bản ngữ. Tuy nhiên 빠르다 (경음) có VOT dài và F0 thấp, bị kéo về phía 격음, còn 바지 (평음) cũng hơi dài nên khoảng cách giữa ba âm chưa được mở rộng đủ. Hãy tập trung vào một điều duy nhất — 후두 긴장 của 경음 — thì ba âm sẽ tự nhiên tách ra rõ hơn. Việc bạn đã ổn định được tông của 격음 là một bước tiến rõ ràng, hãy lấy cảm giác đó làm mốc để chỉnh hai âm còn lại.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)는 F0 측정이 빠져 톤 위계는 단정하기 어렵지만, VOT 측정상 128ms 부근으로 원어민 97ms보다 다소 길게 나타나는 인상이 있습니다. PRAAT 파형에서 첫 칸(폐쇄 해제부터 모음 시작까지)이 평음치고는 살짝 넓게 보일 가능성이 큽니다. 베트남 학습자에게서 흔히 보이는 패턴처럼, 평음을 베트남어 /b/ 보다 '약간 더 신경 써서' 발음하다 보니 오히려 기식이 살짝 섞인 것일 수 있습니다. 입술을 가볍게 닫았다가 거의 힘을 빼고 부드럽게 '바' 하고 시작해 보세요 — 손바닥을 입 앞에 두었을 때 아주 약한 바람만 느껴지면 충분합니다.",
      "baji_vn": "바지(ㅂ) thiếu dữ liệu F0 nên khó khẳng định chắc về trật tự tông, nhưng VOT đo được khoảng 128ms — dài hơn người bản ngữ (97ms). Trên dạng sóng PRAAT, ô đầu tiên (từ lúc nhả môi đến lúc nguyên âm bắt đầu) có khả năng trông hơi rộng so với một 평음 thông thường. Giống như xu hướng chung của học viên Việt Nam, có thể bạn đang phát âm 평음 'cẩn thận hơn' so với /b/ tiếng Việt và vô tình thêm chút hơi vào. Hãy khép môi nhẹ, gần như buông lỏng rồi bắt đầu 'ba' một cách mềm mại — đặt bàn tay trước miệng chỉ cảm nhận một luồng gió rất nhẹ là đủ.",
      "bbareuda": "빠르다(ㅃ)는 VOT 74ms로 원어민 0ms와 비교해 폐쇄 해제 직후 공백이 매우 길게 나타나, PRAAT 파형에서는 첫 칸이 경음치고 지나치게 넓고 격음과 비슷한 모양으로 보일 것입니다. F0 패턴도 -3.2 st로 원어민 -0.4 st보다 2.9 st 낮아, 파란 F0 곡선이 모음 시작 부분에서 위로 솟지 않고 오히려 아래로 처지는 형태입니다. 즉 후두 긴장 대신 기식으로 발음하고 있어 경음이 격음 쪽으로 끌려간 상태입니다. 발음 직전에 숨을 한 박자 멈추고 목 안쪽을 살짝 조인 뒤, 입술을 짧고 단단하게 '빡' 하고 끊어 터뜨리세요 — 손바닥에 바람이 거의 느껴지지 않아야 정답입니다.",
      "bbareuda_vn": "빠르다(ㅃ) có VOT 74ms so với người bản ngữ 0ms — khoảng trống sau khi nhả môi rất dài, nên trên dạng sóng PRAAT, ô đầu tiên sẽ rộng quá mức so với 경음 và trông giống 격음. F0 pattern -3.2 st cũng thấp hơn chuẩn -0.4 st đến 2.9 st, nghĩa là đường F0 màu xanh ở đầu nguyên âm không nhô lên mà còn võng xuống. Tức là bạn đang dùng 기식 thay cho 후두 긴장, khiến 경음 bị kéo về phía 격음. Trước khi phát âm hãy nín hơi một nhịp, siết nhẹ phía trong cổ họng, rồi bật môi ra thật ngắn và chắc 'pặc' — bàn tay đặt trước miệng gần như không cảm nhận được gió là đúng.",
      "paransaek": "파란색(ㅍ)은 VOT 92ms로 원어민 60ms보다는 다소 길지만 격음으로서의 기식은 충분히 확보되어 있고, F0 패턴 2.7 st도 원어민 3.4 st와 거의 같은 위치에 있습니다. PRAAT 파형에서는 첫 칸이 넓게 펼쳐지고, 파란 F0 곡선이 모음 시작과 함께 위로 또렷이 올라가는 모양이 잘 보일 것입니다. 세 단어 중 가장 안정적인 발음이니 이 감각을 기준점으로 삼으세요 — 다만 VOT가 살짝 더 긴 편이라, 기식의 양은 유지하되 폐쇄 해제부터 모음 시작까지의 간격을 아주 약간만 더 짧게 끊어주면 더 자연스러워집니다.",
      "paransaek_vn": "파란색(ㅍ) có VOT 92ms — hơi dài hơn người bản ngữ (60ms) — nhưng đặc tính 기식 của 격음 được giữ đầy đủ, và F0 pattern 2.7 st gần như trùng với chuẩn 3.4 st. Trên dạng sóng PRAAT, ô đầu tiên sẽ trải rộng và đường F0 màu xanh nhô lên rõ ràng ngay khi nguyên âm bắt đầu. Đây là âm ổn định nhất trong ba âm, hãy lấy cảm giác này làm mốc — chỉ cần giữ nguyên lượng hơi, nhưng rút ngắn một chút khoảng cách từ lúc nhả môi đến lúc nguyên âm bắt đầu thì sẽ tự nhiên hơn nữa."
    },
    "encouragement": "격음의 톤을 거의 원어민 수준으로 잡으신 것은 정말 큰 진전입니다 — 그 감각을 기준 삼아 한 걸음씩 가시면 됩니다!",
    "encouragement_vn": "Việc bạn đã giữ được tông của 격음 gần như ngang người bản ngữ là một bước tiến rất lớn — hãy lấy cảm giác đó làm mốc và đi từng bước một, bạn nhất định sẽ làm được!",
    "_source": "claude"
