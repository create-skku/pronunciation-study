  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음의 VOT 위계는 잡혔으나, 격음의 기식이 과도하고 평음이 너무 약합니다.",
      "summary_vn": "Thứ tự VOT của 평음·경음·격음 đã hình thành, nhưng 격음 thì hơi gió quá mạnh còn 평음 lại quá yếu.",
      "detail": "가방(ㄱ)의 VOT가 0ms로 측정되어 원어민 63ms 대비 지나치게 짧고, 성대 진동이 모음과 거의 동시에 시작되어 베트남어 유성 /b/ 영역에 가깝게 들립니다. 까만색(ㄲ)은 VOT 9ms로 원어민 8ms와 거의 일치해 가장 안정적입니다. 카드(ㅋ)는 VOT 110ms로 원어민 83ms보다 27ms 더 길어 기식이 과도하게 분출되었고, 동시에 F0 패턴이 +1.9st 대신 +1.1st로 낮아져 격음의 '높은 톤' 특징이 살짝 약해졌습니다.",
      "detail_vn": "가방(ㄱ) có VOT đo được 0ms, quá ngắn so với 63ms của người bản ngữ, và dây thanh rung gần như đồng thời với nguyên âm nên nghe gần với âm /b/ hữu thanh tiếng Việt. 까만색(ㄲ) có VOT 9ms, gần như trùng khớp với 8ms của người bản ngữ — đây là âm ổn định nhất. 카드(ㅋ) có VOT 110ms, dài hơn người bản ngữ (83ms) tới 27ms, hơi gió bị bung ra quá mức; đồng thời pattern F0 chỉ đạt +1.1st thay vì +1.9st nên đặc trưng 'tông cao' của 격음 hơi yếu đi."
    },
    "cause": "베트남어에는 한국어식 평음-경음-격음 3중 구분이 없고 유·무성 대립이 중심이라, 평음 ㄱ을 베트남어 유성 /b/처럼 성대 진동을 일찍 시작하는 습관이 그대로 나타납니다. 반면 격음 ㅋ은 '한국어다운 강한 자음'으로 의식하면서 필요 이상으로 기식을 길게 빼는 과보상이 일어나고 있습니다. 경음 ㄲ이 잘 잡힌 것은 후두 긴장 동작을 이미 익혔다는 강한 신호입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc 평음-경음-격음 mà chủ yếu là đối lập hữu thanh/vô thanh, nên thói quen phát 평음 ㄱ giống /b/ hữu thanh của tiếng Việt (rung dây thanh sớm) vẫn còn nguyên. Ngược lại, với 격음 ㅋ, người học có ý thức 'đây là phụ âm mạnh kiểu Hàn' nên bù trừ quá mức bằng cách kéo dài hơi gió hơn cần thiết. Việc 경음 ㄲ phát chuẩn là dấu hiệu mạnh cho thấy bạn đã nắm được động tác căng thanh quản.",
    "correction": {
      "main_focus": "평음 ㄱ에 '약간의 무성 지연(20ms 정도 숨)'을 더하고, 격음 ㅋ의 기식을 절반 정도로 줄여 세 음을 등간격으로 벌리는 것이 핵심입니다.",
      "main_focus_vn": "Trọng tâm là thêm 'một chút trễ vô thanh (khoảng 20ms hơi)' vào 평음 ㄱ và giảm hơi gió của 격음 ㅋ xuống còn khoảng một nửa, để ba âm cách đều nhau.",
      "steps": [
        "손바닥을 입 앞 5cm에 두고 평음-경음-격음을 차례로 발음하며 바람 양의 '약-없음-강' 차이를 손으로 직접 느껴 보세요.",
        "최소대립쌍(가-까-카)을 거울 앞에서 천천히 3번씩 반복하며, 입술이 열리는 순간과 모음이 시작되는 순간의 시간 간격에 집중하세요.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 격음에서 '숨이 너무 길지 않은지' 매 회 체크하세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm, lần lượt phát 평음-경음-격음 và cảm nhận trực tiếp bằng tay sự khác biệt lượng hơi 'nhẹ-không có-mạnh'.",
        "Lặp lại cặp đối lập tối thiểu (가-까-카) trước gương, mỗi âm 3 lần thật chậm, tập trung vào khoảng cách thời gian giữa lúc môi mở ra và lúc nguyên âm bắt đầu.",
        "Nghe xen kẽ giữa âm mẫu của người bản ngữ và bản ghi của chính mình, mỗi lần đều kiểm tra xem hơi ở 격음 có bị kéo quá dài không."
      ]
    },
    "overall": "세 음의 VOT 위계 자체는 '0ms < 9ms < 110ms'로 한국어식 순서가 정확히 잡혀 있고, 특히 경음 까만색은 원어민 수치와 1ms 차이로 거의 완벽합니다. 다만 양 끝의 평음과 격음이 각각 한 발씩 더 멀리 벌어져 있어, 평음은 베트남어 /b/ 쪽으로, 격음은 과한 기식 쪽으로 치우쳐 있습니다. 양 끝을 안쪽으로 한 칸씩 당겨오면 세 음이 한국어다운 균형을 이룰 것입니다. 전반적으로 매우 안정적인 토대 위에 있는 단계입니다.",
    "overall_vn": "Bản thân thứ tự VOT của ba âm là '0ms < 9ms < 110ms' — đúng trật tự tiếng Hàn, đặc biệt 경음 까만색 chỉ chênh 1ms so với người bản ngữ, gần như hoàn hảo. Tuy nhiên 평음 và 격음 ở hai đầu lại bị dạt ra xa thêm một bước: 평음 nghiêng về /b/ tiếng Việt, còn 격음 thì hơi gió quá mức. Chỉ cần kéo hai đầu vào trong mỗi bên một nấc là ba âm sẽ đạt được sự cân bằng kiểu tiếng Hàn. Nhìn chung bạn đang ở giai đoạn có nền tảng rất vững chắc.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방 ㄱ의 VOT가 0ms로 측정되어, PRAAT 파형에서 자음 폐쇄가 풀리는 순간과 모음 ㅏ의 규칙적 진동이 거의 같은 지점에서 시작됩니다 — 원어민의 63ms 공백 구간이 사실상 사라진 상태입니다. 파란 F0 곡선도 -3.0st로 원어민 -3.7st보다 살짝 높아, 평음 특유의 '낮고 부드러운 출발' 느낌이 약합니다. 입술을 한 번 닫았다가 풀 때, 모음을 바로 내지 말고 '하나' 셀 정도의 짧은 숨(약 20ms)을 의식적으로 흘려보내 보세요. 손바닥을 입 앞에 두면 아주 약한 바람이 잠깐 느껴져야 합니다.",
      "gabang_vn": "VOT của 가방 ㄱ đo được 0ms, trên dạng sóng PRAAT thì khoảnh khắc phụ âm bật ra và lúc nguyên âm ㅏ bắt đầu rung đều gần như cùng một điểm — khoảng trống 63ms của người bản ngữ gần như biến mất. Đường F0 màu xanh cũng ở -3.0st, hơi cao hơn -3.7st của người bản ngữ, nên cảm giác 'khởi đầu thấp và mềm' đặc trưng của 평음 bị yếu đi. Khi mở môi ra sau khi khép, đừng phát nguyên âm ngay lập tức, hãy có ý thức để một hơi ngắn (khoảng 20ms, đếm 'một') thoát ra. Đặt lòng bàn tay trước miệng, bạn phải cảm nhận được một luồng gió rất nhẹ trong khoảnh khắc.",
      "ggamansaek": "까만색 ㄲ의 VOT는 9ms로 원어민 8ms와 단 1ms 차이 — PRAAT 파형에서 폐쇄 직후 모음이 칼처럼 깔끔하게 들어오는 이상적인 모습입니다. F0도 +1.6st로 원어민 +1.3st와 거의 같은 높이에서 출발해 경음의 '단단한 시작' 특징이 잘 살아 있습니다. 이 단어는 손대지 말고 그대로 유지하세요 — 다른 두 단어를 교정할 때 '경음의 입 모양·후두 긴장 느낌'을 기준점(anchor)으로 삼으면 됩니다.",
      "ggamansaek_vn": "VOT của 까만색 ㄲ là 9ms, chỉ chênh 1ms so với 8ms của người bản ngữ — trên dạng sóng PRAAT, nguyên âm vào ngay sau khi phụ âm bật ra một cách sắc gọn như dao cắt, đúng kiểu lý tưởng. F0 cũng ở +1.6st, gần như cùng độ cao với +1.3st của người bản ngữ, nên đặc trưng 'khởi đầu cứng cáp' của 경음 được giữ rất tốt. Đừng động vào âm này — khi sửa hai âm còn lại, hãy lấy 'cảm giác về khẩu hình và độ căng thanh quản của 경음' này làm điểm tựa (anchor).",
      "kadeu": "카드 ㅋ의 VOT는 110ms로 원어민 83ms보다 27ms 더 길어, PRAAT 파형에서 폐쇄 풀림과 모음 시작 사이의 회색 기식 구간이 한 칸 더 넓게 보입니다. 게다가 파란 F0 곡선이 +1.1st로 원어민 +1.9st보다 낮아, 기식만 강하고 톤은 오히려 평탄해진 상태입니다. 손바닥을 입 앞에 두고 '카' 를 발음할 때, 바람이 끝까지 다 빠지기 전에 모음으로 빨리 넘어가는 연습을 해 보세요 — 지금의 절반 정도 길이로 짧게 끊되, 모음의 시작 톤은 의식적으로 한 단계 더 높이는 것이 핵심입니다.",
      "kadeu_vn": "VOT của 카드 ㅋ là 110ms, dài hơn người bản ngữ (83ms) tới 27ms — trên dạng sóng PRAAT, khoảng hơi gió màu xám giữa lúc bật phụ âm và lúc nguyên âm bắt đầu rộng hơn một nấc. Hơn nữa đường F0 màu xanh chỉ ở +1.1st, thấp hơn +1.9st của người bản ngữ, nên chỉ có hơi gió mạnh còn tông lại phẳng đi. Khi phát '카' với lòng bàn tay trước miệng, hãy luyện tập chuyển sang nguyên âm sớm hơn, trước khi hơi gió thoát hết — rút ngắn còn khoảng một nửa độ dài hiện tại, nhưng có ý thức nâng tông khởi đầu của nguyên âm lên một nấc, đó là điểm mấu chốt.",
      "kadeu_vn_note": ""
    },
    "encouragement": "경음 까만색이 원어민과 1ms 차이로 거의 완벽합니다 — 가장 어려운 후두 긴장을 이미 익혔다는 뜻이니, 양 끝만 다듬으면 곧 세 음 모두 자연스러워질 거예요!",
    "encouragement_vn": "경음 까만색 của bạn chỉ chênh 1ms so với người bản ngữ — gần như hoàn hảo! Điều đó có nghĩa bạn đã nắm được động tác căng thanh quản khó nhất rồi, chỉ cần chỉnh hai đầu là cả ba âm sẽ tự nhiên ngay thôi!",
