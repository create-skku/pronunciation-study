  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음이 VOT 20ms 부근으로 평탄화되어 3중 구분이 거의 형성되지 않은 단계입니다.",
      "summary_vn": "Ba phụ âm 평음·경음·격음 đều có VOT khoảng 20ms, gần như chưa hình thành sự phân biệt ba bậc.",
      "detail": "바지(ㅂ)의 VOT 가 20ms 로 원어민 97ms 보다 크게 짧고, 파란색(ㅍ)도 20ms 에 머물러 원어민 60ms 의 강한 기식이 거의 보이지 않습니다. 빠르다(ㅃ)는 20ms 로 원어민 0ms 보다 다소 길어 후두 긴장 대신 약한 기식이 섞여 있습니다. F0 패턴(semitone)을 보면 원어민은 평음 -3.7 / 경음 -0.4 / 격음 +3.4 로 뚜렷한 위계가 있는 반면, 학습자는 0.2 / 0.7 / -0.9 로 위계가 거의 평탄하고 오히려 격음에서 톤이 살짝 내려가는 역전이 관찰됩니다. 결과적으로 세 자음이 VOT·F0 모두에서 비슷한 자리에 모여 있습니다.",
      "detail_vn": "바지(ㅂ) có VOT 20ms, ngắn hơn nhiều so với người bản ngữ 97ms; 파란색(ㅍ) cũng dừng ở 20ms nên hầu như không thấy luồng hơi mạnh đặc trưng của 60ms bản ngữ. 빠르다(ㅃ) ở mức 20ms, dài hơn mức 0ms của bản ngữ, cho thấy thay vì căng thanh quản thì lại lẫn một chút bật hơi yếu. Về F0 (semitone), bản ngữ có thứ bậc rõ: 평음 -3.7 / 경음 -0.4 / 격음 +3.4, còn học viên là 0.2 / 0.7 / -0.9 — gần như phẳng và thậm chí 격음 còn tụt xuống một chút, ngược chiều. Kết quả là ba phụ âm đều tụ về cùng một vùng cả về VOT lẫn F0.",
      "compass_overview": ""
    },
    "cause": "베트남어에는 한국어식 평·경·격 3중 대립이 없고, /b/·/p/ 정도의 2중 대립만 존재하기 때문에 세 자음이 베트남어의 가장 익숙한 무기식 짧은 자음 쪽으로 끌려와 같은 자리에 모이는 것입니다. 특히 격음의 강한 기식과 경음의 후두 긴장은 모두 베트남어에 없는 동작이라 동시에 약화되기 쉽고, F0 위계도 자연스럽게 형성되지 못합니다.",
    "cause_vn": "Tiếng Việt không có thế đối lập ba bậc 평·경·격 như tiếng Hàn mà chỉ có khoảng /b/·/p/, nên cả ba phụ âm bị kéo về vùng phụ âm ngắn, không bật hơi quen thuộc nhất của tiếng Việt và tụ về cùng một điểm. Đặc biệt, luồng hơi mạnh của 격음 và sự căng thanh quản của 경음 đều là động tác không có trong tiếng Việt nên thường yếu đi cùng lúc, và thứ bậc F0 cũng vì thế chưa kịp hình thành.",
    "correction": {
      "main_focus": "셋을 동시에 다듬으려 하지 말고, 입 앞 손바닥에 닿는 '바람의 양' 차이부터 ㅍ(강함) → ㅂ(부드러움) → ㅃ(거의 없음) 순서로 몸으로 만드세요.",
      "main_focus_vn": "Đừng cố sửa cả ba cùng lúc; trước hết hãy dùng lòng bàn tay trước miệng để tạo ra sự khác biệt về 'lượng hơi' theo thứ tự ㅍ (mạnh) → ㅂ (nhẹ) → ㅃ (gần như không có).",
      "steps": [
        "손바닥을 입 앞 5cm 에 대고 ㅍ-ㅂ-ㅃ 순서로 발음하며 손바닥에 닿는 바람의 양이 '강·중·거의 없음' 으로 분명히 달라지는지 매번 확인하기.",
        "거울 앞에서 최소대립쌍(바-빠-파, 바지-빠지-파지)을 천천히 3회씩 반복하며, ㅃ 에서는 발음 직전 0.3초 정도 목과 입술을 단단히 잠갔다가 터뜨리는 '긴장→터짐' 감각을 만들기.",
        "원어민 음원과 본인 녹음을 번갈아 들으며, 자음 직후 모음의 톤이 ㅂ에서는 낮게 내려가고 ㅍ·ㅃ 에서는 위로 떠오르는지 — 위계가 들리는지 — 귀로 확인하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm, phát âm theo thứ tự ㅍ-ㅂ-ㅃ và mỗi lần kiểm tra xem luồng hơi chạm vào tay có rõ ràng khác nhau theo mức 'mạnh – vừa – gần như không có' hay không.",
        "Đứng trước gương, lặp lại các cặp tối thiểu (바-빠-파, 바지-빠지-파지) chậm rãi 3 lần mỗi cặp; với ㅃ, hãy khóa chặt môi và cổ họng khoảng 0.3 giây trước khi bật ra để tạo cảm giác 'căng → vỡ'.",
        "Nghe xen kẽ bản ghi của người bản ngữ và bản ghi của chính mình, kiểm tra bằng tai xem nguyên âm ngay sau phụ âm có hạ thấp ở ㅂ và nổi lên ở ㅍ·ㅃ hay không — tức là thứ bậc cao thấp có nghe ra được hay chưa."
      ]
    },
    "overall": "현재는 세 자음이 VOT 20ms·F0 0 부근에 모두 모여 있어 한국인 청자에게는 셋이 비슷한 소리로 들릴 가능성이 큰 단계입니다. 다만 모든 측정이 안정적으로 잡혔다는 것은 발음 자체가 일관되고 또렷하다는 뜻이고, 이는 위계를 새로 얹기에 아주 좋은 출발점입니다. 우선순위는 ① 격음 ㅍ 의 기식을 키워 오른쪽으로 보내기 → ② 경음 ㅃ 의 후두 긴장을 만들어 왼쪽 위로 올리기 → ③ 평음 ㅂ 을 아래로 자연스럽게 내려놓기 순입니다. 한 번에 하나씩만 바꿔도 전체 그림이 빠르게 살아납니다.",
    "overall_vn": "Hiện tại cả ba phụ âm đều tụ quanh VOT 20ms và F0 khoảng 0, nên với người Hàn nghe sẽ rất giống nhau. Tuy nhiên, việc tất cả các giá trị đo đều ổn định cho thấy cách phát âm rất nhất quán và rõ ràng — đây là điểm xuất phát rất tốt để bắt đầu xây dựng thứ bậc. Thứ tự ưu tiên là: ① tăng luồng hơi của 격음 ㅍ để đẩy sang bên phải → ② tạo độ căng thanh quản cho 경음 ㅃ để đưa lên góc trái trên → ③ để 평음 ㅂ hạ xuống một cách tự nhiên. Mỗi lần chỉ cần sửa một điểm, toàn bộ bức tranh sẽ nhanh chóng sống động trở lại.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)는 나침반의 중앙 ngang 부근에 머물러 있고, F0 가 본인 baseline 보다 +0.2 st 로 거의 평평합니다. 원어민은 같은 자리에서 -3.7 st 아래쪽(huyền 영역) 으로 내려가 있어, 학습자가 평음 특유의 '아래로 내려앉는 톤' 을 아직 만들지 못한 상태입니다. VOT 20ms 자체는 평음으로서 적절한 위치지만, 자음 직후 모음의 첫 음을 의도적으로 한 단계 낮게 떨어뜨려야 nặng·huyền 쪽 깊은 영역으로 자리잡습니다. 발음 직전 어깨를 살짝 떨어뜨리고 '바' 의 모음을 한숨 쉬듯 부드럽게 내려놓는 연습이 좋습니다.",
      "baji_vn": "바지(ㅂ) đang nằm gần vùng giữa ngang của la bàn, F0 chỉ +0.2 st so với baseline của chính bạn, tức gần như phẳng. Người bản ngữ ở cùng vị trí lại tụt xuống -3.7 st, tức vùng huyền phía dưới, cho thấy bạn chưa tạo được tông 'chùng xuống' đặc trưng của 평음. Bản thân VOT 20ms là hợp lý cho 평음, nhưng nguyên âm ngay sau phụ âm cần được hạ thấp một bậc một cách có chủ ý để rơi vào vùng sâu phía nặng·huyền. Trước khi phát âm, hãy thả vai xuống nhẹ và 'đặt' nguyên âm 바 xuống mềm như một tiếng thở.",
      "bbareuda": "빠르다(ㅃ)는 본래 왼쪽 nặng 깊은 영역(VOT 거의 0, F0 위로 솟음)에 있어야 하는데, 학습자는 VOT 20ms·F0 +0.7 st 로 거의 평음 ㅂ 과 같은 자리에 멈춰 있습니다. 즉 나침반 위에서 ㅂ 과 ㅃ 이 한 점에 겹쳐 있는 상태입니다. 왼쪽으로 보내려면 발음 직전 입술과 목을 0.3초 정도 단단히 잠그는 '긴장' 동작이 필요하고, 그 긴장이 풀리면서 모음이 자연스럽게 약간 위로(sắc 쪽) 튀어 올라야 합니다. 손바닥에는 바람이 거의 닿지 않아야 하고, 그 대신 가슴이 살짝 단단해지는 느낌을 확인하세요.",
      "bbareuda_vn": "빠르다(ㅃ) lẽ ra phải nằm ở vùng sâu phía nặng bên trái (VOT gần 0, F0 vọt lên), nhưng bạn đang ở VOT 20ms và F0 +0.7 st — gần như trùng vị trí với 평음 ㅂ. Tức là trên la bàn, ㅂ và ㅃ đang chồng lên cùng một điểm. Để đẩy sang trái, trước khi bật âm bạn cần khóa chặt môi và cổ họng khoảng 0.3 giây tạo động tác 'căng', rồi khi nhả ra nguyên âm sẽ bật lên trên (về phía sắc) một cách tự nhiên. Lòng bàn tay gần như không cảm thấy hơi, thay vào đó hãy chú ý cảm giác ngực hơi căng cứng.",
      "paransaek": "파란색(ㅍ)은 나침반의 오른쪽 bật hơi 영역, 그리고 위쪽 sắc 영역에 동시에 있어야 합니다. 그러나 학습자는 VOT 20ms·F0 -0.9 st 로 오른쪽으로 거의 가지 못했고, 톤은 오히려 baseline 아래로 떨어져 sắc 의 반대 방향인 huyền 쪽으로 가 있습니다 — 격음으로서는 가장 큰 어긋남입니다. 입 앞 손바닥에 종이를 들고 그 종이가 확실히 흔들릴 만큼 '하!' 하는 기식을 자음에 얹고, 그와 동시에 뒤따르는 '아' 의 첫 음을 평소보다 한 단계 위로 띄워 주세요. 바람과 톤 두 가지를 함께 끌어올리는 것이 핵심입니다.",
      "paransaek_vn": "파란색(ㅍ) phải nằm đồng thời ở vùng bật hơi bên phải và vùng sắc phía trên của la bàn. Nhưng bạn đang ở VOT 20ms và F0 -0.9 st — gần như chưa dịch sang phải, còn tông lại tụt xuống dưới baseline, đi về phía huyền — ngược hướng với sắc, đây là độ lệch lớn nhất đối với 격음. Hãy cầm một tờ giấy trước miệng và thêm vào phụ âm một luồng hơi 'ha!' đủ mạnh để giấy rung rõ, đồng thời nâng nốt đầu của nguyên âm '아' theo sau lên cao hơn bình thường một bậc. Mấu chốt là nâng cả luồng hơi và tông giọng lên cùng lúc."
    },
    "encouragement": "세 단어 모두 측정이 또렷이 잡힐 만큼 발음이 일관돼 있다는 점은 큰 강점이에요 — 이제 위계 하나만 얹으면 됩니다!",
    "encouragement_vn": "Việc cả ba từ đều được đo rõ ràng và ổn định cho thấy cách phát âm của bạn rất nhất quán — đây là điểm mạnh lớn, giờ chỉ cần thêm 'thứ bậc' lên trên là được!",
    "_source": "claude"
  },
