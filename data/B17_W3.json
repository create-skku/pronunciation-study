  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음의 VOT 가 원어민보다 약간 길게 나타나고, 격음 카드의 기식이 절반 수준으로 줄어 격음의 '강한 바람' 특징이 가장 약합니다.",
      "summary_vn": "Âm thường (평음) và âm căng (경음) có VOT hơi dài hơn người bản ngữ một chút, còn âm bật hơi 카드 lại có luồng hơi chỉ bằng khoảng một nửa, nên đặc trưng 'hơi mạnh' của 격음 là yếu nhất.",
      "detail": "가방(ㄱ)은 VOT 76ms 로 원어민 63ms 보다 13ms 길어 평음치고 기식이 다소 과한 편이며, 까만색(ㄲ)은 16ms 로 원어민 8ms 보다 길어 후두 긴장이 살짝 풀린 인상입니다. 반면 카드(ㅋ)는 VOT 40ms 로 원어민 83ms 의 절반 수준에 그쳐, 격음다운 강한 기식이 명확히 부족합니다. F0 패턴(semitone)은 세 단어 모두 원어민과 거의 동일(-3.8/+1.3/+1.9 st)해 평음은 낮고 경음·격음은 높은 위계가 잘 잡혀 있습니다. 즉 음높이 위계는 안정적이지만, VOT 축에서 평음↔격음의 거리가 좁아져 셋이 가운데로 수렴하는 경향이 보입니다.",
      "detail_vn": "가방(ㄱ) có VOT 76ms, dài hơn người bản ngữ (63ms) 13ms — hơi nhiều hơi so với chuẩn của âm thường; 까만색(ㄲ) là 16ms so với 8ms của người bản ngữ, cho thấy độ căng thanh hầu hơi lỏng. Ngược lại, 카드(ㅋ) chỉ đạt VOT 40ms, bằng khoảng một nửa của người bản ngữ (83ms), nên đặc trưng bật hơi mạnh của 격음 rõ ràng còn thiếu. Về cao độ F0 (semitone), cả ba từ gần như trùng khớp với người bản ngữ (-3.8 / +1.3 / +1.9 st), nên thứ bậc 'âm thường thấp – căng/bật hơi cao' đã được hình thành tốt. Tóm lại, trục cao độ ổn định nhưng trục VOT thì khoảng cách giữa 평음 và 격음 bị thu hẹp, khiến cả ba có xu hướng dồn về giữa."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음의 3중 구분이 없고, 특히 한국어 격음 ㅋ 만큼 긴 기식(~80ms)을 만드는 자음 범주가 익숙하지 않습니다. 그래서 카드 같은 격음에서 폐 공기를 끝까지 길게 내보내는 동작이 짧게 끊기고, 동시에 평음 ㄱ 은 베트남어 무성 파열음과 비슷하게 발음하려다 보니 오히려 기식이 살짝 더 붙어 두 범주가 가운데로 모이는 결과가 나타납니다. 다행히 F0 위계는 이미 자리잡혀, 남은 과제는 음높이가 아니라 '바람의 양' 차이입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc 평음·경음·격음 như tiếng Hàn, và đặc biệt không quen tạo luồng hơi dài (~80ms) như 격음 ㅋ của tiếng Hàn. Vì vậy ở 카드, động tác đẩy hơi ra dài đến cuối bị ngắt sớm; đồng thời ở 평음 ㄱ, người học cố phát âm giống phụ âm tắc vô thanh tiếng Việt nên vô tình lại thêm chút hơi — kết quả là hai loại bị dồn về giữa. May mắn là thứ bậc F0 đã được thiết lập tốt, nên việc còn lại không phải cao độ mà là 'lượng hơi'.",
    "correction": {
      "main_focus": "음높이 위계는 이미 잘 잡혀 있으니, 이제는 입 앞 손바닥에 닿는 '바람의 양' 으로 평음↔격음 거리를 벌리는 데 집중하세요.",
      "main_focus_vn": "Thứ bậc cao độ đã rất tốt rồi, nên bây giờ hãy tập trung mở rộng khoảng cách giữa 평음 và 격음 bằng 'lượng hơi' cảm nhận được trên lòng bàn tay đặt trước miệng.",
      "steps": [
        "입 앞 5cm 에 손바닥을 두고 가-까-카 최소대립쌍을 천천히 반복하면서 카에서 손바닥에 닿는 바람이 가의 두 배 이상이 되는지 확인하세요.",
        "격음을 연습할 때는 자음 직전에 가슴 윗부분에 공기를 한 번 모았다가 한꺼번에 길게 내보내는 호흡 동작을 따로 떼어 연습하세요.",
        "원어민 음원과 본인 녹음을 번갈아 들으며, 자음 직후 '쉭~' 하는 기식 구간 길이를 귀로 비교해 보세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm và lặp lại chậm rãi cặp tối thiểu 가-까-카, kiểm tra xem luồng hơi chạm vào tay ở 카 có gấp đôi trở lên so với 가 không.",
        "Khi luyện âm bật hơi (격음), hãy tách riêng động tác hô hấp: dồn hơi vào phần ngực trên một lần, rồi đẩy ra một mạch dài ngay trước phụ âm.",
        "Nghe xen kẽ giữa file người bản ngữ và bản ghi âm của chính mình, dùng tai so sánh độ dài đoạn 'shhh~' bật hơi ngay sau phụ âm."
      ]
    },
    "overall": "F0 패턴이 세 단어 모두 원어민과 사실상 일치(차이 0.0~0.1 st)한다는 점은 매우 큰 강점입니다 — 음높이 감각은 이미 한국어 화자 수준에 와 있습니다. 다만 VOT 축에서 평음이 살짝 길고 격음은 절반밖에 안 나와, 세 자음이 가운데로 모이는 경향이 보입니다. 특히 격음 카드의 기식 부족이 가장 두드러진 단일 과제이니, 다른 두 단어보다 카드에 더 많은 연습 시간을 배정하세요. 경음 까만색은 약간만 더 짧고 단단하게 다듬으면 완성형에 가깝습니다.",
    "overall_vn": "Việc cả ba từ có F0 gần như trùng khớp với người bản ngữ (chênh lệch chỉ 0.0~0.1 st) là một điểm mạnh rất lớn — cảm nhận cao độ của bạn đã đạt tới mức của người nói tiếng Hàn. Tuy nhiên trên trục VOT, 평음 hơi dài và 격음 chỉ đạt một nửa, khiến cả ba phụ âm có xu hướng dồn về giữa. Đặc biệt việc thiếu hơi ở 격음 카드 là nhiệm vụ đơn lẻ nổi bật nhất, nên hãy dành nhiều thời gian luyện tập cho 카드 hơn hai từ còn lại. 경음 까만색 chỉ cần ngắn và chắc hơn một chút nữa là gần như hoàn thiện.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방은 나침반에서 ngang(평탄) 라인보다 -3.8 st 아래로 깊이 내려와 huyền(아래) 영역에 안정적으로 자리잡고 있어 평음 특유의 낮은 톤이 잘 표현됩니다. 다만 VOT 76ms 로 원어민 63ms 보다 오른쪽(bật hơi 방향)으로 13ms 정도 밀려나 있어, 평음치고는 살짝 기식 영역으로 새어 나간 좌표입니다. 입술이 떨어지자마자 모음 ㅏ 가 거의 동시에 시작된다는 감각으로, 자음과 모음 사이 '틈' 을 조금 줄여 좌표를 약간 왼쪽(nặng 방향)으로 당겨 주세요. 그러면 카드와의 좌우 거리가 자연스럽게 벌어집니다.",
      "gabang_vn": "Trên la bàn, 가방 nằm sâu phía dưới đường ngang -3.8 st, ổn định trong vùng huyền — nét tông thấp đặc trưng của 평음 được thể hiện tốt. Tuy nhiên với VOT 76ms so với 63ms của người bản ngữ, tọa độ bị đẩy sang phải (về phía bật hơi) khoảng 13ms, hơi lệch sang vùng có hơi so với chuẩn 평음. Hãy cảm giác như nguyên âm ㅏ bắt đầu gần như đồng thời ngay khi môi vừa tách ra, rút ngắn 'khe hở' giữa phụ âm và nguyên âm để kéo tọa độ về bên trái (hướng nặng) một chút. Khi đó khoảng cách trái-phải với 카드 sẽ tự nhiên được mở rộng.",
      "ggamansaek": "까만색은 나침반 위쪽(+1.3 st)에 정확히 원어민과 같은 높이에 놓여 있고, 좌우로도 VOT 16ms 로 nặng(왼쪽) 영역 안에 잘 들어와 있습니다. 다만 원어민 8ms 보다 8ms 정도 오른쪽으로 살짝 떠 있어, 경음 특유의 '짧고 단단한' 응축이 조금만 더 필요합니다. 자음을 만들기 직전 0.5초간 목을 살짝 조이고 숨을 멈췄다가 '딱!' 하고 짧게 터뜨리는 느낌으로 연습하면 좌표가 더 왼쪽 깊숙이 들어갑니다. 전체적으로는 세 단어 중 가장 안정적인 좌표입니다.",
      "ggamansaek_vn": "Trên la bàn, 까만색 nằm ở phía trên (+1.3 st) đúng cùng độ cao với người bản ngữ, và theo trục ngang cũng vào tốt vùng nặng (bên trái) với VOT 16ms. Tuy nhiên so với 8ms của người bản ngữ, tọa độ vẫn lệch sang phải khoảng 8ms, nên cần thêm chút độ 'ngắn và chắc' đặc trưng của 경음. Hãy thử ngay trước khi tạo phụ âm, siết nhẹ cổ họng và nín hơi khoảng 0.5 giây, rồi bật ra thật ngắn theo kiểu 'tách!' — tọa độ sẽ lùi sâu hơn về bên trái. Nhìn chung, đây là tọa độ ổn định nhất trong ba từ.",
      "kadeu": "카드는 나침반 위쪽(+1.9 st)에 원어민과 사실상 같은 높이로 잘 올라가 있어 음높이는 흠잡을 데 없습니다. 문제는 좌우 축 — VOT 40ms 로 원어민 83ms 보다 무려 43ms 나 왼쪽(nặng 방향)에 머물러, 격음이 있어야 할 오른쪽 끝(bật hơi) 영역까지 도달하지 못한 상태입니다. ㅋ 직후에 '하~' 하고 한숨을 길게 내쉬는 동작을 일부러 과장해서 붙여, 좌표를 오른쪽 끝까지 두 배 가까이 밀어 보내는 연습을 집중적으로 하세요. 이 한 단어가 이번 세 단어 중 가장 큰 변화 여지를 가진 단어입니다.",
      "kadeu_vn": "Trên la bàn, 카드 nằm phía trên (+1.9 st), gần như cùng độ cao với người bản ngữ — cao độ không có gì để chê. Vấn đề nằm ở trục ngang: với VOT 40ms so với 83ms của người bản ngữ, tọa độ bị lệch tận 43ms về bên trái (hướng nặng), chưa chạm tới vùng bật hơi ở rìa phải nơi 격음 phải nằm. Hãy cố ý phóng đại động tác thở dài 'haaa~' ngay sau ㅋ, tập trung luyện đẩy tọa độ sang sát bên phải, gần như gấp đôi vị trí hiện tại. Đây là từ có dư địa cải thiện lớn nhất trong ba từ lần này.",
      "kadeu_vn_dup_guard": ""
    },
    "encouragement": "F0 위계가 원어민과 거의 똑같다는 건 정말 큰 강점이에요 — 카드의 바람만 늘리면 셋이 또렷이 갈라집니다!",
    "encouragement_vn": "Việc thứ bậc F0 của bạn gần như trùng khớp với người bản ngữ thực sự là một điểm mạnh rất lớn — chỉ cần tăng thêm luồng hơi ở 카드 thôi là cả ba phụ âm sẽ tách bạch rõ ràng!",
    "_source": "claude"
  },
