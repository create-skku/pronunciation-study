  "ai_feedback": {
    "error_analysis": {
      "summary": "평음 ㄷ과 격음 ㅌ의 기식 양이 뒤바뀐 듯한 인상이며, 경음 ㄸ은 VOT 는 정확하지만 톤 상승이 약합니다.",
      "summary_vn": "Lượng hơi bật của ㄷ (bình âm) và ㅌ (kích âm) như bị đảo ngược, còn ㄸ (cảng âm) thì VOT chính xác nhưng độ nâng cao âm còn yếu.",
      "detail": "다리에서 VOT 가 78ms 로 측정되어 원어민 44ms 보다 거의 두 배 길게 나타났고, 반대로 타다는 학습자 VOT 가 0ms 로 원어민 84ms 와 크게 어긋나 격음의 기식이 거의 들리지 않습니다. 따뜻하다는 VOT 0ms 로 경음 자체의 짧고 단단한 시작점은 잘 잡혔지만, 모음 ㅏ 의 pattern_st 가 원어민 +2.3 대비 +0.4 에 머물러 경음 특유의 톤 상승이 1.9 st 부족합니다. 종합하면 ㄷ에는 격음처럼 기식이 새고, ㅌ에는 평음처럼 기식이 빠져 두 음의 좌표가 거의 맞바뀐 형태입니다.",
      "detail_vn": "Ở 다리, VOT đo được 78ms — gần gấp đôi mức 44ms của người bản ngữ, ngược lại ở 타다 VOT của học viên là 0ms, cách rất xa mức 84ms của người bản ngữ nên hơi bật của kích âm gần như không nghe thấy. 따뜻하다 có VOT 0ms cho thấy điểm khởi đầu ngắn và chắc của cảng âm đã được nắm tốt, nhưng pattern_st của nguyên âm ㅏ chỉ +0.4 so với +2.3 của người bản ngữ, tức thiếu 1.9 st độ nâng âm đặc trưng của cảng âm. Tổng hợp lại, ㄷ thì hơi rò như kích âm còn ㅌ thì mất hơi như bình âm — tọa độ của hai âm gần như bị đảo chỗ cho nhau."
    },
    "cause": "베트남어에는 한국어처럼 평·경·격 3중 구분이 없어 기식의 양과 후두 긴장을 자음별로 정밀하게 조절하는 습관이 잡혀 있지 않습니다. 그래서 ㄷ을 안전하게 발음하려다 오히려 숨을 더 실어 보내고, 정작 강한 숨이 필요한 ㅌ에서는 베트남어의 무기식 /t/ 습관이 그대로 나오는 좌표 역전이 생기기 쉽습니다. 경음의 후두 긴장 역시 베트남어에 없는 동작이라 VOT 는 맞춰도 톤이 따라 올라가지 않는 일이 잦습니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc bình–cảng–kích như tiếng Hàn, nên thói quen điều chỉnh chính xác lượng hơi bật và độ căng thanh quản theo từng phụ âm chưa được hình thành. Vì thế khi cố phát âm ㄷ cho an toàn lại vô tình đẩy nhiều hơi hơn, còn ở ㅌ — nơi cần hơi mạnh — thói quen /t/ không bật hơi của tiếng Việt lại lộ ra, gây hiện tượng đảo tọa độ. Độ căng thanh quản của cảng âm cũng là động tác không có trong tiếng Việt nên dù VOT đúng thì âm điệu thường không nâng lên kịp.",
    "correction": {
      "main_focus": "ㄷ의 기식을 줄이고 ㅌ의 기식을 키워 두 음의 '바람의 양' 좌표를 제자리로 돌려놓는 것이 최우선입니다.",
      "main_focus_vn": "Ưu tiên hàng đầu là giảm hơi bật ở ㄷ và tăng hơi bật ở ㅌ để đưa 'lượng gió' của hai âm trở về đúng tọa độ của chúng.",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 평음·경음·격음을 차례로 발음하며 손바닥에 닿는 바람 양의 차이를 직접 느껴 보세요.",
        "다-따-타 최소대립쌍을 원어민 음원과 본인 녹음을 번갈아 들으며 천천히 비교하고, 어느 자음에서 어긋났는지 귀로 먼저 잡아내세요.",
        "거울 앞에서 격음을 발음할 때 입 앞 얇은 종이가 확 흔들릴 만큼 숨을 내보내고, 경음을 발음할 때는 종이가 거의 움직이지 않을 만큼 후두를 짧고 단단하게 잠그는 연습을 하세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm, lần lượt phát âm bình âm–cảng âm–kích âm và cảm nhận trực tiếp sự khác biệt về lượng gió chạm vào tay.",
        "Luyện cặp tối thiểu 다-따-타 bằng cách nghe xen kẽ bản thu của người bản ngữ và của chính mình thật chậm, dùng tai để phát hiện trước phụ âm nào đang lệch.",
        "Trước gương, khi phát âm kích âm hãy thở ra mạnh tới mức tờ giấy mỏng trước miệng rung hẳn, còn khi phát âm cảng âm thì khóa thanh quản ngắn và chắc đến mức tờ giấy gần như không động."
      ]
    },
    "overall": "측정값은 모두 신뢰도 있게 잡혔고, 특히 경음 따뜻하다에서 VOT 를 0ms 로 정확히 맞춘 점은 큰 강점입니다 — 경음의 '시작점' 감각은 이미 자리잡혀 있다는 뜻입니다. 다만 평음 ㄷ과 격음 ㅌ에서 기식의 방향이 서로 뒤바뀐 상태라, 이 둘을 바로잡으면 세 음의 위계가 단번에 또렷해질 가능성이 큽니다. 경음의 톤 상승 부족은 그 다음 단계로 두고, 우선은 ㄷ과 ㅌ의 바람 양부터 분리하는 것을 권장합니다.",
    "overall_vn": "Tất cả các giá trị đo đều đáng tin cậy, đặc biệt việc khớp VOT 0ms ở cảng âm 따뜻하다 là một điểm mạnh rõ rệt — cảm giác về 'điểm khởi đầu' của cảng âm đã hình thành. Tuy nhiên, hướng hơi bật ở bình âm ㄷ và kích âm ㅌ đang bị đảo ngược, nên chỉ cần chỉnh lại hai âm này thì thứ bậc của cả ba âm có khả năng rõ nét lên ngay lập tức. Việc thiếu nâng âm ở cảng âm hãy để bước tiếp theo; trước hết hãy tách rõ lượng gió giữa ㄷ và ㅌ.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "dari": "다리는 나침반에서 원어민이 중앙에서 살짝 왼쪽·약간 아래쪽(부드러운 바람, ngang 살짝 아래)에 머무는 반면, 학습자 좌표는 VOT 78ms 로 오른쪽 bật hơi 영역까지 밀려가 격음 클러스터에 가까워졌습니다. F0 pattern_st 는 -2.4 로 원어민 -3.4 보다 1 st 위에 있어 위쪽으로도 살짝 떠 있는 상태입니다. 입술이 떨어지자마자 모음이 바로 시작되도록 숨을 거의 새지 않게 잡고, 손바닥에 닿는 바람을 절반 이하로 줄여 좌표를 왼쪽·약간 아래로 끌어내리는 것이 목표입니다. '다' 를 발음하기 직전 숨을 한 번 살짝 멈춘 뒤 부드럽게 모음으로 흘려보내는 감각으로 연습해 보세요.",
      "dari_vn": "Trên la bàn, người bản ngữ phát âm 다리 nằm hơi lệch trái và hơi dưới trung tâm (gió nhẹ, ngang hơi xuống), trong khi tọa độ của học viên với VOT 78ms bị đẩy sang vùng bật hơi bên phải, gần với cụm kích âm. F0 pattern_st là -2.4, cao hơn -3.4 của người bản ngữ 1 st nên cũng hơi lệch lên trên. Mục tiêu là giữ cho nguyên âm bắt đầu ngay khi môi vừa mở, không để hơi rò, giảm lượng gió chạm tay xuống còn dưới một nửa để kéo tọa độ về phía trái và hơi xuống dưới. Hãy luyện theo cảm giác: ngay trước khi phát '다' thì ngưng hơi một chút rồi mới nhẹ nhàng thả vào nguyên âm.",
      "ddatteut": "따뜻하다는 VOT 0ms 로 원어민과 동일하게 나침반의 왼쪽 nặng 끝점에 정확히 도달했습니다 — 가로축은 완벽합니다. 다만 F0 pattern_st 가 +0.4 로 원어민 +2.3 보다 약 1.9 st 아래에 머물러, 세로축에서 sắc 위쪽으로 충분히 올라가지 못하고 ngang 부근에 가라앉아 있습니다. 첫 자음을 누를 때 목 안쪽을 꽉 잠그는 느낌을 더 강하게 가져가서, 모음 ㅏ 가 터지는 순간 자기 baseline 보다 한 음정 이상 위에서 시작하도록 의식해 보세요. 짧고 단단한 시작 + 살짝 높은 톤 — 이 두 동작을 한 묶음으로 묶어 연습하면 좌표가 위로 끌어올려집니다.",
      "ddatteut_vn": "따뜻하다 đạt VOT 0ms — trùng khớp với người bản ngữ và chạm chính xác điểm cực trái nặng trên la bàn; trục ngang là hoàn hảo. Tuy nhiên F0 pattern_st chỉ +0.4, thấp hơn mức +2.3 của người bản ngữ khoảng 1.9 st, nên trên trục dọc chưa lên đủ về phía sắc mà đang chìm gần ngang. Hãy tăng cảm giác khóa chặt phía trong cổ họng khi đè phụ âm đầu, và ý thức rằng ngay khoảnh khắc nguyên âm ㅏ bật ra phải bắt đầu cao hơn baseline của bản thân ít nhất một nốt. Khởi đầu ngắn–chắc cộng với âm hơi cao — luyện hai động tác này thành một cụm sẽ kéo tọa độ đi lên.",
      "tada": "타다는 원어민이 오른쪽 bật hơi 끝(VOT 84ms)·살짝 위쪽 sắc 부근에 자리 잡는 단어인데, 학습자 좌표는 VOT 0ms 로 정반대인 왼쪽 nặng 영역까지 완전히 미끄러져 들어와 경음과 거의 같은 위치에 와 있습니다 — 가로축으로만 보면 따뜻하다와 거의 겹칩니다. F0 pattern_st 는 +1.7 로 원어민 +0.7 보다 살짝 위에 있어 세로축 자체는 나쁘지 않습니다. 다리에서 새던 숨을 통째로 이쪽으로 옮겨 온다고 생각하고, 'ㅌ' 직후 입에서 손바닥까지 닿는 바람이 다리·따뜻하다 때보다 분명히 강하도록 끌어올리세요. 종이가 흔들릴 만큼의 기식을 80ms 가까이 유지해야 좌표가 오른쪽 끝으로 이동합니다.",
      "tada_vn": "타다 là từ mà người bản ngữ nằm ở cực phải bật hơi (VOT 84ms) và hơi lệch lên phía sắc, nhưng tọa độ của học viên với VOT 0ms lại trượt hoàn toàn về vùng nặng bên trái — gần như cùng vị trí với cảng âm; xét theo trục ngang thì gần như chồng lên 따뜻하다. F0 pattern_st là +1.7, cao hơn +0.7 của người bản ngữ một chút nên bản thân trục dọc không tệ. Hãy nghĩ rằng toàn bộ hơi đang rò ở 다리 sẽ được chuyển nguyên sang đây: ngay sau 'ㅌ', luồng gió từ miệng tới lòng bàn tay phải mạnh hơn hẳn so với khi phát 다리 và 따뜻하다. Phải giữ được lượng hơi đủ làm tờ giấy rung trong gần 80ms thì tọa độ mới dịch sang cực phải."
    },
    "encouragement": "경음의 시작점을 정확히 잡은 것은 큰 자산입니다 — ㄷ과 ㅌ 사이의 바람만 맞바꿔 주면 세 음의 풍경이 단번에 또렷해질 거예요!",
    "encouragement_vn": "Việc bắt đúng điểm khởi đầu của cảng âm là một tài sản lớn — chỉ cần hoán đổi lại lượng gió giữa ㄷ và ㅌ là bức tranh ba âm sẽ rõ nét lên ngay!",
