  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음이 모두 짧고 평탄한 VOT 로 모여 3중 구분이 거의 형성되지 않은 단계입니다.",
      "summary_vn": "Ba phụ âm 평음·경음·격음 đều có VOT ngắn và bằng phẳng giống nhau, nên sự phân biệt 3 bậc gần như chưa hình thành.",
      "detail": "측정상 바지의 VOT 가 0ms, 빠르다가 7ms, 파란색이 0ms 로 셋이 거의 같은 영역에 몰려 있습니다. 원어민은 바지 97ms·파란색 60ms 로 평음과 격음에 충분한 기식을 두지만, 학습자에게는 그 차이가 사실상 0 입니다. F0 위계도 원어민이 평음(-3.7)<경음(-0.4)<격음(3.4) 로 약 7st 폭을 만드는 반면, 학습자는 -2.5 / 1.5 / 0.7 로 폭이 4st 로 좁고 격음이 경음보다 낮아 위계가 뒤섞여 있습니다.",
      "detail_vn": "Theo đo lường, VOT của 바지 là 0ms, 빠르다 là 7ms, 파란색 là 0ms — cả ba đều dồn về cùng một vùng. Người bản xứ tạo khoảng hơi rõ rệt ở 바지 97ms·파란색 60ms, nhưng ở học viên sự khác biệt gần như bằng 0. Về F0, bản xứ tạo thứ bậc 평음(-3.7)<경음(-0.4)<격음(3.4) với biên độ ~7st, trong khi học viên chỉ -2.5 / 1.5 / 0.7 — biên độ hẹp ~4st và 격음 lại thấp hơn 경음, khiến thứ bậc bị đảo lộn."
    },
    "cause": "베트남어에는 한국어식 평·경·격 3중 구분이 없어 세 자음을 하나의 /p/ 범주로 인식하기 쉽습니다. 특히 ㅍ 의 강한 기식과 ㅃ 의 후두 긴장은 둘 다 모국어에 없는 동작이라 동시에 약하게 나타나며, 그 결과 셋이 베트남어 /b/ 에 가까운 무기식·짧은 자음으로 평탄해진 것입니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt 3 bậc 평·경·격 như tiếng Hàn, nên học viên dễ gộp ba âm vào cùng một phạm trù /p/. Đặc biệt, hơi bật mạnh của ㅍ và sự căng thanh quản của ㅃ đều là động tác không có trong tiếng mẹ đẻ, nên cả hai cùng yếu đi, khiến cả ba âm đều bị san phẳng về dạng không bật hơi, ngắn — gần với /b/ tiếng Việt.",
    "correction": {
      "main_focus": "세 음 동시에 고치려 하지 말고, 입 앞 손바닥 시험으로 '바람의 양' 차이(파>바>빠) 부터 몸으로 만드세요.",
      "main_focus_vn": "Đừng cố sửa cả ba âm cùng lúc — hãy bắt đầu bằng việc tạo ra sự khác biệt về 'lượng hơi' (파>바>빠) qua phép thử lòng bàn tay trước miệng.",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 파/바/빠 를 번갈아 발음하며, 파에서 가장 센 바람·바에서 부드러운 바람·빠에서 거의 바람 없는 짧고 단단한 느낌의 3단 차이를 손으로 직접 느끼기.",
        "최소대립쌍 '바-빠-파' 를 천천히 5회씩 반복하고, 각 회마다 원어민 음원과 본인 녹음을 번갈아 들으며 기식 길이와 음높이 위계를 귀로 비교하기.",
        "녹음 전에는 본인 baseline 음높이로 짧게 워밍업한 뒤, 평음은 baseline 아래·경음과 격음은 baseline 위로 톤을 의식적으로 띄워 위계를 의도적으로 벌리기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm và phát âm luân phiên 파/바/빠, cảm nhận trực tiếp bằng tay 3 mức khác nhau: 파 có luồng hơi mạnh nhất, 바 có hơi nhẹ, 빠 gần như không có hơi nhưng ngắn và chắc.",
        "Lặp lại cặp tối thiểu '바-빠-파' chậm rãi 5 lần mỗi âm, sau mỗi lượt nghe xen kẽ giọng người bản xứ và bản ghi của mình để so sánh bằng tai cả độ dài hơi lẫn thứ bậc cao độ.",
        "Trước khi ghi âm, khởi động ngắn ở cao độ baseline của chính mình, rồi cố ý đẩy 평음 xuống dưới baseline và đẩy 경음·격음 lên trên baseline để mở rộng thứ bậc một cách có ý thức."
      ]
    },
    "overall": "현재는 베트남 학습자에게 가장 흔한 T1(3지 미변별) 단계로, 세 자음이 모두 베트남어 /b/ 에 가까운 짧고 무기식인 형태로 모여 있습니다. 다만 빠르다의 F0 가 평음보다 위로 올라간 점은 경음 방향의 톤 감각이 일부 살아 있다는 좋은 신호이며, 이 위계 감각을 ㅍ 까지 확장하는 것이 다음 단계입니다. VOT 축에서는 격음 기식을 키우는 것이 가장 큰 변화 폭을 만들어 줄 핵심 지점입니다. 듣기·따라하기·손바닥 시험을 같이 묶어 2~3주만 꾸준히 해도 위계가 눈에 띄게 벌어질 것입니다.",
    "overall_vn": "Hiện tại học viên đang ở giai đoạn T1 (chưa phân biệt 3 bậc) — kiểu phổ biến nhất ở người Việt — với cả ba phụ âm đều gom về dạng ngắn, không bật hơi gần với /b/ tiếng Việt. Tuy nhiên, việc F0 của 빠르다 cao hơn 평음 là tín hiệu tốt cho thấy cảm giác cao độ theo hướng 경음 đã phần nào hình thành; bước tiếp theo là mở rộng cảm giác thứ bậc này sang cả ㅍ. Về trục VOT, tăng cường hơi bật cho 격음 sẽ tạo ra biên độ thay đổi lớn nhất. Nếu kết hợp nghe — bắt chước — phép thử lòng bàn tay đều đặn 2~3 tuần, thứ bậc sẽ giãn ra rõ rệt.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)는 VOT 0ms 로 nặng 가장 깊은 왼쪽 영역에 박혀 있어, 본래 평음이 자리해야 할 '왼쪽 약간 안쪽·아래쪽' 위치보다도 더 안으로 들어와 있습니다. F0 도 baseline 대비 -2.5st 로 원어민의 -3.7st 보다 위쪽에 떠 있어, 아래로 내려가는 ngang 의 가라앉음이 부족합니다. 나침반에서 보면 살짝 오른쪽(VOT 를 20ms 정도까지) 으로 빼면서 동시에 톤을 한 단계 더 아래로 내려, 부드럽고 가라앉는 평음 영역으로 이동시키는 것이 목표입니다. 입술을 너무 꽉 다물지 말고 살짝 풀어 짧은 호흡이 자연스럽게 새 나오게 해 보세요.",
      "baji_vn": "바지(ㅂ) có VOT 0ms — bị ghim ở vùng nặng sâu nhất phía bên trái, thậm chí còn vào sâu hơn cả vị trí 'hơi lệch trái·xuống dưới' mà 평음 lẽ ra phải nằm. F0 ở mức -2.5st so với baseline, vẫn cao hơn mức -3.7st của bản xứ, nên độ chìm xuống của ngang còn thiếu. Trên la bàn, mục tiêu là dịch nhẹ sang phải (đưa VOT lên ~20ms) đồng thời hạ tông thêm một bậc xuống, để di chuyển về vùng 평음 mềm mại và trầm. Đừng mím môi quá chặt — hãy thả lỏng một chút để một làn hơi ngắn thoát ra tự nhiên.",
      "bbareuda": "빠르다(ㅃ)는 VOT 7ms 로 nặng 왼쪽 영역에 정확히 자리 잡았고, F0 도 +1.5st 로 baseline 위쪽에 올라가 있어 나침반 좌표상 가장 원어민 클러스터에 가까운 단어입니다. 다만 평음 바지(-2.5st)와의 거리가 4st 정도밖에 안 되어 위계 폭이 좁고, 후두 긴장이 충분히 단단해지지는 않았습니다. 발음 직전에 목 안쪽을 살짝 조여 '꽉' 잡았다 터뜨리는 느낌으로 시작하고, 톤은 지금처럼 위쪽을 유지하되 평음을 더 아래로 떨어뜨려 둘 사이 간격을 벌려 주세요. 이 단어가 학습자의 가장 강한 무기이니, 다른 두 음의 좌표를 잡을 때 기준점으로 활용하세요.",
      "bbareuda_vn": "빠르다(ㅃ) có VOT 7ms — nằm đúng vùng nặng bên trái, F0 cũng đạt +1.5st phía trên baseline, nên trên la bàn đây là từ gần cụm bản xứ nhất. Tuy vậy, khoảng cách với 평음 바지(-2.5st) chỉ ~4st nên biên độ thứ bậc còn hẹp, và độ căng thanh quản chưa đủ chắc. Ngay trước khi phát âm, hãy siết nhẹ phía trong cổ họng để có cảm giác 'giữ chặt rồi bung', giữ tông cao như hiện tại nhưng đồng thời hạ 평음 xuống thấp hơn để mở rộng khoảng cách. Đây là 'vũ khí' mạnh nhất của học viên — hãy dùng nó làm điểm neo khi định vị tọa độ cho hai âm còn lại.",
      "paransaek": "파란색(ㅍ)은 VOT 0ms 로 격음이 있어야 할 오른쪽 bật hơi 영역으로 전혀 이동하지 못하고 평음 바지와 같은 왼쪽에 머물러 있습니다. 더 큰 문제는 F0 가 +0.7st 로 경음(+1.5)보다 낮게 가라앉아 위계가 뒤집힌 상태라는 점입니다. 나침반에서 가장 크게 이동해야 하는 음이 바로 이 단어로, 입술을 떼는 순간 촛불을 끄듯 강한 바람을 내보내 VOT 를 50~60ms 쪽 오른쪽 끝까지 끌고 가고, 동시에 톤도 경음보다 한 단계 위로 띄워 sắc 위쪽으로 올라가야 합니다. '파' 직전에 살짝 숨을 모았다가 한꺼번에 터뜨리는 연습이 가장 효과적입니다.",
      "paransaek_vn": "파란색(ㅍ) có VOT 0ms — hoàn toàn chưa di chuyển sang vùng bật hơi bên phải nơi 격음 lẽ ra phải đứng, mà vẫn ở bên trái cùng vị trí với 평음 바지. Vấn đề lớn hơn là F0 chỉ +0.7st, thấp hơn cả 경음 (+1.5), khiến thứ bậc bị đảo ngược. Đây là âm cần dịch chuyển xa nhất trên la bàn: ngay khi mở môi, hãy thổi mạnh như thổi nến để kéo VOT sang tận 50~60ms phía phải, đồng thời nâng tông lên cao hơn cả 경음, đẩy lên vùng sắc phía trên. Bài tập hiệu quả nhất là gom hơi nhẹ ngay trước '파' rồi bung ra cùng một lúc."
    },
    "encouragement": "빠르다에서 이미 경음 방향의 톤 감각이 살아 있다는 점이 매우 좋은 출발점입니다 — 이 감각을 나침반의 다른 방향으로 넓혀 가면 됩니다.",
    "encouragement_vn": "Việc cảm giác cao độ theo hướng 경음 đã hình thành ở 빠르다 là một điểm khởi đầu rất tốt — bạn chỉ cần mở rộng cảm giác đó sang các hướng khác trên la bàn là được.",
