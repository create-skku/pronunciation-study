  "ai_feedback": {
    "error_analysis": {
      "summary": "경음 ㅃ은 잘 잡혔으나, 평음 ㅂ과 격음 ㅍ의 VOT·음높이 위계가 충분히 벌어지지 않아 두 소리가 가깝게 들립니다.",
      "summary_vn": "Âm căng ㅃ (빠) đã được phát âm khá tốt, nhưng âm thường ㅂ (바) và âm bật hơi ㅍ (파) chưa tách biệt đủ về VOT và cao độ, khiến hai âm này nghe gần giống nhau.",
      "detail": "바지의 VOT는 67ms로 원어민 97ms보다 30ms 짧고, 반대로 파란색의 VOT는 77ms로 원어민 60ms보다 17ms 길게 나타납니다. 즉 평음은 너무 짧고 격음은 살짝 과하게 끌어서 두 값이 가까워지고 있습니다. F0 패턴(자기 baseline 대비 semitone)도 격음에서 +1.7 st 로, 원어민의 +3.4 st 보다 1.6 st 낮아 음높이 상승이 부족합니다. 다행히 빠르다는 VOT 0ms, F0 차이 -0.2 st 로 원어민 패턴과 거의 일치해 경음 감각은 안정적으로 자리 잡았습니다.",
      "detail_vn": "VOT của 바지 là 67ms, ngắn hơn 30ms so với người bản ngữ (97ms); ngược lại, VOT của 파란색 là 77ms, dài hơn 17ms so với người bản ngữ (60ms). Nghĩa là âm thường bị phát âm quá ngắn còn âm bật hơi lại hơi kéo dài, khiến hai giá trị xích lại gần nhau. Về cao độ F0 (semitone so với baseline của chính bạn), âm bật hơi chỉ đạt +1.7 st, thấp hơn 1.6 st so với mức +3.4 st của người bản ngữ — độ vút cao chưa đủ. Đáng mừng là 빠르다 có VOT 0ms và chênh lệch F0 chỉ -0.2 st, gần như trùng khớp với mẫu bản ngữ, cho thấy cảm giác âm căng đã ổn định."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없어, 학습자가 ㅂ과 ㅍ을 같은 무기식 계열로 인식하는 경향이 있습니다. 그 결과 ㅂ은 베트남어 /b/ 처럼 짧게 끊어 발음되고, ㅍ은 충분한 기식과 음높이 상승 없이 평음과 비슷한 영역에서 끝나게 됩니다. 반면 후두를 잠그는 경음 ㅃ은 베트남어 성문 폐쇄음과 감각이 비슷해 비교적 쉽게 잡힌 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc âm thường - âm căng - âm bật hơi như tiếng Hàn, nên người học thường gộp ㅂ và ㅍ vào cùng nhóm không bật hơi. Vì vậy ㅂ bị phát âm ngắn như /b/ tiếng Việt, còn ㅍ lại thiếu luồng hơi mạnh và độ vút cao, kết thúc ở vùng âm thanh gần giống âm thường. Ngược lại, âm căng ㅃ vốn cần khép thanh môn lại có cảm giác gần với âm tắc thanh hầu trong tiếng Việt, nên bạn nắm bắt khá tự nhiên.",
    "correction": {
      "main_focus": "ㅍ(파)의 기식과 모음 음높이 상승을 동시에 키워 평음 ㅂ과의 거리를 분명히 벌리는 것.",
      "main_focus_vn": "Tăng đồng thời luồng hơi và độ vút cao của nguyên âm sau ㅍ (파) để tách rõ ra khỏi âm thường ㅂ (바).",
      "steps": [
        "손바닥을 입 앞 10cm 에 대고 최소대립쌍(바-빠-파)을 천천히 반복하며, 격음에서만 손바닥에 분명한 바람이 닿는지 확인합니다.",
        "거울 앞에서 입 모양과 호흡을 함께 관찰하며, 평음은 짧고 부드럽게, 격음은 모음을 살짝 더 높은 톤으로 시작하도록 의식적으로 음높이 차이를 만듭니다.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 자기 baseline 톤으로 워밍업한 뒤, 자음의 바람 양과 모음의 시작 음높이 두 축을 동시에 비교 청취합니다."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 10cm rồi lặp lại chậm cặp đối lập tối thiểu (바-빠-파), kiểm tra xem chỉ có âm bật hơi mới tạo luồng gió rõ ràng chạm vào tay.",
        "Đứng trước gương quan sát khẩu hình và hơi thở: âm thường phát ngắn và nhẹ, âm bật hơi cần bắt đầu nguyên âm ở cao độ cao hơn một chút — có ý thức tạo ra khoảng cách về độ cao.",
        "Nghe xen kẽ giọng người bản ngữ và bản ghi của chính bạn, khởi động bằng cao độ baseline của mình, sau đó so sánh đồng thời hai trục: lượng hơi của phụ âm và cao độ khởi đầu của nguyên âm."
      ]
    },
    "overall": "전반적으로 경음 ㅃ은 원어민 패턴과 거의 일치하는 단단한 강점이며, 이를 발판으로 ㅂ과 ㅍ의 분리만 보완하면 3중 구분이 빠르게 자리 잡을 단계입니다. 현재는 평음의 VOT 가 너무 짧고 격음의 VOT 는 살짝 길어 두 소리가 중간 지점에서 만나고 있고, 격음의 음높이 상승도 절반 수준에 머물러 있습니다. 자음 길이와 모음 음높이 두 축을 함께 늘리는 연습을 이어가면 단기간에 큰 개선이 가능합니다. 측정 신뢰도가 세 단어 모두 양호해 진단의 방향이 분명합니다.",
    "overall_vn": "Nhìn chung, âm căng ㅃ gần như khớp với mẫu bản ngữ và là điểm mạnh vững chắc; chỉ cần bổ sung phần tách biệt ㅂ và ㅍ là hệ thống ba bậc sẽ nhanh chóng định hình. Hiện tại VOT của âm thường quá ngắn còn VOT của âm bật hơi lại hơi dài, khiến hai âm gặp nhau ở vùng trung gian, đồng thời độ vút cao của âm bật hơi mới đạt khoảng một nửa mức cần thiết. Nếu tiếp tục luyện kéo dài đồng thời hai trục — độ dài phụ âm và cao độ nguyên âm — thì bạn có thể cải thiện rõ rệt trong thời gian ngắn. Cả ba từ đều có độ tin cậy đo lường tốt, nên hướng chẩn đoán rất rõ ràng.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지는 발음 나침반에서 nặng(왼쪽) 쪽으로 너무 가까이 끌려 들어가 있습니다. 원어민이 ngang 중앙에서 살짝 오른쪽(VOT 97ms)에 자리잡는 반면, 학습자는 VOT 67ms 로 왼쪽 nặng 영역 가까이 머물러 경음에 가깝게 들릴 수 있습니다. F0 패턴도 baseline 대비 -1.3 st 로, 원어민 -3.7 st 보다 위쪽에 떠 있어 평음 특유의 차분히 가라앉는 느낌이 약합니다. 입술을 가볍게 떼고 짧은 무성 구간을 살짝 더 둔 뒤, 모음 ㅏ를 본인 baseline 보다 약간 더 낮게 시작해 좌표를 중앙 아래쪽으로 다시 끌어내려 보세요.",
      "baji_vn": "Trên la bàn phát âm, 바지 đang bị kéo quá sát về phía nặng (bên trái). Trong khi người bản ngữ nằm ở trung tâm ngang lệch nhẹ sang phải (VOT 97ms), bạn ở VOT 67ms, gần vùng nặng nên dễ nghe thành âm căng. Cao độ F0 cũng ở mức -1.3 st so với baseline, cao hơn mức -3.7 st của người bản ngữ, làm mất đi cảm giác lắng xuống đặc trưng của âm thường. Hãy mở môi nhẹ, giữ khoảng vô thanh ngắn thêm một chút, rồi khởi đầu nguyên âm ㅏ ở cao độ thấp hơn baseline một chút để kéo tọa độ về phía trung tâm và xuống dưới.",
      "bbareuda": "빠르다는 발음 나침반에서 nặng(왼쪽) 깊숙한 자리에 원어민과 거의 같은 좌표로 정확히 들어가 있습니다. VOT 0ms, F0 차이 -0.2 st 로 원어민 패턴과 사실상 겹치며, 이 단어가 학습자의 가장 큰 강점입니다. 다른 두 단어를 교정할 때 이 좌표를 기준점으로 삼아, ㅂ과 ㅍ이 ㅃ에서 각각 얼마나 떨어져야 하는지 거리감으로 비교해 보세요.",
      "bbareuda_vn": "Trên la bàn phát âm, 빠르다 nằm sâu trong vùng nặng (bên trái), gần như trùng tọa độ với người bản ngữ. VOT 0ms và chênh lệch F0 chỉ -0.2 st cho thấy phát âm gần như khớp hoàn toàn với mẫu bản ngữ — đây là điểm mạnh lớn nhất của bạn. Khi luyện hai từ còn lại, hãy lấy tọa độ này làm điểm mốc và cảm nhận khoảng cách mà ㅂ và ㅍ cần lùi ra khỏi ㅃ.",
      "paransaek": "파란색은 발음 나침반에서 bật hơi(오른쪽) 방향으로는 충분히 나아갔지만, 위쪽(sắc) 으로의 상승이 부족해 좌표가 살짝 가라앉아 있습니다. VOT 77ms 는 원어민 60ms 보다도 길어 자음의 바람 자체는 풍부하지만, F0 패턴이 +1.7 st 로 원어민 +3.4 st 보다 1.6 st 낮아 격음 특유의 위쪽 클러스터에 닿지 못하고 있습니다. 손바닥에 닿는 바람의 양은 지금 그대로 유지하되, 모음 ㅏ를 시작할 때 톤을 한 단계 더 끌어올려 좌표를 오른쪽-위 코너로 밀어 올려 보세요.",
      "paransaek_vn": "Trên la bàn phát âm, 파란색 đã tiến đủ về phía bật hơi (bên phải) nhưng chưa vươn lên đủ về phía trên (sắc), nên tọa độ hơi bị trũng xuống. VOT 77ms thậm chí còn dài hơn người bản ngữ (60ms), tức luồng hơi của phụ âm rất dồi dào, nhưng F0 chỉ đạt +1.7 st so với baseline, thấp hơn mức +3.4 st của người bản ngữ 1.6 st, nên chưa chạm tới cụm âm bật hơi ở góc trên. Hãy giữ nguyên lượng hơi như hiện tại, đồng thời nâng cao độ khởi đầu của nguyên âm ㅏ thêm một bậc nữa để đẩy tọa độ lên góc trên - bên phải."
    },
