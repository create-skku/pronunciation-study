  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅋ은 원어민과 동일한 수준으로 잘 구분되지만, 평음 ㄱ과 경음 ㄲ의 VOT가 모두 짧아 두 소리가 한 덩어리로 합쳐지는 경향이 보입니다.",
      "summary_vn": "Âm bật mạnh ㅋ được phân biệt tốt ngang với người bản xứ, nhưng VOT của âm thường ㄱ và âm căng ㄲ đều ngắn nên hai âm này có xu hướng nhập làm một.",
      "detail": "가방의 ㄱ은 VOT 15ms 로 원어민 63ms 보다 훨씬 짧아 베트남어 무기 폐쇄음 영역에 가깝게 발음되었습니다. 까만색의 ㄲ은 VOT 4ms 로 원어민 8ms 와 가까운 짧은 값이지만, ㄱ(15ms)과의 차이가 11ms 에 불과해 둘이 거의 같은 구간에 모여 있습니다. 반면 카드의 ㅋ은 VOT 83ms 로 원어민과 정확히 일치해 강한 기식이 잘 살아 있습니다. F0(ㅏ) pattern_st 를 보면 ㄱ -2.3 / ㄲ 1.1 / ㅋ 1.0 으로 평음-경음/격음 위계는 형성되어 있으나, 평음에서 경음으로 올라가는 폭(+3.4 st)이 원어민(+5.0 st)보다 다소 좁습니다.",
      "detail_vn": "Âm ㄱ trong 가방 có VOT 15ms, ngắn hơn nhiều so với 63ms của người bản xứ, gần với âm tắc không bật hơi của tiếng Việt. Âm ㄲ trong 까만색 có VOT 4ms, gần với 8ms của bản xứ, nhưng chênh lệch với ㄱ (15ms) chỉ 11ms nên hai âm gần như nằm cùng một vùng. Ngược lại, âm ㅋ trong 카드 có VOT 83ms trùng khớp hoàn toàn với bản xứ, cho thấy hơi bật mạnh được giữ tốt. Về pattern_st của F0(ㅏ): ㄱ -2.3 / ㄲ 1.1 / ㅋ 1.0 — trật tự âm thường thấp hơn âm căng/bật mạnh đã hình thành, nhưng bước nhảy từ ㄱ lên ㄲ (+3.4 st) hẹp hơn bản xứ (+5.0 st)."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 특히 후두 긴장으로 만드는 경음은 베트남어에 존재하지 않는 동작입니다. 그래서 ㄱ과 ㄲ이 모두 베트남어 무기 폐쇄음 영역으로 모이게 됩니다. 반면 격음 ㅋ은 강한 기식이라는 명확한 단서가 있어 베트남어에 없는 소리임에도 학습자가 비교적 잘 잡아낸 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba âm thường - căng - bật mạnh như tiếng Hàn, đặc biệt động tác căng thanh quản để tạo âm căng hoàn toàn không tồn tại trong tiếng Việt. Vì vậy ㄱ và ㄲ đều bị kéo về vùng âm tắc không bật hơi của tiếng Việt. Trong khi đó, ㅋ có dấu hiệu rất rõ là luồng hơi bật mạnh, nên dù không có trong tiếng Việt, học viên vẫn nắm bắt khá tốt.",
    "correction": {
      "main_focus": "평음 ㄱ과 경음 ㄲ의 분리 — 특히 ㄲ을 발음할 때 입안의 긴장(후두 조이기)을 더 명확히 만드는 것이 핵심입니다.",
      "main_focus_vn": "Tách biệt âm thường ㄱ và âm căng ㄲ — trọng tâm là tạo rõ ràng hơn sự căng trong khoang miệng (siết thanh quản) khi phát âm ㄲ.",
      "steps": [
        "거울 앞에서 최소대립쌍 '가-까-카'를 천천히 반복하며 입 모양과 목 근육의 긴장 차이를 눈으로 확인합니다.",
        "손바닥을 입 앞 5cm 에 두고 ㄱ(바람 거의 없음)·ㄲ(바람 없으나 단단함)·ㅋ(바람 확 터짐) 세 단계를 체감하며 구분합니다.",
        "원어민 음원과 본인 녹음을 번갈아 들으며 ㄲ 직전의 '한 박자 멈춤(후두 조이기)' 이 들어갔는지 청각으로 점검합니다."
      ],
      "steps_vn": [
        "Đứng trước gương, lặp đi lặp lại chậm rãi cặp tối thiểu '가-까-카' để mắt quan sát sự khác biệt về khẩu hình và độ căng cơ cổ.",
        "Đặt lòng bàn tay cách miệng 5cm để cảm nhận ba mức độ: ㄱ (hầu như không có hơi), ㄲ (không có hơi nhưng chắc), ㅋ (hơi bật mạnh).",
        "Nghe luân phiên giữa âm thanh của người bản xứ và bản ghi của mình, kiểm tra bằng tai xem trước ㄲ có 'khoảng dừng một nhịp (siết thanh quản)' hay không."
      ]
    },
    "overall": "격음 ㅋ은 VOT 83ms 로 원어민과 완벽히 일치하는 명확한 강점이 있고, F0 위계의 방향성도 평음 낮음 / 경음·격음 높음으로 올바르게 형성되어 있습니다. 다만 평음 ㄱ과 경음 ㄲ이 VOT 15ms·4ms 로 모두 짧은 구간에 모여 있어 두 소리의 분리가 가장 시급한 과제입니다. T2 유형 그대로 — 격음은 잡았으니, 다음 단계는 경음의 후두 긴장을 신체 동작으로 익히는 것입니다. 강점이 분명하니 짧은 시간에 충분히 진전이 가능합니다.",
    "overall_vn": "Âm bật mạnh ㅋ có VOT 83ms trùng khớp hoàn toàn với người bản xứ — đây là điểm mạnh rõ ràng, và hướng của trật tự F0 cũng đã hình thành đúng (âm thường thấp / âm căng·bật mạnh cao). Tuy nhiên, âm thường ㄱ và âm căng ㄲ với VOT lần lượt 15ms và 4ms đều nằm chụm trong vùng ngắn, nên tách hai âm này là nhiệm vụ cấp thiết nhất. Đúng như mẫu T2 — ㅋ đã nắm được, bước tiếp theo là làm quen với động tác căng thanh quản của âm căng bằng cơ thể. Vì điểm mạnh đã rõ, có thể tiến bộ nhanh trong thời gian ngắn.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "가방의 ㄱ은 PRAAT 파형 첫 칸(파열~모음 시작)의 너비가 약 15ms 로, 원어민 63ms 의 4분의 1 수준에 머물러 있습니다. 베트남어의 무기 폐쇄음처럼 폐쇄가 풀리자마자 곧바로 모음이 시작되는 형태입니다. 파란 F0 곡선은 모음 시작점에서 -2.3 st 부근으로 원어민(-3.7 st)보다 살짝 높이 출발해 평음다운 '낮은 출발' 느낌이 약간 부족합니다. 발음할 때 혀뿌리의 힘을 빼고 모음의 톤도 살짝 낮게 깔아주세요. 폐쇄를 푼 뒤 아주 짧은 '숨 한 방울'을 두고 모음으로 넘어가면 ㄱ의 평음 느낌이 살아납니다.",
      "gabang_vn": "Âm ㄱ trong 가방: khoảng đầu của dạng sóng PRAAT (từ bung hơi đến khi nguyên âm bắt đầu) chỉ rộng khoảng 15ms, chỉ bằng 1/4 so với 63ms của người bản xứ. Giống như âm tắc không bật hơi trong tiếng Việt — vừa bung hơi là nguyên âm bắt đầu ngay. Đường F0 màu xanh khởi điểm ở khoảng -2.3 st, hơi cao hơn bản xứ (-3.7 st), nên cảm giác 'khởi đầu thấp' đặc trưng của âm thường còn hơi yếu. Khi phát âm, hãy thả lỏng gốc lưỡi và đặt giọng nguyên âm thấp xuống một chút. Sau khi bung hơi, hãy để 'một giọt hơi' rất ngắn rồi mới chuyển sang nguyên âm — cảm giác âm thường của ㄱ sẽ rõ hơn.",
      "ggamansaek": "까만색의 ㄲ은 PRAAT 파형 첫 칸이 4ms 로 매우 좁아 원어민 8ms 와 비슷한 '짧고 빠른 시작'은 잘 잡혔습니다. 다만 그 좁은 구간 안에 있어야 할 '단단함(후두 긴장)' 의 단서가 약해, ㄱ(15ms)과 시각적으로 너무 가깝게 보입니다. 파란 F0 곡선은 1.1 st 로 ㄱ(-2.3)보다 위에 떠 있어 위계 방향은 맞지만 폭이 +3.4 st 로 원어민(+5.0 st)보다 좁습니다. 발음 직전 1초간 목 안쪽을 살짝 조이고 입술도 꽉 다물었다가, 짧고 단단하게 '딱!' 하고 터뜨려 보세요. 모음 ㅏ도 자기 baseline 보다 한 음 살짝 높게 시작하면 경음 색이 더 분명해집니다.",
      "ggamansaek_vn": "Âm ㄲ trong 까만색: khoảng đầu dạng sóng PRAAT chỉ 4ms, rất hẹp — 'khởi đầu ngắn và nhanh' tương tự bản xứ (8ms) đã được nắm tốt. Tuy nhiên, trong khoảng hẹp đó, dấu hiệu 'sự chắc chắn (căng thanh quản)' còn yếu, nên về mặt thị giác trông quá gần với ㄱ (15ms). Đường F0 màu xanh ở 1.1 st, nằm trên ㄱ (-2.3) nên hướng trật tự đúng, nhưng biên độ +3.4 st hẹp hơn bản xứ (+5.0 st). Trong 1 giây trước khi phát âm, hãy siết nhẹ phía sau cổ họng và mím chặt môi, rồi bung ra ngắn và chắc 'tách!'. Nếu khởi đầu nguyên âm ㅏ cao hơn baseline của mình một chút, màu sắc âm căng sẽ rõ hơn.",
      "kadeu": "카드의 ㅋ은 PRAAT 파형에서 파열 후 모음까지의 첫 칸이 83ms 로 원어민과 정확히 같은 너비를 보입니다. 그 구간 안에 거친 기식 잡음이 충분히 채워져 있어, 손바닥을 입 앞에 두면 확실한 바람을 느낄 수 있는 수준입니다. 파란 F0 곡선도 1.0 st 로 평음 ㄱ(-2.3)보다 명확히 위에 있어 격음의 높은 출발 패턴이 잘 살아 있습니다. 이 단어는 학습자의 가장 강한 자산이니, ㄲ 연습 전에 항상 '카'를 워밍업으로 발음해 기식 감각을 깨우고 들어가세요.",
      "kadeu_vn": "Âm ㅋ trong 카드: trên dạng sóng PRAAT, khoảng đầu từ bung hơi đến nguyên âm rộng đúng 83ms, trùng khớp hoàn toàn với bản xứ. Trong khoảng đó có đủ tiếng nhiễu của hơi bật mạnh — nếu đặt lòng bàn tay trước miệng có thể cảm nhận luồng hơi rõ rệt. Đường F0 màu xanh ở 1.0 st, rõ ràng cao hơn ㄱ (-2.3), nên mẫu khởi đầu cao của âm bật mạnh được giữ tốt. Đây là tài sản mạnh nhất của học viên — trước khi luyện ㄲ, hãy luôn phát âm '카' để khởi động và đánh thức cảm giác hơi bật.",
      "kadeu_vn_dup_check": ""
    },
    "encouragement": "격음 ㅋ을 원어민 수준으로 발음하시는 건 정말 인상적인 강점이에요. 이 감각을 발판 삼아 경음 ㄲ을 하나만 더 단단히 잡으면 3중 구분이 활짝 열립니다!",
    "encouragement_vn": "Việc bạn phát âm âm bật mạnh ㅋ ngang với người bản xứ thực sự là một điểm mạnh ấn tượng. Lấy cảm giác này làm bệ phóng, chỉ cần nắm chắc thêm âm căng ㄲ là hệ thống ba âm sẽ mở ra hoàn toàn!",
