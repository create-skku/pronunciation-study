  "ai_feedback": {
    "error_analysis": {
      "summary": "격음 ㅋ(카드)의 기식이 부족하고 모음 음높이가 낮아, 평음 ㄱ(가방)과의 구분이 흐려진 상태입니다.",
      "summary_vn": "Âm bật hơi mạnh ㅋ (카드) thiếu luồng hơi và cao độ nguyên âm thấp, khiến nó bị lẫn với âm thường ㄱ (가방).",
      "detail": "VOT 위계를 보면 원어민은 카드(83ms) > 가방(63ms) > 까만색(8ms) 순으로 격음이 가장 길지만, 학습자는 가방(70ms) > 카드(56ms) > 까만색(19ms) 로 평음과 격음의 순서가 뒤집혀 있습니다. F0 패턴(semitone) 역시 원어민은 격음·경음이 평음보다 높게 시작되는데, 학습자는 가방 +3.5st 로 평음이 오히려 가장 높고 카드는 -2.0st 로 낮아 위계가 무너져 있습니다. 다만 까만색은 F0 가 셋 중 가장 높게(0.4st) 유지되어 경음의 후두 긴장 신호가 부분적으로 살아 있는 점이 강점입니다.",
      "detail_vn": "Về VOT, người bản ngữ theo thứ tự 카드(83ms) > 가방(63ms) > 까만색(8ms), nhưng học viên lại là 가방(70ms) > 카드(56ms) > 까만색(19ms) — thứ tự giữa âm thường và âm bật hơi bị đảo ngược. Mẫu F0 (semitone) cũng vậy: người bản ngữ phát âm 격음·경음 cao hơn 평음, còn học viên thì 가방 +3.5st lại là cao nhất và 카드 -2.0st lại thấp, làm vỡ trật tự cao độ. Tuy nhiên 까만색 vẫn giữ F0 cao nhất trong ba từ (0.4st), cho thấy tín hiệu căng thanh quản của âm căng vẫn còn — đây là điểm mạnh."
    },
    "cause": "베트남어에는 한국어식 평음·경음·격음 3중 구분이 없고, 격음의 강한 기식과 높은 모음 시작 음높이를 동시에 만드는 습관이 자리잡지 않아 카드의 ㅋ이 평음에 가깝게 약화됩니다. 또한 가방을 발음할 때 모음 ㅏ를 너무 높이 띄워 평음 본연의 낮은 시작 음높이가 사라지면서, 결과적으로 평음과 격음의 두 축(기식·음높이) 모두에서 대비가 무너집니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc 평음·경음·격음 như tiếng Hàn, và thói quen tạo đồng thời luồng hơi mạnh cùng cao độ nguyên âm cao cho âm bật hơi chưa hình thành, nên ㅋ trong 카드 bị yếu đi và gần với âm thường. Ngoài ra, khi phát âm 가방 học viên đẩy nguyên âm ㅏ lên quá cao, làm mất cao độ thấp vốn có của âm thường — kết quả là cả hai trục đối lập (luồng hơi và cao độ) giữa âm thường và âm bật hơi đều bị san phẳng.",
    "correction": {
      "main_focus": "격음의 '강한 바람 + 살짝 높은 모음 시작' 두 가지를 동시에 만들고, 평음은 반대로 모음을 낮고 부드럽게 시작하기.",
      "main_focus_vn": "Đồng thời tạo 'luồng hơi mạnh + cao độ nguyên âm hơi cao' cho âm bật hơi, và ngược lại phát âm thường với cao độ thấp, nhẹ nhàng.",
      "steps": [
        "손바닥을 입 앞 10cm 에 대고 최소대립쌍(가-까-카)을 천천히 반복하며, 카에서만 손바닥에 분명한 바람이 느껴지는지 확인하기.",
        "거울과 녹음을 함께 사용해 본인 음성과 원어민 음원을 번갈아 듣고, 모음 시작 부분의 높낮이 차이를 귀로 비교하기.",
        "녹음 전 편안한 baseline 톤으로 워밍업한 뒤, 평음은 그 baseline 보다 낮게·격음은 살짝 높게 시작하는 패턴을 의식적으로 연습하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 10cm, lặp lại chậm cặp đối lập tối thiểu (가-까-카) và kiểm tra xem chỉ có 카 mới cảm nhận rõ luồng hơi vào lòng bàn tay.",
        "Dùng đồng thời gương và bản ghi âm, nghe luân phiên giọng mình với giọng người bản ngữ để so sánh bằng tai sự khác biệt cao độ ở đầu nguyên âm.",
        "Trước khi ghi âm, khởi động bằng tông baseline thoải mái của bản thân, sau đó luyện ý thức bắt đầu âm thường thấp hơn baseline và âm bật hơi hơi cao hơn baseline."
      ]
    },
    "overall": "세 단어 모두 측정이 안정적이며, 경음 까만색에서 후두 긴장 신호가 살아 있는 점은 분명한 강점입니다. 다만 격음 카드의 VOT(56ms)가 원어민(83ms)보다 27ms 짧고 모음 음높이도 낮아, 평음 가방과 가장 큰 혼동이 일어나는 구간입니다. 평음·경음·격음 세 축의 위계를 다시 세우는 단계로, 특히 카드에서 '바람의 길이'와 '모음 시작 음높이'를 함께 끌어올리면 빠르게 개선될 것입니다. 꾸준히 연습한 노력이 측정에 잘 드러나고 있으니 자신감을 가지셔도 좋습니다.",
    "overall_vn": "Cả ba từ đều có kết quả đo ổn định, và việc tín hiệu căng thanh quản còn rõ ở âm căng 까만색 là một điểm mạnh rõ ràng. Tuy nhiên, VOT của âm bật hơi 카드 (56ms) ngắn hơn người bản ngữ (83ms) tới 27ms và cao độ nguyên âm cũng thấp, nên đây là chỗ dễ lẫn nhất với âm thường 가방. Bước tiếp theo là khôi phục lại trật tự ba bậc 평음·경음·격음, đặc biệt là kéo đồng thời 'độ dài luồng hơi' và 'cao độ mở đầu nguyên âm' của 카드 lên — sẽ tiến bộ nhanh. Sự luyện tập đều đặn của bạn đang thể hiện rõ trên số liệu, hãy tự tin lên nhé.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "gabang": "VOT 70ms 로 원어민 63ms 와 거의 비슷해 파형 첫 칸 너비가 잘 맞습니다. 다만 F0(ㅏ) 패턴이 원어민 대비 +3.5st 높아, 파란 F0 곡선이 평음치고 너무 위로 떠 있는 모습입니다. 평음 ㄱ은 모음을 baseline 보다 낮게, 입술을 살짝 풀고 부드럽게 시작해야 합니다. 입에 힘을 빼고 한숨을 가볍게 내뱉듯 '가' 를 발음하며 F0 곡선이 아래쪽에서 시작되도록 의식해 주세요.",
      "gabang_vn": "VOT 70ms gần như tương đương người bản ngữ 63ms, nên độ rộng ô đầu của sóng âm khớp tốt. Tuy nhiên mẫu F0 của ㅏ cao hơn người bản ngữ +3.5st, khiến đường cong F0 màu xanh nổi lên quá cao so với một âm thường. Với âm thường ㄱ, nguyên âm phải bắt đầu thấp hơn baseline, môi thả lỏng và mở nhẹ nhàng. Hãy thả lỏng miệng, phát âm '가' như thở nhẹ ra, và chú ý để đường cong F0 bắt đầu từ phía dưới.",
      "ggamansaek": "VOT 19ms 로 원어민 8ms 보다 약간 길지만, 파형 첫 칸이 카드보다 짧게 잘 나타나고 F0 곡선도 셋 중 가장 위쪽에서 시작해 경음의 핵심 신호가 살아 있습니다. 강점이니 유지하면서, 후두를 더 단단히 조이고 호흡을 잠시 막은 뒤 터뜨리는 느낌으로 VOT 를 10ms 대까지 더 줄여 보세요. '까' 직전에 목이 살짝 잠기는 긴장감을 의식하면 좋습니다.",
      "ggamansaek_vn": "VOT 19ms hơi dài hơn người bản ngữ 8ms một chút, nhưng ô đầu của sóng âm ngắn hơn 카드 và đường cong F0 cũng khởi đầu cao nhất trong ba từ — tín hiệu cốt lõi của âm căng vẫn còn nguyên. Đây là điểm mạnh, hãy giữ vững; đồng thời siết thanh quản chắc hơn, nín hơi một thoáng rồi bật ra để rút VOT xuống quanh mức 10ms. Hãy ý thức cảm giác cổ họng hơi nghẹn ngay trước khi phát '까'.",
      "kadeu": "VOT 56ms 로 원어민 83ms 보다 27ms 짧아, 파형 첫 칸의 무성 구간이 격음치고 좁게 나타납니다. F0(ㅏ)도 원어민보다 -2.0st 낮아 파란 곡선이 가방보다도 아래에 위치해, 격음 특유의 '높은 시작' 신호가 사라진 상태입니다. 손바닥을 입 앞 10cm 에 대고 '카!' 라고 발음했을 때 손바닥에 분명한 바람이 닿아야 하며, 동시에 ㅏ 모음을 평소보다 살짝 높은 톤으로 끌어올려 시작해 보세요. 입술을 강하게 폐쇄했다가 한 박자 늦게 터뜨리는 느낌으로 무성 구간을 길게 잡으면 VOT 가 자연스럽게 늘어납니다.",
      "kadeu_vn": "VOT 56ms ngắn hơn người bản ngữ 83ms tới 27ms, nên đoạn vô thanh ở ô đầu của sóng âm hẹp hơn mức cần có cho âm bật hơi. F0 của ㅏ cũng thấp hơn người bản ngữ -2.0st, khiến đường cong xanh nằm thấp hơn cả 가방 — tín hiệu 'mở đầu cao' đặc trưng của âm bật hơi đã biến mất. Hãy đặt lòng bàn tay cách miệng 10cm và phát '카!' sao cho lòng bàn tay cảm nhận rõ luồng hơi, đồng thời bắt đầu nguyên âm ㅏ ở tông cao hơn bình thường một chút. Khép môi chặt rồi bật ra chậm hơn một nhịp để kéo dài đoạn vô thanh — VOT sẽ tự nhiên dài ra."
    },
    "encouragement": "경음의 긴장 신호가 살아 있다는 건 이미 가장 어려운 축 하나를 잡았다는 뜻이에요 — 격음의 바람만 더해지면 곧 세 소리가 또렷이 갈라집니다!",
    "encouragement_vn": "Việc tín hiệu căng thanh quản của âm căng vẫn còn nghĩa là bạn đã nắm được một trong những trục khó nhất rồi — chỉ cần thêm luồng hơi cho âm bật hơi, ba âm sẽ sớm tách bạch rõ ràng!",
    "_source": "claude"
