  "ai_feedback": {
    "error_analysis": {
      "summary": "세 파열음의 VOT가 모두 20ms 부근으로 거의 동일해 평음·경음·격음의 구분이 아직 만들어지지 않은 단계입니다.",
      "summary_vn": "VOT của ba âm bật 다리·따뜻하다·타다 đều quanh 20ms gần như giống nhau, nên sự phân biệt giữa 평음·경음·격음 vẫn chưa hình thành.",
      "detail": "다리(ㄷ)의 VOT는 20ms로 원어민 44ms보다 짧고, 타다(ㅌ)의 VOT는 20ms로 원어민 84ms의 1/4 수준이라 격음 특유의 강한 기식이 거의 들리지 않습니다. 반대로 따뜻하다(ㄸ)는 학습자 20ms·원어민 0ms로 경음에서 오히려 더 길게 나타나, 후두 긴장으로 짧고 단단하게 끊는 동작이 아직 자리 잡지 않은 인상입니다. 세 단어가 모두 같은 20ms 구간에 모여 있는 점이 가장 두드러지며, 결과적으로 듣는 사람에게는 셋이 비슷한 자음으로 들리기 쉽습니다. F0(ㅏ) 측정은 이번에 잡히지 않아 음높이 위계는 다음 녹음에서 확인이 필요합니다.",
      "detail_vn": "VOT của 다리(ㄷ) là 20ms, ngắn hơn 44ms của người bản ngữ; VOT của 타다(ㅌ) là 20ms, chỉ bằng khoảng 1/4 mức 84ms của người bản ngữ nên hơi bật mạnh đặc trưng của 격음 gần như không nghe thấy. Ngược lại 따뜻하다(ㄸ) học viên 20ms còn người bản ngữ 0ms, nghĩa là 경음 lại dài hơn — động tác siết thanh hầu để cắt ngắn và chắc vẫn chưa được thiết lập. Điểm nổi bật nhất là cả ba từ đều rơi vào vùng 20ms giống nhau, khiến người nghe cảm thấy ba phụ âm gần như cùng một loại. Phép đo F0(ㅏ) lần này không thu được, nên trật tự cao độ sẽ cần kiểm tra ở bản ghi sau."
    },
    "cause": "베트남어에는 한국어처럼 평음·경음·격음을 셋으로 나누는 체계가 없고, 베트남어 /b·t/ 계열이 무기식·짧은 폐쇄에 가까워 학습자가 세 자음을 모두 자신에게 익숙한 한 가지 음가(짧고 약한 기식)로 통합해 발음하는 경향이 있습니다. 그 결과 격음에 필요한 강한 기식과 경음에 필요한 후두 긴장이라는, 베트남어에 없는 두 동작이 동시에 약하게 나타나면서 세 단어가 평탄해진 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống ba bậc 평음·경음·격음 như tiếng Hàn, và các âm /b·t/ của tiếng Việt vốn gần với kiểu không bật hơi và đóng ngắn, nên học viên có xu hướng gộp cả ba phụ âm vào một âm giá quen thuộc (ngắn và hơi bật yếu). Kết quả là hai động tác vốn không có trong tiếng Việt — hơi bật mạnh cho 격음 và siết thanh hầu cho 경음 — đều cùng lúc bị yếu đi, khiến ba từ trở nên bằng phẳng giống nhau.",
    "correction": {
      "main_focus": "셋을 동시에 고치려 하지 말고, 먼저 손바닥 바람 시험으로 격음(타)에 강한 바람·평음(다)에 부드러운 바람·경음(따)에 거의 바람 없이 짧게 — 세 가지 바람의 양 차이부터 몸으로 만들어내는 것이 핵심입니다.",
      "main_focus_vn": "Đừng cố sửa cả ba cùng lúc; trọng tâm là dùng bài kiểm tra hơi trên lòng bàn tay để cơ thể tạo ra ba mức hơi khác nhau trước — 격음(타) hơi mạnh, 평음(다) hơi nhẹ, 경음(따) gần như không có hơi và phát ra ngắn.",
      "steps": [
        "손바닥을 입 앞 5cm에 두고 격음·평음·경음을 차례로 발음하며 바람의 세기 차이를 직접 느껴 보세요.",
        "최소대립쌍 '다-따-타'를 천천히 3회 반복한 뒤, 같은 순서로 원어민 음원과 본인 녹음을 번갈아 들으며 차이를 확인하세요.",
        "거울 앞에서 입술과 턱의 긴장도를 관찰하면서, 경음에서는 목을 살짝 조이듯 짧게 끊는 감각을 만들어 보세요."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng khoảng 5cm, lần lượt phát âm 격음·평음·경음 và cảm nhận trực tiếp sự khác biệt về cường độ hơi.",
        "Lặp lại cặp tối thiểu '다-따-타' chậm rãi 3 lần, rồi nghe xen kẽ bản ghi của người bản ngữ và của chính mình theo cùng thứ tự để đối chiếu.",
        "Trước gương, quan sát độ căng của môi và hàm; với 경음 hãy tạo cảm giác siết nhẹ ở cổ họng và cắt âm thật ngắn."
      ]
