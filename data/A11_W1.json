  "ai_feedback": {
    "error_analysis": {
      "summary": "평음·경음·격음 세 자음이 아직 충분히 분리되지 않아 위계가 평탄하게 나타나는 단계입니다.",
      "summary_vn": "Ba âm 평음·경음·격음 vẫn chưa được phân tách rõ, thứ bậc còn khá phẳng.",
      "detail": "빠르다는 VOT 10ms 로 경음 목표 구간에 잘 들어와 있고, 파란색도 VOT 66ms 로 격음 범위에 도달했지만 원어민 평균 60ms 보다 다소 길면서 F0 pattern_st 가 +1.7 로 원어민 +3.4 보다 낮아 격음 특유의 높은 톤 상승이 약합니다. 빠르다의 F0 패턴은 +1.4 로 원어민 -0.4 보다 오히려 높게 나와, 경음과 격음의 높낮이 위계가 뒤섞이는 인상이 있습니다. 바지는 VOT 측정이 흔들렸지만(raw 295ms, 신뢰 불가) F0 pattern_st 가 -3.7 로 원어민과 정확히 일치해, 평음의 낮은 톤 기준점은 잘 잡혀 있는 것으로 보입니다.",
      "detail_vn": "빠르다 có VOT 10ms nằm đúng vùng mục tiêu của 경음, 파란색 cũng đạt 66ms thuộc vùng 격음 nhưng hơi dài hơn mức trung bình 60ms của người bản ngữ, đồng thời F0 pattern_st chỉ +1.7 (so với +3.4 của người bản ngữ) nên độ nâng cao âm điệu đặc trưng của 격음 còn yếu. F0 của 빠르다 là +1.4, cao hơn cả mức -0.4 của người bản ngữ, khiến thứ bậc cao thấp giữa 경음 và 격음 bị lẫn lộn. Ở 바지, đo VOT bị nhiễu (raw 295ms, không tin cậy) nhưng F0 pattern_st -3.7 trùng khớp với người bản ngữ, cho thấy điểm neo âm thấp của 평음 đã được hình thành tốt."
    },
    "cause": "베트남어에는 한국어의 평음·경음·격음 3중 구분이 없고, 특히 후두 긴장(경음)과 강한 기식(격음)이 모국어 음소에 존재하지 않습니다. 그래서 세 자음을 비슷한 무기식 음가로 평탄화하는 경향이 나타나며, 격음에서는 기식 양과 함께 따라와야 할 톤 상승이 약해지고 경음에서는 후두 긴장 없이 톤만 높이는 보상이 일어납니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc 평음·경음·격음 của tiếng Hàn, đặc biệt là sự căng thanh hầu (경음) và luồng hơi mạnh (격음) đều không tồn tại trong âm vị mẹ đẻ. Vì vậy ba phụ âm có xu hướng bị san phẳng thành một âm gần như không bật hơi, và ở 격음 thì độ nâng âm điệu đi kèm luồng hơi bị yếu, còn ở 경음 thì thay vì căng thanh hầu, người học lại bù bằng cách đẩy cao âm điệu.",
    "correction": {
      "main_focus": "기식의 양 차이(파>바>빠)를 손바닥 바람 시험으로 신체화해서, 세 자음이 같은 입에서 다른 동작으로 나오게 만드는 것입니다.",
      "main_focus_vn": "Trọng tâm là cảm nhận sự khác biệt về lượng hơi (파>바>빠) bằng thử nghiệm lòng bàn tay, để ba phụ âm phát ra từ cùng một miệng nhưng bằng những động tác khác nhau.",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 파-바-빠 순으로 바람 양 차이를 직접 느끼며 발음하기 (파: 강한 바람, 바: 부드러운 바람, 빠: 거의 바람 없이 단단하게)",
        "최소대립쌍 바-빠-파 를 천천히·낮은 톤→중간 톤→높은 톤 순서로 반복해 톤 위계와 자음 위계를 함께 맞추기",
        "원어민 음원과 본인 녹음을 번갈아 들으며 첫 자음 직후의 모음 시작 높낮이가 어떻게 다른지 귀로 확인하기"
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm rồi phát âm 파-바-빠 theo thứ tự, cảm nhận trực tiếp sự khác biệt lượng hơi (파: hơi mạnh, 바: hơi nhẹ, 빠: gần như không có hơi, dứt khoát và chắc)",
        "Lặp lại cặp đối lập tối thiểu 바-빠-파 thật chậm, theo thứ tự âm thấp → âm trung → âm cao để đồng bộ thứ bậc âm điệu và thứ bậc phụ âm",
        "Nghe xen kẽ âm thanh người bản ngữ và bản ghi của mình, dùng tai kiểm tra cao độ khởi đầu của nguyên âm ngay sau phụ âm đầu khác nhau như thế nào"
      ]
    },
    "overall": "평음 ㅂ의 톤 기준점(F0 pattern_st -3.7)이 원어민과 정확히 일치한다는 점은 큰 강점입니다. 경음 ㅃ의 VOT(10ms)도 목표 구간에 잘 들어와, 자음의 시간적 윤곽은 이미 절반 이상 자리잡혀 있습니다. 다만 격음 ㅍ의 기식이 톤 상승까지 끌고 오지 못하고, 경음의 톤이 오히려 격음보다 높게 나오는 점에서 '경음<격음' 위계가 아직 뒤집힌 상태입니다. 다음 단계는 VOT 길이가 아니라 모음 시작 높낮이로 경음/격음을 분리하는 연습입니다.",
    "overall_vn": "Việc điểm neo âm điệu của 평음 ㅂ (F0 pattern_st -3.7) trùng khớp chính xác với người bản ngữ là một thế mạnh lớn. VOT của 경음 ㅃ (10ms) cũng nằm đúng vùng mục tiêu, nên đường nét thời gian của phụ âm đã được hình thành quá nửa. Tuy nhiên luồng hơi của 격음 ㅍ chưa kéo theo được sự nâng cao âm điệu, và âm điệu của 경음 lại cao hơn cả 격음, khiến thứ bậc '경음<격음' vẫn đang bị đảo ngược. Bước tiếp theo không phải là chỉnh độ dài VOT, mà là luyện tách 경음/격음 bằng cao độ khởi đầu của nguyên âm.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지의 VOT 측정은 흔들렸지만(raw 295ms 로 신뢰 불가), F0(ㅏ) pattern_st 가 -3.7 로 원어민과 정확히 일치해 PRAAT 의 파란 F0 곡선이 같은 높이에서 출발하는 인상이 있습니다. 다만 베트남어 /b/ 의 무기식 습관이 남아 있을 가능성이 높으니, 파형 첫 칸(자음 구간)이 너무 짧아지지 않게 입술을 완전히 닫았다가 부드럽게 터뜨려 보세요. 손바닥 시험에서 '파'보다 약하고 '빠'보다는 분명한 부드러운 바람이 느껴지면 평음다운 윤곽입니다.",
      "baji_vn": "Việc đo VOT của 바지 bị nhiễu (raw 295ms không tin cậy), nhưng F0(ㅏ) pattern_st -3.7 trùng khớp chính xác với người bản ngữ, cho cảm giác đường cong F0 màu xanh trong PRAAT xuất phát từ cùng độ cao. Tuy nhiên thói quen không bật hơi của /b/ tiếng Việt nhiều khả năng vẫn còn, nên hãy khép môi hoàn toàn rồi mở ra một cách nhẹ nhàng, đừng để ô đầu tiên của dạng sóng (đoạn phụ âm) quá ngắn. Nếu trong thử nghiệm lòng bàn tay bạn cảm nhận được luồng hơi nhẹ nhàng — yếu hơn '파' nhưng rõ hơn '빠' — thì đó là đường nét đúng của 평음.",
      "bbareuda": "빠르다는 VOT 10ms 로 PRAAT 파형의 첫 칸이 거의 보이지 않을 만큼 짧게 잘 나와, 경음의 시간적 특징은 정확히 잡혔습니다. 다만 파란 F0 곡선이 pattern_st +1.4 로 원어민 -0.4 보다 오히려 위쪽에서 출발해, 톤으로 경음을 만들려는 보상이 일어나고 있습니다. 다음에는 후두를 살짝 조이듯 긴장시킨 상태에서 모음 시작 높이를 일부러 낮춰, 손바닥에 바람이 거의 닿지 않으면서도 단단하게 끊어지는 느낌을 만들어 보세요.",
      "bbareuda_vn": "빠르다 có VOT 10ms, ngắn đến mức ô đầu tiên của dạng sóng PRAAT gần như không nhìn thấy, nên đặc trưng thời gian của 경음 đã được nắm chính xác. Tuy nhiên đường cong F0 màu xanh xuất phát ở pattern_st +1.4, cao hơn cả -0.4 của người bản ngữ, cho thấy bạn đang bù bằng âm điệu để tạo ra 경음. Lần sau, hãy giữ thanh hầu hơi căng như siết nhẹ, cố ý hạ thấp cao độ khởi đầu của nguyên âm, sao cho lòng bàn tay hầu như không cảm thấy hơi nhưng âm vẫn dứt khoát và chắc.",
      "paransaek": "파란색은 VOT 66ms 로 격음 영역에 도달했고 원어민 60ms 와 매우 가까워, PRAAT 파형 첫 칸의 너비는 거의 목표 수준입니다. 다만 F0(ㅏ) pattern_st 가 +1.7 로 원어민 +3.4 보다 낮아, 파란 F0 곡선이 격음다운 가파른 상승을 그리지 못하고 다소 완만하게 출발하는 인상이 있습니다. 또한 같은 학습자 안에서 경음(+1.4)보다 격음(+1.7)이 거의 비슷한 높이라는 점이 핵심 과제이니, 손바닥에 바람을 강하게 보내면서 동시에 모음을 한 단계 더 위에서 시작한다는 느낌을 의식적으로 만들어 보세요.",
      "paransaek_vn": "파란색 đạt VOT 66ms, đã vào vùng 격음 và rất gần mức 60ms của người bản ngữ, nên độ rộng ô đầu tiên của dạng sóng PRAAT gần như đạt mục tiêu. Tuy nhiên F0(ㅏ) pattern_st chỉ +1.7, thấp hơn +3.4 của người bản ngữ, khiến đường cong F0 màu xanh không vẽ được độ dốc đi lên đặc trưng của 격음 mà xuất phát khá thoai thoải. Hơn nữa, trong cùng một người học, 격음 (+1.7) gần như ngang bằng 경음 (+1.4) — đây chính là điểm cần khắc phục — nên hãy vừa đẩy luồng hơi mạnh vào lòng bàn tay, vừa ý thức khởi đầu nguyên âm cao hơn một bậc."
