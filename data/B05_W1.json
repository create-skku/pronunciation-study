  "ai_feedback": {
    "error_analysis": {
      "summary": "격음의 기식은 과하게, 경음은 평음처럼 약하게 — 셋의 거리 조절이 흐트러진 상태입니다.",
      "summary_vn": "Hơi bật của 격음 thì quá mạnh, còn 경음 lại yếu giống 평음 — khoảng cách giữa ba âm đang bị xáo trộn.",
      "detail": "바지(ㅂ)는 VOT 88ms 로 원어민 97ms 와 비슷한 자리에 있지만, 평음치고는 상당히 긴 편이라 이미 격음 쪽으로 살짝 기울어 있습니다. 빠르다(ㅃ)는 VOT 33ms 로 원어민 0ms 와 비교해 약 33ms 더 길고, 결과적으로 평음 바지와 거의 같은 영역에 머물러 두 음의 분리가 무너졌습니다. 파란색(ㅍ)은 VOT 182ms 로 원어민 60ms 의 3 배에 달해 기식이 과잉이며, F0 패턴도 +7.7 st 로 원어민 +3.4 st 보다 +4.3 st 높이 솟아 있어 격음만 멀리 튀어나간 모양입니다. F0 위계는 ㅂ(-5.9) < ㅃ(-5.3) < ㅍ(+7.7) 로 방향성 자체는 살아있지만, 평음·경음 사이 간격이 거의 0 에 가깝다는 점이 가장 큰 문제입니다.",
      "detail_vn": "바지(ㅂ) có VOT 88ms, gần với người bản ngữ 97ms, nhưng đối với một 평음 thì khá dài, đã hơi nghiêng về phía 격음. 빠르다(ㅃ) có VOT 33ms, dài hơn người bản ngữ (0ms) khoảng 33ms, kết quả là gần như nằm cùng vùng với 평음 바지, làm mất ranh giới giữa hai âm. 파란색(ㅍ) có VOT 182ms, gấp 3 lần người bản ngữ (60ms), hơi bật quá mức, và F0 cũng vọt lên +7.7 st so với +3.4 st của bản ngữ, cao hơn +4.3 st — chỉ riêng 격음 lại bị đẩy ra quá xa. Thứ tự F0 ㅂ(-5.9) < ㅃ(-5.3) < ㅍ(+7.7) thì đúng hướng, nhưng khoảng cách giữa 평음 và 경음 gần như bằng 0, đó là vấn đề lớn nhất."
    },
    "cause": "베트남어에는 한국어의 평음·경음·격음 3 중 구분이 없고, 특히 경음의 후두 긴장 동작이 모국어에 존재하지 않습니다. 그래서 ㅃ 을 만들 때 후두를 단단히 잠그는 대신 평음 ㅂ 과 같은 방식으로 약하게 터뜨려, 두 소리가 한 영역에 겹쳐 들립니다. 반대로 ㅍ 은 '강하게 발음해야 한다' 는 의식이 강하게 작용해 베트남어 무기식 /p/ 와 차별화하려고 기식과 음높이를 과도하게 끌어올린 것으로 보입니다.",
    "cause_vn": "Tiếng Việt không có sự phân biệt ba bậc 평음·경음·격음 của tiếng Hàn, đặc biệt động tác căng thanh môn (긴장) của 경음 không tồn tại trong tiếng mẹ đẻ. Vì vậy khi phát âm ㅃ, thay vì khóa chặt thanh môn, bạn lại bật nhẹ giống như 평음 ㅂ, khiến hai âm chồng lên cùng một vùng. Ngược lại, với ㅍ thì ý thức 'phải phát âm thật mạnh' hoạt động quá mạnh, để khác biệt với /p/ không bật hơi của tiếng Việt, bạn đã đẩy hơi bật và cao độ lên quá mức.",
    "correction": {
      "main_focus": "평음 ㅂ 과 경음 ㅃ 을 같은 영역에서 떼어내는 것 — 특히 ㅃ 에서 입술을 한 박자 더 꽉 다물고 후두를 잠갔다가 짧고 단단하게 터뜨리는 동작을 몸에 익히기.",
      "main_focus_vn": "Tách 평음 ㅂ và 경음 ㅃ ra khỏi cùng một vùng — đặc biệt với ㅃ, hãy khép môi chặt thêm một nhịp, khóa thanh môn rồi bật ra ngắn và chắc, cảm nhận động tác này bằng cơ thể.",
      "steps": [
        "손바닥을 입 앞 5cm 에 두고 바-빠-파를 연달아 발음하며 바람 양 차이를 손으로 느끼기 (ㅂ: 약한 바람, ㅃ: 거의 없음, ㅍ: 강한 바람). 셋의 바람 양이 비슷하면 잘못된 발음 신호.",
        "최소대립쌍(바-빠, 바-파, 빠-파)을 거울 앞에서 천천히 반복하며 입술 다물기·후두 긴장·기식 길이를 단계별로 분리해서 의식하기.",
        "원어민 음원을 한 번 듣고 본인 녹음을 한 번 듣는 ABAB 방식으로 비교하며, 특히 평음과 경음 두 단어의 거리가 좁아지지 않는지 매번 확인하기."
      ],
      "steps_vn": [
        "Đặt lòng bàn tay cách miệng 5cm rồi phát âm liên tục 바-빠-파, dùng tay cảm nhận sự khác biệt về lượng hơi (ㅂ: hơi nhẹ, ㅃ: gần như không có, ㅍ: hơi mạnh). Nếu lượng hơi của ba âm giống nhau thì đó là tín hiệu phát âm sai.",
        "Lặp lại chậm các cặp tối thiểu (바-빠, 바-파, 빠-파) trước gương, ý thức tách riêng từng bước: khép môi, căng thanh môn, độ dài hơi bật.",
        "Nghe âm thanh người bản ngữ một lần rồi nghe bản ghi của mình một lần theo kiểu ABAB, mỗi lần kiểm tra xem khoảng cách giữa 평음 và 경음 có bị thu hẹp lại không."
      ]
    },
    "overall": "F0 위계의 방향성(평음<경음<격음)이 살아있다는 점은 분명한 강점입니다 — 이미 한국어 파열음의 큰 그림은 잡고 계십니다. 다만 평음 ㅂ 과 경음 ㅃ 이 같은 영역에 겹쳐 있고, 격음 ㅍ 만 너무 멀리 튀어나간 '∨' 형태의 불균형이 남아 있습니다. ㅂ 은 지금보다 조금 더 부드럽게, ㅃ 은 후두 긴장으로 더 단단하게, ㅍ 은 기식과 톤을 조금 누그러뜨리면 세 점이 고르게 펼쳐질 것입니다. 격음은 이미 잘 들리는 음이니, 이제는 평음·경음 두 소리 사이의 작은 빈 공간을 만드는 작업에 집중하시면 됩니다.",
    "overall_vn": "Việc hướng của thứ tự F0 (평음<경음<격음) đã đúng là một điểm mạnh rõ ràng — bạn đã nắm được bức tranh tổng thể của các âm tắc tiếng Hàn. Tuy nhiên, 평음 ㅂ và 경음 ㅃ vẫn chồng lên nhau ở cùng một vùng, và chỉ riêng 격음 ㅍ lại nhảy ra quá xa, tạo thành thế mất cân bằng hình '∨'. Nếu phát âm ㅂ mềm hơn một chút, ㅃ chắc hơn nhờ căng thanh môn, và ㅍ giảm bớt hơi bật cùng cao độ, ba điểm sẽ trải đều ra. 격음 vốn đã nghe rõ rồi, giờ bạn chỉ cần tập trung vào việc tạo ra một khoảng trống nhỏ giữa 평음 và 경음.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "바지(ㅂ)는 나침반에서 ngang(기준선) 약간 아래, 왼쪽 nặng 쪽으로 살짝 치우친 자리에 있습니다 — VOT 88ms 는 평음치고 다소 길어 오른쪽 bật hơi 영역으로 한 칸 밀려 있고, F0 도 본인 baseline 보다 -5.9 st 떨어져 원어민 평음 클러스터(-3.7 st)보다 -2.3 st 더 아래에 가라앉아 있습니다. 입술 다물기를 가볍게 풀고, 모음을 자연스러운 톤으로 띄워 가운데 ngang 으로 올라오는 느낌으로 발음해 보세요. '바' 라고 말할 때 베트남어 'ba' 보다 살짝 더 부드럽게, 입술 사이로 공기가 새듯이 빠져나가는 느낌이면 좋습니다.",
      "baji_vn": "바지(ㅂ) trên la bàn nằm hơi dưới ngang (đường chuẩn), lệch nhẹ về bên trái 깊은 nặng — VOT 88ms với một 평음 thì hơi dài, đã bị đẩy một bước sang vùng bật hơi bên phải, và F0 cũng thấp hơn baseline của bạn -5.9 st, chìm xuống dưới cụm 평음 của người bản ngữ (-3.7 st) thêm -2.3 st nữa. Hãy thả lỏng động tác khép môi và nâng nguyên âm về tông tự nhiên, cảm giác như nổi lên ngang ở giữa. Khi nói '바', hãy mềm hơn so với 'ba' tiếng Việt một chút, có cảm giác như hơi rò qua môi.",
      "bbareuda": "빠르다(ㅃ)는 나침반 가장 왼쪽 깊은 nặng 영역에 단단히 박혀 있어야 하는데, 지금은 평음 바지 옆자리에 머물러 있습니다 — VOT 33ms 는 원어민의 0ms 보다 33ms 길어, '왼쪽 끝' 이 아니라 '중앙 약간 왼쪽' 정도 위치입니다. F0 도 본인 baseline 대비 -5.3 st 로 가라앉아 있어 위쪽 sắc 으로 솟아오르는 느낌이 부족합니다. 입술을 한 박자 더 꽉 다물어 압력을 모았다가, 거의 바람 없이 짧고 단단하게 '뽁' 하고 터뜨리세요 — 그리고 모음 'ㅏ' 를 평음보다 살짝 더 높은 톤으로 시작해 ㅏ 가 위로 짧게 튀어오르도록 합니다.",
      "bbareuda_vn": "빠르다(ㅃ) đáng lẽ phải bám chặt vào vùng nặng sâu nhất bên trái la bàn, nhưng hiện tại lại nằm ngay cạnh 평음 바지 — VOT 33ms dài hơn người bản ngữ (0ms) 33ms, nên vị trí không phải 'cực trái' mà chỉ là 'hơi lệch trái so với trung tâm'. F0 cũng chìm xuống -5.3 st so với baseline của bạn, thiếu cảm giác vọt lên phía sắc bên trên. Hãy khép môi chặt thêm một nhịp để dồn áp lực, rồi bật ra ngắn và chắc kiểu 'pốc', gần như không có hơi — và bắt đầu nguyên âm 'ㅏ' ở tông cao hơn 평음 một chút, để ㅏ bật ngắn lên trên.",
      "paransaek": "파란색(ㅍ)은 나침반 오른쪽 bật hơi 영역의 가장 끝, 그리고 위쪽 sắc 끝까지 동시에 뻗어나가 원어민 클러스터에서 멀리 떨어져 있습니다 — VOT 182ms 는 원어민 60ms 의 3 배에 달하고, F0 도 +7.7 st 로 원어민 +3.4 st 보다 +4.3 st 더 높이 솟아 있어 '오른쪽 위 구석에 너무 멀리 던져진' 모양입니다. 격음 구분 자체는 잘하고 계시니, 이제는 힘을 살짝 빼는 방향으로 조절하세요 — 입에서 손바닥까지 닿는 바람을 지금의 절반 정도로 줄이고, 모음 톤도 한 단계 낮춰 원어민 클러스터 쪽으로 끌어당기는 느낌으로 발음하면 됩니다.",
      "paransaek_vn": "파란색(ㅍ) trên la bàn đang vươn ra đến tận góc ngoài cùng bên phải vùng bật hơi, đồng thời cũng lên đến đỉnh sắc phía trên, nằm cách xa cụm người bản ngữ — VOT 182ms gấp 3 lần người bản ngữ (60ms), và F0 cũng vọt lên +7.7 st, cao hơn +3.4 st của bản ngữ +4.3 st, có dạng 'bị ném quá xa ra góc trên bên phải'. Bản thân việc phân biệt 격음 thì bạn đã làm tốt rồi, giờ hãy điều chỉnh theo hướng bớt sức lại — giảm lượng hơi từ miệng đến lòng bàn tay xuống còn khoảng một nửa hiện tại, hạ tông nguyên âm xuống một bậc, kéo về phía cụm người bản ngữ."
    },
    "encouragement": "F0 의 방향이 평음<경음<격음 순서로 이미 잡혀 있다는 건 큰 진전입니다 — 이제 세 점 사이의 간격만 다듬으면 됩니다!",
    "encouragement_vn": "Việc hướng F0 đã đi theo thứ tự 평음<경음<격음 là một bước tiến lớn — giờ bạn chỉ cần chỉnh lại khoảng cách giữa ba điểm thôi!",
