  "ai_feedback": {
    "error_analysis": {
      "summary": "경음 빠르다는 원어민과 완벽히 일치하는 강점이며, 평음 바지의 모음 음높이가 다소 높게 시작되어 격음과의 거리가 좁아지는 경향이 보입니다.",
      "summary_vn": "빠르다 (phụ âm căng/경음) phát âm hoàn hảo như người bản xứ là điểm mạnh, tuy nhiên cao độ nguyên âm trong 바지 (phụ âm bình/평음) bắt đầu hơi cao, khiến khoảng cách với 격음 bị thu hẹp.",
      "detail": "바지(평음)의 VOT는 60ms로 원어민(97ms)보다 짧아 평음다움은 충분하나, ㅏ 모음의 F0 패턴이 baseline 대비 -1.3 ST 로 원어민(-3.7)보다 약 2.3 ST 높게 시작합니다. 빠르다(경음)는 VOT 0ms로 원어민과 정확히 일치하며 F0도 1.2 ST 로 적절히 높게 출발해 위계가 잘 잡혀 있습니다. 파란색(격음)은 VOT 104ms로 원어민(60ms)보다 오히려 더 긴 기식을 만들어 평음 바지(60ms)와 44ms 의 분명한 거리를 확보하고 있습니다. 종합하면 자음의 기식 길이 구분은 매우 잘 통제되고 있으나, 평음의 모음이 충분히 낮게 시작되지 않아 평음↔격음 위계가 평탄해지는 점이 가장 큰 과제입니다.",
      "detail_vn": "VOT của 바지 (평음) là 60ms, ngắn hơn người bản xứ (97ms) nên tính 평음 đã đủ, nhưng mẫu F0 của nguyên âm ㅏ ở mức -1.3 ST so với baseline — cao hơn người bản xứ (-3.7) khoảng 2.3 ST. 빠르다 (경음) có VOT 0ms trùng khớp chính xác với người bản xứ và F0 xuất phát ở 1.2 ST, hệ thống thứ bậc được thiết lập tốt. 파란색 (격음) có VOT 104ms, thậm chí còn dài hơn người bản xứ (60ms), tạo khoảng cách rõ ràng 44ms với 바지 (60ms). Tổng kết, sự phân biệt về độ dài hơi bật của phụ âm được kiểm soát rất tốt, nhưng cao độ nguyên âm ở 평음 chưa đủ thấp, khiến hệ thống thứ bậc 평음↔격음 bị san bằng — đây là nhiệm vụ lớn nhất."
    },
    "cause": "베트남어에는 한국어 평음·경음·격음의 3중 구분이 없어, 모음 음높이를 자음 종류에 맞춰 조절하는 습관이 익숙하지 않습니다. 특히 평음의 낮은 시작 톤은 베트남어 화자에게 자연스럽지 않아 모음을 baseline 가까이에서 출발하게 됩니다. 다행히 자음 기식 길이는 측정상 잘 통제되고 있어, 음높이 패턴만 다듬으면 빠르게 좋아질 수 있는 단계입니다.",
    "cause_vn": "Tiếng Việt không có hệ thống phân biệt ba loại 평음·경음·격음 như tiếng Hàn, nên thói quen điều chỉnh cao độ nguyên âm theo loại phụ âm chưa quen thuộc. Đặc biệt, cao độ thấp ở đầu 평음 không tự nhiên với người nói tiếng Việt, nên nguyên âm thường bắt đầu gần baseline. May mắn là độ dài hơi bật của phụ âm được kiểm soát tốt theo đo lường, nên chỉ cần điều chỉnh mẫu cao độ là sẽ tiến bộ nhanh.",
    "correction": {
      "main_focus": "평음 ㅂ를 발음할 때 모음 ㅏ 를 평소 baseline 보다 한 톤 아래에서 부드럽게 시작하여 격음과의 음높이 거리를 확보하기.",
      "main_focus_vn": "Khi phát âm 평음 ㅂ, hãy bắt đầu nguyên âm ㅏ nhẹ nhàng ở mức thấp hơn baseline thông thường một bậc để tạo khoảng cách cao độ với 격음.",
      "steps": [
        "거울 앞에서 입 모양을 확인하며 최소대립쌍 '바-빠-파' 를 천천히 5회씩 반복 — 입술 폐쇄·후두 긴장·기식 강도를 의식적으로 분리해서 느끼기.",
        "손바닥을 입 앞 10cm 에 두고 바람의 양을 직접 체감 — 평음은 거의 안 느껴지고, 경음은 짧고 단단하게, 격음은 분명한 바람이 길게 닿아야 함.",
        "녹음 전 자기 baseline 톤으로 '음~~' 하고 워밍업한 뒤, 평음은 baseline 보다 살짝 낮게, 경음·격음은 살짝 높게 출발하는 음높이 패턴을 의식적으로 연습하기."
      ],
      "steps_vn": [
        "Đứng trước gương, kiểm tra khẩu hình và lặp lại cặp tối thiểu '바-빠-파' chậm rãi 5 lần mỗi cặp — phân biệt có ý thức khẩu hình đóng môi, độ căng thanh quản và cường độ hơi bật.",
        "Đặt lòng bàn tay cách miệng 10cm để cảm nhận trực tiếp lượng hơi — 평음 hầu như không cảm thấy, 경음 ngắn và chặt, 격음 phải có luồng gió rõ ràng và dài chạm vào tay.",
        "Trước khi ghi âm, khởi động bằng baseline tone của bản thân với âm 'mmm~~', sau đó luyện tập có ý thức mẫu cao độ: 평음 bắt đầu hơi thấp hơn baseline, 경음·격음 hơi cao hơn."
      ]
    },
    "overall": "전반적으로 자음의 기식 길이 구분은 매우 잘 통제되고 있으며, 특히 경음 빠르다는 원어민과 동일한 수준으로 안정적인 강점입니다. 격음 파란색의 기식도 충분하여 평음과 명확히 분리되고 있어, 베트남 학습자가 자주 보이는 '셋이 평탄해지는' 패턴에서 한 단계 앞서 있습니다. 다음 단계로 평음의 모음 음높이를 살짝 더 낮게 시작하는 연습을 더하면, 한국인 청자에게 더 자연스러운 위계가 들릴 것입니다. 지금의 진전이 분명하고, 음높이 패턴만 다듬으면 다음 단계로 도약할 수 있는 좋은 위치에 있습니다.",
    "overall_vn": "Tổng thể, sự phân biệt về độ dài hơi bật của phụ âm được kiểm soát rất tốt, đặc biệt 빠르다 (경음) đạt mức tương đương người bản xứ và là điểm mạnh ổn định. Hơi bật của 파란색 (격음) cũng đủ mạnh để tách biệt rõ với 평음, vượt qua mẫu thường gặp ở người học Việt là 'ba loại bị san bằng'. Bước tiếp theo, nếu thêm luyện tập bắt đầu nguyên âm ở 평음 thấp hơn một chút, người nghe Hàn Quốc sẽ nghe được hệ thống thứ bậc tự nhiên hơn. Sự tiến bộ đến nay rõ ràng, và bạn đang ở vị trí tốt để bước sang giai đoạn tiếp theo chỉ bằng cách điều chỉnh mẫu cao độ.",
    "compass_overview": "",
    "compass_overview_vn": "",
    "by_word": {
      "baji": "VOT 60ms — 원어민(97ms)보다 짧아 평음다움은 충분합니다. 다만 PRAAT 의 파란 F0 곡선이 baseline 대비 -1.3 ST 정도만 내려가, 원어민(-3.7)보다 약 2.3 ST 높게 시작합니다. 입술을 부드럽게 떼면서 모음 ㅏ 를 가슴 깊은 곳에서 낮게 시작하는 느낌으로 발음해보세요. '바' 의 ㅏ 가 평소 말하는 톤보다 한 단계 아래에서 출발해야 평음 특유의 부드러움이 살아납니다.",
      "baji_vn": "VOT 60ms — ngắn hơn người bản xứ (97ms) nên tính 평음 đã đủ. Tuy nhiên đường cong F0 màu xanh trên PRAAT chỉ xuống khoảng -1.3 ST so với baseline, cao hơn người bản xứ (-3.7) khoảng 2.3 ST. Hãy mở môi nhẹ nhàng và thử bắt đầu nguyên âm ㅏ từ sâu trong ngực ở vị trí thấp. ㅏ của '바' phải xuất phát thấp hơn tone nói chuyện thường một bậc thì sự mềm mại đặc trưng của 평음 mới hiện ra.",
      "bbareuda": "VOT 0ms — 원어민과 정확히 일치합니다! 파형에서 첫 자음 폐쇄 직후 모음이 지체 없이 시작되는 모습이 매우 깔끔하며, F0 곡선도 1.2 ST 로 적절히 높게 출발해 원어민 패턴(-0.4)과 위계가 잘 맞습니다. 후두 긴장과 짧은 VOT 가 동시에 안정적으로 통제되고 있어요 — 이 발음을 그대로 유지하면서 다른 단어의 anchor 로 활용하세요.",
      "bbareuda_vn": "VOT 0ms — trùng khớp chính xác với người bản xứ! Trên dạng sóng, nguyên âm bắt đầu ngay sau phụ âm đóng không có độ trễ, rất gọn, và đường F0 xuất phát ở 1.2 ST, cao phù hợp, khớp tốt với mẫu người bản xứ (-0.4). Độ căng thanh quản và VOT ngắn đều được kiểm soát ổn định đồng thời — hãy giữ nguyên cách phát âm này và sử dụng làm anchor cho các từ khác.",
      "paransaek": "VOT 104ms — 원어민(60ms)보다 오히려 더 긴 기식을 만들어, 파형 첫 칸의 잡음(거품) 구간이 길게 보입니다. 평음 바지(60ms)와의 차이가 44ms 로 분명해 기식 면에서는 잘 구분되고 있습니다. F0 측정이 어려웠던 부분이 있어 모음 음높이는 정확히 확인하기 어려웠으나, 측정상 ㅏ 의 음높이가 다소 불안정한 인상이 있습니다. '파!' 의 ㅏ 를 평소보다 살짝 더 높은 톤에서 출발하면, 격음의 강한 기식과 함께 위계가 더 분명해질 것입니다.",
      "paransaek_vn": "VOT 104ms — thậm chí còn dài hơn người bản xứ (60ms); trên dạng sóng, vùng nhiễu (bọt) ở ô đầu tiên kéo dài. Khoảng cách với 바지 (60ms) là 44ms rõ ràng, nên sự phân biệt về hơi bật được thực hiện rất tốt. Có khó khăn khi đo F0 nên cao độ nguyên âm khó xác nhận chính xác, nhưng có cảm giác cao độ ㅏ hơi không ổn định theo đo lường. Nếu xuất phát ㅏ của '파!' ở tone cao hơn một chút so với bình thường, kết hợp với hơi bật mạnh của 격음, hệ thống thứ bậc sẽ trở nên rõ ràng hơn."
    },
    "encouragement": "경음 빠르다는 이미 원어민 수준입니다 — 이 강점을 anchor 삼아 평음의 음높이만 다듬으면 큰 진전이 보일 거예요!",
    "encouragement_vn": "빠르다 (경음) đã đạt mức người bản xứ — hãy lấy điểm mạnh này làm anchor và chỉ cần điều chỉnh cao độ ở 평음 là bạn sẽ thấy tiến bộ lớn!",
